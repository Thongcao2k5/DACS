@model IEnumerable<GPULabOrchestrator.Business.DTOs.InstanceDto>
@{ ViewData["Title"] = "My Instances"; }

<div class="flex justify-between items-center mb-6">
    <div class="flex gap-2">
        <span class="text-xs text-slate-400 bg-surface border border-border px-3 py-1.5 rounded-lg">
            @Model.Count(i => i.Status == InstanceStatus.Running) Running
        </span>
        <span class="text-xs text-slate-400 bg-surface border border-border px-3 py-1.5 rounded-lg">
            @Model.Count(i => i.Status == InstanceStatus.Queued) Queued
        </span>
    </div>
    <a asp-action="Create" class="flex items-center gap-1.5 bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-medium px-3 py-1.5 rounded-lg transition-colors">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
        New Instance
    </a>
</div>

<div class="bg-surface border border-border rounded-xl overflow-hidden">
    <table class="w-full text-sm">
        <thead>
            <tr class="border-b border-border">
                <th class="text-left px-5 py-3 text-xs font-semibold text-slate-400">Instance</th>
                <th class="text-left px-5 py-3 text-xs font-semibold text-slate-400">GPU / Image</th>
                <th class="text-left px-5 py-3 text-xs font-semibold text-slate-400">Status</th>
                <th class="text-left px-5 py-3 text-xs font-semibold text-slate-400">Uptime</th>
                <th class="text-left px-5 py-3 text-xs font-semibold text-slate-400">Expires</th>
                <th class="text-right px-5 py-3 text-xs font-semibold text-slate-400">Actions</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-border">
            @foreach (var inst in Model)
            {
                <tr class="hover:bg-white/[0.02] transition-colors">
                    <td class="px-5 py-3">
                        <a asp-action="Detail" asp-route-id="@inst.Id" class="text-white hover:text-indigo-400 font-medium transition-colors">
                            @(inst.Name ?? inst.Id.ToString()[..8])
                        </a>
                        <p class="text-xs text-slate-500 font-mono">@inst.Id.ToString()[..8]...</p>
                    </td>
                    <td class="px-5 py-3">
                        <p class="text-slate-300">@inst.GpuModel</p>
                        <p class="text-xs text-slate-500">@inst.ImageName</p>
                    </td>
                    <td class="px-5 py-3">
                        <span class="badge-@inst.Status.ToString().ToLower()">@inst.Status</span>
                    </td>
                    <td class="px-5 py-3 text-slate-300 text-xs">
                        @(inst.Uptime.HasValue ? $"{(int)inst.Uptime.Value.TotalHours}h {inst.Uptime.Value.Minutes}m" : "—")
                    </td>
                    <td class="px-5 py-3 text-slate-300 text-xs">
                        @(inst.ExpiresAt?.ToString("MMM d, HH:mm") ?? "—")
                    </td>
                    <td class="px-5 py-3">
                        <div class="flex items-center justify-end gap-2">
                            @if (inst.Status == InstanceStatus.Running && inst.ConnectionUri != null)
                            {
                                <a href="@inst.ConnectionUri" target="_blank"
                                   class="text-xs text-green-400 hover:text-green-300 border border-green-500/20 px-2 py-1 rounded transition-colors">Connect</a>
                            }
                            @if (inst.Status == InstanceStatus.Running)
                            {
                                <form asp-action="Stop" method="post">
                                    <input type="hidden" name="id" value="@inst.Id"/>
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="text-xs text-yellow-400 hover:text-yellow-300 border border-yellow-500/20 px-2 py-1 rounded transition-colors">Stop</button>
                                </form>
                            }
                            @if (inst.Status == InstanceStatus.Stopped)
                            {
                                <form asp-action="Start" method="post">
                                    <input type="hidden" name="id" value="@inst.Id"/>
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="text-xs text-blue-400 hover:text-blue-300 border border-blue-500/20 px-2 py-1 rounded transition-colors">Start</button>
                                </form>
                            }
                            <form asp-action="Destroy" method="post" onsubmit="return confirm('Destroy this instance?')">
                                <input type="hidden" name="id" value="@inst.Id"/>
                                @Html.AntiForgeryToken()
                                <button type="submit" class="text-xs text-red-400 hover:text-red-300 border border-red-500/20 px-2 py-1 rounded transition-colors">Destroy</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="6" class="px-5 py-10 text-center text-slate-500 text-sm">
                        No instances yet. <a asp-action="Create" class="text-indigo-400 hover:underline">Create one</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
