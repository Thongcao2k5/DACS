<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — GPU Lab Orchestrator</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        surface: '#1a1d27',
                        base: '#0f1117',
                        border: '#2a2d3a'
                    }
                }
            }
        }
    </script>
    <style>
        body { background-color: #0f1117; }
        .sidebar-link { @apply flex items-center gap-3 px-4 py-2.5 rounded-lg text-slate-400 hover:text-white hover:bg-white/5 transition-all text-sm; }
        .sidebar-link.active { @apply text-white bg-indigo-600/20 text-indigo-400; }
        .stat-card { @apply bg-surface border border-border rounded-xl p-5; }
        .badge-running { @apply px-2 py-0.5 rounded-full text-xs font-medium bg-green-500/20 text-green-400; }
        .badge-queued { @apply px-2 py-0.5 rounded-full text-xs font-medium bg-yellow-500/20 text-yellow-400; }
        .badge-stopped { @apply px-2 py-0.5 rounded-full text-xs font-medium bg-slate-500/20 text-slate-400; }
        .badge-suspended { @apply px-2 py-0.5 rounded-full text-xs font-medium bg-orange-500/20 text-orange-400; }
        .badge-failed { @apply px-2 py-0.5 rounded-full text-xs font-medium bg-red-500/20 text-red-400; }
        .badge-allocating { @apply px-2 py-0.5 rounded-full text-xs font-medium bg-blue-500/20 text-blue-400; }
    </style>
</head>
<body class="text-slate-200 min-h-screen flex">

@if (User.Identity?.IsAuthenticated == true)
{
    <!-- Sidebar -->
    <aside class="w-60 min-h-screen bg-surface border-r border-border flex flex-col fixed left-0 top-0 z-10">
        <!-- Logo -->
        <div class="px-5 py-5 border-b border-border">
            <div class="flex items-center gap-2.5">
                <div class="w-8 h-8 bg-indigo-600 rounded-lg flex items-center justify-center">
                    <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3H5a2 2 0 00-2 2v4m6-6h10a2 2 0 012 2v4M9 3v18m0 0h10a2 2 0 002-2V9M9 21H5a2 2 0 01-2-2V9m0 0h18"/>
                    </svg>
                </div>
                <span class="font-bold text-white text-sm">GPU Lab</span>
            </div>
        </div>

        <!-- Nav -->
        <nav class="flex-1 px-3 py-4 space-y-1">
            <a asp-controller="Dashboard" asp-action="Index" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
                Dashboard
            </a>
            <a asp-controller="Gpu" asp-action="Index" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Gpu" ? "active" : "")">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2"/></svg>
                GPUs
            </a>
            <a asp-controller="Instance" asp-action="Index" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Instance" ? "active" : "")">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                My Instances
            </a>
            <a asp-controller="Quota" asp-action="Index" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Quota" ? "active" : "")">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                Quota
            </a>

            @if (User.IsInRole("LabManager") || User.IsInRole("SystemAdmin"))
            {
                <div class="pt-4 pb-1 px-4">
                    <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Management</p>
                </div>
                <a asp-area="Manager" asp-controller="Home" asp-action="Index" class="sidebar-link">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
                    Lab Dashboard
                </a>
                <a asp-area="Manager" asp-controller="QuotaRequest" asp-action="Index" class="sidebar-link">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
                    Quota Requests
                </a>
            }

            @if (User.IsInRole("SystemAdmin"))
            {
                <div class="pt-4 pb-1 px-4">
                    <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Admin</p>
                </div>
                <a asp-area="Admin" asp-controller="Node" asp-action="Index" class="sidebar-link">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
                    Nodes
                </a>
                <a asp-area="Admin" asp-controller="Audit" asp-action="Index" class="sidebar-link">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                    Audit Log
                </a>
                <a asp-area="Admin" asp-controller="Image" asp-action="Index" class="sidebar-link">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                    Images
                </a>
            }
        </nav>

        <!-- User footer -->
        <div class="px-3 py-4 border-t border-border">
            <div class="flex items-center gap-3 px-2">
                <div class="w-8 h-8 bg-indigo-600 rounded-full flex items-center justify-center text-xs font-bold text-white">
                    @User.Identity?.Name?.Substring(0, 1).ToUpper()
                </div>
                <div class="flex-1 min-w-0">
                    <p class="text-xs font-medium text-white truncate">@User.Identity?.Name</p>
                    <p class="text-xs text-slate-500">@(User.IsInRole("SystemAdmin") ? "Admin" : User.IsInRole("LabManager") ? "Lab Manager" : "Researcher")</p>
                </div>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="text-slate-500 hover:text-red-400 transition-colors">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
                    </button>
                </form>
            </div>
        </div>
    </aside>

    <!-- Main content -->
    <div class="flex-1 ml-60 min-h-screen flex flex-col">
        <!-- Top nav -->
        <header class="h-16 bg-surface border-b border-border flex items-center justify-between px-6 sticky top-0 z-10">
            <h1 class="text-sm font-semibold text-white">@ViewData["Title"]</h1>
            <div class="flex items-center gap-4">
                @if (TempData["Success"] is string success)
                {
                    <div class="flex items-center gap-2 bg-green-500/10 border border-green-500/20 text-green-400 px-3 py-1.5 rounded-lg text-xs">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                        @success
                    </div>
                }
                <a asp-controller="Instance" asp-action="Create"
                   class="flex items-center gap-1.5 bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-medium px-3 py-1.5 rounded-lg transition-colors">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                    New Instance
                </a>
            </div>
        </header>

        <main class="flex-1 p-6">
            @RenderBody()
        </main>
    </div>
}
else
{
    @RenderBody()
}

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
