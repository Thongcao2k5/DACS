@model MotoShop.Business.Helpers.PagedList<MotoShop.Business.DTOs.ProductDto>

<div class="row row-cols-2 row-cols-md-3 row-cols-xl-4 g-3 @(Context.Request.Cookies["viewType"] == "list" ? "list-view" : "grid-view")" id="productGrid">
    @foreach (var product in Model)
    {
        <div class="col product-item">
            <div class="pc-item-wrap">
                @await Html.PartialAsync("_ProductCard", product)
                <div class="pc-actions-overlay">
                    <button type="button" class="btn-quick-view" onclick="quickView('@product.Slug')">
                        <i class='bx bx-search'></i> Xem nhanh
                    </button>
                    <button type="button" class="btn-compare-abs"
                            data-id="@product.ProductId"
                            data-name="@product.ProductName"
                            data-img="@(product.PrimaryImageUrl ?? "/assets/img/elements/18.jpg")"
                            data-price="@product.MinPrice"
                            onclick="addToCompareFromBtn(this)"
                            title="So sánh">
                        <i class='bx bx-git-compare'></i>
                    </button>
                </div>
            </div>
        </div>
    }
</div>
