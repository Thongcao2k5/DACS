@using MotoShop.Business.DTOs
@model IEnumerable<ProductDto>
@{
    ViewData["Title"] = "Khuyến mãi hấp dẫn - MotoShop";
}

<!-- 1. BREADCRUMB -->
<div class="breadcrumb-wrapper">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                <li class="breadcrumb-item active" aria-current="page">Chương trình khuyến mãi</li>
            </ol>
        </nav>
    </div>
</div>

<main class="container mb-5">
    <!-- 2. PROMOTION BANNER -->
    <section class="p-0 mb-5">
        <div class="promo-banner-large rounded-4 overflow-hidden position-relative">
            <img src="/assets/img/backgrounds/promo-banner.jpg" onerror="this.src='https://images.unsplash.com/photo-1558981403-c5f9899a28bc?w=1600&q=80'" class="w-100" style="height: 400px; object-fit: cover;" alt="Promo">
            <div class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center" style="background: linear-gradient(to right, rgba(0,0,0,0.7), transparent); padding: 60px;">
                <div class="text-white col-lg-6">
                    <h4 class="fw-bold text-warning mb-2">ƯU ĐÃI ĐẶC BIỆT</h4>
                    <h1 class="display-4 fw-bolder mb-3">SĂN PHỤ TÙNG<br>GIẢM ĐẾN 50%</h1>
                    <p class="fs-5 mb-4 opacity-75">Áp dụng cho các linh kiện chính hãng Honda, Yamaha & Motul đang có mặt tại cửa hàng.</p>
                    <a href="#discountGrid" class="btn btn-danger btn-lg rounded-pill px-5 fw-bold">SĂN DEAL NGAY</a>
                </div>
            </div>
        </div>
    </section>

    <!-- 4. FLASH SALE SECTION -->
    <section class="p-0 mb-5">
        <div class="flash-sale-header">
            <div class="d-flex align-items-center gap-3">
                <h3 class="fw-bolder mb-0 italic">FLASH SALE</h3>
                <div class="countdown-timer">
                    <span class="small fw-bold me-1">KẾT THÚC TRONG:</span>
                    <div class="timer-unit" id="hr">02</div>
                    <span class="fw-bold">:</span>
                    <div class="timer-unit" id="mn">15</div>
                    <span class="fw-bold">:</span>
                    <div class="timer-unit" id="sc">30</div>
                </div>
            </div>
        </div>
        <div class="flash-sale-body mt-4">
            <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-4">
                @if (Model != null && Model.Any())
                {
                    foreach (var product in Model.Take(4))
                    {
                        var primaryImg = product.PrimaryImageUrl ?? "/assets/img/elements/1.jpg";
                        var price = product.MinPrice;
                        var oldPrice = product.OldPrice ?? (price * 1.2m); // Giả lập giá cũ nếu không có

                        <div class="col">
                            <div class="product-card h-100 shadow-sm border-0">
                                @if (product.DiscountPercent > 0)
                                {
                                    <div class="discount-badge-large">-@product.DiscountPercent%</div>
                                }
                                <div class="product-img-wrapper position-relative">
                                    <img src="@primaryImg" alt="@product.ProductName" onerror="this.src='https://via.placeholder.com/400'" onclick="location.href='@Url.Action("Details", "Product", new { slug = product.Slug })'">
                                    <button type="button" class="btn-wishlist-abs" onclick="addToWishlist(@product.ProductId)" title="Thêm vào yêu thích">
                                        <i class='bx bx-heart'></i>
                                    </button>
                                </div>
                                <div class="product-info flex-grow-1">
                                    <h6 class="name text-truncate">@product.ProductName</h6>
                                    <div class="product-price">
                                        <span class="current">@price.ToString("N0")đ</span>
                                        @if (product.OldPrice > product.MinPrice)
                                        {
                                            <span class="old">@product.OldPrice?.ToString("N0")đ</span>
                                        }
                                    </div>
                                    <!-- Stock Progress -->
                                    <div class="stock-progress-wrapper mt-2">
                                        <div class="stock-label">
                                            <span>Sắp cháy hàng</span>
                                        </div>
                                        <div class="progress-bar-custom">
                                            <div class="progress-fill" style="width: 85%;"></div>
                                        </div>
                                    </div>
                                </div>
                                <button class="btn btn-danger w-100 rounded-pill fw-bold mt-3" onclick="handleBuyNow(@product.DefaultVariantId)">MUA NGAY</button>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12 text-center py-5">
                        <p class="text-muted">Hiện chưa có sản phẩm Flash Sale.</p>
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- 5. DISCOUNT PRODUCTS GRID -->
    <section class="p-0" id="discountGrid">
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
            <h3 class="fw-bold mb-0 text-uppercase">SẢN PHẨM ƯU ĐÃI</h3>
        </div>

        <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-4">
            @if (Model != null && Model.Any())
            {
                foreach (var product in Model)
                {
                    var primaryImg = product.PrimaryImageUrl ?? "/assets/img/elements/1.jpg";
                    var price = product.MinPrice;
                    var oldPrice = product.OldPrice ?? (price * 1.15m);

                    <div class="col">
                        <div class="product-card h-100 shadow-sm border-0">
                            <span class="product-badge badge-hot">HOT</span>
                            <div class="product-img-wrapper position-relative">
                                <img src="@primaryImg" alt="@product.ProductName" onerror="this.src='https://via.placeholder.com/400'" onclick="location.href='@Url.Action("Details", "Product", new { slug = product.Slug })'">
                                <button type="button" class="btn-wishlist-abs" onclick="addToWishlist(@product.ProductId)" title="Thêm vào yêu thích">
                                    <i class='bx bx-heart'></i>
                                </button>
                            </div>
                            <div class="product-info flex-grow-1">
                                <span class="brand text-uppercase small text-muted">@product.BrandName</span>
                                <h6 class="name text-truncate">@product.ProductName</h6>
                                <div class="product-price">
                                    <span class="current">@price.ToString("N0")đ</span>
                                    <span class="old">@oldPrice.ToString("N0")đ</span>
                                </div>
                            </div>
                            <button class="btn btn-add-cart w-100 rounded-pill fw-bold mt-3" onclick="handleAddToCart(@product.DefaultVariantId)">THÊM VÀO GIỎ</button>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center py-5">
                    <i class='bx bx-purchase-tag-alt fs-1 text-muted mb-3 d-block'></i>
                    <h5 class="text-muted">Đang cập nhật thêm các sản phẩm ưu đãi khác.</h5>
                </div>
            }
        </div>
    </section>
</main>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/assets/js/design-system.js"></script>
    <script src="~/js/cart-handler.js"></script>
    <script>
        // Simple countdown logic
        function startTimer() {
            let h = 2, m = 15, s = 30;
            setInterval(() => {
                s--;
                if(s < 0) { s = 59; m--; }
                if(m < 0) { m = 59; h--; }
                const hrElem = document.getElementById('hr');
                const mnElem = document.getElementById('mn');
                const scElem = document.getElementById('sc');
                if(hrElem) hrElem.innerText = h.toString().padStart(2, '0');
                if(mnElem) mnElem.innerText = m.toString().padStart(2, '0');
                if(scElem) scElem.innerText = s.toString().padStart(2, '0');
            }, 1000);
        }
        startTimer();
    </script>
}
