@using MotoShop.Business.Helpers
@model PagedList<MotoShop.Business.DTOs.ProductDto>

@{
    ViewData["Title"] = "Tất cả sản phẩm";
    var searchTerm = Context.Request.Query["searchTerm"];
    var categoryId = Context.Request.Query["categoryId"];
    var brandId = Context.Request.Query["brandId"];
    var sort = Context.Request.Query["sort"];
}

<div class="breadcrumb-wrapper">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
                <li class="breadcrumb-item active" aria-current="page">Sản phẩm</li>
            </ol>
        </nav>
    </div>
</div>

<main class="container mb-5">
    <form id="filterForm" method="get" asp-action="Index">
        <input type="hidden" name="searchTerm" value="@searchTerm" />
        <div class="row g-4">
            <!-- 1. LEFT SIDEBAR: FILTERS -->
            <aside class="col-lg-3">
                <div class="filter-sidebar sticky-top" style="top: 100px;">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h5 class="fw-bold mb-0 text-uppercase">Bộ lọc</h5>
                        @if (!string.IsNullOrEmpty(categoryId) || !string.IsNullOrEmpty(brandId) || !string.IsNullOrEmpty(searchTerm))
                        {
                            <a asp-action="Index" class="text-danger small fw-bold text-decoration-none">XÓA TẤT CẢ</a>
                        }
                    </div>

                    <!-- Category Filter -->
                    <div class="filter-widget mb-4 pb-4 border-bottom">
                        <h6 class="fw-bold mb-3">DANH MỤC</h6>
                        <select name="categoryId" class="form-select rounded-pill filter-select" asp-items="ViewBag.Categories">
                            <option value="">Tất cả danh mục</option>
                        </select>
                    </div>

                    <!-- Brand Filter -->
                    <div class="filter-widget mb-4 pb-4 border-bottom">
                        <h6 class="fw-bold mb-3">THƯƠNG HIỆU</h6>
                        <select name="brandId" class="form-select rounded-pill filter-select" asp-items="ViewBag.Brands">
                            <option value="">Tất cả thương hiệu</option>
                        </select>
                    </div>

                    <button type="submit" id="applyBtn" class="btn btn-danger w-100 rounded-pill fw-bold mt-2">ÁP DỤNG</button>
                </div>
            </aside>

            <!-- 2. MAIN CONTENT: PRODUCT GRID -->
            <div class="col-lg-9">
                <!-- Toolbar -->
                <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
                    <div class="toolbar-info">
                        @if (!string.IsNullOrEmpty(searchTerm))
                        {
                            <span class="text-muted small">Kết quả tìm kiếm cho: </span> <strong class="text-danger">"@searchTerm"</strong>
                        }
                        <h3 class="fw-bold mb-1 text-uppercase">@ViewBag.CurrentCategoryName</h3>
                        <p class="text-muted mb-0 small">Hiển thị @Model.Count trên tổng số @Model.TotalCount sản phẩm</p>
                    </div>

                    <div class="d-flex align-items-center gap-2">
                        <span class="text-muted small flex-shrink-0">Sắp xếp:</span>
                        <select name="sort" class="form-select rounded-pill border-secondary-subtle py-2 shadow-none small px-3 filter-select" style="min-width: 180px;" asp-items="ViewBag.SortList">
                        </select>
                    </div>
                </div>

                <!-- Product Grid Wrapper -->
                <div class="position-relative" id="gridWrapper">
                    <div id="loadingOverlay" class="position-absolute top-0 start-0 w-100 h-100 bg-white opacity-50 d-none justify-content-center align-items-start pt-5" style="z-index: 10;">
                        <div class="spinner-border text-danger" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>

                    @if (Model.Any())
                    {
                        <div class="row row-cols-2 row-cols-md-3 row-cols-xl-4 g-4" id="productGrid">
                            @foreach (var product in Model)
                            {
                                <div class="col">
                                    <div class="product-card h-100 d-flex flex-column border rounded-4 overflow-hidden shadow-sm hover-shadow transition">
                                        <div class="product-img-wrapper position-relative overflow-hidden" style="aspect-ratio: 1/1;">
                                            <a asp-action="Details" asp-route-slug="@product.Slug" class="d-block h-100">
                                                <img src="@(string.IsNullOrEmpty(product.PrimaryImageUrl) ? "/assets/img/elements/18.jpg" : product.PrimaryImageUrl)" 
                                                     alt="@product.ProductName" 
                                                     class="w-100 h-100 object-fit-cover transition-scale" 
                                                     onerror="this.src='/assets/img/elements/18.jpg'"
                                                     loading="lazy">
                                            </a>
                                            <button type="button" class="btn-wishlist-abs" onclick="addToWishlist(@product.ProductId)" title="Thêm vào yêu thích">
                                                <i class='bx bx-heart'></i>
                                            </button>
                                            @if (product.MinPrice == 0)
                                            {
                                                <span class="badge bg-warning text-dark position-absolute top-0 end-0 m-2 rounded-pill">Liên hệ</span>
                                            }
                                        </div>
                                        <div class="product-info p-3 flex-grow-1 d-flex flex-column">
                                            <div class="d-flex justify-content-between align-items-start mb-1">
                                                <span class="brand text-uppercase text-danger fw-bold" style="font-size: 0.7rem; letter-spacing: 0.5px;">@product.BrandName</span>
                                            </div>
                                            <h6 class="name mb-2 line-clamp-2" style="font-size: 0.95rem; line-height: 1.4; height: 2.8em;">
                                                <a asp-action="Details" asp-route-slug="@product.Slug" class="text-decoration-none text-dark hover-danger fw-semibold">
                                                    @product.ProductName
                                                </a>
                                            </h6>
                                            <div class="product-price mt-auto">
                                                @if (product.MinPrice > 0)
                                                {
                                                    <div class="d-flex align-items-center gap-2 flex-wrap">
                                                        <span class="current text-danger fw-bolder fs-5">@product.MinPrice.ToString("N0")đ</span>
                                                        @if (product.MinOriginalPrice.HasValue && product.MinOriginalPrice > product.MinPrice)
                                                        {
                                                            <del class="text-muted small" style="font-size: 0.8rem;">@product.MinOriginalPrice.Value.ToString("N0")đ</del>
                                                        }
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="current text-muted fw-bold">Liên hệ giá</span>
                                                }
                                            </div>
                                            <button type="button" onclick="CartApi.addToCart(@product.DefaultVariantId)" class="btn btn-danger btn-sm rounded-pill fw-bold mt-3">
                                                <i class='bx bx-cart-add fs-5 me-1'></i> THÊM GIỎ
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Pagination -->
                        @if (Model.TotalPages > 1)
                        {
                            <nav aria-label="Page navigation" class="mt-5">
                                <ul class="pagination justify-content-center">
                                    <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                                        <a class="page-link rounded-circle mx-1 border-0 shadow-sm" href="@Url.Action("Index", new { page = Model.CurrentPage - 1, searchTerm, categoryId, brandId, sort })"><i class='bx bx-chevron-left'></i></a>
                                    </li>
                                    @for (int i = 1; i <= Model.TotalPages; i++)
                                    {
                                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                            <a class="page-link rounded-circle mx-1 border-0 shadow-sm" href="@Url.Action("Index", new { page = i, searchTerm, categoryId, brandId, sort })">@i</a>
                                        </li>
                                    }
                                    <li class="page-item @(Model.HasNext ? "" : "disabled")">
                                        <a class="page-link rounded-circle mx-1 border-0 shadow-sm" href="@Url.Action("Index", new { page = Model.CurrentPage + 1, searchTerm, categoryId, brandId, sort })"><i class='bx bx-chevron-right'></i></a>
                                    </li>
                                </ul>
                            </nav>
                        }
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <img src="/assets/img/illustrations/empty-cart.png" alt="Empty" class="img-fluid mb-4" style="max-width: 250px;">
                            <h5 class="fw-bold">Rất tiếc, không tìm thấy sản phẩm nào!</h5>
                            <p class="text-muted mb-4">Thử thay đổi bộ lọc hoặc từ khóa tìm kiếm khác.</p>
                            <a asp-action="Index" class="btn btn-danger rounded-pill px-4">XEM TẤT CẢ SẢN PHẨM</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </form>
</main>

<style>
    .hover-shadow:hover { box-shadow: 0 .5rem 1.5rem rgba(0,0,0,.1)!important; }
    .transition { transition: all 0.3s ease; }
    .transition-scale { transition: transform 0.5s ease; }
    .product-img-wrapper:hover .transition-scale { transform: scale(1.1); }
    .hover-danger:hover { color: #dc3545!important; }
    .line-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .page-link { width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; color: #333; }
    .page-item.active .page-link { background-color: #dc3545; color: white; }
</style>

@section Scripts {
    <script src="~/js/cart-handler.js"></script>
    <script>
        $(document).ready(function() {
            $('.filter-select').on('change', function () { $('#filterForm').submit(); });
            $('#filterForm').on('submit', function() {
                $('#loadingOverlay').removeClass('d-none').addClass('d-flex');
                $('#applyBtn').prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span> ĐANG LỌC...');
            });
        });
    </script>
}
