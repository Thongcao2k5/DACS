@using MotoShop.Business.Helpers
@model MotoShop.Models.ViewModels.ProductListViewModel

@{
    ViewData["Title"] = Model.PageTitle;
    var pagedProducts = Model.PagedProducts;
}

<!-- BREADCRUMB ĐỘNG -->
<div class="breadcrumb-wrapper py-3 bg-light border-bottom mb-4">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted">Trang chủ</a></li>
                <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none text-muted">Sản phẩm</a></li>
                <li class="breadcrumb-item active text-danger fw-500" aria-current="page">@Model.PageTitle</li>
            </ol>
        </nav>
    </div>
</div>

<main class="container mb-5">
    <!-- TIÊU ĐỀ ĐỘNG -->
    <div class="page-header mb-4">
        <h1 class="fw-bold h3 mb-1">@Model.PageTitle</h1>
        <p class="text-muted small">@Model.PageSubtitle</p>
    </div>

    <form id="filterForm" method="get" asp-action="Index">
        <input type="hidden" name="searchTerm" value="@Model.CurrentKeyword" />
        <input type="hidden" name="viewType" id="viewTypeInput" value="@Context.Request.Cookies["viewType"]" />

        <!-- Ẩn các params để form submit vẫn giữ giá trị (do form GET sẽ reset URL parameters nếu không có hidden inputs) -->
        <input type="hidden" name="sort" id="sortInput" value="@Model.CurrentSort" />
        <input type="hidden" name="inStock" id="inStockInput" value="@(Model.IsInStockActive ? "true" : "")" />
        <input type="hidden" name="onSale" id="onSaleInput" value="@(Model.IsDiscountActive ? "true" : "")" />

        <div class="row g-4">
            <!-- 1. LEFT SIDEBAR: FILTERS -->
            <aside class="col-lg-3">
                <div class="filter-sidebar sticky-top" style="top: 100px;">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h5 class="fw-bold mb-0 text-uppercase h6">Bộ lọc</h5>
                        <a asp-action="Index" class="text-danger small fw-bold text-decoration-none">XÓA TẤT CẢ</a>
                    </div>

                    <!-- Price Slider -->
                    <div class="filter-widget mb-4 pb-4 border-bottom">
                        <h6 class="fw-bold mb-3 small">KHOẢNG GIÁ</h6>
                        <div class="price-display d-flex justify-content-between mb-2 small fw-500">
                            <span id="minPriceLabel">@Model.SelectedMinPrice.ToString("N0")đ</span>
                            <span id="maxPriceLabel">@Model.SelectedMaxPrice.ToString("N0")đ</span>
                        </div>
                        <div class="range-slider-wrapper position-relative py-3">
                            <input type="range" id="minPrice" name="minPrice" class="range-slider" min="0" max="@Model.MaxPriceLimit" step="10000" value="@Model.SelectedMinPrice">
                            <input type="range" id="maxPrice" name="maxPrice" class="range-slider" min="0" max="@Model.MaxPriceLimit" step="10000" value="@Model.SelectedMaxPrice">
                        </div>
                    </div>

                    <!-- Category Filter -->
                    <div class="filter-widget mb-4 pb-4 border-bottom">
                        <h6 class="fw-bold mb-3 small">DANH MỤC</h6>
                        <select name="categoryId" class="form-select rounded-pill filter-select">
                            <option value="">Tất cả danh mục</option>
                            @foreach (var cat in Model.Categories)
                            {
                                var count = Model.CategoryProductCount.GetValueOrDefault(cat.CategoryId, 0);
                                if (count == 0) continue;
                                <option value="@cat.CategoryId" selected="@(Model.CurrentCategoryId == cat.CategoryId)">
                                    @cat.CategoryName (@count)
                                </option>
                            }
                        </select>
                    </div>

                    <!-- Brand Filter -->
                    <div class="filter-widget mb-4 pb-4 border-bottom">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="fw-bold mb-0 small">THƯƠNG HIỆU</h6>
                            <div class="d-flex gap-1">
                                <button type="button" class="brand-arr" onclick="slideBrand(-1)">‹</button>
                                <button type="button" class="brand-arr" onclick="slideBrand(1)">›</button>
                            </div>
                        </div>
                        <input type="hidden" name="brandId" id="brandIdInput" value="@Model.CurrentBrandId">
                        <div class="brand-slider-track" id="brandSliderTrack">
                            <div class="brand-slide-item @(Model.CurrentBrandId == null ? "active" : "")"
                                 onclick="selectBrand('')" title="Tất cả">
                                <div class="brand-slide-logo">
                                    <i class='bx bx-store'></i>
                                </div>
                                <span class="brand-slide-name">Tất cả</span>
                            </div>
                            @foreach (var brand in Model.Brands)
                            {
                                <div class="brand-slide-item @(Model.CurrentBrandId == brand.BrandId ? "active" : "")"
                                     onclick="selectBrand('@brand.BrandId')"
                                     title="@brand.BrandName">
                                    <div class="brand-slide-logo">
                                        @if (!string.IsNullOrEmpty(brand.LogoUrl))
                                        {
                                            <img src="@brand.LogoUrl" alt="@brand.BrandName"
                                                 onerror="this.style.display='none';this.nextElementSibling.style.display='flex';">
                                            <span class="brand-slide-fb" style="display:none;">@brand.BrandName.Substring(0,Math.Min(3,brand.BrandName.Length))</span>
                                        }
                                        else
                                        {
                                            <span class="brand-slide-fb">@brand.BrandName.Substring(0,Math.Min(3,brand.BrandName.Length))</span>
                                        }
                                    </div>
                                    <span class="brand-slide-name">@brand.BrandName</span>
                                </div>
                            }
                        </div>
                    </div>

                    <button type="submit" id="applyBtn" class="btn btn-danger w-100 rounded-pill fw-bold mt-2">ÁP DỤNG BỘ LỌC</button>
                </div>
            </aside>

            <!-- 2. MAIN CONTENT: PRODUCT GRID -->
            <div class="col-lg-9">
                <!-- Toolbar -->
                <div class="toolbar d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3 bg-white p-3 rounded-4 shadow-sm border">
                    <div class="toolbar-info">
                        @{
                            var fromCount = pagedProducts.TotalCount > 0 ? (pagedProducts.CurrentPage - 1) * pagedProducts.PageSize + 1 : 0;
                            var toCount = Math.Min(pagedProducts.CurrentPage * pagedProducts.PageSize, pagedProducts.TotalCount);
                        }
                        <p class="text-muted mb-0 small fw-500">Hiển thị <strong class="text-dark">@fromCount–@toCount</strong> / <strong class="text-danger">@pagedProducts.TotalCount</strong> sản phẩm</p>
                    </div>

                    <div class="d-flex align-items-center gap-3">
                        <div class="view-toggle d-flex gap-1">
                            <button type="button" class="btn-view @(Context.Request.Cookies["viewType"] != "list" ? "active" : "")" onclick="setView('grid')" title="Lưới">
                                <i class='bx bx-grid-alt'></i>
                            </button>
                            <button type="button" class="btn-view @(Context.Request.Cookies["viewType"] == "list" ? "active" : "")" onclick="setView('list')" title="Danh sách">
                                <i class='bx bx-list-ul'></i>
                            </button>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="text-muted small flex-shrink-0">Sắp xếp:</span>
                            <select class="form-select rounded-pill border-secondary-subtle py-1 shadow-none small" style="min-width: 160px;" id="sortSelect" asp-items="ViewBag.SortList" onchange="toggleFilter('sort', this.value)">
                            </select>
                        </div>
                    </div>
                </div>

                @{
                    string BuildQuery(string key, string? val)
                    {
                        var q = new Dictionary<string, string?> {
                            { "searchTerm", Model.CurrentKeyword },
                            { "categoryId", Model.CurrentCategoryId?.ToString() },
                            { "brandId", Model.CurrentBrandId?.ToString() },

                            { "minPrice", Model.SelectedMinPrice > 0 ? Model.SelectedMinPrice.ToString() : null },
                            { "maxPrice", Model.SelectedMaxPrice < Model.MaxPriceLimit ? Model.SelectedMaxPrice.ToString() : null },
                            { "sort", Model.CurrentSort },
                            { "inStock", Model.IsInStockActive ? "true" : null },
                            { "onSale", Model.IsDiscountActive ? "true" : null }
                        };

                        // Toggle Logic
                        q[key] = (q.ContainsKey(key) && string.Equals(q[key], val, StringComparison.OrdinalIgnoreCase)) ? null : val;

                        var queryParams = q.Where(x => !string.IsNullOrEmpty(x.Value))
                                           .Select(x => $"{x.Key}={Uri.EscapeDataString(x.Value!)}");
                        return "?" + string.Join("&", queryParams);
                    }
                }

                <!-- Quick Filters -->
                <div class="quick-filters d-flex gap-2 mb-4 flex-wrap overflow-auto pb-2 no-scrollbar">

                    <!-- Toggle Mới nhất -->
                    @{ var isNewest = Model.CurrentSort == "newest" || string.IsNullOrEmpty(Model.CurrentSort); }
                    <a href="@BuildQuery("sort", "newest")" class="quick-filter-tag @(isNewest ? "active" : "")">
                        Mới nhất @(isNewest ? Html.Raw("<span class='ms-1'>&times;</span>") : "")
                    </a>

                    <!-- Toggle Đang giảm giá -->
                    <a href="@BuildQuery("onSale", "true")" class="quick-filter-tag @(Model.IsDiscountActive ? "active" : "")">
                        Đang giảm giá @(Model.IsDiscountActive ? Html.Raw("<span class='ms-1'>&times;</span>") : "")
                    </a>

                    <!-- Toggle Còn hàng -->
                    <a href="@BuildQuery("inStock", "true")" class="quick-filter-tag @(Model.IsInStockActive ? "active" : "")">
                        Còn hàng @(Model.IsInStockActive ? Html.Raw("<span class='ms-1'>&times;</span>") : "")
                    </a>

                    <!-- Toggle Giá thấp nhất -->
                    <a href="@BuildQuery("sort", "price_asc")" class="quick-filter-tag @(Model.CurrentSort == "price_asc" ? "active" : "")">
                        Giá thấp nhất @(Model.CurrentSort == "price_asc" ? Html.Raw("<span class='ms-1'>&times;</span>") : "")
                    </a>

                    <!-- Sub Categories as Chips (Toggleable) -->
                </div>

                <!-- Product Grid Wrapper -->
                <div class="position-relative" id="gridWrapper">
                    <div id="loadingOverlay" class="position-absolute top-0 start-0 w-100 h-100 bg-white opacity-75 d-none justify-content-center align-items-start pt-5" style="z-index: 10;">
                        <div class="spinner-border text-danger" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>

                    @if (pagedProducts.Any())
                    {
                        <div id="partialContainer">
                            @await Html.PartialAsync("_ProductGridPartial", pagedProducts)
                        </div>

                        <!-- Pagination -->
                        @if (pagedProducts.TotalPages > 1)
                        {
                            <nav aria-label="Page navigation" class="mt-5">
                                <ul class="pagination justify-content-center">
                                    <li class="page-item @(pagedProducts.HasPrevious ? "" : "disabled")">
                                        <a class="page-link rounded-circle mx-1 border-0 shadow-sm" href="@Url.Action("Index", new { page = pagedProducts.CurrentPage + 1, searchTerm = Model.CurrentKeyword, categoryId = Model.CurrentCategoryId, brandId = Model.CurrentBrandId, sort = Model.CurrentSort, minPrice = Model.SelectedMinPrice, maxPrice = Model.SelectedMaxPrice, inStock = Model.IsInStockActive ? "true" : null, onSale = Model.IsDiscountActive ? "true" : null })"><i class='bx bx-chevron-right'></i></a>
                                    </li>
                                    @for (int i = 1; i <= pagedProducts.TotalPages; i++)
                                    {
                                        <li class="page-item @(i == pagedProducts.CurrentPage ? "active" : "")">
                                            <a class="page-link rounded-circle mx-1 border-0 shadow-sm" href="@Url.Action("Index", new { page = i, searchTerm = Model.CurrentKeyword, categoryId = Model.CurrentCategoryId, brandId = Model.CurrentBrandId, sort = Model.CurrentSort, minPrice = Model.SelectedMinPrice, maxPrice = Model.SelectedMaxPrice, inStock = Model.IsInStockActive ? "true" : null, onSale = Model.IsDiscountActive ? "true" : null })">@i</a>
                                        </li>
                                    }
                                    <li class="page-item @(pagedProducts.HasNext ? "" : "disabled")">
                                        <a class="page-link rounded-circle mx-1 border-0 shadow-sm" href="@Url.Action("Index", new { page = pagedProducts.CurrentPage + 1, searchTerm = Model.CurrentKeyword, categoryId = Model.CurrentCategoryId, brandId = Model.CurrentBrandId, sort = Model.CurrentSort, minPrice = Model.SelectedMinPrice, maxPrice = Model.SelectedMaxPrice, inStock = Model.IsInStockActive ? "true" : null, onSale = Model.IsDiscountActive ? "true" : null })"><i class='bx bx-chevron-right'></i></a>
                                    </li>
                                </ul>
                            </nav>
                        }
                    }
                    else
                    {
                        <!-- EMPTY STATE -->
                        <div class="empty-state text-center py-5 bg-white rounded-4 border">
                            <svg width="120" height="120" viewBox="0 0 24 24" fill="none" stroke="#ddd" stroke-width="1.2" class="mb-3">
                                <circle cx="11" cy="11" r="8"/>
                                <path d="m21 21-4.35-4.35"/>
                                <path d="M8 11h6"/>
                            </svg>
                            <h5 class="fw-bold">Không tìm thấy sản phẩm phù hợp với bộ lọc hiện tại.</h5>
                            <p class="text-muted small mb-4">Vui lòng thử thay đổi bộ lọc hoặc xóa bộ lọc để xem các sản phẩm khác.</p>

                            <a href="/Product" class="btn btn-danger rounded-pill px-5 fw-bold">XÓA BỘ LỌC</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </form>
</main>

<!-- Compare Bar -->
<div class="compare-bar" id="compareBar" style="display:none">
    <div class="container d-flex align-items-center gap-3">
        <span class="fw-bold small text-uppercase d-none d-md-block">So sánh:</span>
        <div class="compare-items d-flex gap-2" id="compareItems"></div>
        <div class="ms-auto d-flex gap-2">
            <button class="btn btn-danger btn-sm rounded-pill px-3 fw-bold" onclick="goCompare()">SO SÁNH NGAY</button>
            <button class="btn btn-outline-secondary btn-sm rounded-pill px-3 fw-bold" onclick="clearCompare()">XÓA HẾT</button>
        </div>
    </div>
</div>

<!-- Quick View Modal -->
<div class="modal fade" id="quickViewModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 overflow-hidden">
            <div class="modal-header border-0 position-absolute end-0 top-0" style="z-index: 1;">
                <button type="button" class="btn-close bg-white rounded-circle shadow-sm" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4" id="quickViewContent">
                <!-- Content via AJAX -->
            </div>
        </div>
    </div>
</div>

<style>
    /* Custom Styles */
    .fw-500 { font-weight: 500; }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .hover-shadow:hover { box-shadow: 0 .5rem 2rem rgba(0,0,0,.08)!important; }
    .transition { transition: all 0.3s ease; }
    .transition-scale { transition: transform 0.5s ease; }
    .product-img-wrapper:hover .transition-scale { transform: scale(1.08); }
    .hover-danger:hover { color: #dc3545!important; }
    .line-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .line-clamp-3 { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }

    /* Price Range Slider */
    .range-slider-wrapper { height: 5px; }
    .range-slider { position: absolute; pointer-events: none; -webkit-appearance: none; appearance: none; height: 5px; width: 100%; background: none; z-index: 2; margin: 0; }
    .range-slider::-webkit-slider-thumb { pointer-events: auto; -webkit-appearance: none; appearance: none; width: 18px; height: 18px; border-radius: 50%; background: #dc3545; cursor: pointer; border: 3px solid #fff; box-shadow: 0 1px 4px rgba(0,0,0,0.2); }
    .range-slider::-moz-range-thumb { pointer-events: auto; width: 18px; height: 18px; border-radius: 50%; background: #dc3545; cursor: pointer; border: 3px solid #fff; }

    /* Quick Filter Tags */
    .quick-filter-tag { padding: 6px 16px; border-radius: 20px; font-size: 12px; font-weight: 500; border: 1px solid #eee; background: white; color: #666; text-decoration: none; transition: all 0.2s; white-space: nowrap; }
    .quick-filter-tag:hover, .quick-filter-tag.active { background: #dc3545; color: white; border-color: #dc3545; }
    .quick-filter-tag.active span { opacity: 0.8; }

    /* View Toggle */
    .btn-view { width: 34px; height: 34px; border: 1px solid #eee; border-radius: 8px; background: white; color: #999; transition: all 0.2s; }
    .btn-view.active { background: #dc3545; color: white; border-color: #dc3545; }

    /* Compare Bar */
    .compare-bar { position: fixed; bottom: 0; left: 0; right: 0; background: white; border-top: 3px solid #dc3545; padding: 15px 0; z-index: 1050; box-shadow: 0 -4px 15px rgba(0,0,0,0.1); }
    .compare-item { display: flex; align-items: center; gap: 8px; padding: 5px 12px; border: 1px solid #eee; border-radius: 30px; font-size: 11px; font-weight: 600; background: #f9f9f9; }
    .btn-remove-compare { border: none; background: none; color: #999; font-size: 16px; line-height: 1; padding: 0 0 2px 0; }
    .btn-remove-compare:hover { color: #dc3545; }

    /* List View Styles */
    .list-view .product-item { width: 100%!important; }
    .list-view .product-card { flex-direction: row!important; height: auto!important; }
    .list-view .product-img-wrapper { width: 220px!important; flex-shrink: 0!important; aspect-ratio: 1/1!important; }
    .list-view .product-info { padding: 20px!important; justify-content: center; }

    /* Brand Slider */
    .brand-slider-track {
        display: flex; gap: 6px;
        overflow-x: auto; scroll-behavior: smooth;
        scroll-snap-type: x mandatory;
        padding-bottom: 4px;
        -ms-overflow-style: none; scrollbar-width: none;
    }
    .brand-slider-track::-webkit-scrollbar { display: none; }
    .brand-slide-item {
        flex: 0 0 56px; width: 56px;
        display: flex; flex-direction: column; align-items: center;
        gap: 4px; padding: 6px 4px;
        border: 1.5px solid #eee; border-radius: 10px;
        cursor: pointer; transition: all 0.15s;
        scroll-snap-align: start; background: #fff;
    }
    .brand-slide-item:hover { border-color: #fca5a5; background: #fff5f5; }
    .brand-slide-item.active { border-color: #dc3545; background: #fff0f0; }
    .brand-slide-logo {
        width: 40px; height: 28px;
        display: flex; align-items: center; justify-content: center;
    }
    .brand-slide-logo img { max-width: 38px; max-height: 26px; object-fit: contain; }
    .brand-slide-logo i { font-size: 17px; color: #aaa; }
    .brand-slide-fb { font-size: 8px; font-weight: 800; color: #666; text-transform: uppercase; letter-spacing: 0.5px; }
    .brand-slide-name { font-size: 8.5px; font-weight: 600; text-align: center; color: #555; line-height: 1.2; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; max-width: 54px; }
    .brand-slide-item.active .brand-slide-name { color: #dc3545; }
    .brand-arr { width: 22px; height: 22px; border: 1px solid #ddd; border-radius: 6px; background: #fff; color: #666; font-size: 14px; line-height: 1; padding: 0; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: all 0.15s; }
    .brand-arr:hover { background: #dc3545; color: #fff; border-color: #dc3545; }

    /* Quick View Hover */
    .product-hover-actions { position: absolute; bottom: -50px; left: 0; right: 0; display: flex; justify-content: center; padding: 10px; background: rgba(0,0,0,0.4); transition: bottom 0.3s ease; }
    .product-card:hover .product-hover-actions { bottom: 0; }
    .btn-quick-view { background: white; border: none; border-radius: 20px; padding: 6px 15px; font-size: 11px; font-weight: bold; color: #333; transition: all 0.2s; }
    .btn-quick-view:hover { background: #dc3545; color: white; }
    .btn-wishlist-abs, .btn-compare-abs { position: absolute; right: 10px; width: 34px; height: 34px; border-radius: 50%; border: none; background: white; color: #999; display: flex; align-items: center; justify-content: center; box-shadow: 0 2px 8px rgba(0,0,0,0.1); transition: all 0.2s; z-index: 2; }
    .btn-wishlist-abs { top: 10px; }
    .btn-compare-abs { top: 50px; }
    .btn-compare-abs:hover { color: #007bff; }
</style>

@section Scripts {
    <script>
        function toggleFilter(key, value) {
            // Helper function for select boxes
            if(key === 'sort') {
                document.getElementById('sortInput').value = value;
            }
            $('#filterForm').submit();
        }

        function selectBrand(id) {
            document.getElementById('brandIdInput').value = id;
            document.getElementById('filterForm').submit();
        }

        function slideBrand(dir) {
            const t = document.getElementById('brandSliderTrack');
            if (t) t.scrollBy({ left: dir * 130, behavior: 'smooth' });
        }

        function setView(type) {
            document.cookie = "viewType=" + type + ";path=/;max-age=" + (30*24*60*60);
            $('#viewTypeInput').val(type);
            location.reload();
        }

        async function quickView(slug) {
            const modal = new bootstrap.Modal(document.getElementById('quickViewModal'));
            modal.show();
            $('#quickViewContent').html('<div class="text-center py-5"><div class="spinner-border text-danger"></div></div>');

            try {
                const res = await fetch(`/Product/QuickView?slug=${slug}`);
                const html = await res.text();
                $('#quickViewContent').html(html);
            } catch (e) {
                $('#quickViewContent').html('<div class="alert alert-danger">Lỗi tải dữ liệu.</div>');
            }
        }

        const minPrice = document.getElementById('minPrice');
        const maxPrice = document.getElementById('maxPrice');
        const minLabel = document.getElementById('minPriceLabel');
        const maxLabel = document.getElementById('maxPriceLabel');

        function updateSlider() {
            if (parseInt(minPrice.value) > parseInt(maxPrice.value)) {
                let temp = minPrice.value;
                minPrice.value = maxPrice.value;
                maxPrice.value = temp;
            }
            minLabel.innerText = parseInt(minPrice.value).toLocaleString('vi-VN') + 'đ';
            maxLabel.innerText = parseInt(maxPrice.value).toLocaleString('vi-VN') + 'đ';
        }

        minPrice.addEventListener('input', updateSlider);
        maxPrice.addEventListener('input', updateSlider);

        // Compare Logic
        let compareList = JSON.parse(localStorage.getItem('compareList') || '[]');
        function addToCompareFromBtn(btn) {
            addToCompare(parseInt(btn.dataset.id), btn.dataset.name, btn.dataset.img, parseFloat(btn.dataset.price));
        }

        function addToCompare(id, name, img, price) {
            if (compareList.length >= 3) {
                alert('Chỉ so sánh tối đa 3 sản phẩm!');
                return;
            }
            if (compareList.find(p => p.id === id)) {
                alert('Sản phẩm đã có trong danh sách!');
                return;
            }
            compareList.push({ id, name, img, price });
            localStorage.setItem('compareList', JSON.stringify(compareList));
            renderCompareBar();
        }

        function removeCompare(id) {
            compareList = compareList.filter(p => p.id !== id);
            localStorage.setItem('compareList', JSON.stringify(compareList));
            renderCompareBar();
        }

        function renderCompareBar() {
            const bar = $('#compareBar');
            const items = $('#compareItems');
            if (compareList.length === 0) {
                bar.hide();
                return;
            }
            bar.show();
            items.html(compareList.map(p => `
                <div class="compare-item">
                    <img src="${p.img}" width="30" height="30" class="rounded-circle object-fit-cover">
                    <span>${p.name.substring(0, 15)}...</span>
                    <button onclick="removeCompare(${p.id})" class="btn-remove-compare">&times;</button>
                </div>
            `).join(''));
        }

        function clearCompare() {
            compareList = [];
            localStorage.setItem('compareList', '[]');
            renderCompareBar();
        }

        function goCompare() {
            const ids = compareList.map(p => p.id).join(',');
            window.location.href = `/Product/Compare?ids=${ids}`;
        }

        $(document).ready(function() {
            renderCompareBar();
            $('.filter-select:not(#sortSelect)').on('change', function () { $('#filterForm').submit(); });
            $('#filterForm').on('submit', function() {
                $('#loadingOverlay').removeClass('d-none').addClass('d-flex');
                $('#applyBtn').prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span> ĐANG LỌC...');
            });
        });
    </script>
}
