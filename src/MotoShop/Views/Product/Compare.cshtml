@model IEnumerable<MotoShop.Business.DTOs.ProductDto>
@{
    ViewData["Title"] = "So sánh sản phẩm";
    var products     = Model.ToList();
    var specNames    = ViewBag.SpecNames    as List<string>                            ?? new List<string>();
    var specsMap     = ViewBag.SpecsMap     as Dictionary<int, Dictionary<string, string>> ?? new Dictionary<int, Dictionary<string, string>>();
    var ratingMap    = ViewBag.RatingMap    as Dictionary<int, double>                 ?? new Dictionary<int, double>();
    var relatedProds = ViewBag.RelatedProducts as List<MotoShop.Business.DTOs.ProductDto> ?? new List<MotoShop.Business.DTOs.ProductDto>();
    var categoryName = ViewBag.CategoryName as string ?? string.Empty;
    int colCount     = products.Count;

    var minPrice  = products.Any() ? products.Min(p => p.MinPrice)  : 0m;
    var maxStock  = products.Any() ? products.Max(p => p.StockCount) : 0;
    var maxRating = ratingMap.Any() ? ratingMap.Values.Max()         : 0.0;
}

@section Styles {
<style>
/* ── Compare page layout ── */
.cmp-page { background: #f8f9fa; min-height: 60vh; }
.cmp-section-title {
    font-size: .72rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: .08em; color: #6b7280;
}

/* ── Table ── */
.compare-table { border-collapse: separate; border-spacing: 0; width: 100%; }
.compare-table th, .compare-table td { border: 1px solid #e5e7eb; }
.compare-table .cmp-label {
    background: #f9fafb; font-weight: 600; font-size: .8rem;
    color: #374151; text-align: left; padding: 12px 16px;
    vertical-align: middle; border-right: 2px solid #d1d5db;
    min-width: 150px; white-space: nowrap;
}
.compare-table .cmp-prod-th {
    background: #fff; padding: 20px 16px 16px;
    vertical-align: top; min-width: 220px;
    position: relative;
}
.compare-table td { padding: 12px 16px; vertical-align: middle; text-align: center; }

/* highlight — best value */
.cmp-best { background: #f0fdf4 !important; }

/* section separator */
.cmp-section-row td { background: #f1f5f9 !important; padding: 8px 16px; text-align: left; }

/* product image in header */
.cmp-prod-img {
    width: 100%; height: 160px; object-fit: contain;
    border-radius: 8px; background: #f8f9fa;
}
.cmp-prod-brand { font-size: .7rem; font-weight: 700; text-transform: uppercase; color: #e53e3e; margin-top: 10px; }
.cmp-prod-name {
    font-size: .85rem; font-weight: 700; color: #111827;
    line-height: 1.4; margin: 6px 0 0; display: -webkit-box;
    -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
}
.cmp-prod-remove {
    display: inline-flex; align-items: center; gap: 4px;
    font-size: .72rem; color: #9ca3af; text-decoration: none;
    border: 1px solid #e5e7eb; border-radius: 20px;
    padding: 3px 10px; margin-top: 10px;
    transition: all .2s;
}
.cmp-prod-remove:hover { color: #e53e3e; border-color: #e53e3e; }

/* price row */
.cmp-price-main { font-size: 1.25rem; font-weight: 900; color: #e53e3e; }
.cmp-price-old  { font-size: .8rem;  color: #9ca3af; text-decoration: line-through; }

/* stars */
.cmp-stars { color: #f59e0b; font-size: .95rem; letter-spacing: 1px; }
.cmp-stars-empty { color: #d1d5db; }
.cmp-rating-val { font-size: .78rem; color: #6b7280; margin-left: 4px; }

/* stock badge */
.badge-stock    { background: #dcfce7; color: #16a34a; border: 1px solid #bbf7d0; padding: 4px 10px; border-radius: 20px; font-size: .75rem; font-weight: 600; }
.badge-nostock  { background: #fee2e2; color: #dc2626; border: 1px solid #fecaca; padding: 4px 10px; border-radius: 20px; font-size: .75rem; font-weight: 600; }

/* action button */
.cmp-btn-buy {
    display: inline-flex; align-items: center; gap: 6px;
    background: #e53e3e; color: #fff; border: none;
    padding: 9px 22px; border-radius: 25px;
    font-weight: 700; font-size: .82rem; cursor: pointer;
    text-decoration: none; transition: background .2s;
}
.cmp-btn-buy:hover { background: #c53030; color: #fff; }

/* ── Related products ── */
.cmp-related-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
}
@@media (max-width: 992px)  { .cmp-related-grid { grid-template-columns: repeat(2, 1fr); } }
@@media (max-width: 575px)  { .cmp-related-grid { grid-template-columns: repeat(2, 1fr); } }

.cmp-rel-card {
    background: #fff; border: 1px solid #e5e7eb; border-radius: 12px;
    overflow: hidden; text-decoration: none; color: inherit;
    transition: box-shadow .2s, transform .2s;
    display: block;
}
.cmp-rel-card:hover { box-shadow: 0 4px 20px rgba(0,0,0,.1); transform: translateY(-2px); }
.cmp-rel-card img { width: 100%; height: 140px; object-fit: contain; background: #f8f9fa; }
.cmp-rel-body { padding: 10px 12px; }
.cmp-rel-name { font-size: .8rem; font-weight: 600; color: #111827; line-height: 1.4;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.cmp-rel-price { font-size: .9rem; font-weight: 800; color: #e53e3e; margin-top: 4px; }

/* breadcrumb */
.breadcrumb-wrapper { background: #f8f9fa; border-bottom: 1px solid #eee; }
</style>
}

<div class="breadcrumb-wrapper">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb py-3 mb-0">
                <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted">Trang chủ</a></li>
                <li class="breadcrumb-item"><a href="/Product" class="text-decoration-none text-muted">Sản phẩm</a></li>
                <li class="breadcrumb-item active text-dark fw-bold">So sánh sản phẩm</li>
            </ol>
        </nav>
    </div>
</div>

<div class="cmp-page py-5">
    <div class="container">

        <div class="d-flex align-items-center gap-3 mb-4">
            <div>
                <h3 class="fw-bold mb-0"><i class='bx bx-transfer me-2 text-danger'></i>So sánh sản phẩm</h3>
                @if (!string.IsNullOrEmpty(categoryName))
                {
                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 mt-1">
                        <i class='bx bx-category-alt me-1'></i>@categoryName
                    </span>
                }
            </div>
            <a href="/Product" class="btn btn-outline-secondary btn-sm rounded-pill ms-auto">
                <i class='bx bx-arrow-back me-1'></i> Quay lại
            </a>
        </div>

        @if (!products.Any())
        {
            <div class="text-center py-5 bg-white rounded-4 shadow-sm">
                <i class='bx bx-transfer display-3 text-muted d-block mb-3'></i>
                <h5 class="text-muted">Không có sản phẩm nào để so sánh.</h5>
                <p class="text-muted small">Chọn ít nhất 2 sản phẩm cùng danh mục để so sánh.</p>
                <a href="/Product" class="btn btn-danger rounded-pill px-4 mt-2">Chọn sản phẩm</a>
            </div>
        }
        else
        {
            <!-- ═══ COMPARISON TABLE ═══ -->
            <div class="table-responsive shadow-sm rounded-4 border bg-white mb-5">
                <table class="compare-table">

                    <!-- ── HEADER: product images + names ── -->
                    <thead>
                        <tr>
                            <th class="cmp-label border-end" style="min-width:150px;vertical-align:middle">
                                <span class="cmp-section-title">Sản phẩm</span>
                            </th>
                            @foreach (var p in products)
                            {
                                var otherIds = products.Where(x => x.ProductId != p.ProductId)
                                                      .Select(x => x.ProductId.ToString());
                                var removeUrl = "/Product/Compare?ids=" + string.Join(",", otherIds);
                                <th class="cmp-prod-th" style="min-width:220px">
                                    <a href="/Product/Details/@p.Slug" class="d-block">
                                        <img class="cmp-prod-img"
                                             src="@(string.IsNullOrEmpty(p.PrimaryImageUrl) ? "/assets/img/elements/18.jpg" : p.PrimaryImageUrl)"
                                             onerror="this.src='/assets/img/elements/18.jpg'"
                                             alt="@p.ProductName">
                                    </a>
                                    <div class="cmp-prod-brand">@p.BrandName</div>
                                    <a href="/Product/Details/@p.Slug" class="cmp-prod-name d-block text-decoration-none">@p.ProductName</a>
                                    <a href="@removeUrl" class="cmp-prod-remove">
                                        <i class='bx bx-x'></i> Bỏ so sánh
                                    </a>
                                </th>
                            }
                        </tr>
                    </thead>

                    <tbody>

                        <!-- ── SECTION: Giá ── -->
                        <tr class="cmp-section-row">
                            <td colspan="@(colCount + 1)">
                                <span class="cmp-section-title"><i class='bx bx-purchase-tag me-1'></i>Giá bán</span>
                            </td>
                        </tr>

                        <!-- Giá bán -->
                        <tr>
                            <td class="cmp-label">Giá bán</td>
                            @foreach (var p in products)
                            {
                                <td class="@(p.MinPrice == minPrice && products.Count > 1 ? "cmp-best" : "")">
                                    <div class="cmp-price-main">@p.MinPrice.ToString("N0")₫</div>
                                    @if (p.MinOriginalPrice.HasValue && p.MinOriginalPrice > p.MinPrice)
                                    {
                                        <div class="cmp-price-old">@p.MinOriginalPrice.Value.ToString("N0")₫</div>
                                    }
                                    @if (p.CalculatedDiscountPercent > 0)
                                    {
                                        <span class="badge bg-danger rounded-pill mt-1">-@p.CalculatedDiscountPercent%</span>
                                    }
                                    @if (p.MinPrice == minPrice && products.Count > 1)
                                    {
                                        <div class="mt-1"><span class="badge bg-success rounded-pill" style="font-size:.65rem">Giá tốt nhất</span></div>
                                    }
                                </td>
                            }
                        </tr>

                        <!-- Thương hiệu -->
                        <tr>
                            <td class="cmp-label">Thương hiệu</td>
                            @foreach (var p in products)
                            {
                                <td>
                                    @if (!string.IsNullOrEmpty(p.BrandLogoUrl))
                                    {
                                        <img src="@p.BrandLogoUrl" alt="@p.BrandName" style="height:22px;object-fit:contain;vertical-align:middle">
                                        <span class="ms-1 fw-600 small">@p.BrandName</span>
                                    }
                                    else
                                    {
                                        <span class="fw-600">@p.BrandName</span>
                                    }
                                </td>
                            }
                        </tr>

                        <!-- ── SECTION: Thông số kỹ thuật ── -->
                        @if (specNames.Any())
                        {
                            <tr class="cmp-section-row">
                                <td colspan="@(colCount + 1)">
                                    <span class="cmp-section-title"><i class='bx bx-list-ul me-1'></i>Thông số kỹ thuật</span>
                                </td>
                            </tr>
                            @foreach (var specName in specNames)
                            {
                                var vals = products.Select(p =>
                                    specsMap.ContainsKey(p.ProductId) && specsMap[p.ProductId].ContainsKey(specName)
                                        ? specsMap[p.ProductId][specName]
                                        : "—").ToList();
                                <tr>
                                    <td class="cmp-label">@specName</td>
                                    @for (int i = 0; i < products.Count; i++)
                                    {
                                        <td class="@(vals[i] == "—" ? "text-muted" : "")">@vals[i]</td>
                                    }
                                </tr>
                            }
                        }

                        <!-- ── SECTION: Đánh giá & Tình trạng ── -->
                        <tr class="cmp-section-row">
                            <td colspan="@(colCount + 1)">
                                <span class="cmp-section-title"><i class='bx bx-bar-chart-alt-2 me-1'></i>Thống kê & Đánh giá</span>
                            </td>
                        </tr>

                        <!-- Đánh giá -->
                        <tr>
                            <td class="cmp-label">Đánh giá</td>
                            @foreach (var p in products)
                            {
                                var rating = ratingMap.ContainsKey(p.ProductId) ? ratingMap[p.ProductId] : 0.0;
                                var isBestRating = rating > 0 && rating == maxRating && products.Count > 1;
                                <td class="@(isBestRating ? "cmp-best" : "")">
                                    @if (rating > 0)
                                    {
                                        var full  = (int)Math.Floor(rating);
                                        var half  = (rating - full) >= 0.5;
                                        var empty = 5 - full - (half ? 1 : 0);
                                        <span class="cmp-stars">
                                            @for (int s = 0; s < full;  s++) { <text>★</text> }
                                            @if (half) { <text>½</text> }
                                            @for (int s = 0; s < empty; s++) { <span class="cmp-stars-empty">★</span> }
                                        </span>
                                        <span class="cmp-rating-val">(@rating.ToString("0.0"))</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Chưa có đánh giá</span>
                                    }
                                </td>
                            }
                        </tr>

                        <!-- Đã bán -->
                        <tr>
                            <td class="cmp-label">Đã bán</td>
                            @foreach (var p in products)
                            {
                                <td>
                                    @if (p.SoldCount > 0)
                                    {
                                        <span class="fw-600">@p.SoldCount.ToString("N0")</span>
                                        <span class="text-muted small"> lượt</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>
                            }
                        </tr>

                        <!-- Tồn kho -->
                        <tr>
                            <td class="cmp-label">Tồn kho</td>
                            @foreach (var p in products)
                            {
                                var isBestStock = p.StockCount == maxStock && maxStock > 0 && products.Count > 1;
                                <td class="@(isBestStock ? "cmp-best" : "")">
                                    @if (p.IsInStock)
                                    {
                                        <span class="badge-stock"><i class='bx bxs-check-circle me-1'></i>Còn @p.StockCount</span>
                                    }
                                    else
                                    {
                                        <span class="badge-nostock"><i class='bx bxs-x-circle me-1'></i>Hết hàng</span>
                                    }
                                </td>
                            }
                        </tr>

                        <!-- ── ACTION ROW ── -->
                        <tr style="background:#f9fafb">
                            <td class="cmp-label"></td>
                            @foreach (var p in products)
                            {
                                <td class="py-4">
                                    <a href="/Product/Details/@p.Slug" class="cmp-btn-buy">
                                        <i class='bx bx-cart-add'></i> Xem & Mua
                                    </a>
                                </td>
                            }
                        </tr>

                    </tbody>
                </table>
            </div>

            <!-- ═══ RELATED PRODUCTS ═══ -->
            @if (relatedProds.Any())
            {
                <div class="mt-2 mb-4">
                    <h5 class="fw-bold mb-1">
                        <i class='bx bx-collection me-2 text-danger'></i>Sản phẩm khác cùng danh mục
                    </h5>
                    <p class="text-muted small mb-3">Các sản phẩm phổ biến trong danh mục <strong>@categoryName</strong></p>
                    <div class="cmp-related-grid">
                        @foreach (var rp in relatedProds)
                        {
                            <a href="/Product/Details/@rp.Slug" class="cmp-rel-card">
                                <img src="@(string.IsNullOrEmpty(rp.PrimaryImageUrl) ? "/assets/img/elements/18.jpg" : rp.PrimaryImageUrl)"
                                     onerror="this.src='/assets/img/elements/18.jpg'"
                                     alt="@rp.ProductName">
                                <div class="cmp-rel-body">
                                    <div class="cmp-rel-name">@rp.ProductName</div>
                                    <div class="cmp-rel-price">@rp.MinPrice.ToString("N0")₫</div>
                                    @if (rp.SoldCount > 0)
                                    {
                                        <div class="text-muted" style="font-size:.72rem;margin-top:3px">Đã bán @rp.SoldCount</div>
                                    }
                                </div>
                            </a>
                        }
                    </div>
                </div>
            }
        }
    </div>
</div>
