@model MotoShop.Business.DTOs.ProductDto
@using System.Linq
@{
    ViewData["Title"] = Model.ProductName;
    var primaryImg = Model.Images?.FirstOrDefault(i => i.IsPrimary)?.ImageUrl ?? Model.PrimaryImageUrl ?? "/assets/img/elements/18.jpg";
    var defaultVariant = ViewBag.DefaultVariant as MotoShop.Business.DTOs.ProductVariantDto;
    var attributeGroups = ViewBag.AttributeGroups as Dictionary<string, List<string>>;
    var relatedProducts = ViewBag.RelatedProducts as IEnumerable<MotoShop.Business.DTOs.ProductDto>;
    var vouchers = ViewBag.Vouchers as IEnumerable<MotoShop.Business.DTOs.CouponDto>;
}

@Html.AntiForgeryToken()

<div class="breadcrumb-wrapper">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
                <li class="breadcrumb-item"><a href="/Product/Category/@Model.CategoryId">@Model.CategoryName</a></li>
                <li class="breadcrumb-item active">@Model.ProductName</li>
            </ol>
        </nav>
    </div>
</div>

<main class="container mb-5">
    <div class="row g-4 g-lg-5">
        <!-- 1. LEFT: GALLERY -->
        <div class="col-md-6">
            <div class="product-gallery sticky-top" style="top: 100px;">
                <div class="main-img-container border rounded-4 overflow-hidden mb-3 bg-white">
                    <img id="mainImg" src="@primaryImg" class="img-fluid w-100" alt="@Model.ProductName" onerror="this.src='/assets/img/elements/18.jpg'">
                </div>
                <div class="thumb-list d-flex gap-2 overflow-auto scroll-hide pb-2">
                    @if (Model.Images != null && Model.Images.Any())
                    {
                        foreach (var img in Model.Images.OrderByDescending(i => i.IsPrimary))
                        {
                            <div class="thumb-item border rounded-3" style="min-width: 80px; width: 80px; height: 80px;" onclick="changeMainImg('@img.ImageUrl', this)">
                                <img src="@img.ImageUrl" class="w-100 h-100 object-fit-cover rounded-2 cursor-pointer" alt="Thumbnail" onerror="this.src='/assets/img/elements/18.jpg'">
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <!-- 2. RIGHT: PRODUCT INFO -->
        <div class="col-md-6">
            <div class="product-info-content">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div>
                        <span class="text-danger fw-bold text-uppercase small">@Model.BrandName</span>
                        <h1 class="product-title mt-1">@Model.ProductName</h1>
                    </div>
                    <button id="wishBtn" onclick="toggleWishlist(@Model.ProductId)" class="wish-btn @(ViewBag.IsWishlisted ? "active" : "")">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
                    </button>
                </div>

                <div class="d-flex align-items-center gap-3 mb-3 small">
                    <div class="text-warning">
                        @for (int i = 1; i <= 5; i++) { <i class="bi bi-star-fill"></i> }
                        <span class="text-muted ms-1">(4.5)</span>
                    </div>
                    <span class="text-muted">|</span>
                    <span class="text-muted">Mã SKU: <span id="displaySku" class="fw-bold text-dark">@defaultVariant?.SKU</span></span>
                </div>

                <div class="price-box mb-3">
                    <div class="d-flex align-items-baseline gap-2">
                        <span id="displayPrice" class="text-danger display-6 fw-bold">@defaultVariant?.Price.ToString("N0")₫</span>
                        @if (defaultVariant?.OriginalPrice > defaultVariant?.Price)
                        {
                            <del id="displayOldPrice" class="text-muted h5">@defaultVariant.OriginalPrice.Value.ToString("N0")₫</del>
                        }
                    </div>
                </div>

                <!-- FIX 7: VOUCHERS -->
                @if (vouchers != null && vouchers.Any())
                {
                    <div class="voucher-section">
                        <div class="voucher-title mb-2">
                            <i class='bx bxs-coupon'></i> Mã giảm giá áp dụng
                        </div>
                        @foreach (var v in vouchers)
                        {
                            <div class="voucher-item">
                                <div class="voucher-info">
                                    <span class="voucher-name">Giảm @(v.DiscountType == "Percentage" ? v.DiscountValue + "%" : v.DiscountValue.ToString("N0") + "₫")</span>
                                    <span class="voucher-desc">Đơn tối thiểu @v.MinOrderValue?.ToString("N0")₫</span>
                                </div>
                                <button class="btn btn-sm btn-outline-danger rounded-pill px-3" onclick="copyVoucher('@v.Code')">Lưu</button>
                            </div>
                        }
                    </div>
                }

                <!-- FIX 1: VARIANTS -->
                <div class="variant-selection mt-4">
                    @if (attributeGroups != null)
                    {
                        foreach (var group in attributeGroups)
                        {
                            <div class="attr-group mb-3">
                                <label class="small fw-bold text-uppercase mb-2 d-block">CHỌN @group.Key:</label>
                                <div class="d-flex flex-wrap gap-2" data-attr-name="@group.Key">
                                    @foreach (var val in group.Value)
                                    {
                                        <button type="button" class="attr-btn" onclick="selectAttr('@group.Key', '@val', this)">@val</button>
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>

                <!-- FIX 2: QUANTITY & BUY BUTTONS -->
                <div class="action-section mt-4 pt-4 border-top">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="qty-wrapper">
                            <button type="button" class="qty-minus" onclick="changeQty(-1)">−</button>
                            <input type="number" id="qty" value="1" min="1" data-max="@ViewBag.MaxStock" readonly>
                            <button type="button" class="qty-plus" onclick="changeQty(1)">+</button>
                        </div>
                        <div id="stockStatus">
                            @if (defaultVariant?.StockQuantity > 0)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-2">Còn hàng</span>
                            }
                            else
                            {
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-2">Hết hàng</span>
                            }
                        </div>
                    </div>

                    <div class="row g-2">
                        <div class="col-6">
                            <button onclick="addToCart()" class="btn btn-outline-danger w-100 py-3 rounded-pill fw-bold">THÊM GIỎ HÀNG</button>
                        </div>
                        <div class="col-6">
                            <button onclick="buyNow()" class="btn btn-danger w-100 py-3 rounded-pill fw-bold">MUA NGAY</button>
                        </div>
                    </div>
                </div>

                <!-- FIX 8.3: SHARE -->
                <div class="share-box mt-4 small">
                    <span class="text-muted me-3">Chia sẻ:</span>
                    <div class="d-inline-flex gap-2">
                        <a href="#" class="share-icon fb"><i class='bx bxl-facebook'></i> Facebook</a>
                        <a href="#" class="share-icon zalo">Zalo</a>
                        <button onclick="copyUrl()" class="share-icon link"><i class='bx bx-link'></i> Copy link</button>
                    </div>
                </div>

                <div class="trust-features mt-5 row g-3 text-center border-top pt-4">
                    <div class="col-4">
                        <i class='bx bx-refresh text-danger fs-3'></i>
                        <p class="x-small mt-1 mb-0">7 ngày đổi trả</p>
                    </div>
                    <div class="col-4 border-start border-end">
                        <i class='bx bx-shield-check text-danger fs-3'></i>
                        <p class="x-small mt-1 mb-0">100% Chính hãng</p>
                    </div>
                    <div class="col-4">
                        <i class='bx bx-headphone text-danger fs-3'></i>
                        <p class="x-small mt-1 mb-0">Hỗ trợ 24/7</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- TABS SECTION -->
    <div class="mt-5 pt-5">
        <ul class="nav nav-tabs product-tabs border-bottom-0 gap-4" id="pTabs">
            <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tabDesc">Mô tả sản phẩm</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabSpec">Thông số kỹ thuật</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabReview">Đánh giá khách hàng</button></li>
        </ul>
        <div class="tab-content border rounded-4 p-4 bg-white shadow-sm mt-n1">
            <div class="tab-pane fade show active" id="tabDesc">
                <div class="rich-content">@Html.Raw(Model.Description)</div>
            </div>
            
            <!-- FIX 4: SPECIFICATIONS -->
            <div class="tab-pane fade" id="tabSpec">
                <div class="row justify-content-center">
                    <div class="col-lg-8">
                        <table class="spec-table">
                            <tbody>
                                <tr><td>Thương hiệu</td><td>@Model.BrandName</td></tr>
                                <tr><td>Danh mục</td><td>@Model.CategoryName</td></tr>
                                <tr id="specRows">
                                    @foreach (var attr in defaultVariant?.VariantAttributeValues ?? new List<MotoShop.Business.DTOs.VariantAttributeDto>())
                                    {
                                        <tr><td>@attr.AttributeName</td><td>@attr.Value</td></tr>
                                    }
                                </tr>
                                <tr><td>Mã SKU</td><td id="specSku">@defaultVariant?.SKU</td></tr>
                                <tr><td>Tình trạng</td><td id="specStock">@(defaultVariant?.StockQuantity > 0 ? "Còn hàng" : "Hết hàng")</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- FIX 5: REVIEWS -->
            <div class="tab-pane fade" id="tabReview">
                <div class="row g-5">
                    <div class="col-lg-5">
                        <div class="rating-overview text-center p-4 bg-light rounded-4">
                            @{
                                var reviewAvg = Model.Reviews.Any() ? Math.Round(Model.Reviews.Average(r => r.Rating), 1) : 0;
                                var reviewCount = Model.Reviews.Count();
                            }
                            <div class="display-3 fw-bold text-danger">@reviewAvg</div>
                            <div class="text-warning h4">
                                @for (int i = 1; i <= 5; i++) { <i class="bi bi-star@(i <= reviewAvg ? "-fill" : (i - 0.5 <= reviewAvg ? "-half" : ""))"></i> }
                            </div>
                            <p class="text-muted">(@reviewCount đánh giá)</p>
                            
                            <div class="mt-4 rating-bars">
                                @for (int i = 5; i >= 1; i--)
                                {
                                    var count = Model.Reviews.Count(r => r.Rating == i);
                                    var percent = reviewCount > 0 ? (count * 100 / reviewCount) : 0;
                                    <div class="d-flex align-items-center gap-2 mb-2">
                                        <span class="small fw-bold" style="width: 20px;">@i★</span>
                                        <div class="progress flex-grow-1" style="height: 8px;">
                                            <div class="progress-bar bg-warning" style="width: @percent%"></div>
                                        </div>
                                        <span class="small text-muted" style="width: 40px;">@count</span>
                                    </div>
                                }
                            </div>
                        </div>

                        @if (ViewBag.IsLoggedIn == true)
                        {
                            @if (ViewBag.CanReview == true && ViewBag.HasReviewed == false)
                            {
                                <div class="review-form-box mt-4 p-4 border rounded-4">
                                    <h6 class="fw-bold mb-3">GỬI ĐÁNH GIÁ CỦA BẠN</h6>
                                    <form id="revForm">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="productId" value="@Model.ProductId">
                                        <div class="star-rating mb-3 h3 text-warning">
                                            <i class='bx bx-star cursor-pointer' data-val="1"></i>
                                            <i class='bx bx-star cursor-pointer' data-val="2"></i>
                                            <i class='bx bx-star cursor-pointer' data-val="3"></i>
                                            <i class='bx bx-star cursor-pointer' data-val="4"></i>
                                            <i class='bx bx-star cursor-pointer' data-val="5"></i>
                                            <input type="hidden" name="rating" id="inpRating" value="5">
                                        </div>
                                        <textarea name="comment" class="form-control rounded-3 mb-3" rows="3" placeholder="Chia sẻ cảm nhận về sản phẩm..." required minlength="10"></textarea>
                                        <button type="submit" class="btn btn-danger w-100 rounded-pill fw-bold">GỬI ĐÁNH GIÁ</button>
                                    </form>
                                </div>
                            }
                            else if (ViewBag.HasReviewed == true)
                            {
                                <div class="alert alert-success rounded-4 mt-4 small"><i class='bx bx-check-circle me-1'></i> Bạn đã đánh giá sản phẩm này. Cảm ơn bạn!</div>
                            }
                            else
                            {
                                <div class="alert alert-light border rounded-4 mt-4 small text-muted"><i class='bx bx-info-circle me-1'></i> Chỉ khách hàng đã mua mới được đánh giá.</div>
                            }
                        }
                        else
                        {
                            <div class="mt-4 p-4 border border-dashed rounded-4 text-center">
                                <p class="small text-muted mb-3">Vui lòng đăng nhập để đánh giá</p>
                                <a href="/Account/Login?returnUrl=@Context.Request.Path" class="btn btn-outline-danger btn-sm rounded-pill px-4">Đăng nhập</a>
                            </div>
                        }
                    </div>

                    <div class="col-lg-7">
                        <div id="revList">
                            @foreach (var r in Model.Reviews.OrderByDescending(x => x.CreatedDate).Take(5))
                            {
                                <div class="review-item mb-4 pb-4 border-bottom">
                                    <div class="d-flex align-items-center gap-3 mb-2">
                                        <div class="rev-avatar">@r.CustomerName[0]</div>
                                        <div>
                                            <div class="fw-bold small">@r.CustomerName</div>
                                            <div class="text-warning x-small">
                                                @for (int i = 1; i <= 5; i++) { <i class="bi bi-star@(i <= r.Rating ? "-fill" : "")"></i> }
                                                <span class="text-muted ms-2">@r.CreatedDate.ToString("dd/MM/yyyy")</span>
                                            </div>
                                        </div>
                                    </div>
                                    <p class="text-secondary small mb-0">@r.Comment</p>
                                </div>
                            }
                        </div>
                        @if (reviewCount > 5)
                        {
                            <button class="btn btn-link text-danger w-100 text-decoration-none fw-bold" onclick="loadMoreReviews()">Xem thêm đánh giá <i class='bx bx-chevron-down'></i></button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- FIX 6: RELATED PRODUCTS -->
    <div class="mt-5 pt-5 border-top">
        <h4 class="fw-bold mb-4 text-uppercase">Sản phẩm liên quan</h4>
        <div class="related-grid">
            @if (relatedProducts != null)
            {
                foreach (var p in relatedProducts)
                {
                    <div class="product-card border rounded-4 bg-white transition-all hover-shadow">
                        <div class="position-relative overflow-hidden rounded-t-4 aspect-square">
                            <a href="/Product/Details?slug=@p.Slug">
                                <img src="@(string.IsNullOrEmpty(p.PrimaryImageUrl) ? "/assets/img/elements/18.jpg" : p.PrimaryImageUrl)" class="w-100 h-100 object-fit-cover" alt="@p.ProductName">
                            </a>
                        </div>
                        <div class="p-3">
                            <h6 class="product-name small fw-bold mb-2 text-truncate-2">@p.ProductName</h6>
                            <div class="text-danger fw-bold">@p.MinPrice.ToString("N0")₫</div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</main>

@section Scripts {
    <script src="~/js/cart-handler.js"></script>
    <script>
        const variants = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Variants.Select(v => new {
            v.ProductVariantId, v.Price, v.OriginalPrice, v.SKU, v.StockQuantity, v.ImageUrl,
            Attributes = v.VariantAttributeValues.Select(av => new { Name = av.AttributeName, Value = av.Value }).ToList()
        }).ToList()));

        let selected = {};
        let currentVar = null;

        function changeMainImg(url, el) {
            document.getElementById('mainImg').src = url;
            document.querySelectorAll('.thumb-item').forEach(i => i.classList.remove('active'));
            el.classList.add('active');
        }

        function selectAttr(name, val, el) {
            el.closest('[data-attr-name]').querySelectorAll('.attr-btn').forEach(b => b.classList.remove('active'));
            el.classList.add('active');
            selected[name] = val;
            checkVariants();
        }

        function checkVariants() {
            // Disable/Enable buttons based on stock
            const attrGroups = document.querySelectorAll('[data-attr-name]');
            attrGroups.forEach(group => {
                const name = group.dataset.attrName;
                group.querySelectorAll('.attr-btn').forEach(btn => {
                    const val = btn.innerText;
                    const testSelected = { ...selected, [name]: val };
                    const hasStock = variants.some(v => 
                        Object.entries(testSelected).every(([k, v]) => v.Attributes?.some(a => a.Name === k && a.Value === v))
                        && v.StockQuantity > 0
                    );
                    //btn.disabled = !hasStock; // Tùy chọn: Disable thay vì mờ
                    btn.classList.toggle('out-of-stock', !hasStock);
                });
            });

            // Update info if fully selected
            const matched = variants.find(v => v.Attributes.every(a => selected[a.Name] === a.Value));
            if (matched) {
                currentVar = matched;
                document.getElementById('displayPrice').innerText = matched.Price.toLocaleString('vi-VN') + '₫';
                if(matched.OriginalPrice > matched.Price) {
                    let old = document.getElementById('displayOldPrice');
                    if(!old) {
                        document.querySelector('.price-box .d-flex').insertAdjacentHTML('beforeend', `<del id="displayOldPrice" class="text-muted h5"></del>`);
                        old = document.getElementById('displayOldPrice');
                    }
                    old.innerText = matched.OriginalPrice.toLocaleString('vi-VN') + '₫';
                } else {
                    document.getElementById('displayOldPrice')?.remove();
                }
                document.getElementById('displaySku').innerText = matched.SKU;
                document.getElementById('specSku').innerText = matched.SKU;
                document.getElementById('specStock').innerText = matched.StockQuantity > 0 ? 'Còn hàng' : 'Hết hàng';
                document.getElementById('qty').dataset.max = matched.StockQuantity;
                
                const status = document.getElementById('stockStatus');
                status.innerHTML = matched.StockQuantity > 0 
                    ? `<span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-2">Còn hàng</span>`
                    : `<span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-2">Hết hàng</span>`;

                if(matched.ImageUrl) document.getElementById('mainImg').src = matched.ImageUrl;

                // Update spec table rows
                let specHtml = matched.Attributes.map(a => `<tr><td>${a.Name}</td><td>${a.Value}</td></tr>`).join('');
                document.getElementById('specRows').innerHTML = specHtml;
            }
        }

        function changeQty(delta) {
            const inp = document.getElementById('qty');
            const max = parseInt(inp.dataset.max) || 99;
            let val = parseInt(inp.value) + delta;
            inp.value = Math.max(1, Math.min(val, max));
        }

        async function toggleWishlist(pid) {
            const btn = document.getElementById('wishBtn');
            try {
                const res = await fetch('/Account/ToggleWishlist', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': document.querySelector('[name=__RequestVerificationToken]').value },
                    body: JSON.stringify({ productId: pid })
                });
                const data = await res.json();
                if(data.success) {
                    btn.classList.toggle('active', data.added);
                    showToast(data.added ? 'Đã thêm vào yêu thích' : 'Đã xóa khỏi yêu thích');
                } else if(data.redirectUrl) {
                    location.href = data.redirectUrl;
                }
            } catch(e) {}
        }

        function copyUrl() {
            navigator.clipboard.writeText(window.location.href);
            showToast('Đã copy liên kết!');
        }

        function copyVoucher(code) {
            navigator.clipboard.writeText(code);
            showToast('Đã copy mã: ' + code);
        }

        function showToast(msg) {
            Swal.fire({ toast: true, position: 'top-end', showConfirmButton: false, timer: 2000, title: msg, icon: 'success' });
        }

        function addToCart() {
            if(!currentVar) return Swal.fire('Thông báo', 'Vui lòng chọn đầy đủ thuộc tính', 'info');
            handleAddToCart(currentVar.ProductVariantId, parseInt(document.getElementById('qty').value));
        }

        function buyNow() {
            if(!currentVar) return Swal.fire('Thông báo', 'Vui lòng chọn đầy đủ thuộc tính', 'info');
            handleBuyNow(currentVar.ProductVariantId, parseInt(document.getElementById('qty').value));
        }

        // Star rating
        document.querySelectorAll('.star-rating i').forEach(s => {
            s.onclick = function() {
                const val = this.dataset.val;
                document.getElementById('inpRating').value = val;
                document.querySelectorAll('.star-rating i').forEach(x => {
                    x.classList.toggle('bxs-star', x.dataset.val <= val);
                    x.classList.toggle('bx-star', x.dataset.val > val);
                });
            }
        });

        // Review form
        const revForm = document.getElementById('revForm');
        if(revForm) {
            revForm.onsubmit = async (e) => {
                e.preventDefault();
                const res = await fetch('/Review/SubmitReview', { method: 'POST', body: new FormData(revForm) });
                const data = await res.json();
                if(data.success) {
                    Swal.fire('Thành công', 'Đánh giá của bạn đã được gửi và đang chờ duyệt.', 'success').then(() => location.reload());
                } else {
                    Swal.fire('Lỗi', data.message, 'error');
                }
            }
        }

        // Default selection
        document.addEventListener('DOMContentLoaded', () => {
            const groups = document.querySelectorAll('[data-attr-name]');
            if(groups.length > 0) {
                groups.forEach(g => {
                    const firstBtn = g.querySelector('.attr-btn:not(.out-of-stock)') || g.querySelector('.attr-btn');
                    if(firstBtn) firstBtn.click();
                });
            } else {
                currentVar = variants[0];
            }
        });
    </script>

    <style>
        .product-title { text-transform: none; font-size: 24px; font-weight: 700; color: #111; line-height: 1.3; }
        .wish-btn { width: 44px; height: 44px; border-radius: 50%; border: 1px solid #eee; background: #fff; display: flex; align-items: center; justify-content: center; transition: all 0.2s; color: #666; }
        .wish-btn:hover { border-color: #E24B4A; color: #E24B4A; }
        .wish-btn.active { background: #fff9f9; border-color: #E24B4A; color: #E24B4A; }
        .wish-btn.active svg { fill: #E24B4A; }
        
        .voucher-section { border: 1px dashed #E24B4A; border-radius: 12px; padding: 16px; margin: 20px 0; background: #fff9f9; }
        .voucher-title { font-weight: 700; font-size: 14px; color: #E24B4A; text-transform: uppercase; }
        .voucher-item { display: flex; justify-content: space-between; align-items: center; padding: 10px 0; border-bottom: 1px solid #f5e0e0; }
        .voucher-item:last-child { border-bottom: none; }
        .voucher-name { display: block; font-weight: 700; font-size: 14px; color: #111; }
