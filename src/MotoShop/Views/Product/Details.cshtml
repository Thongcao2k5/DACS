@model MotoShop.Business.DTOs.ProductDto
@{
    ViewData["Title"] = Model.ProductName;
    var primaryImg = Model.Images?.FirstOrDefault(i => i.IsPrimary)?.ImageUrl ?? Model.PrimaryImageUrl ?? "/assets/img/elements/18.jpg";
}

<div class="breadcrumb-wrapper">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
                <li class="breadcrumb-item"><a href="/Product">Sản phẩm</a></li>
                <li class="breadcrumb-item active">@Model.ProductName</li>
            </ol>
        </nav>
    </div>
</div>

<div class="container mb-5">
    <div class="row g-4 g-lg-5">
        <!-- LEFT: IMAGES -->
        <div class="col-md-6">
            <div class="product-gallery sticky-top" style="top: 100px;">
                <div class="main-img-container border rounded-4 overflow-hidden mb-3 bg-white">
                    <img id="main-product-image" src="@primaryImg" class="img-fluid w-100 cursor-zoom" alt="@Model.ProductName" onerror="this.src='/assets/img/elements/18.jpg'">
                </div>
                <div class="thumb-list d-flex gap-2 overflow-auto scroll-hide pb-2">
                    @if (Model.Images != null && Model.Images.Any())
                    {
                        var index = 0;
                        foreach (var img in Model.Images.OrderByDescending(i => i.IsPrimary))
                        {
                            <div class="thumb-item border rounded-3 @(index == 0 ? "active" : "")" style="min-width: 80px; width: 80px; height: 80px;" onclick="switchImage('@img.ImageUrl', this, @index)">
                                <img src="@img.ImageUrl" class="w-100 h-100 object-fit-cover rounded-2 cursor-pointer" alt="Thumbnail @index" onerror="this.src='/assets/img/elements/18.jpg'">
                            </div>
                            index++;
                        }
                    }
                </div>
            </div>
        </div>

        <!-- RIGHT: INFO -->
        <div class="col-md-6">
            <div class="product-info-wrapper">
                <div class="mb-2 d-flex justify-content-between align-items-start">
                    <div>
                        <span class="badge bg-danger mb-2">@Model.BrandName</span>
                        <h1 class="h2 fw-bold mb-1 text-uppercase">@Model.ProductName</h1>
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="text-warning">
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-half"></i>
                                <span class="text-muted small ms-1">(4.5)</span>
                            </div>
                            <span class="text-muted small">|</span>
                            <span class="text-muted small">Mã sản phẩm: <span id="display-sku" class="fw-bold">@Model.Variants.FirstOrDefault()?.SKU</span></span>
                        </div>
                    </div>
                    <button id="btn-wishlist" class="btn btn-outline-secondary rounded-circle px-2" onclick="addToWishlist(@Model.ProductId)">
                        <i class="bi bi-heart h5 mb-0"></i>
                    </button>
                </div>

                <div class="price-section mb-4 p-3 bg-light rounded-3">
                    <div class="d-flex align-items-center gap-3">
                        <span id="display-price" class="text-danger display-5 fw-bold">@Model.MinPrice.ToString("N0")₫</span>
                        @if (Model.MinOriginalPrice.HasValue && Model.MinOriginalPrice > Model.MinPrice)
                        {
                            <del class="text-muted h4 mb-0">@Model.MinOriginalPrice.Value.ToString("N0")₫</del>
                            <span class="badge bg-danger rounded-pill">-@Math.Round((1 - (Model.MinPrice / Model.MinOriginalPrice.Value)) * 100)%</span>
                        }
                    </div>
                </div>

                <!-- Variant Options -->
                <div class="variant-selection mb-4">
                    @{
                        var attributeGroups = Model.Variants
                            .SelectMany(v => v.AttributeValues)
                            .GroupBy(a => a.AttributeName)
                            .ToList();
                    }
                    @foreach (var group in attributeGroups)
                    {
                        <div class="variant-group mb-3">
                            <label class="form-label small fw-bold text-uppercase">Chọn @group.Key:</label>
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var val in group.Select(g => g.Value).Distinct())
                                {
                                    <button type="button" class="btn btn-outline-dark btn-sm rounded-pill px-3 variant-option" 
                                            onclick="selectAttribute('@group.Key', '@val', this)"
                                            data-attribute="@group.Key" data-value="@val">@val</button>
                                }
                            </div>
                        </div>
                    }
                </div>

                <div class="buy-actions-wrapper border-top pt-4">
                    <div class="row g-3">
                        <div class="col-4 col-lg-3">
                            <div class="input-group border rounded-pill overflow-hidden">
                                <button class="btn btn-link text-dark px-2" onclick="updateQty(-1)"><i class="bi bi-dash-lg"></i></button>
                                <input type="number" id="buy-quantity" class="form-control border-0 text-center fw-bold shadow-none" value="1" min="1" max="99">
                                <button class="btn btn-link text-dark px-2" onclick="updateQty(1)"><i class="bi bi-plus-lg"></i></button>
                            </div>
                        </div>
                        <div class="col-8 col-lg-9">
                            <div class="d-flex align-items-center gap-2 h-100">
                                <span id="display-stock" class="badge bg-success">Còn hàng</span>
                            </div>
                        </div>
                        <div class="col-12 mt-4">
                            <div class="d-flex gap-2">
                                <button class="btn btn-outline-danger btn-lg rounded-pill flex-grow-1 fw-bold py-3" onclick="triggerAddToCart()">
                                    THÊM GIỎ HÀNG
                                </button>
                                <button class="btn btn-danger btn-lg rounded-pill flex-grow-1 fw-bold py-3" onclick="triggerBuyNow()">
                                    MUA NGAY
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="trust-badges mt-5 pt-4 border-top">
                    <div class="row row-cols-3 text-center g-2">
                        <div class="col">
                            <i class='bx bx-refresh fs-2 text-danger'></i>
                            <span class="d-block small mt-1">Đổi trả 7 ngày</span>
                        </div>
                        <div class="col border-start border-end">
                            <i class='bx bx-shield-quarter fs-2 text-danger'></i>
                            <span class="d-block small mt-1">Bảo hành 12 tháng</span>
                        </div>
                        <div class="col">
                            <i class='bx bx-check-shield fs-2 text-danger'></i>
                            <span class="d-block small mt-1">Chính hãng 100%</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- PHẦN 3: TAB NỘI DUNG -->
    <div class="product-tabs-container mt-5">
        <ul class="nav nav-tabs border-bottom-0 gap-4" id="productTabs" role="tablist">
            <li class="nav-item" role="presentation"><button class="nav-link active fw-bold text-uppercase border-0 position-relative pb-3" data-bs-toggle="tab" data-bs-target="#description">Mô tả</button></li>
            <li class="nav-item" role="presentation"><button class="nav-link fw-bold text-uppercase border-0 position-relative pb-3" data-bs-toggle="tab" data-bs-target="#specifications">Thông số</button></li>
            <li class="nav-item" role="presentation"><button class="nav-link fw-bold text-uppercase border-0 position-relative pb-3" data-bs-toggle="tab" data-bs-target="#reviews">Đánh giá</button></li>
        </ul>
        <div class="tab-content border rounded p-4 bg-white shadow-sm">
            <div class="tab-pane fade show active" id="description">
                @Html.Raw(Model.Description)
            </div>
            <div class="tab-pane fade" id="specifications">
                <table class="table table-striped border mb-0">
                    <tbody id="spec-table-body">
                        @foreach (var attr in Model.Variants.FirstOrDefault()?.AttributeValues ?? new List<MotoShop.Business.DTOs.VariantAttributeDto>())
                        {
                            <tr><th class="w-25 bg-light">@attr.AttributeName</th><td>@attr.Value</td></tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="tab-pane fade" id="reviews">
                <p class="text-muted text-center py-5">Sản phẩm này chưa có đánh giá nào.</p>
            </div>
        </div>
    </div>

    <!-- PHẦN 4: SẢN PHẨM GỢI Ý -->
    <div class="related-products mt-5 pt-5 border-top">
        <h3 class="fw-bold mb-4 text-uppercase h4">Sản phẩm liên quan</h3>
        <div class="row g-3 g-md-4">
            @if (ViewBag.RelatedProducts != null)
            {
                foreach (var item in (IEnumerable<MotoShop.Business.DTOs.ProductDto>)ViewBag.RelatedProducts)
                {
                    <div class="col-6 col-md-4 col-lg-3">
                        <div class="product-card border rounded bg-white h-100 transition-all hover-shadow p-2">
                            <div class="position-relative overflow-hidden rounded mb-2" style="aspect-ratio: 1/1;">
                                <a href="/Product/Details?slug=@item.Slug">
                                    <img src="@(string.IsNullOrEmpty(item.PrimaryImageUrl) ? "/assets/img/elements/18.jpg" : item.PrimaryImageUrl)" class="w-100 h-100 object-fit-cover" alt="@item.ProductName" onerror="this.src='/assets/img/elements/18.jpg'">
                                </a>
                                <button type="button" class="btn-wishlist-abs" onclick="addToWishlist(@item.ProductId)"><i class='bx bx-heart'></i></button>
                            </div>
                            <div class="px-2">
                                <div class="text-muted x-small mb-1">@item.BrandName</div>
                                <h5 class="product-name small fw-bold mb-2 text-truncate-2" style="height: 2.5rem;">@item.ProductName</h5>
                                <div class="text-danger fw-bold">@item.MinPrice.ToString("N0")₫</div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/cart-handler.js"></script>
    <script>
        const variants = @Html.Raw(Json.Serialize(Model.Variants));
        let selectedAttributes = {};
        let currentVariant = variants[0];

        function switchImage(url, element) {
            document.getElementById('main-product-image').src = url;
            document.querySelectorAll('.thumb-item').forEach(item => item.classList.remove('active'));
            element.classList.add('active');
        }

        function selectAttribute(attrName, value, element) {
            element.closest('.variant-group').querySelectorAll('.variant-option').forEach(btn => btn.classList.remove('active'));
            element.classList.add('active');
            selectedAttributes[attrName] = value;
            updateVariant();
        }

        function updateVariant() {
            const matched = variants.find(v => v.attributeValues.every(av => selectedAttributes[av.attributeName] === av.value));
            if (matched) {
                currentVariant = matched;
                document.getElementById('display-price').textContent = new Intl.NumberFormat('vi-VN').format(matched.price) + '₫';
                document.getElementById('display-sku').textContent = matched.sku;
                document.getElementById('display-stock').className = matched.stockQuantity > 0 ? 'badge bg-success' : 'badge bg-danger';
                document.getElementById('display-stock').textContent = matched.stockQuantity > 0 ? 'Còn hàng' : 'Hết hàng';
                if (matched.imageUrl) document.getElementById('main-product-image').src = matched.imageUrl;
            }
        }

        function updateQty(delta) {
            const input = document.getElementById('buy-quantity');
            let val = parseInt(input.value) + delta;
            input.value = Math.max(1, Math.min(val, 99));
        }

        function triggerAddToCart() {
            if (currentVariant) handleAddToCart(currentVariant.productVariantId);
        }

        function triggerBuyNow() {
            if (currentVariant) handleBuyNow(currentVariant.productVariantId);
        }

        document.addEventListener('DOMContentLoaded', () => {
            if (variants.length > 0 && variants[0].attributeValues.length > 0) {
                variants[0].attributeValues.forEach(av => {
                    const btn = document.querySelector(`.variant-option[data-attribute="${av.attributeName}"][data-value="${av.value}"]`);
                    if (btn) btn.click();
                });
            }
        });
    </script>
    <style>
        .thumb-item.active { border-color: #dc3545 !important; border-width: 2px !important; }
        .text-truncate-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
        .variant-option.active { background-color: #dc3545; color: white; border-color: #dc3545; }
        .x-small { font-size: 0.7rem; }
    </style>
}
