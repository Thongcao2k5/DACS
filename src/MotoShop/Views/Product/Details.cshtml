@model MotoShop.Business.DTOs.ProductDto
@using System.Linq
@{
    ViewData["Title"] = Model.ProductName;
    var primaryImg = Model.Images?.FirstOrDefault(i => i.IsPrimary)?.ImageUrl ?? Model.PrimaryImageUrl ?? "/assets/img/elements/18.jpg";
    var defaultVariant = ViewBag.DefaultVariant as MotoShop.Business.DTOs.ProductVariantDto;
    var attributeGroups = ViewBag.AttributeGroups as Dictionary<string, List<string>>;
    var relatedProducts = ViewBag.RelatedProducts as IEnumerable<MotoShop.Business.DTOs.ProductDto>;
    var promotionType = ViewBag.PromotionType as string;
    var isFlashPromotion = promotionType == "FlashSale";
    var isProductDiscountPromotion = promotionType == "ProductDiscount";
    var variantPromotionPrices = ViewBag.VariantPromotionPrices as Dictionary<int, decimal> ?? new Dictionary<int, decimal>();
    var variantPromotionOriginalPrices = ViewBag.VariantPromotionOriginalPrices as Dictionary<int, decimal> ?? new Dictionary<int, decimal>();
}

@Html.AntiForgeryToken()

<div class="breadcrumb-wrapper">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb py-3 mb-0">
                <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted">Trang chủ</a></li>
                <li class="breadcrumb-item"><a href="/Product?categoryId=@Model.CategoryId" class="text-decoration-none text-muted">@Model.CategoryName</a></li>
                <li class="breadcrumb-item active text-dark fw-bold">@Model.ProductName</li>
            </ol>
        </nav>
    </div>
</div>

<main class="container mb-5 mt-2">
    <div class="pd-grid">

        <!-- ══════════════════════════════════════════
             CỘT TRÁI: Gallery + Tabs
        ══════════════════════════════════════════ -->
        <div class="pd-left">

            <!-- 1. Gallery -->
            <div class="product-gallery mb-4">
                <div class="main-img-container position-relative border rounded-4 overflow-hidden mb-3 bg-white shadow-sm">
                    @if (isFlashPromotion)
                    {
                        <div class="position-absolute top-0 start-0 m-3 px-3 py-2 rounded-3 text-white fw-bold shadow-lg" style="background: linear-gradient(45deg,#f12711,#f5af19); z-index: 5;">
                            <i class='bx bxs-bolt-circle me-1'></i> FLASH SALE
                        </div>
                    }
                    else if (isProductDiscountPromotion)
                    {
                        <div class="position-absolute top-0 start-0 m-3 px-3 py-2 rounded-3 text-dark fw-bold shadow-lg" style="background: #ffb020; z-index: 5;">
                            <i class='bx bxs-purchase-tag me-1'></i> SALE @ViewBag.PromotionPercent%
                        </div>
                    }
                    <img id="mainImg" src="@primaryImg" class="img-fluid w-100" alt="@Model.ProductName"
                         onerror="this.src='/assets/img/elements/18.jpg'">
                </div>
                <div class="thumb-list d-flex gap-2 overflow-auto scroll-hide pb-2">
                    @if (Model.Images != null && Model.Images.Any())
                    {
                        foreach (var img in Model.Images.OrderByDescending(i => i.IsPrimary))
                        {
                            <div class="thumb-item border rounded-3 bg-white shadow-sm @(img.ImageUrl == primaryImg ? "active border-danger" : "")"
                                 style="min-width:80px;width:80px;height:80px;cursor:pointer;transition:.2s;"
                                 onclick="changeMainImg('@img.ImageUrl', this)">
                                <img src="@img.ImageUrl" class="w-100 h-100 object-fit-cover rounded-2" alt="Thumbnail"
                                     onerror="this.src='/assets/img/elements/18.jpg'">
                            </div>
                        }
                    }
                </div>
            </div>

            <!-- 2. Tabs: Mô tả / Thông số / Đánh giá -->
            <div class="product-tabs-wrapper">
                <ul class="nav nav-pills mb-0 border-bottom gap-1" id="productTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active rounded-top-3 py-2 px-3 fw-bold text-uppercase small"
                                id="desc-tab" data-bs-toggle="pill" data-bs-target="#tabDesc" type="button" role="tab">Mô tả</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link rounded-top-3 py-2 px-3 fw-bold text-uppercase small"
                                id="spec-tab" data-bs-toggle="pill" data-bs-target="#tabSpec" type="button" role="tab">Thông số</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link rounded-top-3 py-2 px-3 fw-bold text-uppercase small"
                                id="review-tab" data-bs-toggle="pill" data-bs-target="#tabReview" type="button" role="tab">Đánh giá (@Model.Reviews.Count)</button>
                    </li>
                </ul>

                <div class="tab-content border border-top-0 rounded-bottom-4 bg-white shadow-sm">

                    <!-- Mô tả -->
                    <div class="tab-pane fade show active p-4" id="tabDesc" role="tabpanel">
                        <div class="rich-content text-dark lh-lg">
                            @Html.Raw(Model.Description)
                        </div>
                    </div>

                    <!-- Thông số — 2-column grid -->
                    <div class="tab-pane fade p-4" id="tabSpec" role="tabpanel">
                        <div class="spec-grid">
                            <div class="spec-row">
                                <span class="spec-label">Thương hiệu</span>
                                <span class="spec-value">@Model.BrandName</span>
                            </div>
                            <div class="spec-row">
                                <span class="spec-label">Danh mục</span>
                                <span class="spec-value">@Model.CategoryName</span>
                            </div>
                            @foreach (var attr in defaultVariant?.VariantAttributeValues ?? new List<MotoShop.Business.DTOs.VariantAttributeDto>())
                            {
                                <div class="spec-row">
                                    <span class="spec-label">@attr.AttributeName</span>
                                    <span class="spec-value">@attr.Value</span>
                                </div>
                            }
                            <div class="spec-row">
                                <span class="spec-label">Mã SKU</span>
                                <span class="spec-value" id="specSku">@defaultVariant?.SKU</span>
                            </div>
                            <div class="spec-row">
                                <span class="spec-label">Tình trạng</span>
                                <span class="spec-value" id="specStock">@(defaultVariant?.StockQuantity > 0 ? "Còn hàng" : "Hết hàng")</span>
                            </div>
                        </div>
                    </div>

                    <!-- Đánh giá -->
                    <div class="tab-pane fade p-4" id="tabReview" role="tabpanel">
                        <div class="row g-4">
                            <div class="col-lg-5">
                                <div class="rating-overview text-center p-4 bg-light rounded-4 border">
                                    @{
                                        var reviewAvg = Model.Reviews.Any() ? Math.Round(Model.Reviews.Average(r => r.Rating), 1) : 0;
                                        var reviewCount = Model.Reviews.Count();
                                    }
                                    <div class="display-2 fw-bold text-danger mb-0">@reviewAvg</div>
                                    <div class="text-warning h5 mb-2">
                                        @for (int i = 1; i <= 5; i++) { <i class="bi bi-star@(i <= reviewAvg ? "-fill" : (i - 0.5 <= reviewAvg ? "-half" : ""))"></i> }
                                    </div>
                                    <p class="text-muted fw-bold small mb-0">@reviewCount đánh giá</p>
                                    <div class="mt-3 pt-3 border-top">
                                        @for (int i = 5; i >= 1; i--)
                                        {
                                            var cnt = Model.Reviews.Count(r => r.Rating == i);
                                            var pct = reviewCount > 0 ? (cnt * 100 / reviewCount) : 0;
                                            <div class="d-flex align-items-center gap-2 mb-2">
                                                <span class="small fw-bold text-nowrap" style="width:28px;">@i ★</span>
                                                <div class="progress flex-grow-1" style="height:8px;border-radius:8px;">
                                                    <div class="progress-bar bg-warning" style="width:@pct%"></div>
                                                </div>
                                                <span class="small text-muted" style="width:22px;">@cnt</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                                <div class="mt-3 p-3 border rounded-4 bg-white">
                                    <h6 class="fw-bold mb-2 small"><i class='bx bx-info-circle me-1 text-danger'></i> Quy tắc đánh giá</h6>
                                    <ul class="small text-muted ps-3 mb-0">
                                        <li class="mb-1">Chỉ khách hàng đã mua mới có thể đánh giá.</li>
                                        <li class="mb-1">Nội dung lịch sự, tập trung trải nghiệm sản phẩm.</li>
                                        <li>Ảnh thật nhận được nhiều lượt "Hữu ích" hơn.</li>
                                    </ul>
                                </div>
                            </div>
                            <div class="col-lg-7">
                                @if ((ViewBag.CanReview as bool?) == true && (ViewBag.HasReviewed as bool?) != true)
                                {
                                    <form id="productReviewForm" class="border rounded-4 p-3 mb-3 bg-white">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="productId" value="@Model.ProductId">
                                        <input type="hidden" name="variantId" id="productReviewVariantId" value="@defaultVariant?.ProductVariantId">
                                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                                            <div class="fw-bold text-dark">Viết đánh giá sản phẩm</div>
                                            <div class="text-warning fs-5 product-rating-stars">
                                                @for (int i = 1; i <= 5; i++)
                                                {
                                                    <i class="bi bi-star-fill product-rating-star" data-rating="@i" style="cursor:pointer;"></i>
                                                }
                                            </div>
                                            <input type="hidden" name="rating" id="productReviewRating" value="5">
                                        </div>
                                        <textarea name="comment" class="form-control rounded-3 mb-3" rows="4" placeholder="Chia sẻ cảm nhận thực tế của bạn về sản phẩm..." required></textarea>
                                        <input type="file" name="reviewImages" class="form-control rounded-3 mb-2" accept="image/jpeg,image/png,image/webp" multiple>
                                        <div class="d-flex justify-content-between align-items-center gap-2">
                                            <span class="small text-muted">Tối đa 5 ảnh JPG, PNG hoặc WEBP.</span>
                                            <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold">Gửi đánh giá</button>
                                        </div>
                                    </form>
                                }
                                else if ((ViewBag.HasReviewed as bool?) == true)
                                {
                                    <div class="alert alert-light border rounded-4 small mb-3">
                                        Bạn đã gửi đánh giá cho sản phẩm này.
                                    </div>
                                }
                                <div class="d-flex flex-wrap gap-2 mb-3 bg-light p-2 rounded-3 border">
                                    <button class="btn btn-sm btn-white border rounded-pill active px-3 filter-btn" data-filter="all">Tất cả</button>
                                    <button class="btn btn-sm btn-white border rounded-pill px-3 filter-btn" data-filter="5">5 Sao</button>
                                    <button class="btn btn-sm btn-white border rounded-pill px-3 filter-btn" data-filter="photo">
                                        <i class='bx bx-camera me-1'></i>Có ảnh
                                    </button>
                                </div>
                                <div id="revList">
                                    @if (Model.Reviews.Any())
                                    {
                                        foreach (var r in Model.Reviews.OrderByDescending(x => x.CreatedDate))
                                        {
                                            <div class="review-item mb-4 pb-4 border-bottom @(r.Rating == 5 ? "star-5" : "")">
                                                <div class="d-flex align-items-center gap-3 mb-2">
                                                    <div class="rev-avatar d-flex align-items-center justify-content-center bg-danger text-white fw-bold rounded-circle flex-shrink-0"
                                                         style="width:44px;height:44px;font-size:18px;">
                                                        @(!string.IsNullOrEmpty(r.AvatarUrl)
                                                            ? Html.Raw($"<img src='{r.AvatarUrl}' class='w-100 h-100 object-fit-cover rounded-circle'>")
                                                            : Html.Raw(r.CustomerName[0].ToString()))
                                                    </div>
                                                    <div>
                                                        <div class="fw-bold text-dark small d-flex align-items-center gap-2">
                                                            @r.CustomerName
                                                            <span class="badge bg-success-subtle text-success border border-success-subtle" style="font-size:9px;">
                                                                <i class='bx bxs-check-circle'></i> ĐÃ MUA
                                                            </span>
                                                        </div>
                                                        <div class="text-warning x-small">
                                                            @for (int i = 1; i <= 5; i++) { <i class="bi bi-star@(i <= r.Rating ? "-fill" : "")"></i> }
                                                            <span class="text-muted ms-1 fw-normal" style="font-size:11px;">@r.CreatedDate.ToString("dd/MM/yyyy")</span>
                                                        </div>
                                                    </div>
                                                </div>
                                                <p class="text-dark mb-2 small" style="line-height:1.6;">@r.Comment</p>
                                                @if (r.ReviewImages != null && r.ReviewImages.Any())
                                                {
                                                    <div class="d-flex flex-wrap gap-2 mb-2 customer-photos">
                                                        @foreach (var img in r.ReviewImages)
                                                        {
                                                            <div class="photo-thumb rounded-2 border overflow-hidden"
                                                                 onclick="openLightbox('@img')"
                                                                 style="width:80px;height:80px;cursor:pointer;">
                                                                <img src="@img" class="w-100 h-100 object-fit-cover" alt="Ảnh khách">
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                                <button class="btn btn-sm btn-link text-decoration-none text-muted p-0 like-btn" style="font-size:12px;">
                                                    <i class='bx bx-like me-1'></i> Hữu ích (0)
                                                </button>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <div class="text-center py-5 text-muted">
                                            <i class='bx bx-comment-detail display-4 d-block mb-3'></i>
                                            Chưa có đánh giá nào. Hãy là người đầu tiên chia sẻ!
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <!-- ══════════════════════════════════════════
             CỘT PHẢI: Thông tin + Sản phẩm tương tự
        ══════════════════════════════════════════ -->
        <div class="pd-right">

            <!-- 1. Product Info Card -->
            <div class="product-info-content bg-white p-4 rounded-4 shadow-sm border mb-4">

                <!-- Brand + Wishlist -->
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div class="d-flex align-items-center gap-2">
                        @if (!string.IsNullOrEmpty(Model.BrandLogoUrl))
                        {
                            <img src="@Model.BrandLogoUrl" alt="@Model.BrandName" style="height:26px;object-fit:contain;">
                        }
                        <span class="text-danger fw-bold text-uppercase small tracking-wider">@Model.BrandName</span>
                    </div>
                    <button id="wishBtn" onclick="toggleWishlist(@Model.ProductId)"
                            class="btn btn-light rounded-circle shadow-sm @(ViewBag.IsWishlisted ? "active text-danger" : "")"
                            style="width:40px;height:40px;">
                        <i class='bx @(ViewBag.IsWishlisted ? "bxs-heart" : "bx-heart") fs-5'></i>
                    </button>
                </div>

                <h1 class="product-title h4 fw-bold text-dark mb-2">@Model.ProductName</h1>

                <div class="d-flex align-items-center flex-wrap gap-2 mb-3 small border-bottom pb-3">
                    <div class="text-warning d-flex align-items-center gap-1">
                        <span class="fw-bold text-dark">4.5</span>
                        @for (int i = 1; i <= 5; i++) { <i class="bi bi-star-fill" style="font-size:11px;"></i> }
                    </div>
                    <span class="text-muted opacity-50">|</span>
                    <span class="text-muted"><span class="fw-bold text-dark">@Model.Reviews.Count</span> Đánh giá</span>
                    <span class="text-muted opacity-50">|</span>
                    <span class="text-muted">SKU: <span id="displaySku" class="fw-bold text-dark">@defaultVariant?.SKU</span></span>
                </div>

                <!-- Price Box -->
                <div class="price-box mb-3 p-3 rounded-3 bg-light border-start border-danger border-4">
                    <div class="d-flex align-items-center flex-wrap gap-2">
                        @if (isFlashPromotion && ViewBag.PromotionPrice != null)
                        {
                            <span id="displayPrice" class="text-danger fs-2 fw-bold">@(((decimal)ViewBag.PromotionPrice).ToString("N0"))₫</span>
                            <del id="displayOldPrice" class="text-muted h6 mb-0">@(((decimal)ViewBag.PromotionOriginalPrice).ToString("N0"))₫</del>
                            @if (ViewBag.PromotionPercent != null && (int)ViewBag.PromotionPercent > 0)
                            {
                                <span class="badge bg-danger px-2 py-1">FLASH SALE -@ViewBag.PromotionPercent%</span>
                            }
                        }
                        else if (ViewBag.PromotionPrice != null && defaultVariant != null)
                        {
                            <span id="displayPrice" class="text-danger fs-2 fw-bold">@(((decimal)ViewBag.PromotionPrice).ToString("N0"))₫</span>
                            <del id="displayOldPrice" class="text-muted h6 mb-0">@(((decimal)ViewBag.PromotionOriginalPrice).ToString("N0"))₫</del>
                            @if (ViewBag.PromotionPercent != null && (int)ViewBag.PromotionPercent > 0)
                            {
                                <span class="badge bg-warning text-dark px-2 py-1">SALE @ViewBag.PromotionPercent%</span>
                            }
                        }
                        else if (defaultVariant != null)
                        {
                            <span id="displayPrice" class="text-danger fs-2 fw-bold">@defaultVariant.Price.ToString("N0")₫</span>
                            @if (defaultVariant.OriginalPrice != null && defaultVariant.OriginalPrice > defaultVariant.Price)
                            {
                                <del id="displayOldPrice" class="text-muted h6 mb-0">@defaultVariant.OriginalPrice.Value.ToString("N0")₫</del>
                                <span class="badge bg-danger px-2 py-1">-@Model.CalculatedDiscountPercent%</span>
                            }
                        }
                    </div>
                    @if (isFlashPromotion)
                    {
                        <div class="mt-2 d-flex align-items-center text-danger fw-bold small">
                            <i class='bx bx-time-five me-1 fs-5'></i> KẾT THÚC TRONG:
                            <span id="countdown" class="ms-2 font-monospace bg-white px-2 py-1 rounded border"
                                  data-end="@(((DateTime?)ViewBag.PromotionEndDate)?.ToString("yyyy-MM-ddTHH:mm:ss"))">--:--:--</span>
                        </div>
                    }
                    else if (ViewBag.PromotionPrice != null)
                    {
                        <div class="mt-1 small text-warning fw-bold">
                            <i class='bx bxs-purchase-tag me-1'></i> @ViewBag.PromotionName
                        </div>
                    }
                </div>

                <!-- Variant Selection -->
                <div class="variant-selection mb-3">
                    @if (attributeGroups != null)
                    {
                        foreach (var group in attributeGroups)
                        {
                            <div class="attr-group mb-3">
                                <label class="small fw-bold text-uppercase mb-2 d-block text-muted">CHỌN @group.Key:</label>
                                <div class="d-flex flex-wrap gap-2" data-attr-name="@group.Key">
                                    @foreach (var val in group.Value)
                                    {
                                        <button type="button" class="attr-btn" onclick="selectAttr('@group.Key', '@val', this)">@val</button>
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>

                <!-- Quantity + Stock + Buttons -->
                <div class="action-section pt-3 border-top">
                    <div class="d-flex align-items-center gap-4 mb-3">
                        <div>
                            <label class="small fw-bold text-uppercase text-muted d-block mb-1">SỐ LƯỢNG</label>
                            <div class="qty-wrapper d-flex align-items-center border rounded-pill overflow-hidden" style="width:120px;height:42px;">
                                <button type="button" class="btn btn-link text-dark text-decoration-none flex-grow-1 py-0" onclick="changeQty(-1)">
                                    <i class='bx bx-minus'></i>
                                </button>
                                <input type="number" id="qty" value="1" min="1" data-max="@Model.StockCount" readonly
                                       class="form-control border-0 bg-transparent text-center fw-bold text-dark p-0"
                                       style="width:36px;box-shadow:none;">
                                <button type="button" class="btn btn-link text-dark text-decoration-none flex-grow-1 py-0" onclick="changeQty(1)">
                                    <i class='bx bx-plus'></i>
                                </button>
                            </div>
                        </div>
                        <div>
                            <label class="small fw-bold text-uppercase text-muted d-block mb-1">TÌNH TRẠNG</label>
                            <div id="stockStatus">
                                @if (Model.IsInStock)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-2">
                                        <i class='bx bxs-check-circle me-1'></i>Còn hàng (@Model.StockCount)
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-2">
                                        <i class='bx bxs-x-circle me-1'></i>Hết hàng
                                    </span>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <button class="btn btn-outline-danger w-100 rounded-pill fw-bold d-flex align-items-center justify-content-center gap-1"
                                    style="height:50px;border-width:2px;" onclick="addToCart()">
                                <i class='bx bx-cart-add fs-5'></i> Thêm vào giỏ hàng
                            </button>
                        </div>
                        <div class="col-6">
                            <button class="btn btn-danger w-100 rounded-pill fw-bold"
                                    style="height:50px;background:#E24B4A;border:none;" onclick="buyNow()">Mua ngay</button>
                        </div>
                    </div>

                    <div class="trust-badges d-flex justify-content-between p-3 bg-light rounded-3 border">
                        <div class="text-center small flex-grow-1 border-end">
                            <i class='bx bx-refresh text-danger d-block fs-5 mb-1'></i>7 Ngày đổi trả
                        </div>
                        <div class="text-center small flex-grow-1 border-end">
                            <i class='bx bx-check-shield text-danger d-block fs-5 mb-1'></i>Chính hãng
                        </div>
                        <div class="text-center small flex-grow-1">
                            <i class='bx bx-support text-danger d-block fs-5 mb-1'></i>Hỗ trợ 24/7
                        </div>
                    </div>
                </div>
            </div>

            <!-- 2. Sản phẩm tương tự (right column, max 4) -->
            @if (relatedProducts != null && relatedProducts.Any())
            {
                <div class="related-right-section bg-white rounded-4 border shadow-sm p-3">
                    <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
                        <h6 class="fw-bold mb-0 text-dark">
                            <i class='bx bxs-grid-alt me-1 text-danger'></i> Sản phẩm tương tự
                        </h6>
                        <a href="/Product?categoryId=@Model.CategoryId" class="small text-danger text-decoration-none fw-bold">
                            Xem tất cả <i class='bx bx-chevron-right'></i>
                        </a>
                    </div>
                    <div class="d-flex flex-column gap-3">
                        @foreach (var p in relatedProducts.Take(4))
                        {
                            var relImg = p.PrimaryImageUrl ?? "/assets/img/elements/18.jpg";
                            var relPrice = p.IsFlashSale && p.FlashSalePrice != null ? p.FlashSalePrice.Value : p.MinPrice;
                            var relOldPrice = p.MinOriginalPrice;
                            var relDisc = p.CalculatedDiscountPercent > 0 ? p.CalculatedDiscountPercent : p.DiscountPercent;
                            <div class="rel-card d-flex gap-3 p-2 rounded-3 border">
                                <a asp-controller="Product" asp-action="Details" asp-route-slug="@p.Slug" class="flex-shrink-0">
                                    <img src="@relImg" alt="@p.ProductName" class="rounded-3 object-fit-cover"
                                         style="width:90px;height:90px;" onerror="this.src='/assets/img/elements/18.jpg'">
                                </a>
                                <div class="flex-grow-1" style="min-width:0;">
                                    @if (!string.IsNullOrEmpty(p.BrandName))
                                    {
                                        <div class="text-danger fw-bold" style="font-size:11px;letter-spacing:.5px;">@p.BrandName.ToUpper()</div>
                                    }
                                    <a asp-controller="Product" asp-action="Details" asp-route-slug="@p.Slug"
                                       class="text-dark text-decoration-none fw-semibold d-block"
                                       style="font-size:13px;line-height:1.4;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">
                                        @p.ProductName
                                    </a>
                                    <div class="d-flex align-items-center gap-2 mt-1 flex-wrap">
                                        <span class="text-danger fw-bold" style="font-size:14px;">@relPrice.ToString("N0")₫</span>
                                        @if (relOldPrice != null && relOldPrice > relPrice)
                                        {
                                            <del class="text-muted" style="font-size:11px;">@relOldPrice.Value.ToString("N0")₫</del>
                                        }
                                        @if (relDisc > 0)
                                        {
                                            <span class="badge bg-danger px-1" style="font-size:10px;padding-top:2px;padding-bottom:2px;">-@relDisc%</span>
                                        }
                                    </div>
                                    <div class="d-flex gap-2 mt-2">
                                        <button class="btn btn-sm btn-outline-danger rounded-pill flex-grow-1"
                                                style="font-size:12px;padding:4px 8px;"
                                                onclick="handleAddToCart(@p.DefaultVariantId)"
                                                @(!p.IsInStock ? "disabled" : "")>
                                            <i class='bx bx-cart-add'></i> Thêm vào giỏ
                                        </button>
                                        <button class="btn btn-sm btn-danger rounded-pill flex-grow-1"
                                                style="font-size:12px;padding:4px 8px;background:#E24B4A;border:none;"
                                                onclick="handleBuyNow(@p.DefaultVariantId)"
                                                @(!p.IsInStock ? "disabled" : "")>
                                            Mua ngay
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

        </div><!-- /detail-right -->
    </div><!-- /row -->
</main>

<!-- Lightbox Modal -->
<div class="modal fade" id="photoLightbox" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content bg-transparent border-0 text-center position-relative">
            <img id="lightboxImg" src="" class="img-fluid rounded-4 shadow-lg mx-auto border border-secondary">
            <button type="button" class="btn-close btn-close-white position-absolute top-0 end-0 m-3" data-bs-dismiss="modal"></button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        async function toggleWishlist(productId) {
            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value
                           || document.querySelector('meta[name="__RequestVerificationToken"]')?.content
                           || '';
                const res = await fetch('/Wishlist/Toggle', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'X-XSRF-TOKEN': token },
                    body: JSON.stringify({ productId: productId })
                });
                const data = await res.json();
                if (data.success) {
                    const btn = document.getElementById('wishBtn');
                    const icon = btn?.querySelector('i');
                    if (icon) {
                        icon.className = data.added ? 'bx bxs-heart fs-5' : 'bx bx-heart fs-5';
                        btn.classList.toggle('active', data.added);
                        btn.classList.toggle('text-danger', data.added);
                    }
                    if (typeof updateWishlistBadge === 'function') updateWishlistBadge();
                }
            } catch (e) { console.error('Wishlist error:', e); }
        }

        const variants = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Variants.Select(v => new {
            v.ProductVariantId, v.Price, v.OriginalPrice, v.SKU, v.StockQuantity, v.ImageUrl,
            Attributes = v.VariantAttributeValues.Any()
                ? v.VariantAttributeValues.Select(av => new { Name = av.AttributeName, Value = av.Value }).ToList()
                : new[] { new { Name = "Phiên bản", Value = v.VariantName } }.ToList()
        }).ToList()));
        const activePromotion = {
            percent: @((ViewBag.PromotionPercent ?? 0).ToString()),
            hasDiscount: @(ViewBag.PromotionPrice != null ? "true" : "false")
        };
        const variantPromotionPrices = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(variantPromotionPrices));
        const variantPromotionOriginalPrices = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(variantPromotionOriginalPrices));

        let selected = {};
        let currentVar = null;

        // Auto-select: nếu chỉ có 1 variant hoặc mỗi nhóm thuộc tính chỉ có 1 giá trị
        // thì tự điền selected và gọi checkVariants để set currentVar ngay khi load trang
        (function autoInit() {
            if (variants.length === 1 && variants[0].Attributes.length === 0) {
                currentVar = variants[0];
                return;
            }
            const allAttrs = {};
            variants.forEach(v => v.Attributes.forEach(a => {
                if (!allAttrs[a.Name]) allAttrs[a.Name] = new Set();
                allAttrs[a.Name].add(a.Value);
            }));
            // Pre-select các nhóm chỉ có 1 giá trị
            Object.entries(allAttrs).forEach(([name, vals]) => {
                if (vals.size === 1) selected[name] = [...vals][0];
            });
            // Nếu chỉ có đúng 1 variant, auto-select luôn bất kể thuộc tính
            if (variants.length === 1) {
                variants[0].Attributes.forEach(a => { selected[a.Name] = a.Value; });
            }
            checkVariants();
            // Đánh dấu active cho các button đã auto-select
            document.querySelectorAll('[data-attr-name]').forEach(group => {
                const name = group.getAttribute('data-attr-name');
                if (selected[name]) {
                    group.querySelectorAll('.attr-btn').forEach(btn => {
                        if (btn.textContent.trim() === selected[name]) btn.classList.add('active');
                    });
                }
            });
        })();

        function changeMainImg(url, el) {
            document.getElementById('mainImg').src = url;
            document.querySelectorAll('.thumb-item').forEach(i => i.classList.remove('active', 'border-danger'));
            el.classList.add('active', 'border-danger');
        }

        function selectAttr(name, val, el) {
            el.closest('[data-attr-name]').querySelectorAll('.attr-btn').forEach(b => b.classList.remove('active'));
            el.classList.add('active');
            selected[name] = val;
            checkVariants();
        }

        function checkVariants() {
            const matched = variants.find(v => v.Attributes.every(a => selected[a.Name] === a.Value));
            if (matched) {
                currentVar = matched;
                const reviewVariantInput = document.getElementById('productReviewVariantId');
                if (reviewVariantInput) reviewVariantInput.value = matched.ProductVariantId;
                const variantKey = String(matched.ProductVariantId);
                const promotionPrice = variantPromotionPrices[variantKey];
                const promotionOriginalPrice = variantPromotionOriginalPrices[variantKey];
                const displayPrice = promotionPrice !== undefined ? Number(promotionPrice) : matched.Price;
                const displayOldPrice = promotionOriginalPrice !== undefined ? Number(promotionOriginalPrice) : matched.OriginalPrice;
                document.getElementById('displayPrice').innerText = displayPrice.toLocaleString('vi-VN') + '₫';

                let oldPriceEl = document.getElementById('displayOldPrice');
                if (displayOldPrice && displayOldPrice > displayPrice) {
                    if (!oldPriceEl) {
                        document.querySelector('.price-box .d-flex').insertAdjacentHTML('beforeend',
                            `<del id="displayOldPrice" class="text-muted h6 mb-0 ms-2"></del>`);
                        oldPriceEl = document.getElementById('displayOldPrice');
                    }
                    oldPriceEl.innerText = displayOldPrice.toLocaleString('vi-VN') + '₫';
                } else {
                    oldPriceEl?.remove();
                }

                document.getElementById('displaySku').innerText = matched.SKU;
                document.getElementById('specSku').innerText = matched.SKU;
                document.getElementById('specStock').innerText = matched.StockQuantity > 0 ? 'Còn hàng' : 'Hết hàng';
                document.getElementById('qty').dataset.max = matched.StockQuantity;

                const status = document.getElementById('stockStatus');
                status.innerHTML = matched.StockQuantity > 0
                    ? `<span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-2"><i class='bx bxs-check-circle me-1'></i>Còn hàng (${matched.StockQuantity})</span>`
                    : `<span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-2"><i class='bx bxs-x-circle me-1'></i>Hết hàng</span>`;

                if (matched.ImageUrl) document.getElementById('mainImg').src = matched.ImageUrl;
            }
        }

        function changeQty(delta) {
            const inp = document.getElementById('qty');
            const max = parseInt(inp.dataset.max) || 99;
            inp.value = Math.max(1, Math.min(parseInt(inp.value) + delta, max));
        }

        function addToCart() {
            if (!currentVar) { Swal.fire('Thông báo', 'Vui lòng chọn đầy đủ thuộc tính', 'info'); return; }
            handleAddToCart(currentVar.ProductVariantId, parseInt(document.getElementById('qty').value));
        }

        function buyNow() {
            if (!currentVar) { Swal.fire('Thông báo', 'Vui lòng chọn đầy đủ thuộc tính', 'info'); return; }
            handleBuyNow(currentVar.ProductVariantId, parseInt(document.getElementById('qty').value));
        }

        function openLightbox(src) {
            if (!src) return;
            document.getElementById('lightboxImg').src = src;
            new bootstrap.Modal(document.getElementById('photoLightbox')).show();
        }

        $(document).on('click', '.like-btn', function (e) {
            e.preventDefault();
            const $btn = $(this);
            $btn.toggleClass('liked text-danger');
            const count = parseInt($btn.text().match(/\d+/) || [0]);
            $btn.html($btn.hasClass('liked')
                ? `<i class='bx bxs-like me-1'></i> Hữu ích (${count + 1})`
                : `<i class='bx bx-like me-1'></i> Hữu ích (${count - 1})`);
        });

        $(document).on('click', '.filter-btn', function () {
            $('.filter-btn').removeClass('active btn-danger text-white').addClass('btn-white');
            $(this).addClass('active btn-danger text-white').removeClass('btn-white');
            const filter = $(this).data('filter');
            $('.review-item').hide();
            if (filter === 'all') $('.review-item').fadeIn();
            else if (filter === 'photo') $('.customer-photos').closest('.review-item').fadeIn();
            else $('.star-' + filter).fadeIn();
        });

        $(document).on('click', '.product-rating-star', function () {
            const rating = parseInt($(this).data('rating'));
            $('#productReviewRating').val(rating);
            $('.product-rating-star').each(function () {
                const isActive = parseInt($(this).data('rating')) <= rating;
                $(this).toggleClass('bi-star-fill', isActive).toggleClass('bi-star', !isActive);
            });
        });

        $('#productReviewForm').on('submit', async function (e) {
            e.preventDefault();
            const btn = this.querySelector('button[type="submit"]');
            const originalText = btn.innerText;
            btn.disabled = true;
            btn.innerText = 'Đang gửi...';

            try {
                const response = await fetch('/Review/SubmitReview', {
                    method: 'POST',
                    body: new FormData(this)
                });
                const data = await response.json();
                if (data.success) {
                    Swal.fire('Thành công', data.message, 'success').then(() => location.reload());
                } else {
                    Swal.fire('Lỗi', data.message, 'error');
                    btn.disabled = false;
                    btn.innerText = originalText;
                }
            } catch {
                Swal.fire('Lỗi', 'Không thể gửi đánh giá lúc này.', 'error');
                btn.disabled = false;
                btn.innerText = originalText;
            }
        });

        document.addEventListener('DOMContentLoaded', () => {
            // Đánh dấu biến thể hết hàng
            document.querySelectorAll('[data-attr-name]').forEach(group => {
                const attrName = group.dataset.attrName;
                group.querySelectorAll('.attr-btn').forEach(btn => {
                    const val = btn.textContent.trim();
                    const anyInStock = variants.some(v =>
                        v.StockQuantity > 0 &&
                        v.Attributes.some(a => a.Name === attrName && a.Value === val)
                    );
                    if (!anyInStock) btn.classList.add('out-of-stock');
                });
            });

            // Tự chọn biến thể đầu tiên còn hàng
            document.querySelectorAll('[data-attr-name]').forEach(g => {
                const first = g.querySelector('.attr-btn:not(.out-of-stock)') || g.querySelector('.attr-btn');
                if (first) first.click();
            });
        });
    </script>

}

@section Styles {
<style>
    /* ── 2-column layout (flexbox, mobile-first) ── */
    .pd-grid { display: flex; flex-wrap: wrap; gap: 1.5rem; align-items: flex-start; }
    .pd-left, .pd-right { flex: 1 1 340px; min-width: 0; }
    @@media (max-width: 767px) {
        .pd-left, .pd-right { flex: 1 1 100%; }
    }

    /* ── Ảnh chính ── */
    #mainImg { width: 100%; max-height: 460px; object-fit: contain; aspect-ratio: 1/1; }
    @@media (max-width: 767px) {
        #mainImg { max-height: 320px; aspect-ratio: unset; }
    }
    @@media (max-width: 480px) {
        #mainImg { max-height: 250px; }
    }

    /* ── Variant buttons ── */
    .attr-btn {
        padding: 6px 16px;
        border: 1.5px solid #dee2e6;
        border-radius: 8px;
        background: #fff;
        color: #333;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: all .15s;
        line-height: 1.4;
    }
    .attr-btn:hover:not(.out-of-stock) { border-color: #e24b4a; color: #e24b4a; }
    .attr-btn.active { border-color: #e24b4a !important; color: #e24b4a !important; background: #fff5f5; }
    .attr-btn.out-of-stock { opacity: .4; text-decoration: line-through; cursor: not-allowed; }

    /* ── Specs 2-column grid ── */
    .spec-grid { display: flex; flex-direction: column; gap: 2px; }
    .spec-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        border: 1px solid #f0f0f0;
        border-radius: 6px;
        overflow: hidden;
    }
    .spec-row:nth-child(odd)  { background: #f8f9fa; }
    .spec-row:nth-child(even) { background: #fff; }
    .spec-label { padding: 10px 14px; font-weight: 600; color: #6c757d; font-size: 13px; border-right: 1px solid #f0f0f0; }
    .spec-value { padding: 10px 14px; font-size: 13px; color: #212529; }

    /* ── Related product cards ── */
    .rel-card { background: #fafafa; transition: .2s; }
    .rel-card:hover { background: #fff; box-shadow: 0 2px 12px rgba(0,0,0,.08); }

    /* ── Misc ── */
    .breadcrumb-wrapper { background: #f8f9fa; border-bottom: 1px solid #eee; }
    .scroll-hide::-webkit-scrollbar { display: none; }
    .nav-pills .nav-link { color: #666; border-radius: 0; border-bottom: 3px solid transparent; }
    .nav-pills .nav-link.active { background: none; color: #E24B4A; border-bottom-color: #E24B4A; }
    .photo-thumb { transition: .2s; }
    .photo-thumb:hover { transform: scale(1.05); }
    .x-small { font-size: 11px; }
    .tracking-wider { letter-spacing: 1px; }
</style>
}
