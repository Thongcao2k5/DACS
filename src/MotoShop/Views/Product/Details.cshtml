@model MotoShop.Business.DTOs.ProductDto
@using System.Linq
@{
    ViewData["Title"] = Model.ProductName;
    var primaryImg = Model.Images?.FirstOrDefault(i => i.IsPrimary)?.ImageUrl ?? Model.PrimaryImageUrl ?? "/assets/img/elements/18.jpg";
    var defaultVariant = ViewBag.DefaultVariant as MotoShop.Business.DTOs.ProductVariantDto;
    var attributeGroups = ViewBag.AttributeGroups as Dictionary<string, List<string>>;
    var relatedProducts = ViewBag.RelatedProducts as IEnumerable<MotoShop.Business.DTOs.ProductDto>;
    var vouchers = ViewBag.Vouchers as IEnumerable<MotoShop.Business.DTOs.CouponDto>;
    var promotionType = ViewBag.PromotionType as string;
    var isFlashPromotion = promotionType == "FlashSale";
    var isProductDiscountPromotion = promotionType == "ProductDiscount";
}

@Html.AntiForgeryToken()

<div class="breadcrumb-wrapper">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb py-3 mb-0">
                <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted">Trang chủ</a></li>
                <li class="breadcrumb-item"><a href="/Product?categoryId=@Model.CategoryId" class="text-decoration-none text-muted">@Model.CategoryName</a></li>
                <li class="breadcrumb-item active text-dark fw-bold">@Model.ProductName</li>
            </ol>
        </nav>
    </div>
</div>

<main class="container mb-5 mt-2">
    <div class="row g-4 g-lg-5">
        <!-- 1. LEFT: GALLERY -->
        <div class="col-md-6">
            <div class="product-gallery sticky-top" style="top: 100px; z-index: 10;">
                <div class="main-img-container border rounded-4 overflow-hidden mb-3 bg-white shadow-sm shadow-hover">
                    @if (isFlashPromotion)
                    {
                        <div class="badge-flash-sale position-absolute top-0 start-0 m-3 px-3 py-2 rounded-3 text-white fw-bold shadow-lg" style="background: linear-gradient(45deg, #f12711, #f5af19); z-index: 5;">
                            <i class='bx bxs-bolt-circle me-1'></i> FLASH SALE
                        </div>
                    }
                    else if (isProductDiscountPromotion)
                    {
                        <div class="position-absolute top-0 start-0 m-3 px-3 py-2 rounded-3 text-dark fw-bold shadow-lg" style="background: #ffb020; z-index: 5;">
                            <i class='bx bxs-purchase-tag me-1'></i> SALE @ViewBag.PromotionPercent%
                        </div>
                    }
                    <img id="mainImg" src="@primaryImg" class="img-fluid w-100" alt="@Model.ProductName" onerror="this.src='/assets/img/elements/18.jpg'" style="aspect-ratio: 1/1; object-fit: contain;">
                </div>
                <div class="thumb-list d-flex gap-2 overflow-auto scroll-hide pb-2">
                    @if (Model.Images != null && Model.Images.Any())
                    {
                        foreach (var img in Model.Images.OrderByDescending(i => i.IsPrimary))
                        {
                            <div class="thumb-item border rounded-3 bg-white shadow-sm @(img.ImageUrl == primaryImg ? "active border-danger" : "")" style="min-width: 80px; width: 80px; height: 80px; cursor: pointer; transition: 0.2s;" onclick="changeMainImg('@img.ImageUrl', this)">
                                <img src="@img.ImageUrl" class="w-100 h-100 object-fit-cover rounded-2" alt="Thumbnail" onerror="this.src='/assets/img/elements/18.jpg'">
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <!-- 2. RIGHT: PRODUCT INFO -->
        <div class="col-md-6">
            <div class="product-info-content bg-white p-4 rounded-4 shadow-sm border">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div class="d-flex align-items-center gap-2">
                        @if (!string.IsNullOrEmpty(Model.BrandLogoUrl))
                        {
                            <img src="@Model.BrandLogoUrl" alt="@Model.BrandName" class="brand-logo-img" style="height: 30px; object-fit: contain;">
                        }
                        <span class="text-danger fw-bold text-uppercase small tracking-wider">@Model.BrandName</span>
                    </div>
                    <button id="wishBtn" onclick="toggleWishlist(@Model.ProductId)" class="wish-btn btn btn-light rounded-circle shadow-sm @(ViewBag.IsWishlisted ? "active text-danger" : "")" style="width: 42px; height: 42px;">
                        <i class='bx @(ViewBag.IsWishlisted ? "bxs-heart" : "bx-heart") fs-4'></i>
                    </button>
                </div>

                <h1 class="product-title h3 fw-bold text-dark mb-3">@Model.ProductName</h1>

                <div class="d-flex align-items-center gap-3 mb-4 small border-bottom pb-3">
                    <div class="text-warning d-flex align-items-center">
                        <span class="fw-bold me-1 text-dark">4.5</span>
                        @for (int i = 1; i <= 5; i++) { <i class="bi bi-star-fill"></i> }
                    </div>
                    <span class="text-muted opacity-50">|</span>
                    <span class="text-muted"><span class="fw-bold text-dark">@Model.Reviews.Count</span> Đánh giá</span>
                    <span class="text-muted opacity-50">|</span>
                    <span class="text-muted">SKU: <span id="displaySku" class="fw-bold text-dark">@defaultVariant?.SKU</span></span>
                </div>

                <div class="price-box mb-4 p-3 rounded-3 bg-light border-start border-danger border-4">
                    <div class="d-flex align-items-center flex-wrap gap-2">
                        @if (isFlashPromotion && ViewBag.PromotionPrice != null)
                        {
                            <span id="displayPrice" class="text-danger display-6 fw-bold">@((decimal)ViewBag.PromotionPrice).ToString("N0")₫</span>
                            <del id="displayOldPrice" class="text-muted h5 mb-0">@((decimal)ViewBag.PromotionOriginalPrice).ToString("N0")₫</del>
                            <span class="badge bg-danger ms-2 px-2 py-1">FLASH SALE -@ViewBag.PromotionPercent%</span>
                        }
                        else if (ViewBag.PromotionPrice != null && defaultVariant != null)
                        {
                            <span id="displayPrice" class="text-danger display-6 fw-bold">@((decimal)ViewBag.PromotionPrice).ToString("N0")₫</span>
                            <del id="displayOldPrice" class="text-muted h5 mb-0">@((decimal)ViewBag.PromotionOriginalPrice).ToString("N0")₫</del>
                            <span class="badge bg-warning text-dark ms-2 px-2 py-1">SALE @ViewBag.PromotionPercent%</span>
                        }
                        else if (defaultVariant != null)
                        {
                            <span id="displayPrice" class="text-danger display-6 fw-bold">@defaultVariant.Price.ToString("N0")₫</span>
                            @if (defaultVariant.OriginalPrice != null && defaultVariant.OriginalPrice > defaultVariant.Price)
                            {
                                <del id="displayOldPrice" class="text-muted h5 mb-0">@defaultVariant.OriginalPrice.Value.ToString("N0")₫</del>
                                <span class="badge bg-danger ms-2 px-2 py-1">-@Model.CalculatedDiscountPercent%</span>
                            }
                        }
                    </div>
                    @if (isFlashPromotion)
                    {
                        <div class="mt-3 d-flex align-items-center text-danger fw-bold small">
                            <i class='bx bx-time-five me-1 fs-5'></i> KẾT THÚC TRONG:
                            <span id="countdown" class="ms-2 font-monospace bg-white px-2 py-1 rounded border shadow-sm" data-end="@(((DateTime?)ViewBag.PromotionEndDate)?.ToString("yyyy-MM-ddTHH:mm:ss"))">--:--:--</span>
                        </div>
                    }
                    else if (ViewBag.PromotionPrice != null)
                    {
                        <div class="mt-2 small text-warning fw-bold">
                            <i class='bx bxs-purchase-tag me-1'></i> Ưu đãi: @ViewBag.PromotionName
                        </div>
                    }
                </div>

                <!-- FIX 7: VOUCHERS -->
                @if (vouchers != null && vouchers.Any())
                {
                    <div class="voucher-section p-3 rounded-3 mb-4" style="background-color: #fff8f8; border: 1px dashed #e24b4a;">
                        <div class="voucher-title mb-2 text-danger fw-bold small text-uppercase">
                            <i class='bx bxs-coupon me-1'></i> Ưu đãi đặc biệt
                        </div>
                        <div class="d-flex flex-wrap gap-2">
                        @foreach (var v in vouchers)
                        {
                            <div class="voucher-item bg-white border rounded px-3 py-2 d-flex align-items-center gap-3 shadow-sm">
                                <div class="voucher-info">
                                    <div class="fw-bold text-dark small">Giảm @(v.DiscountType == "Percentage" ? v.DiscountValue + "%" : v.DiscountValue.ToString("N0") + "₫")</div>
                                    <div class="text-muted" style="font-size: 11px;">Đơn từ @v.MinOrderValue?.ToString("N0")₫</div>
                                </div>
                                <button class="btn btn-sm btn-outline-danger rounded-pill px-3 py-1 font-weight-bold" onclick="copyVoucher('@v.Code')">Lưu</button>
                            </div>
                        }
                        </div>
                    </div>
                }

                <!-- VARIANTS -->
                <div class="variant-selection mt-4">
                    @if (attributeGroups != null)
                    {
                        foreach (var group in attributeGroups)
                        {
                            <div class="attr-group mb-4">
                                <label class="small fw-bold text-uppercase mb-3 d-block text-muted tracking-wide">CHỌN @group.Key:</label>
                                <div class="d-flex flex-wrap gap-2" data-attr-name="@group.Key">
                                    @foreach (var val in group.Value)
                                    {
                                        <button type="button" class="attr-btn btn btn-outline-dark px-4 py-2 rounded-3 fw-bold" style="font-size: 14px; transition: 0.2s;" onclick="selectAttr('@group.Key', '@val', this)">@val</button>
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>

                <!-- QUANTITY & BUY BUTTONS -->
                <div class="action-section mt-4 pt-4 border-top">
                    <div class="row g-3 align-items-center mb-4">
                        <div class="col-auto">
                            <label class="small fw-bold text-uppercase text-muted d-block mb-2">SỐ LƯỢNG:</label>
                            <div class="qty-wrapper d-flex align-items-center border rounded-pill overflow-hidden shadow-sm" style="width: 130px; height: 48px;">
                                <button type="button" class="qty-minus btn btn-link text-dark text-decoration-none flex-grow-1" onclick="changeQty(-1)"><i class='bx bx-minus'></i></button>
                                <input type="number" id="qty" value="1" min="1" data-max="@Model.StockCount" readonly class="form-control border-0 bg-transparent text-center fw-bold text-dark p-0" style="width: 40px; box-shadow: none;">
                                <button type="button" class="qty-plus btn btn-link text-dark text-decoration-none flex-grow-1" onclick="changeQty(1)"><i class='bx bx-plus'></i></button>
                            </div>
                        </div>
                        <div class="col">
                            <label class="small fw-bold text-uppercase text-muted d-block mb-2">TÌNH TRẠNG:</label>
                            <div id="stockStatus" class="mt-1">
                                @if (Model.IsInStock) {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-2"><i class='bx bxs-check-circle me-1'></i>Còn hàng (@Model.StockCount)</span>
                                } else {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-2"><i class='bx bxs-x-circle me-1'></i>Hết hàng</span>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-sm-6">
                            <button class="btn btn-outline-danger w-100 rounded-pill fw-bold d-flex align-items-center justify-content-center gap-2" style="height: 54px; border-width: 2px;" onclick="addToCart()">
                                <i class='bx bx-cart-add fs-4'></i> THÊM GIỎ HÀNG
                            </button>
                        </div>
                        <div class="col-sm-6">
                            <button class="btn btn-danger w-100 rounded-pill fw-bold shadow-lg" style="height: 54px; background: #E24B4A; border: none;" onclick="buyNow()">MUA NGAY</button>
                        </div>
                    </div>

                    <div class="trust-badges d-flex justify-content-between mt-4 p-3 bg-light rounded-3 border">
                        <div class="text-center small flex-grow-1 border-end"><i class='bx bx-refresh text-danger d-block fs-4 mb-1'></i>7 Ngày đổi trả</div>
                        <div class="text-center small flex-grow-1 border-end"><i class='bx bx-check-shield text-danger d-block fs-4 mb-1'></i>100% Chính hãng</div>
                        <div class="text-center small flex-grow-1"><i class='bx bx-support text-danger d-block fs-4 mb-1'></i>Hỗ trợ 24/7</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. TABS: DESCRIPTION, SPECS, REVIEWS -->
    <div class="product-tabs-wrapper mt-5 pt-4">
        <ul class="nav nav-pills nav-justified mb-0 border-bottom gap-2" id="productTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active rounded-top-4 py-3 fw-bold text-uppercase" id="desc-tab" data-bs-toggle="pill" data-bs-target="#tabDesc" type="button" role="tab">Mô tả sản phẩm</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link rounded-top-4 py-3 fw-bold text-uppercase" id="spec-tab" data-bs-toggle="pill" data-bs-target="#tabSpec" type="button" role="tab">Thông số kỹ thuật</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link rounded-top-4 py-3 fw-bold text-uppercase" id="review-tab" data-bs-toggle="pill" data-bs-target="#tabReview" type="button" role="tab">Đánh giá khách hàng</button>
            </li>
        </ul>
        <div class="tab-content border border-top-0 rounded-bottom-4 p-4 bg-white shadow-sm">
            <!-- DESCRIPTION -->
            <div class="tab-pane fade show active" id="tabDesc" role="tabpanel">
                <div class="rich-content text-dark lh-lg py-3">
                    @Html.Raw(Model.Description)
                </div>
            </div>

            <!-- SPECIFICATIONS -->
            <div class="tab-pane fade" id="tabSpec" role="tabpanel">
                <div class="row justify-content-center py-4">
                    <div class="col-lg-8">
                        <div class="table-responsive">
                            <table class="table table-hover border">
                                <tbody id="specRows">
                                    <tr><td class="bg-light fw-bold text-muted w-25">Thương hiệu</td><td>@Model.BrandName</td></tr>
                                    <tr><td class="bg-light fw-bold text-muted">Danh mục</td><td>@Model.CategoryName</td></tr>
                                    @foreach (var attr in defaultVariant?.VariantAttributeValues ?? new List<MotoShop.Business.DTOs.VariantAttributeDto>())
                                    {
                                        <tr><td class="bg-light fw-bold text-muted">@attr.AttributeName</td><td>@attr.Value</td></tr>
                                    }
                                    <tr><td class="bg-light fw-bold text-muted">Mã SKU</td><td id="specSku">@defaultVariant?.SKU</td></tr>
                                    <tr><td class="bg-light fw-bold text-muted">Tình trạng</td><td id="specStock">@(defaultVariant?.StockQuantity > 0 ? "Còn hàng" : "Hết hàng")</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- REVIEWS (SOCIAL PROOF ENHANCED) -->
            <div class="tab-pane fade" id="tabReview" role="tabpanel">
                <div class="row g-5 py-4">
                    <div class="col-lg-5">
                        <div class="rating-overview text-center p-5 bg-light rounded-4 shadow-sm border">
                            @{
                                var reviewAvg = Model.Reviews.Any() ? Math.Round(Model.Reviews.Average(r => r.Rating), 1) : 0;
                                var reviewCount = Model.Reviews.Count();
                            }
                            <div class="display-1 fw-bold text-danger mb-0">@reviewAvg</div>
                            <div class="text-warning h4 mb-2">
                                @for (int i = 1; i <= 5; i++) { <i class="bi bi-star@(i <= reviewAvg ? "-fill" : (i - 0.5 <= reviewAvg ? "-half" : ""))"></i> }
                            </div>
                            <p class="text-muted fw-bold">(@reviewCount đánh giá từ khách hàng)</p>

                            <div class="mt-4 pt-3 border-top rating-bars">
                                @for (int i = 5; i >= 1; i--)
                                {
                                    var count = Model.Reviews.Count(r => r.Rating == i);
                                    var percent = reviewCount > 0 ? (count * 100 / reviewCount) : 0;
                                    <div class="d-flex align-items-center gap-3 mb-2">
                                        <span class="small fw-bold text-nowrap" style="width: 30px;">@i ★</span>
                                        <div class="progress flex-grow-1" style="height: 10px; border-radius: 10px;">
                                            <div class="progress-bar bg-warning" style="width: @percent%"></div>
                                        </div>
                                        <span class="small text-muted" style="width: 40px;">@count</span>       
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="review-policy mt-4 p-4 border rounded-4 bg-white shadow-sm">
                            <h6 class="fw-bold mb-3"><i class='bx bx-info-circle me-1 text-danger'></i> Quy tắc đánh giá</h6>
                            <ul class="small text-muted ps-3 mb-0">
                                <li class="mb-1">Chỉ những khách hàng đã mua sản phẩm này mới có thể viết đánh giá.</li>
                                <li class="mb-1">Nội dung đánh giá nên lịch sự, tập trung vào trải nghiệm sản phẩm.</li>
                                <li>Hình ảnh thật từ bạn sẽ nhận được nhiều lượt "Hữu ích" hơn.</li>
                            </ul>
                        </div>
                    </div>

                    <div class="col-lg-7">
                        <!-- REVIEW FILTERS -->
                        <div class="d-flex flex-wrap gap-2 mb-4 bg-light p-3 rounded-3 border">
                            <span class="text-muted align-self-center me-2 small fw-bold text-uppercase">Lọc theo:</span>
                            <button class="btn btn-sm btn-white border rounded-pill active px-4 filter-btn" data-filter="all">Tất cả</button>
                            <button class="btn btn-sm btn-white border rounded-pill px-4 filter-btn" data-filter="5">5 Sao</button>
                            <button class="btn btn-sm btn-white border rounded-pill px-4 filter-btn" data-filter="photo"><i class='bx bx-camera me-1'></i> Có ảnh</button>
                        </div>

                        <div id="revList">
                            @if (Model.Reviews.Any()) {
                                foreach (var r in Model.Reviews.OrderByDescending(x => x.CreatedDate))     
                                {
                                    <div class="review-item mb-4 pb-4 border-bottom @(r.Rating == 5 ? "star-5" : "")">
                                        <div class="d-flex align-items-center gap-3 mb-3">
                                            <div class="rev-avatar d-flex align-items-center justify-content-center bg-danger text-white fw-bold rounded-circle" style="width: 48px; height: 48px; font-size: 20px;">
                                                @(!string.IsNullOrEmpty(r.AvatarUrl) ? Html.Raw($"<img src='{r.AvatarUrl}' class='w-100 h-100 object-fit-cover rounded-circle'>") : Html.Raw(r.CustomerName[0].ToString()))
                                            </div>
                                            <div>
                                                <div class="fw-bold text-dark d-flex align-items-center gap-2">
                                                    @r.CustomerName
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle py-1" style="font-size: 10px;"><i class='bx bxs-check-circle'></i> ĐÃ MUA HÀNG</span>
                                                </div>
                                                <div class="text-warning x-small d-flex align-items-center gap-1">
                                                    @for (int i = 1; i <= 5; i++) { <i class="bi bi-star@(i <= r.Rating ? "-fill" : "")"></i> }
                                                    <span class="text-muted ms-2 fw-normal" style="font-size: 12px;">@r.CreatedDate.ToString("dd/MM/yyyy HH:mm")</span>
                                                </div>
                                            </div>
                                        </div>
                                        
                                        <p class="text-dark mb-3" style="line-height: 1.6;">@r.Comment</p>

                                        <!-- REAL REVIEW IMAGES -->
                                        @if (r.ReviewImages != null && r.ReviewImages.Any())
                                        {
                                            <div class="d-flex flex-wrap gap-2 mb-3 customer-photos">
                                                @foreach (var img in r.ReviewImages)
                                                {
                                                    <div class="photo-thumb rounded-3 border shadow-sm shadow-hover overflow-hidden" onclick="openLightbox('@img')" style="width: 100px; height: 100px; cursor: pointer;">
                                                        <img src="@img" class="w-100 h-100 object-fit-cover" alt="Ảnh thực tế từ khách">
                                                    </div>
                                                }
                                            </div>
                                        }

                                        <div class="d-flex align-items-center gap-3 mt-2">
                                            <button class="btn btn-sm btn-link text-decoration-none text-muted p-0 like-btn" style="font-size: 13px;">
                                                <i class='bx bx-like me-1'></i> Hữu ích (0)
                                            </button>
                                            <button class="btn btn-sm btn-link text-decoration-none text-muted p-0" style="font-size: 13px;">
                                                <i class='bx bx-message-square-dots me-1'></i> Trả lời
                                            </button>
                                        </div>
                                    </div>
                                }
                            } else {
                                <div class="text-center py-5 text-muted">
                                    <i class='bx bx-comment-detail display-4 d-block mb-3'></i>
                                    Chưa có đánh giá nào cho sản phẩm này. Hãy là người đầu tiên chia sẻ cảm nhận của bạn!
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- RELATED PRODUCTS -->
    @if (relatedProducts != null && relatedProducts.Any())
    {
    <section class="related-section mt-5 pt-5 border-top">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <h4 class="fw-bold mb-1"><i class='bx bxs-grid-alt me-1 text-danger'></i> SẢN PHẨM TƯƠNG TỰ</h4>
                <p class="text-muted mb-0 small">Các sản phẩm cùng danh mục @Model.CategoryName</p>
            </div>
            <a href="/Product?categoryId=@Model.CategoryId" class="btn btn-outline-danger btn-sm rounded-pill px-4 fw-bold">
                XEM TẤT CẢ <i class='bx bx-chevron-right'></i>
            </a>
        </div>

        <div class="related-products-grid" id="relatedGrid">
            @foreach (var p in relatedProducts)
            {
                @await Html.PartialAsync("_ProductCard", p)
            }
        </div>
    </section>
    }
</main>

<!-- Modal Lightbox -->
<div class="modal fade" id="photoLightbox" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content bg-transparent border-0 text-center position-relative">
            <img id="lightboxImg" src="" class="img-fluid rounded-4 shadow-lg mx-auto border border-secondary">
            <button type="button" class="btn-close btn-close-white position-absolute top-0 end-0 m-3 shadow-lg" data-bs-dismiss="modal"></button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/cart-handler.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        const variants = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Variants.Select(v => new {   
            v.ProductVariantId, v.Price, v.OriginalPrice, v.SKU, v.StockQuantity, v.ImageUrl,
            Attributes = v.VariantAttributeValues.Any() 
                ? v.VariantAttributeValues.Select(av => new { Name = av.AttributeName, Value = av.Value }).ToList()
                : new[] { new { Name = "Phiên bản", Value = v.VariantName } }.ToList()
        }).ToList()));
        const activePromotion = {
            percent: @((ViewBag.PromotionPercent ?? 0).ToString()),
            hasDiscount: @(ViewBag.PromotionPrice != null ? "true" : "false")
        };

        let selected = {};
        let currentVar = null;

        function changeMainImg(url, el) {
            document.getElementById('mainImg').src = url;
            document.querySelectorAll('.thumb-item').forEach(i => i.classList.remove('active', 'border-danger'));
            el.classList.add('active', 'border-danger');
        }

        function selectAttr(name, val, el) {
            el.closest('[data-attr-name]').querySelectorAll('.attr-btn').forEach(b => b.classList.remove('active', 'btn-dark', 'text-white'));
            el.classList.add('active', 'btn-dark', 'text-white');
            selected[name] = val;
            checkVariants();
        }

        function checkVariants() {
            const matched = variants.find(v => v.Attributes.every(a => selected[a.Name] === a.Value));
            if (matched) {
                currentVar = matched;
                document.getElementById('displayPrice').innerText = matched.Price.toLocaleString('vi-VN') + '₫';
                
                let oldPriceEl = document.getElementById('displayOldPrice');
                if(matched.OriginalPrice > matched.Price) {
                    if(!oldPriceEl) {
                        document.querySelector('.price-box .d-flex').insertAdjacentHTML('beforeend', `<del id="displayOldPrice" class="text-muted h5 mb-0 ms-2"></del>`);
                        oldPriceEl = document.getElementById('displayOldPrice');
                    }
                    oldPriceEl.innerText = matched.OriginalPrice.toLocaleString('vi-VN') + '₫';
                } else {
                    oldPriceEl?.remove();
                }

                document.getElementById('displaySku').innerText = matched.SKU;
                document.getElementById('specSku').innerText = matched.SKU;
                document.getElementById('specStock').innerText = matched.StockQuantity > 0 ? 'Còn hàng' : 'Hết hàng';
                document.getElementById('qty').dataset.max = matched.StockQuantity;

                const status = document.getElementById('stockStatus');
                status.innerHTML = matched.StockQuantity > 0
                    ? `<span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-2"><i class='bx bxs-check-circle me-1'></i>Còn hàng (${matched.StockQuantity})</span>`
                    : `<span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-2"><i class='bx bxs-x-circle me-1'></i>Hết hàng</span>`;

                if(matched.ImageUrl) document.getElementById('mainImg').src = matched.ImageUrl;
            }
        }

        function changeQty(delta) {
            const inp = document.getElementById('qty');
            const max = parseInt(inp.dataset.max) || 99;
            let val = parseInt(inp.value) + delta;
            inp.value = Math.max(1, Math.min(val, max));
        }

        function copyVoucher(code) {
            navigator.clipboard.writeText(code);
            Swal.fire({ toast: true, position: 'top-end', timer: 2000, showConfirmButton: false, icon: 'success', title: 'Đã copy mã: ' + code });
        }

        function addToCart() {
            if(!currentVar) {
                Swal.fire('Thông báo', 'Vui lòng chọn đầy đủ thuộc tính', 'info');
                return;
            }
            handleAddToCart(currentVar.ProductVariantId, parseInt(document.getElementById('qty').value));       
        }

        function buyNow() {
            if(!currentVar) {
                Swal.fire('Thông báo', 'Vui lòng chọn đầy đủ thuộc tính', 'info');
                return;
            }
            handleBuyNow(currentVar.ProductVariantId, parseInt(document.getElementById('qty').value));
        }

        // --- NEW FEATURES: SOCIAL PROOF ---
        function openLightbox(src) {
            if(!src) return;
            document.getElementById('lightboxImg').src = src;
            new bootstrap.Modal(document.getElementById('photoLightbox')).show();
        }

        $(document).on('click', '.like-btn', function(e) {
            e.preventDefault();
            const $btn = $(this);
            $btn.toggleClass('liked text-danger');
            let text = $btn.text().trim();
            let count = parseInt(text.match(/\d+/) || [0]);
            if($btn.hasClass('liked')) {
                $btn.html("<i class='bx bxs-like me-1'></i> Hữu ích (" + (count + 1) + ")");
            } else {
                $btn.html("<i class='bx bx-like me-1'></i> Hữu ích (" + (count - 1) + ")");
            }
        });

        $(document).on('click', '.filter-btn', function() {
            $('.filter-btn').removeClass('active btn-danger text-white').addClass('btn-white');
            $(this).addClass('active btn-danger text-white').removeClass('btn-white');
            
            const filter = $(this).data('filter');
            $('.review-item').hide();
            if(filter === 'all') $('.review-item').fadeIn();
            else if (filter === 'photo') $('.customer-photos').closest('.review-item').fadeIn();
            else $('.star-' + filter).fadeIn();
        });

        // Auto Select first variant
        document.addEventListener('DOMContentLoaded', () => {
            const groups = document.querySelectorAll('[data-attr-name]');
            groups.forEach(g => {
                const firstBtn = g.querySelector('.attr-btn');
                if(firstBtn) firstBtn.click();
            });
        });

        async function addToCartQuick(productId, btn) {
            handleAddToCart(null, 1, productId); // Using global cart-handler.js
        }
    </script>

    <style>
        .breadcrumb-wrapper { background: #f8f9fa; border-bottom: 1px solid #eee; }
        .shadow-hover:hover { box-shadow: 0 .5rem 1.5rem rgba(0,0,0,.1) !important; transform: translateY(-2px); transition: 0.3s; }
        .attr-btn:hover { border-color: #E24B4A; color: #E24B4A; }
        .attr-btn.active { border-color: #111; background: #111; color: #fff; }
        .scroll-hide::-webkit-scrollbar { display: none; }
        .nav-pills .nav-link { color: #666; border-radius: 0; border-bottom: 3px solid transparent; }
        .nav-pills .nav-link.active { background: none; color: #E24B4A; border-bottom-color: #E24B4A; }
        .photo-thumb { transition: 0.2s; position: relative; }
        .photo-thumb:hover { transform: scale(1.05); }
        .related-products-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 16px; }
        @@media (max-width: 1200px) { .related-products-grid { grid-template-columns: repeat(4, 1fr); } }
        @@media (max-width: 992px) { .related-products-grid { grid-template-columns: repeat(3, 1fr); } }
        @@media (max-width: 768px) { .related-products-grid { grid-template-columns: repeat(2, 1fr); } }
        .x-small { font-size: 11px; }
        .tracking-wider { letter-spacing: 1px; }
    </style>
}
