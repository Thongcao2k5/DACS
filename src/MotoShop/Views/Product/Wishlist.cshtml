@model IEnumerable<MotoShop.Data.Models.WishlistNew>
@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

@{
    ViewData["Title"] = "Sản phẩm yêu thích";
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="h3 mb-0">Danh sách yêu thích (<span id="wishlistCount">@Model.Count()</span>)</h2>
        @if (Model.Any())
        {
            <div class="d-flex gap-2">
                <button class="btn btn-outline-danger" onclick="clearWishlist()">
                    <i class='bx bx-trash'></i> Xóa toàn bộ
                </button>
            </div>
        }
    </div>

    @if (!Model.Any())
    {
        <div id="emptyWishlist" class="text-center py-5">
            <i class='bx bx-heart display-1 text-muted mb-3'></i>
            <p class="lead">Bạn chưa có sản phẩm yêu thích nào.</p>
            <a href="/Product" class="btn btn-danger rounded-pill px-4 fw-bold">KHÁM PHÁ NGAY</a>
        </div>
    }

    <div class="row g-4" id="wishlistContainer">
        @foreach (var item in Model)
        {
            var product = item.Product;
            if (product == null) continue;
            var variant = product.Variants.FirstOrDefault();
            var primaryImg = product.Images?.FirstOrDefault(i => i.IsPrimary)?.ImageUrl ?? "/assets/img/elements/18.jpg";
            
            <div class="col-6 col-md-4 col-lg-3 wishlist-card" data-product-id="@product.ProductId">
                <div class="card h-100 shadow-sm border-0 product-card rounded-4 overflow-hidden">
                    <div class="position-relative overflow-hidden" style="aspect-ratio: 1/1;">
                        <img src="@primaryImg" 
                             class="card-img-top w-100 h-100 object-fit-cover transition-scale" alt="@product.ProductName"
                             onerror="this.src='/assets/img/elements/18.jpg'">
                        
                        <button class="btn btn-light btn-sm position-absolute top-0 end-0 m-2 rounded-circle shadow-sm btn-remove" 
                                onclick="removeWishlistItem(event, @product.ProductId, this.closest('.wishlist-card'))"
                                title="Xóa khỏi yêu thích">
                            <i class='bx bx-x text-danger fs-4'></i>
                        </button>
                    </div>
                    
                    <div class="card-body p-3 d-flex flex-column text-center">
                        <small class="text-muted text-uppercase">@product.Brand?.BrandName</small>
                        <h5 class="card-title h6 text-truncate mb-2 mt-1" title="@product.ProductName">
                            <a href="/Product/Details?slug=@product.Slug" class="text-decoration-none text-dark fw-bold">@product.ProductName</a>
                        </h5>
                        
                        <div class="mt-auto">
                            @if (variant != null)
                            {
                                <div class="mb-3">
                                    <span class="text-danger fw-bold fs-5">@variant.Price.ToString("N0")đ</span>
                                </div>
                                <button class="btn btn-danger btn-sm w-100 rounded-pill fw-bold py-2" onclick="addToCart(event, @product.ProductId)">
                                    <i class='bx bx-cart-add'></i> THÊM GIỎ
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        async function removeWishlistItem(e, productId, cardElement) {
            if (e) e.preventDefault();
            const res = await fetch('/Wishlist/Remove', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || '' },
                body: JSON.stringify({ productId })
            });
            if ((await res.json()).success) cardElement.remove();
        }
    </script>
}
