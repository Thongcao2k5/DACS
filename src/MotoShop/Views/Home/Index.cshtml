@model MotoShop.Models.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "Trang chủ";
}

<!-- 1. HERO SLIDER -->
<section class="hero-slider-section p-0">
    <div id="heroSlider" class="carousel slide carousel-fade"
         data-bs-ride="carousel" data-bs-pause="hover" data-bs-interval="4000">

        <div class="carousel-indicators">
            <button type="button" data-bs-target="#heroSlider" data-bs-slide-to="0" class="active" aria-current="true"></button>
            <button type="button" data-bs-target="#heroSlider" data-bs-slide-to="1"></button>
            <button type="button" data-bs-target="#heroSlider" data-bs-slide-to="2"></button>
        </div>

        <div class="carousel-inner">
            <div class="carousel-item active">
                <div class="hero-slide-bg" style="background-image:url('https://images.unsplash.com/photo-1558981403-c5f9899a28bc?w=1600&q=80')">
                    <div class="hero-slide-overlay"></div>
                    <div class="container h-100 d-flex align-items-center">
                        <div class="hero-slide-content">
                            <span class="hero-slide-badge">NEW ARRIVAL 2026</span>
                            <h1 class="hero-slide-title">PHỤ TÙNG XE MÁY<br><span class="hero-slide-accent">CHÍNH HÃNG</span></h1>
                            <p class="hero-slide-desc">Chất lượng vượt trội cho xế yêu của bạn. Nhập khẩu trực tiếp từ Nhật Bản, Ý và Thái Lan.</p>
                            <div class="hero-slide-ctas">
                                <a asp-controller="Product" asp-action="Index" class="btn-hero-slide-primary">MUA NGAY</a>
                                <a asp-controller="Product" asp-action="Index" class="btn-hero-slide-outline">XEM DANH MỤC</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="carousel-item">
                <div class="hero-slide-bg" style="background-image:url('https://images.unsplash.com/photo-1449426468159-d96dbf08f19f?w=1600&q=80')">
                    <div class="hero-slide-overlay"></div>
                    <div class="container h-100 d-flex align-items-center">
                        <div class="hero-slide-content">
                            <span class="hero-slide-badge">SIÊU ƯU ĐÃI</span>
                            <h1 class="hero-slide-title">BẢO DƯỠNG TRỌN GÓI<br><span class="hero-slide-accent">TIẾT KIỆM 30%</span></h1>
                            <p class="hero-slide-desc">Combo phụ tùng nồi – lọc gió – bugi cho mọi dòng xe tay ga. Duy nhất trong tháng.</p>
                            <div class="hero-slide-ctas">
                                <a asp-controller="Product" asp-action="Index" class="btn-hero-slide-primary">XEM SẢN PHẨM</a>
                                <a asp-controller="Service" asp-action="Index" class="btn-hero-slide-outline">ĐẶT LỊCH BẢO DƯỠNG</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="carousel-item">
                <div class="hero-slide-bg" style="background-image:url('/assets/img/elements/18.jpg');background-color:#1a202c;">
                    <div class="hero-slide-overlay"></div>
                    <div class="container h-100 d-flex align-items-center">
                        <div class="hero-slide-content">
                            <span class="hero-slide-badge">FLASH SALE</span>
                            <h1 class="hero-slide-title">GIÁ TỐT NHẤT<br><span class="hero-slide-accent">MỖI NGÀY</span></h1>
                            <p class="hero-slide-desc">Hàng ngàn sản phẩm chính hãng giảm giá sâu mỗi ngày. Đừng bỏ lỡ!</p>
                            <div class="hero-slide-ctas">
                                <a asp-controller="Product" asp-action="Index" asp-route-sortBy="sale" class="btn-hero-slide-primary">XEM FLASH SALE</a>
                                <a asp-controller="Product" asp-action="Index" class="btn-hero-slide-outline">TẤT CẢ SẢN PHẨM</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <button class="carousel-control-prev" type="button" data-bs-target="#heroSlider" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#heroSlider" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
        </button>
    </div>
</section>

<!-- 2. CATEGORY QUICK ACCESS -->
<section class="bg-white">
    <div class="container">
        <div class="section-title-wrapper text-center">
            <h2 class="section-title center text-uppercase">Danh mục nổi bật</h2>
        </div>
        <div class="cat-row">
            @if (Model.TopCategories != null)
            {
                foreach (var cat in Model.TopCategories)
                {
                    string catName = cat.CategoryName.ToUpper();
                    string iconClass = catName.Contains("NHỚT") || catName.Contains("DẦU") ? "bxs-droplet"
                                     : catName.Contains("PHANH") || catName.Contains("CHÂN") ? "bxs-stop-circle"
                                     : catName.Contains("LỐP") || catName.Contains("VỎ") ? "bxs-rotate-right"
                                     : catName.Contains("ẮC QUY") || catName.Contains("BÌNH") ? "bxs-battery-charging"
                                     : catName.Contains("ĐỒ CHƠI") || catName.Contains("ĐÈN") ? "bxs-bolt"
                                     : catName.Contains("GIẢM XÓC") ? "bxs-equalizer"
                                     : catName.Contains("ĐIỆN") ? "bxs-plug"
                                     : catName.Contains("BẢO DƯỠNG") ? "bxs-wrench"
                                     : "bxs-cog";
                    string gradient = catName.Contains("NHỚT") || catName.Contains("DẦU")
                                     ? "linear-gradient(135deg,#ff6b6b,#e53e3e)"
                                     : catName.Contains("LỐP") || catName.Contains("VỎ")
                                     ? "linear-gradient(135deg,#51cf66,#16a34a)"
                                     : catName.Contains("PHANH") || catName.Contains("CHÂN")
                                     ? "linear-gradient(135deg,#339af0,#1d4ed8)"
                                     : catName.Contains("ẮC QUY") || catName.Contains("BÌNH")
                                     ? "linear-gradient(135deg,#cc5de8,#7c3aed)"
                                     : catName.Contains("BẢO DƯỠNG")
                                     ? "linear-gradient(135deg,#ffa94d,#f59e0b)"
                                     : "linear-gradient(135deg,#868e96,#495057)";
                    <a asp-controller="Product" asp-action="Index" asp-route-categoryId="@cat.CategoryId"
                       class="cat-item text-decoration-none">
                        <div class="cat-circle" style="background:@gradient;">
                            <i class='bx @iconClass'></i>
                        </div>
                        <div class="cat-name">@cat.CategoryName</div>
                        <div class="cat-count">@cat.ProductCount sản phẩm</div>
                    </a>
                }
            }
            <a asp-controller="Product" asp-action="Index" class="cat-item text-decoration-none">
                <div class="cat-circle" style="background:linear-gradient(135deg,#868e96,#495057);">
                    <i class='bx bxs-grid'></i>
                </div>
                <div class="cat-name">Tất cả</div>
                <div class="cat-count">Xem thêm</div>
            </a>
        </div>
    </div>
</section>

<!-- 3. PROMO BANNERS — Pure CSS, no images -->
<section class="py-4 bg-light">
    <div class="container">
        <div class="row g-4">
            <div class="col-md-6">
                <div class="promo-card-v2 promo-red-v2">
                    <span class="promo-tag-v2">ƯU ĐÃI HOT</span>
                    <h3>ƯU ĐÃI THÁNG 5</h3>
                    <p>Giảm ngay 200k cho đơn hàng bảo dưỡng trọn gói. Áp dụng đến hết tháng.</p>
                    <a asp-controller="Product" asp-action="Promotion" class="btn-promo-white">NHẬN ƯU ĐÃI</a>
                </div>
            </div>
            <div class="col-md-6">
                <div class="promo-card-v2 promo-dark-v2">
                    <span class="promo-tag-v2">MIỄN PHÍ</span>
                    <h3>FREE SHIPPING</h3>
                    <p>Miễn phí vận chuyển toàn quốc cho mọi đơn hàng phụ tùng trên 500k.</p>
                    <a asp-controller="Info" asp-action="ShippingPolicy" class="btn-promo-white">XEM CHI TIẾT</a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- 4. FEATURED PRODUCTS -->
<section class="bg-white">
    <div class="container">
        <div class="section-title-wrapper d-flex justify-content-between align-items-end">
            <div>
                <h2 class="section-title text-uppercase">Sản phẩm nổi bật</h2>
            </div>
            <a asp-controller="Product" asp-action="Index" class="text-danger fw-bold text-decoration-none">Xem thêm <i class='bx bx-right-arrow-alt'></i></a>
        </div>
        <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-3" id="featuredProducts">
            @if (Model.FeaturedProducts != null && Model.FeaturedProducts.Any())
            {
                foreach (var product in Model.FeaturedProducts)
                {
                    <div class="col">@await Html.PartialAsync("_ProductCard", product)</div>
                }
            }
        </div>
    </div>
</section>

<!-- 5. BEST SELLING PRODUCTS -->
<section class="bg-light">
    <div class="container">
        <div class="section-title-wrapper d-flex justify-content-between align-items-end">
            <div>
                <h2 class="section-title text-uppercase">Sản phẩm bán chạy</h2>
            </div>
