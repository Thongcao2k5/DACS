<!-- 6. BRAND SHOWCASE -->
<section class="bg-white brand-section">
    <div class="container">
        <div class="section-title-wrapper text-center">
            <h5 class="text-muted text-uppercase mb-4">Thương hiệu đồng hành</h5>
        </div>
        <div class="row align-items-center justify-content-center g-4">
            <div class="col-4 col-md-2 brand-item text-center">
                <img src="~/assets/img/brand/honda.png" alt="Honda" class="brand-logo-img" asp-append-version="true">
            </div>
            <div class="col-4 col-md-2 brand-item text-center">
                <img src="~/assets/img/brand/yamaha.png" alt="Yamaha" class="brand-logo-img" asp-append-version="true">
            </div>
            <div class="col-4 col-md-2 brand-item text-center">
                <img src="~/assets/img/brand/mortul.png" alt="Motul" class="brand-logo-img" asp-append-version="true">
            </div>
            <div class="col-4 col-md-2 brand-item text-center">
                <img src="~/assets/img/brand/brembo.png" alt="Brembo" class="brand-logo-img" asp-append-version="true">
            </div>
            <div class="col-4 col-md-2 brand-item text-center">
                <img src="~/assets/img/brand/michelin.png" alt="Michelin" class="brand-logo-img" asp-append-version="true">
            </div>
            <div class="col-4 col-md-2 brand-item text-center">
                <img src="~/assets/img/brand/ohlins.png" alt="Ohlins" class="brand-logo-img" asp-append-version="true">
            </div>
        </div>
    </div>
</section>

<style>
    /* Brand section layout */
    .brand-section { padding-top: 24px !important; padding-bottom: 24px !important; }
    .brand-section h5 {
        font-size: 13px;
        letter-spacing: 2px;
        color: #9ca3af;
        text-align: center;
        margin-bottom: 20px !important;
        font-weight: 600;
    }
    /* Logo — trạng thái bình thường */
    .brand-logo-img {
        max-width: 100%;
        max-height: 70px;
        object-fit: contain;
        filter: grayscale(30%);
        opacity: 0.75;
        transition: filter 0.2s ease, opacity 0.2s ease, transform 0.2s ease;
    }
    /* Logo — hover */
    .brand-item:hover .brand-logo-img {
        filter: grayscale(0%);
        opacity: 1;
        transform: scale(1.05);
    }
</style>

