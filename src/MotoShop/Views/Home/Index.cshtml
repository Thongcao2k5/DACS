@model MotoShop.Models.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "Trang chủ";
}

<!-- 1. HERO BANNER -->
<section class="hero-section p-0">
    <div id="heroSlider" class="carousel slide carousel-fade" data-bs-ride="carousel">
        <div class="carousel-inner">
            <div class="carousel-item active">
                <img src="https://images.unsplash.com/photo-1558981403-c5f9899a28bc?w=1600" class="d-block w-100" style="height: 550px; object-fit: cover;" alt="Banner">
                <div class="carousel-caption d-flex align-items-center h-100 text-start" style="left: 10%; right: 10%;">
                    <div class="col-lg-6">
                        <h1 class="display-3 fw-bold text-white mb-3">PHỤ TÙNG XE MÁY<br><span class="text-danger">CHÍNH HÃNG</span></h1>
                        <p class="fs-5 mb-4 text-white-50">Chất lượng vượt trội cho xế yêu của bạn. Nhập khẩu trực tiếp từ Nhật Bản, Ý và Thái Lan.</p>
                        <a href="/Product" class="btn btn-danger btn-lg rounded-pill px-5 fw-bold">MUA NGAY</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- 2. CATEGORY QUICK ACCESS -->
<section class="py-5 bg-white">
    <div class="container text-center">
        <h2 class="fw-bold mb-5 text-uppercase">Danh mục nổi bật</h2>
        <div class="row row-cols-2 row-cols-md-3 row-cols-lg-6 g-4">
            @if (Model.TopCategories != null) {
                foreach (var cat in Model.TopCategories) {
                    <div class="col">
                        <a href="/Product?categoryId=@cat.CategoryId" class="text-decoration-none text-dark">
                            <div class="bg-light rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 100px; height: 100px;">
                                <i class='bx bxs-component fs-1 text-danger'></i>
                            </div>
                            <span class="fw-bold d-block">@cat.CategoryName</span>
                        </a>
                    </div>
                }
            }
        </div>
    </div>
</section>

<!-- 4. FEATURED PRODUCTS -->
<section class="py-5 bg-light">
    <div class="container">
        <div class="d-flex justify-content-between align-items-end mb-4">
            <h2 class="fw-bold mb-0 text-uppercase">Sản phẩm nổi bật</h2>
            <a href="/Product" class="text-danger fw-bold text-decoration-none">Xem tất cả <i class='bx bx-right-arrow-alt'></i></a>
        </div>
        <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-4">
            @if (Model.FeaturedProducts != null) {
                foreach (var p in Model.FeaturedProducts) {
                    <div class="col">
                        <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden position-relative product-card">
                            <div class="position-relative overflow-hidden" style="aspect-ratio: 1/1;">
                                <a asp-controller="Product" asp-action="Details" asp-route-slug="@p.Slug" class="d-block h-100">
                                    <img src="@(string.IsNullOrEmpty(p.PrimaryImageUrl) ? "/assets/img/elements/no-image.png" : p.PrimaryImageUrl)" 
                                         class="w-100 h-100 object-fit-cover transition-scale" 
                                         onerror="this.src='/assets/img/elements/no-image.png'"
                                         loading="lazy">
                                </a>
                                <button type="button" class="btn-wishlist-abs" onclick="addToWishlist(@p.ProductId)"><i class='bx bx-heart'></i></button>
                            </div>
                            <div class="card-body p-3 text-center d-flex flex-column">
                                <small class="text-muted text-uppercase">@p.BrandName</small>
                                <h6 class="fw-bold my-2 flex-grow-1">@p.ProductName</h6>
                                <div class="text-danger fw-bold fs-5 mb-3">@p.MinPrice.ToString("N0")đ</div>
                                <button class="btn btn-danger rounded-pill w-100 fw-bold py-2" onclick="handleAddToCart(@p.DefaultVariantId)">
                                    <i class='bx bx-cart-add'></i> THÊM VÀO GIỎ
                                </button>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</section>

<!-- 5. BEST SELLING -->
<section class="py-5 bg-white">
    <div class="container">
        <div class="d-flex justify-content-between align-items-end mb-4">
            <h2 class="fw-bold mb-0 text-uppercase">Sản phẩm bán chạy</h2>
        </div>
        <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-4">
            @if (Model.BestSellingProducts != null) {
                foreach (var p in Model.BestSellingProducts) {
                    <div class="col">
                        <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden position-relative product-card">
                            <div class="position-relative overflow-hidden" style="aspect-ratio: 1/1;">
                                <a asp-controller="Product" asp-action="Details" asp-route-slug="@p.Slug" class="d-block h-100">
                                    <img src="@(string.IsNullOrEmpty(p.PrimaryImageUrl) ? "/assets/img/elements/no-image.png" : p.PrimaryImageUrl)" 
                                         class="w-100 h-100 object-fit-cover transition-scale" 
                                         onerror="this.src='/assets/img/elements/no-image.png'"
                                         loading="lazy">
                                </a>
                                <button type="button" class="btn-wishlist-abs" onclick="addToWishlist(@p.ProductId)"><i class='bx bx-heart'></i></button>
                            </div>
                            <div class="card-body p-3 text-center d-flex flex-column">
                                <small class="text-muted">@p.BrandName</small>
                                <h6 class="fw-bold my-2 flex-grow-1">@p.ProductName</h6>
                                <div class="text-danger fw-bold fs-5 mb-3">@p.MinPrice.ToString("N0")đ</div>
                                <button class="btn btn-danger rounded-pill w-100 fw-bold py-2" onclick="handleAddToCart(@p.DefaultVariantId)">
                                    <i class='bx bx-cart-add'></i> THÊM VÀO GIỎ
                                </button>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/cart-handler.js"></script>
}
<style>
    .product-card { transition: all 0.3s; }
    .product-card:hover { transform: translateY(-10px); }
    .transition-scale { transition: transform 0.5s; }
    .product-card:hover .transition-scale { transform: scale(1.1); }
</style>
