<!-- 9. BLOG / NEWS -->
@{
    var recentBlogs = ViewBag.RecentBlogs as List<MotoShop.Data.Models.Blog> ?? new List<MotoShop.Data.Models.Blog>();
}
<section class="bg-light">
    <div class="container">
        <div class="section-title-wrapper text-center">
            <h2 class="section-title center text-uppercase">Tin tức & Kinh nghiệm</h2>
        </div>
        <div class="row g-4">
            @foreach (var blog in recentBlogs)
            {
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100">
                        <img src="@(blog.Thumbnail ?? "https://images.unsplash.com/photo-1558981403-c5f9899a28bc?w=600")"
                             class="card-img-top" alt="@blog.Title" style="height:200px;object-fit:cover;">
                        <div class="card-body p-4">
                            <span class="text-danger small fw-bold">@blog.CreatedDate.ToString("dd/MM/yyyy")</span>
                            <h5 class="fw-bold mt-2">@blog.Title</h5>
                            <a asp-controller="Blog" asp-action="Detail" asp-route-slug="@blog.Slug"
                               class="text-danger fw-bold text-decoration-none small">ĐỌC TIẾP <i class='bx bx-right-arrow-alt'></i></a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- 10. NEWSLETTER SUBSCRIPTION -->
<section class="newsletter-section text-center">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-7">
                <h2 class="fw-bold mb-3">NHẬN THÔNG TIN KHUYẾN MÃI</h2>
                <p class="mb-5 opacity-75">Đăng ký email để nhận ngay các thông tin về sản phẩm mới và các chương trình ưu đãi đặc biệt sớm nhất từ MOTO SHOP.</p>
                <form id="newsletterForm" class="news-input-group d-flex">
                    <input type="email" id="newsEmail" class="form-control" placeholder="Nhập địa chỉ email của bạn..." required>
                    <button type="submit" id="btnSubscribe" class="btn btn-subscribe">ĐĂNG KÝ</button>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        document.getElementById('newsletterForm')?.addEventListener('submit', async function(e) {
            e.preventDefault();
            const email = document.getElementById('newsEmail').value;
            const btn = document.getElementById('btnSubscribe');
            const originalText = btn.innerText;

            if (!email) return;

            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> ĐANG XỬ LÝ...';

            try {
                const response = await fetch('/Newsletter/Subscribe', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: `email=${encodeURIComponent(email)}`
                });
                
                const data = await response.json();
                
                if (data.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Thành công!',
                        text: data.message,
                        confirmButtonColor: '#E24B4A'
                    });
                    document.getElementById('newsEmail').value = '';
                } else {
                    Swal.fire({
                        icon: 'info',
                        title: 'Thông báo',
                        text: data.message,
                        confirmButtonColor: '#E24B4A'
                    });
                }
            } catch (error) {
                Swal.fire('Lỗi', 'Không thể kết nối đến máy chủ.', 'error');
            } finally {
                btn.disabled = false;
                btn.innerText = originalText;
            }
        });

    </script>
}
