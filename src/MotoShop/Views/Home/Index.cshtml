@model MotoShop.Models.ViewModels.HomeViewModel
@using MotoShop.Data.Models
@{
    var productUsages = ViewBag.ProductUsages as List<ProductUsage> ?? new List<ProductUsage>();
    ViewData["Title"] = "Trang chủ";
}

@{
    var flashSale = ViewBag.ActiveFlashSale as MotoShop.Data.Models.Promotion;
    var flashProducts = ViewBag.FlashSaleProducts as List<MotoShop.Business.DTOs.ProductDto>;
    var flashDiscountLabel = flashSale?.DiscountType == MotoShop.Data.Enums.DiscountType.Percent
        ? $"-{flashSale.DiscountValue:0}%"
        : $"-{flashSale?.DiscountValue.ToString("N0")}đ";
}
@if (flashSale != null)
{
<div class="popup-overlay" id="eventPopup">
  <div class="popup-box">
    <button class="popup-close" onclick="closePopup()"><i class='bx bx-x'></i></button>

    <div class="popup-header">
      <div class="popup-badges">
        <span class="popup-badge-live"><i class='bx bx-radio-circle-marked'></i> ĐANG DIỄN RA</span>
        <span class="popup-badge-type"><i class='bx bx-flame'></i> FLASH SALE</span>
      </div>
      <div class="popup-discount">@flashDiscountLabel</div>
      <div class="popup-title">@flashSale.Name</div>
      <div class="popup-subtitle">Kết thúc lúc @flashSale.EndDate.ToString("HH:mm dd/MM/yyyy")</div>
    </div>

    <div class="popup-countdown">
      <div class="popup-cd-label"><i class='bx bx-time'></i> Kết thúc sau</div>
      <div class="popup-cd-items">
        <div class="popup-cd-box" id="cdHours">00</div>
        <div class="popup-cd-sep">:</div>
        <div class="popup-cd-box" id="cdMinutes">00</div>
        <div class="popup-cd-sep">:</div>
        <div class="popup-cd-box" id="cdSeconds">00</div>
      </div>
    </div>

    @if (flashProducts != null && flashProducts.Any())
    {
    <div class="popup-products">
      <div class="popup-products-label">Sản phẩm đang giảm giá</div>
      <div class="popup-products-grid">
        @foreach (var p in flashProducts.Take(4))
        {
          <a href="/Product/Details?slug=@p.Slug" class="popup-prod-item">
            <div class="popup-prod-img">
              <img src="@p.PrimaryImageUrl" alt="@p.ProductName"
                   onerror="this.src='/images/placeholder.jpg'" />
              <span class="popup-prod-pct">@flashDiscountLabel</span>
            </div>
            <div class="popup-prod-info">
              <div class="popup-prod-name">@p.ProductName</div>
              <div class="popup-prod-price">@((p.FlashSalePrice ?? p.MinPrice).ToString("N0"))đ</div>
              <div class="popup-prod-old">@((p.MinOriginalPrice ?? p.MinPrice).ToString("N0"))đ</div>
            </div>
          </a>
        }
      </div>
    </div>
    }

    <div class="popup-actions">
      <a href="/Product/Promotion" class="popup-btn-main">
        <i class='bx bx-bolt-circle'></i> Xem tất cả ưu đãi
      </a>
      <button class="popup-btn-skip" onclick="closePopup()">Để sau</button>
    </div>
  </div>
</div>
<script>
(function() {
    setTimeout(() => {
        const el = document.getElementById('eventPopup');
        if (el) el.style.display = 'flex';
    }, 800);
})();
function closePopup() {
    const el = document.getElementById('eventPopup');
    if (el) el.style.display = 'none';
}
const endDate = new Date('@flashSale.EndDate.ToString("yyyy-MM-ddTHH:mm:ss")');
function tick() {
    const diff = endDate - new Date();
    if (diff <= 0) {
        ['cdHours','cdMinutes','cdSeconds'].forEach(id => {
            document.getElementById(id).textContent = '00';
        });
        return;
    }
    const h = Math.floor(diff / 3600000);
    const m = Math.floor((diff % 3600000) / 60000);
    const s = Math.floor((diff % 60000) / 1000);
    document.getElementById('cdHours').textContent   = String(h).padStart(2,'0');
    document.getElementById('cdMinutes').textContent = String(m).padStart(2,'0');
    document.getElementById('cdSeconds').textContent = String(s).padStart(2,'0');
}
tick();
setInterval(tick, 1000);
</script>
}

<!-- 1. HERO SLIDER -->
@{
    var sliders = ViewBag.Sliders as List<MotoShop.Data.Models.Slider> ?? new List<MotoShop.Data.Models.Slider>();
}
<section class="hero-slider-section p-0">
    <div id="heroSlider" class="carousel slide carousel-fade"
         data-bs-ride="carousel" data-bs-pause="hover" data-bs-interval="4000">

        <div class="carousel-indicators">
            @for (int i = 0; i < sliders.Count; i++)
            {
                if (i == 0)
                {
                    <button type="button" data-bs-target="#heroSlider" data-bs-slide-to="@i" class="active" aria-current="true"></button>
                }
                else
                {
                    <button type="button" data-bs-target="#heroSlider" data-bs-slide-to="@i"></button>
                }
            }
        </div>

        <div class="carousel-inner">
            @if (sliders.Any())
            {
                for (int i = 0; i < sliders.Count; i++)
                {
                    var s = sliders[i];
                    <div class="carousel-item @(i == 0 ? "active" : "")">
                        <div class="hero-slide-bg" style="background-image:url('@s.ImageUrl')">
                            <div class="hero-slide-overlay"></div>
                            <div class="container h-100 d-flex align-items-center">
                                <div class="hero-slide-content">
                                    @if (!string.IsNullOrEmpty(s.Title))
                                    {
                                        <h1 class="hero-slide-title">@s.Title</h1>
                                    }
                                    @if (!string.IsNullOrEmpty(s.LinkUrl))
                                    {
                                        <div class="hero-slide-ctas">
                                            <a href="@s.LinkUrl" class="btn-hero-slide-primary">XEM NGAY</a>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="carousel-item active">
                    <div class="hero-slide-bg" style="background-image:url('https://images.unsplash.com/photo-1558981403-c5f9899a28bc?w=1600&q=80')">
                        <div class="hero-slide-overlay"></div>
                    </div>
                </div>
            }
        </div>

        <button class="carousel-control-prev" type="button" data-bs-target="#heroSlider" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#heroSlider" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
        </button>
    </div>
</section>

<!-- 2. CATEGORY QUICK ACCESS -->
<section class="bg-white home-category-section">
    <div class="container">
        <div class="section-title-wrapper text-center">
            <h2 class="section-title center text-uppercase home-category-title">Danh mục nổi bật</h2>
        </div>
        <div class="cat-row">
            @if (Model.TopCategories != null)
            {
                foreach (var cat in Model.TopCategories)
                {
                    string catName = cat.CategoryName.ToUpper();
                    string iconClass = catName.Contains("NHỚT") || catName.Contains("DẦU") ? "fa-oil-can"
                                     : catName.Contains("PHANH") || catName.Contains("CHÂN") ? "fa-circle-stop"
                                     : catName.Contains("LỐP") || catName.Contains("VỎ") ? "fa-record-vinyl"
                                     : catName.Contains("ẮC QUY") || catName.Contains("BÌNH") ? "fa-battery-full"
                                     : catName.Contains("ĐỒ CHƠI") || catName.Contains("ĐÈN") ? "fa-lightbulb"
                                     : catName.Contains("GIẢM XÓC") ? "fa-sliders"
                                     : catName.Contains("PHỤ TÙNG") || catName.Contains("PHỤ KIỆN") ? "fa-gear"
                                     : catName.Contains("ĐIỆN") ? "fa-plug"
                                     : catName.Contains("BẢO DƯỠNG") ? "fa-wrench"
                                     : "fa-gear";
                    string gradient = catName.Contains("NHỚT") || catName.Contains("DẦU")
                                     ? "linear-gradient(135deg,#ff6b6b,#e53e3e)"
                                     : catName.Contains("LỐP") || catName.Contains("VỎ")
                                     ? "linear-gradient(135deg,#51cf66,#16a34a)"
                                     : catName.Contains("PHANH") || catName.Contains("CHÂN")
                                     ? "linear-gradient(135deg,#339af0,#1d4ed8)"
                                     : catName.Contains("ẮC QUY") || catName.Contains("BÌNH")
                                     ? "linear-gradient(135deg,#cc5de8,#7c3aed)"
                                     : catName.Contains("BẢO DƯỠNG")
                                     ? "linear-gradient(135deg,#ffa94d,#f59e0b)"
                                     : "linear-gradient(135deg,#868e96,#495057)";
                    <a asp-controller="Product" asp-action="Index" asp-route-categoryId="@cat.CategoryId"
                       class="cat-item text-decoration-none">
                        <div class="cat-circle" style="background:@gradient;">
                            <i class="fa-solid @iconClass"></i>
                        </div>
                        <div class="cat-name">@cat.CategoryName</div>
                        <div class="cat-count">@cat.ProductCount sản phẩm</div>
                    </a>
                }
            }
            <a asp-controller="Product" asp-action="Index" class="cat-item text-decoration-none">
                <div class="cat-circle" style="background:linear-gradient(135deg,#868e96,#495057);">
                    <i class="fa-solid fa-grip"></i>
                </div>
                <div class="cat-name">Tất cả</div>
                <div class="cat-count">Xem thêm</div>
            </a>
        </div>
    </div>
</section>

