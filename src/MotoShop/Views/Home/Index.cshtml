<style>
    /* Brand section layout */
    .brand-section { padding-top: 24px !important; padding-bottom: 24px !important; }
    .brand-section h5 {
        font-size: 13px;
        letter-spacing: 2px;
        color: #9ca3af;
        text-align: center;
        margin-bottom: 20px !important;
        font-weight: 600;
    }
    /* Logo — trạng thái bình thường */
    .brand-logo-img {
        max-width: 100%;
        max-height: 70px;
        object-fit: contain;
        filter: grayscale(30%);
        opacity: 0.75;
        transition: filter 0.2s ease, opacity 0.2s ease, transform 0.2s ease;
    }
    /* Logo — hover */
    .brand-item:hover .brand-logo-img {
        filter: grayscale(0%);
        opacity: 1;
        transform: scale(1.05);
    }
    .usage-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 12px;
    }
    .usage-card {
        display: flex;
        align-items: center;
        gap: 10px;
        min-height: 56px;
        padding: 12px 14px;
        border: 1px solid #edf0f4;
        border-radius: 8px;
        background: #fff;
        color: #2b2c40;
        font-weight: 700;
        box-shadow: 0 8px 22px rgba(67, 89, 113, 0.06);
        transition: transform .15s ease, border-color .15s ease;
    }
    .usage-card:hover {
        transform: translateY(-2px);
        border-color: #ea3943;
        color: #ea3943;
    }
    .usage-icon {
        width: 32px;
        height: 32px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #fff0f1;
