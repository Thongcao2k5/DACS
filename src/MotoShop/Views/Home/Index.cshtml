@model MotoShop.Models.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "Trang chủ";
}

<!-- 1. HERO SLIDER -->
@{
    var sliders = ViewBag.Sliders as List<MotoShop.Data.Models.Slider> ?? new List<MotoShop.Data.Models.Slider>();
}
<section class="hero-slider-section p-0">
    <div id="heroSlider" class="carousel slide carousel-fade"
         data-bs-ride="carousel" data-bs-pause="hover" data-bs-interval="4000">

        <div class="carousel-indicators">
            @for (int i = 0; i < sliders.Count; i++)
            {
                if (i == 0)
                {
                    <button type="button" data-bs-target="#heroSlider" data-bs-slide-to="@i" class="active" aria-current="true"></button>
                }
                else
                {
                    <button type="button" data-bs-target="#heroSlider" data-bs-slide-to="@i"></button>
                }
            }
        </div>

        <div class="carousel-inner">
            @if (sliders.Any())
            {
                for (int i = 0; i < sliders.Count; i++)
                {
                    var s = sliders[i];
                    <div class="carousel-item @(i == 0 ? "active" : "")">
                        <div class="hero-slide-bg" style="background-image:url('@s.ImageUrl')">
                            <div class="hero-slide-overlay"></div>
                            <div class="container h-100 d-flex align-items-center">
                                <div class="hero-slide-content">
                                    @if (!string.IsNullOrEmpty(s.Title))
                                    {
                                        <h1 class="hero-slide-title">@s.Title</h1>
                                    }
                                    @if (!string.IsNullOrEmpty(s.LinkUrl))
                                    {
                                        <div class="hero-slide-ctas">
                                            <a href="@s.LinkUrl" class="btn-hero-slide-primary">XEM NGAY</a>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="carousel-item active">
                    <div class="hero-slide-bg" style="background-image:url('https://images.unsplash.com/photo-1558981403-c5f9899a28bc?w=1600&q=80')">
                        <div class="hero-slide-overlay"></div>
                    </div>
                </div>
            }
        </div>

        <button class="carousel-control-prev" type="button" data-bs-target="#heroSlider" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#heroSlider" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
        </button>
    </div>
</section>

<!-- 2. CATEGORY QUICK ACCESS -->
<section class="bg-white">
    <div class="container">
        <div class="section-title-wrapper text-center">
            <h2 class="section-title center text-uppercase">Danh mục nổi bật</h2>
        </div>
        <div class="cat-row">
            @if (Model.TopCategories != null)
            {
                foreach (var cat in Model.TopCategories)
                {
                    string catName = cat.CategoryName.ToUpper();
                    string iconClass = catName.Contains("NHỚT") || catName.Contains("DẦU") ? "fa-oil-can"
                                     : catName.Contains("PHANH") || catName.Contains("CHÂN") ? "fa-circle-stop"
                                     : catName.Contains("LỐP") || catName.Contains("VỎ") ? "fa-record-vinyl"
                                     : catName.Contains("ẮC QUY") || catName.Contains("BÌNH") ? "fa-battery-full"
                                     : catName.Contains("ĐỒ CHƠI") || catName.Contains("ĐÈN") ? "fa-lightbulb"
                                     : catName.Contains("GIẢM XÓC") ? "fa-sliders"
                                     : catName.Contains("PHỤ TÙNG") || catName.Contains("PHỤ KIỆN") ? "fa-gear"
                                     : catName.Contains("ĐIỆN") ? "fa-plug"
                                     : catName.Contains("BẢO DƯỠNG") ? "fa-wrench"
                                     : "fa-gear";
                    string gradient = catName.Contains("NHỚT") || catName.Contains("DẦU")
                                     ? "linear-gradient(135deg,#ff6b6b,#e53e3e)"
                                     : catName.Contains("LỐP") || catName.Contains("VỎ")
                                     ? "linear-gradient(135deg,#51cf66,#16a34a)"
                                     : catName.Contains("PHANH") || catName.Contains("CHÂN")
                                     ? "linear-gradient(135deg,#339af0,#1d4ed8)"
                                     : catName.Contains("ẮC QUY") || catName.Contains("BÌNH")
                                     ? "linear-gradient(135deg,#cc5de8,#7c3aed)"
                                     : catName.Contains("BẢO DƯỠNG")
                                     ? "linear-gradient(135deg,#ffa94d,#f59e0b)"
                                     : "linear-gradient(135deg,#868e96,#495057)";
                    <a asp-controller="Product" asp-action="Index" asp-route-categoryId="@cat.CategoryId"
                       class="cat-item text-decoration-none">
                        <div class="cat-circle" style="background:@gradient;">
                            <i class="fa-solid @iconClass"></i>
                        </div>
                        <div class="cat-name">@cat.CategoryName</div>
                        <div class="cat-count">@cat.ProductCount sản phẩm</div>
                    </a>
                }
            }
            <a asp-controller="Product" asp-action="Index" class="cat-item text-decoration-none">
                <div class="cat-circle" style="background:linear-gradient(135deg,#868e96,#495057);">
                    <i class="fa-solid fa-grip"></i>
                </div>
                <div class="cat-name">Tất cả</div>
                <div class="cat-count">Xem thêm</div>
            </a>
        </div>
    </div>
</section>

<!-- 3. BANNERS -->
@{
    var banners = ViewBag.Banners as List<MotoShop.Data.Models.Banner> ?? new List<MotoShop.Data.Models.Banner>();
    var homeTopBanners = banners.Where(b => b.Position == "home-top").ToList();
    var homeMidBanners = banners.Where(b => b.Position == "home-mid").ToList();
}
@if (homeTopBanners.Any())
{
    <section class="py-3">
        <div class="container">
            <div class="row g-3">
                @foreach (var b in homeTopBanners)
                {
                    <div class="col-md-@(homeTopBanners.Count == 1 ? "12" : "6")">
                        <a href="@(b.LinkUrl ?? "#")">
                            <img src="@b.ImageUrl" alt="@b.Title"
                                 class="img-fluid rounded-3 w-100" style="object-fit:cover;max-height:180px;" />
                        </a>
                    </div>
                }
            </div>
        </div>
    </section>
}

<!-- 4. FEATURED PRODUCTS -->
<section class="home-sections-bg">
    <div class="container">
        <div class="prod-section-wrap psw-feat">
            <div class="section-head">
                <div class="section-head-left">
                    <div class="section-icon"><i class='bx bx-star'></i></div>
                    <span class="section-label">Sản phẩm nổi bật</span>
                    <span class="section-badge">@(Model.FeaturedProducts?.Count() ?? 0) sản phẩm</span>
                </div>
                <a href="/Product" class="section-more">Xem tất cả <i class='bx bx-chevron-right'></i></a>
            </div>
            <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-3" id="featuredProducts">
                @if (Model.FeaturedProducts != null && Model.FeaturedProducts.Any())
                {
                    foreach (var product in Model.FeaturedProducts)
                    {
                        <div class="col">@await Html.PartialAsync("_ProductCard", product)</div>
                    }
                }
            </div>
        </div>
    </div>
</section>

<!-- 5. BEST SELLING PRODUCTS -->
<section class="home-sections-bg">
    <div class="container">
        <div class="prod-section-wrap psw-hot">
            <div class="section-head">
                <div class="section-head-left">
                    <div class="section-icon"><i class='bx bx-trending-up'></i></div>
                    <span class="section-label">Bán chạy nhất</span>
                    <span class="section-badge">Tuần này</span>
                </div>
                <a href="/Product?sort=bestselling" class="section-more">Xem tất cả <i class='bx bx-chevron-right'></i></a>
            </div>
            <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-3" id="bestSellingProducts">
                @if (Model.BestSellingProducts != null && Model.BestSellingProducts.Any())
                {
                    foreach (var product in Model.BestSellingProducts)
                    {
                        <div class="col">@await Html.PartialAsync("_ProductCard", product)</div>
                    }
                }
            </div>
        </div>
    </div>
</section>

<!-- 6. BRAND SHOWCASE -->
<section class="bg-white brand-section">
    <div class="container">
        <div class="section-title-wrapper text-center">
            <h5 class="text-muted text-uppercase mb-4">Thương hiệu đồng hành</h5>
        </div>
        <div class="row align-items-center justify-content-center g-4">
            <div class="col-4 col-md-2 brand-item text-center">
                <img src="~/assets/img/brand/honda.png" alt="Honda" class="brand-logo-img" asp-append-version="true">
            </div>
            <div class="col-4 col-md-2 brand-item text-center">
                <img src="~/assets/img/brand/yamaha.png" alt="Yamaha" class="brand-logo-img" asp-append-version="true">
            </div>
            <div class="col-4 col-md-2 brand-item text-center">
                <img src="~/assets/img/brand/mortul.png" alt="Motul" class="brand-logo-img" asp-append-version="true">
            </div>
            <div class="col-4 col-md-2 brand-item text-center">
                <img src="~/assets/img/brand/brembo.png" alt="Brembo" class="brand-logo-img" asp-append-version="true">
            </div>
            <div class="col-4 col-md-2 brand-item text-center">
                <img src="~/assets/img/brand/michelin.png" alt="Michelin" class="brand-logo-img" asp-append-version="true">
            </div>
            <div class="col-4 col-md-2 brand-item text-center">
                <img src="~/assets/img/brand/ohlins.png" alt="Ohlins" class="brand-logo-img" asp-append-version="true">
            </div>
        </div>
    </div>
</section>

<style>
    /* Brand section layout */
    .brand-section { padding-top: 24px !important; padding-bottom: 24px !important; }
    .brand-section h5 {
        font-size: 13px;
        letter-spacing: 2px;
        color: #9ca3af;
        text-align: center;
        margin-bottom: 20px !important;
        font-weight: 600;
    }
    /* Logo — trạng thái bình thường */
    .brand-logo-img {
        max-width: 100%;
        max-height: 70px;
        object-fit: contain;
        filter: grayscale(30%);
        opacity: 0.75;
        transition: filter 0.2s ease, opacity 0.2s ease, transform 0.2s ease;
    }
    /* Logo — hover */
    .brand-item:hover .brand-logo-img {
        filter: grayscale(0%);
        opacity: 1;
        transform: scale(1.05);
    }
</style>

<!-- 7. NEW PRODUCTS -->
<section class="home-sections-bg">
    <div class="container">
        <div class="prod-section-wrap psw-new">
            <div class="section-head">
                <div class="section-head-left">
                    <div class="section-icon"><i class='bx bx-badge-check'></i></div>
                    <span class="section-label">Sản phẩm mới</span>
                    <span class="section-badge">Vừa về kho</span>
                </div>
                <a href="/Product?sort=newest" class="section-more">Xem tất cả <i class='bx bx-chevron-right'></i></a>
            </div>
            <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-3" id="newProducts">
                @if (Model.NewProducts != null && Model.NewProducts.Any())
                {
                    foreach (var product in Model.NewProducts)
                    {
                        <div class="col">@await Html.PartialAsync("_ProductCard", product)</div>
                    }
                }
            </div>
        </div>
    </div>
</section>

@* ── CATEGORY SECTIONS ── *@
@{
    var catGroups = ViewBag.CategoryWithProducts as List<MotoShop.Business.DTOs.CategoryWithProductsDto>;
}
@if (catGroups != null && catGroups.Any())
{
    foreach (var group in catGroups)
    {
        <section class="home-sections-bg">
            <div class="container">
                <div class="prod-section-wrap psw-cat">
                    <div class="section-head">
                        <div class="section-head-left">
                            <div class="section-icon"><i class='bx bx-category'></i></div>
                            <span class="section-label">@group.CategoryName</span>
                            <span class="section-badge">@group.TotalCount sản phẩm</span>
                        </div>
                        <a asp-controller="Product" asp-action="Index" asp-route-categoryId="@group.CategoryId" class="section-more">
                            Xem tất cả <i class='bx bx-chevron-right'></i>
                        </a>
                    </div>
                    <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-3">
                        @foreach (var product in group.Products)
                        {
                            <div class="col">@await Html.PartialAsync("_ProductCard", product)</div>
                        }
                    </div>
                </div>
            </div>
        </section>
    }
}

