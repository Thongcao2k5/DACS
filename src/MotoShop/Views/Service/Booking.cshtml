@using MotoShop.Data.Models
@using System.Globalization
@model MotoShop.Business.DTOs.BookingViewModel
@{
    ViewData["Title"] = "Đặt lịch dịch vụ";
    var selectedServiceId = ViewBag.SelectedServiceId as int?;
    var selectedService = ViewBag.Service as Service;
    var customer = ViewBag.Customer as Customer;
}

<div class="breadcrumb-wrapper">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
                <li class="breadcrumb-item"><a href="/Service">Dịch vụ</a></li>
                <li class="breadcrumb-item active">Đặt lịch hẹn</li>
            </ol>
        </nav>
    </div>
</div>

<main class="container py-5">
    @if (ViewBag.HasService == false)
    {
        <div class="text-center py-5">
            <i class='bx bx-calendar-x mb-3' style="font-size: 64px; color: #ddd;"></i>
            <h4 class="fw-bold">Bạn chưa chọn dịch vụ</h4>
            <p class="text-muted mb-4">Vui lòng chọn một dịch vụ để tiến hành đặt lịch hẹn.</p>
            <a href="/Service" class="btn btn-danger rounded-pill px-5">XEM DANH SÁCH DỊCH VỤ</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            <!-- 1. LEFT: BOOKING FORM -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-4 p-4">
                    <h5 class="fw-bold mb-4">THÔNG TIN ĐẶT LỊCH</h5>
                    
                    <form id="bookingForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ServiceId" value="@selectedServiceId">
                        
                        <!-- SECTION: CONTACT -->
                        <div class="row g-3 mb-4">
                            <div class="col-12">
                                <label class="form-label small fw-bold">Họ và tên <span class="text-danger">*</span></label>
                                <input type="text" asp-for="FullName" class="form-control rounded-3" placeholder="Nhập họ tên của bạn" required>
                                <span asp-validation-for="FullName" class="text-danger x-small"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Số điện thoại <span class="text-danger">*</span></label>
                                <input type="tel" asp-for="Phone" class="form-control rounded-3" placeholder="Ví dụ: 0912345678" 
                                       oninput="this.value = this.value.replace(/[^0-9]/g, '')" maxlength="11" required>
                                <span asp-validation-for="Phone" class="text-danger x-small"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Email</label>
                                <input type="email" asp-for="Email" class="form-control rounded-3" placeholder="Địa chỉ email nhận thông báo">
                            </div>
                        </div>

                        <!-- SECTION: VEHICLE -->
                        <h6 class="fw-bold mb-3 border-top pt-4">THÔNG TIN XE</h6>
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Hãng xe <span class="text-danger">*</span></label>
                                <select asp-for="VehicleBrand" class="form-select rounded-3" id="brandSel" onchange="loadModels(this.value)" required>
                                    <option value="">-- Chọn hãng xe --</option>
                                    @if (ViewBag.Brands != null)
                                    {
                                        foreach (var brand in ViewBag.Brands)
                                        {
                                            <option value="@brand">@brand</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Dòng xe <span class="text-danger">*</span></label>
                                <select asp-for="VehicleModel" class="form-select rounded-3" id="modelSel" disabled required>
                                    <option value="">-- Chọn hãng trước --</option>
                                </select>
                            </div>
                            <div class="col-md-12">
                                <label class="form-label small fw-bold">Biển số xe (Nếu có)</label>
                                <input type="text" asp-for="LicensePlate" class="form-control rounded-3" 
                                       placeholder="Ví dụ: 59A1-12345" oninput="this.value = this.value.toUpperCase()">
                            </div>
                        </div>

                        <!-- SECTION: NOTES -->
                        <div class="mb-0">
                            <label class="form-label small fw-bold">Ghi chú yêu cầu thêm</label>
                            <textarea asp-for="Note" class="form-control rounded-3" rows="3" placeholder="Mô tả tình trạng xe hoặc yêu cầu riêng..."></textarea>
                        </div>

                        <!-- HIDDEN INPUTS FOR DATE/TIME -->
                        <input type="hidden" asp-for="ServiceDate" id="selectedDate">
                        <input type="hidden" asp-for="TimeSlot" id="selectedTime">
                    </form>
                </div>
            </div>

            <!-- 2. RIGHT: SUMMARY & SLOTS -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 p-4 position-sticky" style="top: 100px;">
                    <h5 class="fw-bold mb-3">TÓM TẮT DỊCH VỤ</h5>
                    
                    <div class="bg-light rounded-3 p-3 mb-4">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="fw-bold">@selectedService?.ServiceName</span>
                            <span class="text-danger fw-bold">@selectedService?.Price.ToString("N0")đ</span>
                        </div>
                        <div class="small text-muted">
                            <i class='bx bx-time-five'></i> Dự kiến: @(selectedService?.Duration ?? 30) phút
                        </div>
                    </div>

                    <!-- DATE PICKER -->
                    <div class="mb-4">
                        <label class="form-label small fw-bold mb-2">CHỌN NGÀY HẸN <span class="text-danger">*</span></label>
                        <div class="date-scroll d-flex gap-2 overflow-auto pb-2" id="dateRow">
                            <!-- JS will render dates here -->
                        </div>
                    </div>

                    <!-- TIME PICKER -->
                    <div class="mb-4">
                        <label class="form-label small fw-bold mb-2">CHỌN KHUNG GIỜ <span class="text-danger">*</span></label>
                        <div class="time-grid" id="timeGrid">
                            <div class="text-muted small py-3 text-center w-100">Vui lòng chọn ngày trước</div>
                        </div>
                        <div class="d-flex gap-3 mt-2">
                            <small class="d-flex align-items-center gap-1"><span class="legend-dot active"></span> Đang chọn</small>
                            <small class="d-flex align-items-center gap-1"><span class="legend-dot disabled"></span> Đã có khách</small>
                        </div>
                    </div>

                    <div class="border-top pt-3">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted small">Cọc trước (30%)</span>
                            <span class="text-danger fw-bold">@ViewBag.DepositAmount?.ToString("N0")đ</span>
                        </div>
                        <p class="x-small text-muted mb-4">Lưu ý: Bạn cần chuyển khoản cọc để giữ chỗ. Lịch hẹn sẽ tự động hủy nếu không cọc sau 2 tiếng.</p>
                        
                        <button type="button" id="btnSubmit" onclick="submitBooking()" class="btn btn-danger w-100 py-3 rounded-pill fw-bold shadow-sm">XÁC NHẬN ĐẶT LỊCH</button>
                    </div>
                </div>
            </div>
        </div>
    }
</main>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        const days = ['CN', 'T2', 'T3', 'T4', 'T5', 'T6', 'T7'];
        const dateRow = document.getElementById('dateRow');
        const timeGrid = document.getElementById('timeGrid');
        const allSlots = ['08:00', '08:30', '09:00', '09:30', '10:00', '10:30', '11:00', '13:30', '14:00', '14:30', '15:00', '15:30', '16:00', '16:30'];

        // 1. RENDER 7 DAYS
        function initDates() {
            const today = new Date();
            for (let i = 1; i <= 7; i++) {
                const d = new Date(today);
                d.setDate(today.getDate() + i);
                
                const isSunday = d.getDay() === 0;
                const dateStr = d.toISOString().split('T')[0];
                
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = `date-btn ${isSunday ? 'disabled' : ''}`;
                btn.disabled = isSunday;
                btn.innerHTML = `
                    <div class="small">${days[d.getDay()]}</div>
                    <div class="fw-bold">${d.getDate()}</div>
                `;
                if (!isSunday) {
                    btn.onclick = () => selectDate(dateStr, btn);
                } else {
                    btn.title = "Cửa hàng nghỉ Chủ Nhật";
                }
                dateRow.appendChild(btn);
            }
        }

        // 2. SELECT DATE
        async function selectDate(date, el) {
            document.querySelectorAll('.date-btn').forEach(b => b.classList.remove('active'));
            el.classList.add('active');
            document.getElementById('selectedDate').value = date;
            
            // Clear current selection
            document.getElementById('selectedTime').value = '';
            
            // Load slots
            timeGrid.innerHTML = '<div class="text-center w-100 py-3"><div class="spinner-border spinner-border-sm text-danger"></div></div>';
            try {
                const res = await fetch(`/Service/GetBookedSlots?date=${date}`);
                const booked = await res.json();
                
                timeGrid.innerHTML = '';
                allSlots.forEach(slot => {
                    const isBooked = booked.includes(slot);
                    const btn = document.createElement('button');
                    btn.type = 'button';
                    btn.className = `time-btn ${isBooked ? 'disabled' : ''}`;
                    btn.disabled = isBooked;
                    btn.textContent = slot;
                    if (!isBooked) {
                        btn.onclick = () => selectTime(slot, btn);
                    }
                    timeGrid.appendChild(btn);
                });
            } catch (err) {
                timeGrid.innerHTML = '<div class="text-danger small">Lỗi tải dữ liệu. Vui lòng thử lại.</div>';
            }
        }

        // 3. SELECT TIME
        function selectTime(time, el) {
            document.querySelectorAll('.time-btn').forEach(b => b.classList.remove('active'));
            el.classList.add('active');
            document.getElementById('selectedTime').value = time;
        }

        // 4. LOAD MODELS
        async function loadModels(brand) {
            const sel = document.getElementById('modelSel');
            sel.disabled = true;
            sel.innerHTML = '<option>Đang tải...</option>';
            
            if (!brand) {
                sel.innerHTML = '<option value="">-- Chọn hãng trước --</option>';
                return;
            }

            try {
                const res = await fetch(`/Service/GetModelsByBrand?brand=${encodeURIComponent(brand)}`);
                const models = await res.json();
                
                sel.innerHTML = '<option value="">-- Chọn dòng xe --</option>';
                models.forEach(m => {
                    const opt = document.createElement('option');
                    opt.value = m.modelName;
                    opt.textContent = m.modelName;
                    sel.appendChild(opt);
                });
                sel.disabled = false;
            } catch (err) {
                sel.innerHTML = '<option value="">Lỗi tải dữ liệu</option>';
            }
        }

        // 5. SUBMIT BOOKING
        async function submitBooking() {
            const form = document.getElementById('bookingForm');
            const date = document.getElementById('selectedDate').value;
            const time = document.getElementById('selectedTime').value;
            const btn = document.getElementById('btnSubmit');

            // Reset validation states
            form.querySelectorAll('.is-invalid').forEach(i => i.classList.remove('is-invalid'));

            // Client-side quick check
            if (!date || !time) {
                Swal.fire('Thông báo', 'Vui lòng chọn Ngày và Giờ hẹn ở cột bên phải!', 'warning');
                return;
            }

            if (!form.checkValidity()) {
                form.reportValidity();
                // Highlight invalid fields
                form.querySelectorAll(':invalid').forEach(i => i.classList.add('is-invalid'));
                return;
            }

            // Start loading
            const originalText = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> ĐANG XỬ LÝ...';

            try {
                const formData = new FormData(form);
                const res = await fetch('/Service/Booking', {
                    method: 'POST',
                    body: formData
                });
                const data = await res.json();

                if (data.success) {
                    Swal.fire({
                        title: 'Thành công!',
                        text: 'Lịch hẹn đã được ghi nhận. Đang chuyển đến trang thanh toán cọc...',
                        icon: 'success',
                        timer: 2000,
                        showConfirmButton: false
                    }).then(() => {
                        window.location.href = data.redirectUrl;
                    });
                } else {
                    Swal.fire({
                        title: 'Lỗi thông tin',
                        html: data.message,
                        icon: 'error'
                    });
                    btn.disabled = false;
                    btn.innerHTML = originalText;
                }
            } catch (error) {
                Swal.fire('Lỗi kết nối', 'Không thể kết nối với máy chủ. Vui lòng thử lại sau!', 'error');
                btn.disabled = false;
                btn.innerHTML = originalText;
            }
        }

        // Initialize
        document.addEventListener('DOMContentLoaded', initDates);
    </script>

    <style>
        .date-btn { 
            border: 1px solid #eee; background: #fff; padding: 10px; min-width: 65px; 
            border-radius: 12px; display: flex; flex-direction: column; align-items: center;
            transition: all 0.2s; cursor: pointer;
        }
        .date-btn:hover:not(.disabled) { border-color: #E24B4A; color: #E24B4A; background: #fff9f9; }
        .date-btn.active { background: #E24B4A; color: #fff; border-color: #E24B4A; box-shadow: 0 4px 10px rgba(226, 75, 74, 0.3); }
        .date-btn.disabled { opacity: 0.3; cursor: not-allowed; background: #f8f8f8; }

        .time-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
        .time-btn { 
            border: 1px solid #eee; background: #fff; padding: 8px; font-size: 13px; 
            font-weight: 600; border-radius: 8px; transition: 0.2s; 
        }
        .time-btn:hover:not(.disabled) { border-color: #111; }
        .time-btn.active { background: #111; color: #fff; border-color: #111; }
        .time-btn.disabled { background: #f5f5f5; color: #ccc; cursor: not-allowed; text-decoration: line-through; }

        .legend-dot { width: 10px; height: 10px; border-radius: 50%; display: inline-block; }
        .legend-dot.active { background: #111; }
        .legend-dot.disabled { background: #f5f5f5; border: 1px solid #eee; }

        .is-invalid { border-color: #dc3545 !important; background-image: none !important; }
        .x-small { font-size: 11px; }
        .date-scroll::-webkit-scrollbar { height: 4px; }
        .date-scroll::-webkit-scrollbar-thumb { background: #eee; border-radius: 10px; }
    </style>
}
