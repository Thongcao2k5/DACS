@model MotoShop.Data.Models.ServiceBooking
@{
    ViewData["Title"] = "Thanh toán tiền cọc";
}

<div class="breadcrumb-wrapper py-3 bg-light border-bottom mb-4">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
                <li class="breadcrumb-item"><a href="/Service">Dịch vụ</a></li>
                <li class="breadcrumb-item active">Thanh toán cọc</li>
            </ol>
        </nav>
    </div>
</div>

<main class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header bg-danger text-white p-4 border-0">
                    <h4 class="fw-bold mb-0">XÁC NHẬN & THANH TOÁN CỌC</h4>
                    <p class="mb-0 small opacity-75">Vui lòng hoàn tất thanh toán cọc để giữ chỗ cho lịch hẹn của bạn.</p>
                </div>
                <div class="card-body p-4">
                    <div class="row g-4">
                        <!-- Left: Info -->
                        <div class="col-md-6">
                            <h6 class="fw-bold text-uppercase small text-muted mb-3">Thông tin lịch hẹn</h6>
                            <div class="bg-light rounded-3 p-3 mb-3">
                                <div class="mb-2">
                                    <small class="text-muted d-block">Dịch vụ:</small>
                                    <span class="fw-bold">@Model.Service?.ServiceName</span>
                                </div>
                                <div class="mb-2">
                                    <small class="text-muted d-block">Thời gian:</small>
                                    <span class="fw-bold text-danger">
                                        <i class='bx bx-calendar'></i> @Model.ServiceDate?.ToString("dd/MM/yyyy") 
                                        <i class='bx bx-time ms-2'></i> @Model.ServiceDate?.ToString("HH:mm")
                                    </span>
                                </div>
                                <div class="mb-0">
                                    <small class="text-muted d-block">Khách hàng:</small>
                                    <span class="fw-bold">@Model.CustomerFullName (@Model.CustomerPhone)</span>
                                </div>
                            </div>

                            <div class="alert alert-warning border-0 rounded-3 small mb-0">
                                <i class='bx bx-info-circle me-1'></i> 
                                Bạn cần thanh toán <strong>30% giá trị dịch vụ</strong> để hệ thống xác nhận lịch hẹn.
                            </div>
                        </div>

                        <!-- Right: Payment -->
                        <div class="col-md-6 border-start-md">
                            <h6 class="fw-bold text-uppercase small text-muted mb-3">Số tiền cần cọc</h6>
                            <div class="display-5 fw-bold text-danger mb-4">
                                @Model.DepositAmount.ToString("N0")đ
                            </div>

                            <div class="payment-methods d-grid gap-3">
                                <!-- Option 1: VNPAY -->
                                <button type="button" onclick="payWithVNPAY()" class="btn btn-outline-primary py-3 rounded-3 d-flex align-items-center justify-content-center gap-2">
                                    <img src="https://vnpay.vn/wp-content/uploads/2020/07/vnpay-logo.png" height="20" alt="VNPAY">
                                    <span class="fw-bold">Thanh toán VNPAY</span>
                                </button>

                                <div class="text-center position-relative my-2">
                                    <hr>
                                    <span class="position-absolute top-50 start-50 translate-middle bg-white px-3 small text-muted">HOẶC</span>
                                </div>

                                <!-- Option 2: Bank Transfer -->
                                <button type="button" class="btn btn-dark py-3 rounded-3 fw-bold" data-bs-toggle="modal" data-bs-target="#bankTransferModal">
                                    <i class='bx bx-transfer me-2'></i> Chuyển khoản ngân hàng
                                </button>

                                <div class="text-center position-relative my-2">
                                    <hr>
                                    <span class="position-absolute top-50 start-50 translate-middle bg-white px-3 small text-muted">HOẶC</span>
                                </div>

                                <!-- Option 3: Pay Later -->
                                <button type="button" class="btn btn-outline-secondary w-100 py-3 rounded-3 fw-bold" id="btnPayLater" onclick="payLater()">
                                    <i class='bx bx-time me-2'></i> Thanh toán khi hoàn thành dịch vụ
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="text-center mt-4">
                <a href="/Service" class="text-muted text-decoration-none small"><i class='bx bx-left-arrow-alt'></i> Quay lại danh sách dịch vụ</a>
            </div>
        </div>
    </div>
</main>

<!-- Bank Transfer Modal -->
<div class="modal fade" id="bankTransferModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold">Chuyển khoản giữ chỗ</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4 pt-0">
                <div class="text-center mb-4">
                    <img src="https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=VCB:0011001234567:Motoshop_Booking_@Model.BookingId" class="img-fluid rounded-3 border p-2 mb-2" alt="QR Code">
                    <p class="small text-muted mb-0">Quét mã QR để thanh toán nhanh</p>
                </div>

                <div class="bg-light p-3 rounded-3 mb-4">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="small text-muted">Ngân hàng:</span>
                        <span class="fw-bold">Vietcombank</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="small text-muted">Số tài khoản:</span>
                        <span class="fw-bold">0011 0012 34567</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="small text-muted">Chủ tài khoản:</span>
                        <span class="fw-bold">NGUYEN VAN A</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="small text-muted">Nội dung CK:</span>
                        <span class="fw-bold text-danger">MOTOSHOP @Model.BookingId</span>
                    </div>
                </div>

                <form id="proofForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="bookingId" value="@Model.BookingId">
                    <label class="form-label small fw-bold">Tải lên ảnh bằng chứng (Chụp màn hình CK) <span class="text-danger">*</span></label>
                    <input type="file" name="transferProof" class="form-control rounded-3" accept="image/*" required>
                    <button type="button" onclick="submitProof()" id="btnSubmitProof" class="btn btn-danger w-100 py-3 rounded-pill fw-bold mt-3">XÁC NHẬN ĐÃ CHUYỂN KHOẢN</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // 1. Thanh toán VNPAY
        function payWithVNPAY() {
            window.location.href = `/Payment/CreateServiceDeposit?bookingId=@Model.BookingId`;
        }

        // 2. Thanh toán khi hoàn thành dịch vụ
        async function payLater() {
            const btn = document.getElementById('btnPayLater');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Đang xử lý...';

            try {
                const res = await fetch('/Service/PayLater', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value },
                    body: `bookingId=@Model.BookingId`
                });
                const data = await res.json();

                if (data.success) {
                    Swal.fire({
                        title: 'Đã xác nhận!',
                        text: 'Lịch hẹn đã được ghi nhận. Bạn sẽ thanh toán khi hoàn thành dịch vụ.',
                        icon: 'success'
                    }).then(() => {
                        window.location.href = `/Service/BookingSuccess?id=@Model.BookingId`;
                    });
                } else {
                    Swal.fire('Lỗi', data.message, 'error');
                    btn.disabled = false;
                    btn.innerHTML = '<i class="bx bx-time me-2"></i> Thanh toán khi hoàn thành dịch vụ';
                }
            } catch (err) {
                Swal.fire('Lỗi', 'Không thể kết nối máy chủ.', 'error');
                btn.disabled = false;
                btn.innerHTML = '<i class="bx bx-time me-2"></i> Thanh toán khi hoàn thành dịch vụ';
            }
        }

        // 3. Gửi bằng chứng chuyển khoản
        async function submitProof() {
            const form = document.getElementById('proofForm');
            const file = form.transferProof.files[0];
            const btn = document.getElementById('btnSubmitProof');

            if (!file) {
                Swal.fire('Chú ý', 'Vui lòng chọn ảnh chụp màn hình chuyển khoản!', 'warning');
                return;
            }

            const originalText = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> ĐANG GỬI...';

            try {
                const formData = new FormData(form);
                const res = await fetch('/Service/ConfirmDeposit', {
                    method: 'POST',
                    body: formData
                });
                const data = await res.json();

                if (data.success) {
                    Swal.fire({
                        title: 'Thành công!',
                        text: 'Hệ thống đã nhận thông báo. Chúng tôi sẽ kiểm tra và xác nhận lịch hẹn trong 30 phút!',
                        icon: 'success'
                    }).then(() => {
                        window.location.href = '/Service';
                    });
                } else {
                    Swal.fire('Lỗi', data.message, 'error');
                    btn.disabled = false;
                    btn.innerHTML = originalText;
                }
            } catch (err) {
                Swal.fire('Lỗi', 'Không thể kết nối máy chủ.', 'error');
                btn.disabled = false;
                btn.innerHTML = originalText;
            }
        }
    </script>
    
    <style>
        .border-start-md { border-left: 1px solid #eee; padding-left: 2rem; }
        @@media (max-width: 767px) {
            .border-start-md { border-left: none; padding-left: 0; border-top: 1px solid #eee; padding-top: 2rem; }
        }
    </style>
}
