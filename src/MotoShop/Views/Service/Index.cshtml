@model IEnumerable<MotoShop.Data.Models.Service>
@{
    ViewData["Title"] = "Dịch vụ bảo dưỡng & Chăm sóc xe";
    Layout = "_Layout";
}

<!-- 1. HERO BANNER -->
<section class="service-hero">
    <div class="container text-center py-5">
        <div class="hero-content py-5">
            <span class="badge bg-danger rounded-pill px-3 py-2 mb-3 glow-effect">DỊCH VỤ CHUYÊN NGHIỆP</span>
            <h1 class="display-4 fw-bold text-white mb-3">Dịch vụ chăm sóc & bảo dưỡng</h1>
            <p class="lead text-white-50 mx-auto mb-4" style="max-width: 600px;">
                Đội ngũ kỹ thuật viên tay nghề cao, trang thiết bị hiện đại, cam kết mang lại trải nghiệm tốt nhất cho xế yêu của bạn.
            </p>
        </div>
    </div>
</section>

<!-- 2. FILTER BAR -->
<div id="booking-anchor" style="position: relative; top: -120px; visibility: hidden;"></div>
<div class="filter-wrapper sticky-top shadow-sm" id="service-filter-section">
    <div class="container py-3">
        <div class="d-flex justify-content-center flex-wrap gap-2" id="filter-buttons">
            <button class="btn btn-pill active" data-filter="all">Tất cả</button>
            <button class="btn btn-pill" data-filter="maintenance">Bảo dưỡng xe</button>
            <button class="btn btn-pill" data-filter="install">Lắp đặt phụ tùng</button>
            <button class="btn btn-pill" data-filter="tuning">Độ xe</button>
            <button class="btn btn-pill" data-filter="rescue">Cứu hộ</button>
            <button class="btn btn-pill" data-filter="washing">Rửa xe</button>
        </div>
    </div>
</div>

<!-- 3. SERVICE CARD GRID -->
<section class="container py-5">
    <div class="row g-4" id="service-grid">
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                // Logic xác định category dựa trên tên dịch vụ để filter (tạm thời)
                string category = "maintenance";
                if (item.ServiceName.Contains("Lắp đặt")) category = "install";
                else if (item.ServiceName.Contains("ECU") || item.ServiceName.Contains("Độ")) category = "tuning";
                else if (item.ServiceName.Contains("Cứu hộ")) category = "rescue";
                else if (item.ServiceName.Contains("Rửa xe")) category = "washing";

                <div class="col-md-6 col-lg-4 service-item" data-category="@category">
                    <div class="card h-100 service-card">
                        <div class="card-body p-4 text-center">
                            <div class="service-icon-box @(category == "maintenance" ? "bg-orange-light text-orange" : 
                                                          category == "install" ? "bg-blue-light text-blue" :
                                                          category == "tuning" ? "bg-purple-light text-purple" :
                                                          category == "rescue" ? "bg-red-light text-danger" : "bg-green-light text-green") mb-3">
                                <i class='bx @(category == "maintenance" ? "bx-wrench" : 
                                              category == "install" ? "bx-cog" :
                                              category == "tuning" ? "bx-bolt-circle" :
                                              category == "rescue" ? "bx-support" : "bx-water")'></i>
                            </div>
                            <h5 class="fw-bold mb-3">@item.ServiceName</h5>
                            <p class="text-muted small mb-4">@item.Description</p>
                            <div class="d-flex justify-content-between align-items-center mt-auto border-top pt-3">
                                <span class="h5 fw-bold text-danger mb-0">@item.Price.ToString("N0")đ</span>
                                <a href="/Service/Booking?serviceId=@item.ServiceId" class="btn btn-danger rounded-pill px-4">Đặt lịch</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <p class="text-muted">Hiện chưa có dịch vụ nào khả dụng.</p>
            </div>
        }
    </div>
</section>

<!-- 4. CTA + WHY SECTION -->
<section class="bg-light py-5 mt-4">
    <div class="container text-center">
        <h2 class="fw-bold mb-5">Tại sao nên chọn MotoShop?</h2>
        <div class="row g-4 mb-5">
            <div class="col-md-3">
                <div class="p-3">
                    <i class='bx bx-medal fs-1 text-danger mb-3'></i>
                    <h6 class="fw-bold">Kỹ thuật viên chuyên nghiệp</h6>
                    <p class="text-muted small">Trên 10 năm kinh nghiệm trong ngành xe máy.</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="p-3">
                    <i class='bx bx-check-shield fs-1 text-danger mb-3'></i>
                    <h6 class="fw-bold">Linh kiện chính hãng</h6>
                    <p class="text-muted small">100% linh kiện thay thế là hàng chính hãng cao cấp.</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="p-3">
                    <i class='bx bx-show fs-1 text-danger mb-3'></i>
                    <h6 class="fw-bold">Giá minh bạch</h6>
                    <p class="text-muted small">Báo giá rõ ràng trước khi thực hiện, không phát sinh.</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="p-3">
                    <i class='bx bx-timer fs-1 text-danger mb-3'></i>
                    <h6 class="fw-bold">Hỗ trợ nhanh</h6>
                    <p class="text-muted small">Tiết kiệm thời gian, hoàn thành đúng cam kết.</p>
                </div>
            </div>
        </div>
        <a href="#booking-anchor" class="btn btn-danger btn-lg rounded-pill px-5 fw-bold shadow">
            ĐẶT LỊCH NGAY <i class='bx bx-right-arrow-alt ms-2'></i>
        </a>
    </div>
</section>

<style>
    html {
        scroll-behavior: smooth;
    }
    :root {
        --primary-red: #dc3545;
        --orange: #ff9800;
        --blue: #2196f3;
        --purple: #9c27b0;
        --green: #4caf50;
    }

    /* Hero Banner */
    .service-hero {
        background: linear-gradient(rgba(0,0,0,0.7), rgba(0,0,0,0.7)), 
                    url('https://images.unsplash.com/photo-1558981403-c5f91cbba527?auto=format&fit=crop&q=80&w=2000');
        background-size: cover;
        background-position: center;
        border-radius: 0 0 40px 40px;
        position: relative;
        overflow: hidden;
        margin-top: -20px;
    }

    .hero-content { animation: fadeInDown 0.8s ease; }
    .glow-effect { box-shadow: 0 0 15px rgba(220, 53, 69, 0.4); }

    /* Filter Bar */
    #service-filter-section { scroll-margin-top: 20px; }
    .filter-wrapper { background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(10px); z-index: 1000; top: 0; }
    .btn-pill { border-radius: 50px; padding: 8px 24px; border: 1.5px solid #eee; background: #fff; color: #666; font-weight: 500; transition: all 0.3s ease; }
    .btn-pill:hover { border-color: var(--primary-red); color: var(--primary-red); }
    .btn-pill.active { background: var(--primary-red); border-color: var(--primary-red); color: #fff; box-shadow: 0 8px 15px rgba(220, 53, 69, 0.2); }

    /* Service Cards */
    .service-card { border: none; border-radius: 20px; transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275); box-shadow: 0 10px 30px rgba(0,0,0,0.05); position: relative; }
    .service-card:hover { transform: translateY(-12px); box-shadow: 0 20px 40px rgba(0,0,0,0.1); }
    .service-icon-box { width: 70px; height: 70px; border-radius: 18px; display: flex; align-items: center; justify-content: center; font-size: 2rem; margin: 0 auto; }

    /* Color Palette */
    .bg-orange-light { background: #fff3e0; } .text-orange { color: var(--orange); }
    .bg-blue-light { background: #e3f2fd; } .text-blue { color: var(--blue); }
    .bg-purple-light { background: #f3e5f5; } .text-purple { color: var(--purple); }
    .bg-red-light { background: #ffebee; }
    .bg-green-light { background: #e8f5e9; } .text-green { color: var(--green); }

    .service-item { transition: all 0.4s ease; }
    @@keyframes fadeInDown { from { opacity: 0; transform: translateY(-30px); } to { opacity: 1; transform: translateY(0); } }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const buttons = document.querySelectorAll('#filter-buttons .btn-pill');
        const items = document.querySelectorAll('.service-item');

        buttons.forEach(btn => {
            btn.addEventListener('click', () => {
                buttons.forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
                const filter = btn.getAttribute('data-filter');

                items.forEach(item => {
                    const category = item.getAttribute('data-category');
                    if (filter === 'all' || filter === category) {
                        item.style.display = 'block';
                        setTimeout(() => { item.style.opacity = '1'; item.style.transform = 'scale(1)'; }, 10);
                    } else {
                        item.style.opacity = '0';
                        item.style.transform = 'scale(0.8)';
                        setTimeout(() => { item.style.display = 'none'; }, 300);
                    }
                });
            });
        });
    });
</script>
