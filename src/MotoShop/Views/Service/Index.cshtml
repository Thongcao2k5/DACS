@{
    ViewData["Title"] = "Dịch vụ bảo dưỡng & Sửa chữa xe máy";
    var services = ViewBag.Services as IEnumerable<MotoShop.Data.Models.Service>;
    var combos = ViewBag.Combos as IEnumerable<MotoShop.Data.Models.ServiceCombo>;
}

<div class="service-banner text-white py-5 mb-5" style="background: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.6)), url('https://shop2banh.vn/images/thumbs/2023/12/bao-duong-xe-may-cuoi-nam.jpg'); background-size: cover; background-position: center;">
    <div class="container py-4 text-center">
        <h1 class="fw-bold display-4 text-uppercase">Dịch vụ chuyên nghiệp</h1>
        <p class="lead">Đội ngũ kỹ thuật tay nghề cao - Trang thiết bị hiện đại - Phụ tùng chính hãng</p>
        <div class="mt-4">
            <a href="#booking" class="btn btn-danger btn-lg rounded-pill px-5 fw-bold shadow-lg animate__animated animate__pulse animate__infinite">ĐẶT LỊCH NGAY</a>
        </div>
    </div>
</div>

<main class="container mb-5">
    <!-- SECTION 1: CÁC GÓI COMBO TIẾT KIỆM -->
    <section class="mb-5">
        <div class="d-flex align-items-center mb-4">
            <h3 class="fw-bold text-uppercase mb-0 border-start border-danger border-5 ps-3">Combo Bảo Dưỡng Tiết Kiệm</h3>
            <span class="badge bg-danger ms-3 rounded-pill px-3 py-2">HOT</span>
        </div>
        
        <div class="row g-4">
            @if (combos != null && combos.Any())
            {
                @foreach (var combo in combos)
                {
                    <div class="col-lg-6">
                        <div class="combo-card shadow-sm border-0 rounded-4 overflow-hidden bg-white h-100 d-flex flex-column flex-md-row border">
                            <div class="combo-img-wrapper position-relative" style="min-width: 220px; height: 240px;">
                                <img src="@(string.IsNullOrEmpty(combo.ImageUrl) ? "https://shop2banh.vn/images/thumbs/2023/10/ve-sinh-noi-xe-tay-ga.jpg" : combo.ImageUrl)" 
                                     class="w-100 h-100 object-fit-cover" alt="@combo.ComboName">
                                <div class="discount-tag">-@(((combo.TotalPrice - combo.DiscountPrice) / combo.TotalPrice * 100).ToString("0"))%</div>
                            </div>
                            <div class="p-4 d-flex flex-column justify-content-between">
                                <div>
                                    <h5 class="fw-bold text-danger mb-2">@combo.ComboName</h5>
                                    <p class="small text-muted mb-3">@combo.Description</p>
                                    <ul class="list-unstyled mb-4">
                                        @foreach (var item in combo.ComboItems.Take(4))
                                        {
                                            <li class="small mb-1 text-dark"><i class='bx bx-check-circle text-success me-2'></i>@item.Service?.ServiceName</li>
                                        }
                                    </ul>
                                </div>
                                <div class="d-flex align-items-center justify-content-between mt-auto">
                                    <div>
                                        <div class="text-muted text-decoration-line-through small">@combo.TotalPrice.ToString("N0")đ</div>
                                        <div class="fw-bold fs-4 text-danger">@combo.DiscountPrice.ToString("N0")đ</div>
                                    </div>
                                    <a href="/Service/Detail/@combo.ComboId?isCombo=true" class="btn btn-dark rounded-pill px-4 fw-bold btn-sm shadow-sm">CHI TIẾT</a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </section>

    <!-- SECTION 2: BẢNG GIÁ DỊCH VỤ LẺ -->
    <section id="pricing" class="mb-5 py-5 bg-light rounded-4 px-4">
        <div class="text-center mb-5">
            <h3 class="fw-bold text-uppercase">Bảng Giá Dịch Vụ Lẻ</h3>
            <p class="text-muted">Minh bạch giá cả - Không phát sinh chi phí ẩn</p>
        </div>

        <div class="service-filter-bar mb-4 d-flex flex-wrap gap-2 justify-content-center">
            <button class="btn btn-white border shadow-sm rounded-pill px-4 active filter-btn" data-filter="all">Tất cả</button>
            <button class="btn btn-white border shadow-sm rounded-pill px-4 filter-btn" data-filter="động cơ">Động cơ</button>
            <button class="btn btn-white border shadow-sm rounded-pill px-4 filter-btn" data-filter="phanh">Phanh & Dàn chân</button>
            <button class="btn btn-white border shadow-sm rounded-pill px-4 filter-btn" data-filter="điện">Điện & Đèn</button>
        </div>

        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-dark text-white">
                        <tr>
                            <th class="ps-4 py-3">Tên dịch vụ</th>
                            <th class="py-3">Mô tả chi tiết</th>
                            <th class="py-3 text-center">Giá (Dự kiến)</th>
                            <th class="pe-4 py-3 text-end">Hành động</th>
                        </tr>
                    </thead>
                    <tbody id="serviceTableBody">
                        @if (services != null)
                        {
                            @foreach (var s in services)
                            {
                                <tr class="service-row" data-name="@s.ServiceName.ToLower()">
                                    <td class="ps-4">
                                        <div class="fw-bold text-dark">@s.ServiceName</div>
                                    </td>
                                    <td class="text-muted small">@s.Description</td>
                                    <td class="text-center">
                                        <span class="fw-bold text-danger">@s.Price.ToString("N0")đ</span>
                                    </td>
                                    <td class="pe-4 text-end">
                                        <button class="btn btn-sm btn-outline-danger rounded-pill px-3 fw-bold">Đặt lịch</button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    <!-- SECTION 3: QUY TRÌNH & CAM KẾT -->
    <div class="row g-4 text-center mt-4">
        <div class="col-md-4">
            <div class="p-4 bg-white shadow-sm rounded-4 border h-100">
                <i class='bx bx-time-five fs-1 text-danger mb-3'></i>
                <h5 class="fw-bold">Tiết kiệm thời gian</h5>
                <p class="text-muted small mb-0">Đặt lịch trước qua Website, tới là làm ngay không cần chờ đợi.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-4 bg-white shadow-sm rounded-4 border h-100">
                <i class='bx bx-certification fs-1 text-danger mb-3'></i>
                <h5 class="fw-bold">Phụ tùng chính hãng</h5>
                <p class="text-muted small mb-0">Cam kết 100% linh kiện thay thế là hàng chính hãng từ các thương hiệu lớn.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-4 bg-white shadow-sm rounded-4 border h-100">
                <i class='bx bx-shield-quarter fs-1 text-danger mb-3'></i>
                <h5 class="fw-bold">Bảo hành dài hạn</h5>
                <p class="text-muted small mb-0">Mọi dịch vụ sửa chữa đều được bảo hành từ 3-6 tháng tại hệ thống MotoShop.</p>
            </div>
        </div>
    </div>
</main>

<style>
    .discount-tag {
        position: absolute; top: 15px; left: 15px; background: #dc3545; color: #fff;
        padding: 5px 12px; border-radius: 50px; font-weight: 800; font-size: 0.85rem;
        box-shadow: 0 5px 15px rgba(220, 53, 69, 0.3);
    }
    .combo-card { transition: all 0.3s ease; }
    .combo-card:hover { transform: translateY(-10px); box-shadow: 0 20px 40px rgba(0,0,0,0.1) !important; }
    
    .filter-btn.active { background-color: #dc3545 !important; color: #fff !important; border-color: #dc3545 !important; }
    .btn-white { background: #fff; color: #333; }
    
    .service-row { cursor: pointer; transition: 0.2s; }
    .service-row:hover { background-color: #fff5f5 !important; }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const filterBtns = document.querySelectorAll('.filter-btn');
        const rows = document.querySelectorAll('.service-row');

        filterBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                // Active class
                filterBtns.forEach(b => b.classList.remove('active'));
                btn.classList.add('active');

                const filter = btn.getAttribute('data-filter');
                rows.forEach(row => {
                    const name = row.getAttribute('data-name');
                    if (filter === 'all' || name.includes(filter)) {
                        row.style.display = '';
                    } else {
                        row.style.display = 'none';
                    }
                });
            });
        });
    });
</script>
