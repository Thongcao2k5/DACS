@model IEnumerable<MotoShop.Data.Models.Service>
@{
    ViewData["Title"] = "Dịch vụ MotoShop";
    var categories = ViewBag.ServiceCategories as List<MotoShop.Data.Models.ServiceCategory>;
    var currentCatId = ViewBag.CurrentCategoryId as int?;
}

<div class="breadcrumb-wrapper">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
                <li class="breadcrumb-item active">Dịch vụ</li>
            </ol>
        </nav>
    </div>
</div>

<main class="container py-5">
    <div class="row g-4">
        <!-- 1. SIDEBAR FILTER -->
        <aside class="col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 sticky-top" style="top: 100px;">
                <h6 class="fw-bold mb-3 text-uppercase">Danh mục dịch vụ</h6>
                <div class="list-group list-group-flush service-category-list">
                    <a href="/Service" class="list-group-item list-group-item-action border-0 px-0 d-flex justify-content-between align-items-center @(currentCatId == null ? "active text-danger fw-bold" : "")">
                        <span><i class='bx bx-grid-alt me-2'></i> Tất cả dịch vụ</span>
                    </a>
                    @if (categories != null)
                    {
                        foreach (var cat in categories)
                        {
                            <a href="/Service?categoryId=@cat.CategoryId" class="list-group-item list-group-item-action border-0 px-0 d-flex justify-content-between align-items-center @(currentCatId == cat.CategoryId ? "active text-danger fw-bold" : "")">
                                <span><i class='bx @(cat.Icon ?? "bx-wrench") me-2'></i> @cat.CategoryName</span>
                                <span class="badge bg-light text-muted rounded-pill small">@cat.Services.Count</span>
                            </a>
                        }
                    }
                </div>

                <div class="mt-5 p-3 bg-dark rounded-4 text-white">
                    <h6 class="fw-bold mb-2 text-danger">Hỗ trợ 24/7</h6>
                    <p class="x-small mb-3 text-white-50">Liên hệ ngay để được tư vấn kỹ thuật miễn phí.</p>
                    <a href="tel:0123456789" class="btn btn-danger w-100 rounded-pill btn-sm fw-bold">GỌI NGAY</a>
                </div>
            </div>
        </aside>

        <!-- 2. SERVICE LIST -->
        <div class="col-lg-9">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4 class="fw-bold mb-0">
                    @(currentCatId.HasValue ? categories?.FirstOrDefault(c => c.CategoryId == currentCatId)?.CategoryName : "Tất cả dịch vụ")
                </h4>
                <div class="text-muted small">Tìm thấy <strong>@Model.Count()</strong> dịch vụ</div>
            </div>

            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class='bx bx-search-alt mb-3' style="font-size: 48px; color: #ddd;"></i>
                    <p class="text-muted">Không tìm thấy dịch vụ nào trong danh mục này.</p>
                </div>
            }
            else
            {
                <div class="row g-4">
                    @foreach (var item in Model)
                    {
                        <div class="col-md-6 col-xl-4">
                            <div class="service-card h-100 bg-white border rounded-4 overflow-hidden transition-all hover-shadow">
                                <div class="position-relative overflow-hidden" style="height: 180px;">
                                    <a href="/Service/Details?slug=@item.Slug">
                                        <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/assets/img/elements/18.jpg" : item.ImageUrl)" class="w-100 h-100 object-fit-cover" alt="@item.ServiceName" onerror="this.src='/assets/img/elements/18.jpg'">
                                    </a>
                                    <div class="position-absolute top-0 end-0 p-3">
                                        <span class="badge bg-white text-dark shadow-sm rounded-pill small fw-bold">~@item.Duration phút</span>
                                    </div>
                                </div>
                                <div class="p-4">
                                    <div class="small text-danger fw-bold text-uppercase mb-1">@item.ServiceCategory?.CategoryName</div>
                                    <h6 class="fw-bold mb-2">
                                        <a href="/Service/Details?slug=@item.Slug" class="text-dark text-decoration-none">@item.ServiceName</a>
                                    </h6>
                                    <p class="text-muted small mb-3 text-truncate-2">@(item.ShortDescription ?? item.Description)</p>
                                    
                                    <div class="d-flex justify-content-between align-items-center border-top pt-3 mt-auto">
                                        <div class="fw-bold text-danger fs-5">@item.Price.ToString("N0")đ</div>
                                        <a href="/Service/Booking?serviceId=@item.ServiceId" class="btn btn-outline-danger btn-sm rounded-pill px-3 fw-bold">ĐẶT LỊCH</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</main>

<style>
    .service-card { transition: 0.3s; }
    .service-card:hover { transform: translateY(-5px); }
    .hover-shadow:hover { box-shadow: 0 10px 25px rgba(0,0,0,0.08) !important; }
    .text-truncate-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; height: 38px; }
    
    .service-category-list .list-group-item { transition: 0.2s; font-size: 14px; }
    .service-category-list .list-group-item:hover { color: #E24B4A; background: #fff9f9; padding-left: 10px !important; }
    .service-category-list .list-group-item.active { background: #fff9f9 !important; }
    
    .x-small { font-size: 11px; }
</style>
