@model MotoShop.Business.DTOs.BookingSuccessViewModel
@{
    ViewData["Title"] = "Đặt lịch thành công";
}

<div class="container py-5 my-5">
    <div class="row justify-content-center">
        <div class="col-md-8 text-center">
            <!-- PHẦN 1: XÁC NHẬN ĐẶT LỊCH -->
            <div class="success-icon mb-4">
                <i class='bx bxs-check-circle text-success' style="font-size: 80px;"></i>
            </div>
            
            <h1 class="fw-bold mb-3">Đặt lịch thành công!</h1>
            <p class="text-muted mb-4 fs-5">Mã lịch hẹn của bạn là <span class="text-danger fw-bold">#@Model.BookingCode</span></p>
            
            <div class="booking-summary-box p-4 bg-white rounded-4 shadow-sm text-start mb-4 border">
                <div class="row g-3">
                    <div class="col-sm-6">
                        <label class="text-muted small d-block">Dịch vụ</label>
                        <span class="fw-bold">@Model.ServiceName</span>
                    </div>
                    <div class="col-sm-6">
                        <label class="text-muted small d-block">Thời gian</label>
                        <span class="fw-bold">@Model.TimeSlot - @Model.ServiceDate.ToString("dd/MM/yyyy")</span>
                    </div>
                    <div class="col-sm-6">
                        <label class="text-muted small d-block">Tổng chi phí</label>
                        <span class="fw-bold">@Model.ServicePrice.ToString("N0")đ</span>
                    </div>
                    <div class="col-sm-6">
                        <label class="text-muted small d-block">Trạng thái</label>
                        @if (Model.Status == "Pending")
                        {
                            <span class="badge bg-warning text-dark px-3 rounded-pill">Chờ đặt cọc</span>
                        }
                        else
                        {
                            <span class="badge bg-success px-3 rounded-pill">@Model.Status</span>
                        }
                    </div>
                </div>
            </div>

            <!-- PHẦN 2: HƯỚNG DẪN CỌC 30% -->
            @if (Model.Status == "Pending")
            {
                <div class="deposit-instruction-box p-4 rounded-4 text-start mb-5" style="background-color: #FFF9E6; border: 1px solid #FFD580;">
                    <div class="d-flex align-items-center gap-2 mb-3 text-warning">
                        <i class='bx bx-error-circle fs-4'></i>
                        <h5 class="fw-bold mb-0">HƯỚNG DẪN ĐẶT CỌC 30% ĐỂ GIỮ CHỖ</h5>
                    </div>
                    
                    <p class="mb-4">Để hoàn tất việc giữ chỗ, quý khách vui lòng thanh toán số tiền cọc <strong class="text-danger">@Model.DepositAmount.ToString("N0")đ</strong> trong vòng 2 tiếng.</p>
                    
                    <div class="bank-info-card p-3 bg-white rounded-3 border mb-4">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted small">Ngân hàng</span>
                            <span class="fw-bold">@Model.BankName</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted small">Số tài khoản</span>
                            <div class="d-flex align-items-center gap-2">
                                <span id="accNum" class="fw-bold text-danger">@Model.AccountNumber</span>
                                <button class="btn btn-sm btn-light p-1" onclick="copyText('accNum')"><i class='bx bx-copy'></i></button>
                            </div>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted small">Chủ tài khoản</span>
                            <span class="fw-bold">@Model.AccountHolder</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted small">Số tiền cọc</span>
                            <div class="d-flex align-items-center gap-2">
                                <span id="depAmt" class="fw-bold text-danger">@Model.DepositAmount.ToString("N0")đ</span>
                                <button class="btn btn-sm btn-light p-1" onclick="copyText('depAmt')"><i class='bx bx-copy'></i></button>
                            </div>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted small">Nội dung CK</span>
                            <div class="d-flex align-items-center gap-2">
                                <span id="transContent" class="fw-bold text-danger">@Model.TransferContent</span>
                                <button class="btn btn-sm btn-light p-1" onclick="copyText('transContent')"><i class='bx bx-copy'></i></button>
                            </div>
                        </div>
                    </div>

                    <div class="countdown-timer d-flex align-items-center justify-content-center gap-2 mb-4 p-2 bg-white rounded-pill border text-danger fw-bold">
                        <i class='bx bx-timer fs-4'></i>
                        <span>HẾT HẠN SAU: <span id="timer">02:00:00</span></span>
                    </div>

                    <div class="upload-section">
                        <label class="form-label fw-bold small">TẢI ẢNH XÁC NHẬN CHUYỂN KHOẢN</label>
                        <div class="input-group">
                            <input type="file" id="depositProof" class="form-control" accept="image/*">
                            <button class="btn btn-danger px-4" type="button" onclick="uploadProof(@Model.BookingId)">XÁC NHẬN ĐÃ CỌC</button>
                        </div>
                        <div id="imagePreview" class="mt-3 text-center d-none">
                            <img src="" class="img-thumbnail" style="max-height: 200px;">
                        </div>
                    </div>
                </div>

                <div class="alert alert-secondary py-2 small mb-5">
                    <i class='bx bx-info-circle me-1'></i> Số tiền còn lại <strong>@Model.RemainingAmount.ToString("N0")đ</strong> quý khách sẽ thanh toán tại cửa hàng sau khi hoàn thành dịch vụ.
                </div>
            }
            else if (Model.Status == "Confirmed")
            {
                <div class="alert alert-success py-4 rounded-4 mb-5 border-0">
                    <i class='bx bxs-badge-check fs-1 mb-2'></i>
                    <h5 class="fw-bold">LỊCH HẸN ĐÃ ĐƯỢC XÁC NHẬN</h5>
                    <p class="mb-0">Cảm ơn quý khách đã hoàn tất đặt cọc. Vui lòng đến đúng giờ để được phục vụ tốt nhất.</p>
                </div>
            }

            <div class="d-flex flex-column flex-sm-row gap-3 justify-content-center">
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-dark rounded-pill px-5 py-3 fw-bold">
                    Về trang chủ
                </a>
                <a asp-controller="Service" asp-action="MyBookings" class="btn btn-danger rounded-pill px-5 py-3 fw-bold shadow-sm">
                    Xem lịch sử dịch vụ
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Countdown Timer
        const expireAt = new Date('@Model.ExpireAt.ToString("yyyy-MM-ddTHH:mm:ss")').getTime();
        
        const x = setInterval(function() {
            const now = new Date().getTime();
            const distance = expireAt - now;
            
            const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
            const seconds = Math.floor((distance % (1000 * 60)) / 1000);
            
            document.getElementById("timer").innerHTML = 
                (hours < 10 ? "0" + hours : hours) + ":" + 
                (minutes < 10 ? "0" + minutes : minutes) + ":" + 
                (seconds < 10 ? "0" + seconds : seconds);
            
            if (distance < 0) {
                clearInterval(x);
                document.getElementById("timer").innerHTML = "ĐÃ HẾT HẠN";
                location.reload();
            }
        }, 1000);

        // Copy Text
        function copyText(id) {
            const text = document.getElementById(id).innerText.replace('đ', '').replace(/\./g, '');
            navigator.clipboard.writeText(text).then(() => {
                alert('Đã sao chép: ' + text);
            });
        }

        // Preview Image
        document.getElementById('depositProof').addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(event) {
                    const preview = document.getElementById('imagePreview');
                    preview.querySelector('img').src = event.target.result;
                    preview.classList.remove('d-none');
                }
                reader.readAsDataURL(file);
            }
        });

        // Upload Proof
        async function uploadProof(id) {
            const fileInput = document.getElementById('depositProof');
            if (fileInput.files.length === 0) {
                alert('Vui lòng chọn ảnh chuyển khoản.');
                return;
            }

            const formData = new FormData();
            formData.append('bookingId', id);
            formData.append('transferProof', fileInput.files[0]);
            formData.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);

            const btn = event.target;
            const originalText = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Đang gửi...';

            try {
                const res = await fetch('/Service/ConfirmDeposit', {
                    method: 'POST',
                    body: formData
                });
                const data = await res.json();
                
                if (data.success) {
                    alert(data.message);
                    location.reload();
                } else {
                    alert(data.message);
                    btn.disabled = false;
                    btn.innerHTML = originalText;
                }
            } catch (error) {
                console.error('Error:', error);
                alert('Có lỗi xảy ra, vui lòng thử lại.');
                btn.disabled = false;
                btn.innerHTML = originalText;
            }
        }
    </script>
}

<style>
    .bank-info-card { border-style: dashed !important; border-width: 1.5px !important; }
</style>
