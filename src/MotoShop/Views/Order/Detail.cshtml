@model MotoShop.Models.ViewModels.OrderDetailViewModel
@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
@inject MotoShop.Data.Interfaces.IUnitOfWork UnitOfWork
@using Microsoft.EntityFrameworkCore
@{
    var order = Model.OrderInfo;
    ViewData["Title"] = "Chi tiết đơn hàng " + order.OrderCode;
    var user = await UserManager.GetUserAsync(User);
    var currentCustomer = await UnitOfWork.Repository<MotoShop.Data.Models.Customer>().Find(c => c.UserId == user.Id).FirstOrDefaultAsync();
}

<div class="breadcrumb-wrapper">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                <li class="breadcrumb-item"><a asp-controller="Account" asp-action="Profile">Tài khoản</a></li>
                <li class="breadcrumb-item"><a asp-controller="Order" asp-action="Index">Đơn hàng của tôi</a></li>
                <li class="breadcrumb-item active" aria-current="page">Chi tiết đơn hàng</li>
            </ol>
        </nav>
    </div>
</div>

<main class="container mb-5">
    <div class="row g-4">
        <!-- SIDEBAR MENU -->
        <aside class="col-lg-3">
            <div class="account-sidebar shadow-sm">
                <div class="d-flex align-items-center gap-3 mb-4 pb-4 border-bottom">
                    <div style="width: 50px; height: 50px;">
                        <img src="https://ui-avatars.com/api/?name=@(currentCustomer?.FullName)&background=random" class="rounded-circle w-100 h-100 object-fit-cover" alt="User">
                    </div>
                    <div>
                        <h6 class="fw-bold mb-0">@currentCustomer?.FullName</h6>
                        <p class="text-muted small mb-0">Thành viên</p>
                    </div>
                </div>
                <ul class="account-nav">
                    <li class="account-nav-item"><a asp-controller="Account" asp-action="Profile" class="account-nav-link"><i class='bx bx-user'></i> Thông tin cá nhân</a></li>
                    <li class="account-nav-item"><a asp-controller="Order" asp-action="Index" class="account-nav-link active"><i class='bx bx-package'></i> Đơn hàng của tôi</a></li>
                    <li class="account-nav-item"><a asp-controller="Account" asp-action="AddressBook" class="account-nav-link"><i class='bx bx-map'></i> Địa chỉ giao hàng</a></li>
                    <li class="account-nav-item"><a asp-controller="Account" asp-action="Wishlist" class="account-nav-link"><i class='bx bx-heart'></i> Sản phẩm yêu thích</a></li>
                    <li class="account-nav-item"><a asp-controller="Account" asp-action="ChangePassword" class="account-nav-link"><i class='bx bx-lock-alt'></i> Đổi mật khẩu</a></li>
                </ul>
            </div>
        </aside>

        <!-- MAIN CONTENT -->
        <div class="col-lg-9">
            <div class="order-detail-header d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
                <div>
                    <h4 class="fw-bold text-uppercase mb-1">ĐƠN HÀNG #@order.OrderCode</h4>
                    <p class="text-muted small mb-0">Ngày đặt: @order.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
                </div>
                <div class="status-indicator @(order.Status == "Cancelled" ? "bg-light text-muted" : "status-shipping")">
                    <i class='bx @(order.Status == "Pending" ? "bx-time" : order.Status == "Cancelled" ? "bx-x-circle" : "bx-truck")'></i> 
                    @(order.StatusLabel ?? "Chờ xử lý")
                </div>
            </div>

            <!-- ORDER STATUS TIMELINE -->
            <div class="profile-section-card mb-4 shadow-sm">
                <div class="tracking-timeline-wrapper py-2">
                    <div class="tracking-timeline">
                        @{
                            var progress = order.Status == "Pending" || order.Status == "DangXuLy" ? 25 : order.Status == "Processing" ? 50 : order.Status == "Shipping" || order.Status == "DangGiao" ? 75 : order.Status == "Completed" || order.Status == "DaHoanThanh" ? 100 : 0;
                            if (order.Status == "Cancelled" || order.Status == "DaHuy") progress = 0;
                        }
                        <div class="timeline-progress" style="width: @progress%;"></div>
                        <div class="timeline-step @(progress >= 25 ? "completed" : "")">
                            <div class="step-icon-circle"><i class='bx bx-check'></i></div>
                            <div class="step-label">Đã đặt</div>
                        </div>
                        <div class="timeline-step @(progress >= 50 ? "completed" : "")">
                            <div class="step-icon-circle"><i class='bx bx-cog'></i></div>
                            <div class="step-label">Xử lý</div>
                        </div>
                        <div class="timeline-step @(progress >= 75 ? "completed" : "")">
                            <div class="step-icon-circle"><i class='bx bx-package'></i></div>
                            <div class="step-label">Đang giao</div>
                        </div>
                        <div class="timeline-step @(progress >= 100 ? "completed" : "")">
                            <div class="step-icon-circle"><i class='bx bx-home-heart'></i></div>
                            <div class="step-label">Hoàn tất</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- PRODUCT LIST -->
            <div class="profile-section-card p-0 overflow-hidden shadow-sm mb-4">
                <div class="p-4 border-bottom">
                    <h5 class="fw-bold mb-0">DANH SÁCH SẢN PHẨM</h5>
                </div>
                <div class="table-responsive">
                    <table class="table-custom">
                        <thead>
                            <tr>
                                <th>Sản phẩm</th>
                                <th>Đơn giá</th>
                                <th>Số lượng</th>
                                <th class="text-end">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach(var item in order.Items)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-3">
                                            <img src="@(string.IsNullOrEmpty(item.ProductImage) ? "/assets/img/elements/18.jpg" : item.ProductImage)" class="rounded-3 border" style="width: 50px; height: 50px; object-fit: cover;" alt="P">
                                            <div>
                                                <span class="text-dark fw-bold small d-block">@item.ProductName</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td>@item.UnitPrice.ToString("N0")đ</td>
                                    <td>@item.Quantity.ToString("D2")</td>
                                    <td class="text-end fw-bold">@((item.UnitPrice * item.Quantity).ToString("N0"))đ</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="row g-4 mb-4">
                <!-- SHIPPING INFO -->
                <div class="col-md-6">
                    <div class="profile-section-card h-100 shadow-sm">
                        <h6 class="info-card-title"><i class='bx bx-map-pin'></i> THÔNG TIN NHẬN HÀNG</h6>
                        <div class="info-card-content">
                            <p class="fw-bold mb-1">@currentCustomer?.FullName</p>
                            <p class="mb-1">@currentCustomer?.Phone</p>
                            <p class="mb-3">@Model.ShippingAddress</p>
                            <p class="mb-0"><span class="text-muted">Trạng thái thanh toán:</span><br>
                                <span class="badge @(order.PaymentStatus == "Paid" ? "bg-success" : "bg-warning")">@(order.PaymentStatus == "Paid" ? "Đã thanh toán" : "Chưa thanh toán")</span>
                            </p>
                        </div>
                    </div>
                </div>

                <!-- PAYMENT SUMMARY -->
                <div class="col-md-6">
                    <div class="profile-section-card h-100 shadow-sm">
                        <h6 class="info-card-title"><i class='bx bx-credit-card'></i> TÓM TẮT THANH TOÁN</h6>
                        <div class="info-card-content">
                            <div class="payment-summary-row">
                                <span class="text-muted">Tạm tính:</span>
                                <span>@order.TotalAmount.ToString("N0")đ</span>
                            </div>
                            <div class="payment-summary-row">
                                <span class="text-muted">Phí vận chuyển:</span>
                                <span class="text-success">Miễn phí</span>
                            </div>
                            @if (Model.Discount > 0)
                            {
                                <div class="payment-summary-row text-success">
                                    <span>Mã giảm giá (@Model.VoucherCode):</span>
                                    <span>-@Model.Discount.ToString("N0")đ</span>
                                </div>
                            }
                            <div class="payment-summary-row">
                                <span class="text-muted">Phương thức:</span>
                                <span class="fw-bold">@(order.PaymentMethod ?? "Tiền mặt (COD)")</span>
                            </div>
                            <div class="payment-summary-total">
                                <span>TỔNG CỘNG:</span>
                                <span>@order.TotalAmount.ToString("N0")đ</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ACTIONS -->
            <div class="d-flex gap-3 mt-4 flex-wrap">
                @if (order.CanCancel)
                {
                    <button onclick="cancelOrder(@order.Id)" class="btn btn-outline-danger rounded-pill px-4 fw-bold">
                        <i class='bx bx-x-circle me-2'></i> HỦY ĐƠN HÀNG
                    </button>
                }
                <button onclick="reorder(@order.Id)" class="btn btn-danger rounded-pill px-4 fw-bold">
                    <i class='bx bx-refresh me-2'></i> MUA LẠI ĐƠN HÀNG
                </button>
                <a href="mailto:support@motoshop.vn" class="btn btn-outline-dark rounded-pill px-4 fw-bold">
                    <i class='bx bx-support me-2'></i> LIÊN HỆ HỖ TRỢ
                </a>
            </div>

            @if (!string.IsNullOrEmpty(order.Note))
            {
                <div class="mt-4 p-3 bg-light rounded-3 border-start border-danger border-4">
                    <p class="small mb-0"><strong>Ghi chú đơn hàng:</strong> @order.Note</p>
                </div>
            }
        </div>
    </div>
</main>

<!-- REVIEW MODAL -->
<div class="modal fade" id="reviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Đánh giá sản phẩm</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <form id="reviewForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="productId" id="reviewProductId">
                    <input type="hidden" name="variantId" id="reviewVariantId">
                    
                    <div class="mb-3 text-center">
                        <p class="mb-1 fw-bold" id="reviewProductName"></p>
                        <p class="text-muted small" id="reviewVariantName"></p>
                    </div>

                    <div class="mb-4 text-center">
                        <label class="form-label d-block fw-bold mb-2">Chất lượng sản phẩm</label>
                        <div class="star-rating fs-2 text-warning">
                            <i class='bx bx-star rating-star' data-rating="1"></i>
                            <i class='bx bx-star rating-star' data-rating="2"></i>
                            <i class='bx bx-star rating-star' data-rating="3"></i>
                            <i class='bx bx-star rating-star' data-rating="4"></i>
                            <i class='bx bx-star rating-star' data-rating="5"></i>
                        </div>
                        <input type="hidden" name="rating" id="reviewRating" value="5">
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Bình luận của bạn</label>
                        <textarea name="comment" class="form-control rounded-3" rows="4" placeholder="Chia sẻ cảm nhận của bạn về sản phẩm này..."></textarea>
                    </div>

                    <button type="submit" class="btn btn-danger w-100 rounded-pill py-2 fw-bold">GỬI ĐÁNH GIÁ</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .rating-star { cursor: pointer; transition: 0.1s; }
        .rating-star:hover { transform: scale(1.1); }
        .bxs-star { color: #ffc107; }
    </style>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        const reviewModal = new bootstrap.Modal(document.getElementById('reviewModal'));
        
        function openReviewModal(pId, vId, pName, vName) {
            document.getElementById('reviewProductId').value = pId;
            document.getElementById('reviewVariantId').value = vId;
            document.getElementById('reviewProductName').innerText = pName;
            document.getElementById('reviewVariantName').innerText = 'Phân loại: ' + vName;
            reviewModal.show();
        }

        // Star Rating Logic
        document.querySelectorAll('.rating-star').forEach(star => {
            star.addEventListener('click', function() {
                const rating = this.dataset.rating;
                document.getElementById('reviewRating').value = rating;
                updateStars(rating);
            });
        });

        function updateStars(rating) {
            document.querySelectorAll('.rating-star').forEach(star => {
                if (star.dataset.rating <= rating) {
                    star.classList.replace('bx-star', 'bxs-star');
                } else {
                    star.classList.replace('bxs-star', 'bx-star');
                }
            });
        }

        document.getElementById('reviewForm').onsubmit = async function(e) {
            e.preventDefault();
            const btn = this.querySelector('button[type="submit"]');
            btn.disabled = true; btn.innerText = 'ĐANG GỬI...';

            try {
                const response = await fetch('/Review/SubmitReview', {
                    method: 'POST',
                    body: new FormData(this)
                });
                const data = await response.json();
                if (data.success) {
                    Swal.fire('Thành công', data.message, 'success').then(() => {
                        reviewModal.hide();
                        location.reload();
                    });
                } else {
                    Swal.fire('Lỗi', data.message, 'error');
                    btn.disabled = false; btn.innerText = 'GỬI ĐÁNH GIÁ';
                }
            } catch (e) {
                Swal.fire('Lỗi', 'Không thể kết nối đến máy chủ.', 'error');
                btn.disabled = false; btn.innerText = 'GỬI ĐÁNH GIÁ';
            }
        };

        async function cancelOrder(orderId) {
            const result = await Swal.fire({
                title: 'Hủy đơn hàng?',
                text: "Bạn có chắc chắn muốn hủy đơn hàng này không?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Đồng ý hủy',
                cancelButtonText: 'Bỏ qua'
            });

            if (result.isConfirmed) {
                try {
                    const response = await fetch(`/Order/CancelOrder/${orderId}`, {
                        method: 'POST',
                        headers: {
                            'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                        }
                    });
                    const data = await response.json();
                    if (data.success) {
                        Swal.fire('Thành công', data.message, 'success').then(() => location.reload());
                    } else {
                        Swal.fire('Lỗi', data.message, 'error');
                    }
                } catch (e) {
                    Swal.fire('Lỗi', 'Không thể kết nối đến máy chủ.', 'error');
                }
            }
        }

        function reorder(orderId) {
            Swal.fire('Thông báo', 'Tính năng mua lại đang được phát triển.', 'info');
        }
    </script>
}
