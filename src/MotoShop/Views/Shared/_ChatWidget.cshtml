@* Chat widget – Hỗ trợ MotoShop realtime (Deduplicated Version) *@

<div class="chat-widget-container">
    <!-- Nút mở chat duy nhất -->
    <button id="chatToggleButton" class="chat-toggle-btn shadow-lg">
        <i class='bx bx-message-rounded-dots'></i>
        <span class="chat-badge d-none" id="chatUnreadBadge">0</span>
    </button>

    <!-- Khung chat -->
    <div id="chatWindow" class="chat-window shadow-lg d-none">
        <div class="chat-header d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center">
                <div class="chat-avatar me-2">
                    <img src="/assets/img/avatars/1.png" alt="Admin" width="32" height="32" class="rounded-circle">
                    <span class="online-status"></span>
                </div>
                <div>
                    <div class="fw-bold small">Hỗ trợ MotoShop</div>
                    <div class="chat-status small">Phản hồi nhanh chóng</div>
                </div>
            </div>
            <button id="chatCloseButton" class="btn-close btn-close-white small"></button>
        </div>

        <div id="chatMessages" class="chat-messages p-3">
            <!-- Tin nhắn sẽ được append vào đây -->
        </div>

        <div class="chat-footer p-2 border-top">
            <div class="input-group input-group-sm">
                <input type="text" id="chatInput" class="form-control border-0 shadow-none" placeholder="Nhập tin nhắn..." autocomplete="off">
                <button class="btn btn-primary px-3 border-0" id="chatSendBtn">
                    <i class='bx bxs-send'></i>
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .chat-widget-container { position: fixed; bottom: 24px; right: 24px; z-index: 10000; }
    .chat-toggle-btn { width: 56px; height: 56px; border-radius: 50%; background: #e53e3e; border: none; color: white; font-size: 28px; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: all 0.3s ease; position: relative; }
    .chat-toggle-btn:hover { transform: scale(1.1); background: #c53030; }
    .chat-toggle-btn.active { transform: rotate(90deg); background: #2d3748; }
    
    .chat-badge { position: absolute; top: -2px; right: -2px; background: #48bb78; color: white; border-radius: 50%; width: 20px; height: 20px; font-size: 10px; display: flex; align-items: center; justify-content: center; border: 2px solid white; }
    
    .chat-window { position: absolute; bottom: 72px; right: 0; width: 340px; height: 480px; background: white; border-radius: 16px; display: flex; flex-direction: column; overflow: hidden; box-shadow: 0 12px 40px rgba(0,0,0,0.15); animation: chatFadeIn 0.3s ease; }
    
    @@keyframes chatFadeIn { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }

    .chat-header { background: #e53e3e; color: white; padding: 16px; }
    .chat-avatar { position: relative; }
    .online-status { position: absolute; bottom: 0; right: 0; width: 10px; height: 10px; background: #48bb78; border-radius: 50%; border: 2px solid #e53e3e; }
    .chat-status { font-size: 10px; opacity: 0.8; }
    
    .chat-messages { flex-grow: 1; overflow-y: auto; background: #f4f7f6; display: flex; flex-direction: column; padding: 15px !important; }
    .msg-bubble { max-width: 80%; padding: 10px 14px; border-radius: 18px; font-size: 13px; margin-bottom: 12px; position: relative; line-height: 1.5; }
    .msg-customer { background: #e53e3e; color: white; align-self: flex-end; border-bottom-right-radius: 4px; box-shadow: 0 2px 5px rgba(229,62,62,0.2); }
    .msg-admin { background: white; color: #1a202c; align-self: flex-start; border-bottom-left-radius: 4px; border: 1px solid #e2e8f0; box-shadow: 0 2px 5px rgba(0,0,0,0.03); }
    .msg-time { font-size: 9px; opacity: 0.5; margin-top: 4px; }
    .msg-customer .msg-time { text-align: right; color: #fff; }

    #chatInput:focus { background: #f8fafc; }
    
    @@media (max-width: 480px) {
        .chat-window { width: calc(100vw - 48px); height: 80vh; bottom: 70px; }
        .chat-widget-container { bottom: 20px; right: 20px; }
    }
</style>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
<script>
(function() {
    'use strict';
    
    let conversationId = null;
    let customerName = "Khách hàng";
    let unreadCount = 0;
    let isOpen = false;

    const btnToggle = document.getElementById('chatToggleButton');
    const windowChat = document.getElementById('chatWindow');
    const btnClose = document.getElementById('chatCloseButton');
    const inputMsg = document.getElementById('chatInput');
    const btnSend = document.getElementById('chatSendBtn');
    const containerMsgs = document.getElementById('chatMessages');
    const badge = document.getElementById('chatUnreadBadge');

    function getGuestSessionId() {
        let sid = localStorage.getItem('motorshop_guest_session_id');
        if (!sid) {
            sid = 'gs_' + Math.random().toString(36).substr(2, 9) + Date.now();
            localStorage.setItem('motorshop_guest_session_id', sid);
        }
        return sid;
    }

    // ── SignalR ──────────────────────────────────────────────────
    const connection = new signalR.HubConnectionBuilder()
        .withUrl('/chatHub')
        .withAutomaticReconnect()
        .build();

    connection.on('ReceiveMessage', function(msg) {
        appendMsg(msg.message, msg.senderType === 'Customer', new Date(msg.createdAt));
        if (!isOpen) {
            unreadCount++;
            updateBadge();
        } else {
            markAsRead();
        }
    });

    async function startChat() {
        try {
            await connection.start();
            await initConversation();
        } catch (err) {
            setTimeout(startChat, 5000);
        }
    }

    async function initConversation() {
        try {
            const sid = getGuestSessionId();
            const res = await fetch(`/api/chat/messages?guestSessionId=${sid}`);
            const result = await res.json();
            
            conversationId = result.conversationId;
            const messages = result.data || [];
            
            containerMsgs.innerHTML = '';
            if (messages.length === 0) {
                containerMsgs.innerHTML = '<div class="text-center small text-muted mb-3 mt-2">Chào mừng bạn! Chúng tôi có thể giúp gì cho bạn?</div>';
            } else {
                messages.forEach(m => appendMsg(m.message, m.senderType === 'Customer', new Date(m.createdAt)));
            }

            if (conversationId) {
                await connection.invoke('JoinConversation', conversationId);
            }
        } catch (e) {
            console.error('Chat init error:', e);
        }
    }

    function appendMsg(text, isMine, time) {
        const div = document.createElement('div');
        div.className = `msg-bubble ${isMine ? 'msg-customer' : 'msg-admin'}`;
        const timeStr = time.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' });
        
        div.innerHTML = `
            <div class="message-body">${esc(text)}</div>
            <div class="msg-time">${timeStr}</div>
        `;
        containerMsgs.appendChild(div);
        containerMsgs.scrollTop = containerMsgs.scrollHeight;
    }

    async function sendMsg() {
        const msg = inputMsg.value.trim();
        if (!msg) return;
        
        inputMsg.value = '';
        const sid = getGuestSessionId();

        try {
            const res = await fetch('/api/chat/send', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ guestSessionId: sid, message: msg })
            });
            const result = await res.json();
            
            if (result.success) {
                if (!conversationId) {
                    conversationId = result.conversationId;
                    await connection.invoke('JoinConversation', conversationId);
                }
                // Dùng SignalR để phát tin nhắn đi
                await connection.invoke('UserSendMessage', conversationId, msg, result.message.senderName);
            }
        } catch (e) {
            alert('Lỗi gửi tin nhắn.');
        }
    }

    function updateBadge() {
        if (unreadCount > 0) {
            badge.innerText = unreadCount;
            badge.classList.remove('d-none');
        } else {
            badge.classList.add('d-none');
        }
    }

    async function markAsRead() {
        if (!conversationId) return;
        unreadCount = 0;
        updateBadge();
        const sid = getGuestSessionId();
        await fetch(`/api/chat/read?guestSessionId=${sid}`, { method: 'POST' });
        await connection.invoke('MarkAsRead', conversationId, 'Customer');
    }

    function esc(s) { return String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); }

    btnToggle.onclick = () => {
        isOpen = !isOpen;
        windowChat.classList.toggle('d-none');
        btnToggle.classList.toggle('active');
        if (isOpen) {
            inputMsg.focus();
            markAsRead();
        }
    };
    
    btnClose.onclick = () => {
        isOpen = false;
        windowChat.classList.add('d-none');
        btnToggle.classList.remove('active');
    };

    btnSend.onclick = sendMsg;
    inputMsg.onkeypress = e => { if (e.key === 'Enter') sendMsg(); };

    startChat();
})();
</script>
