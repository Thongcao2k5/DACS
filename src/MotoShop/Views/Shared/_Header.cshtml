@using Microsoft.AspNetCore.Identity
@using MotoShop.Data.Interfaces
@using MotoShop.Data.Models
@using Microsoft.EntityFrameworkCore
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
@inject IUnitOfWork UnitOfWork

@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

    string? userDisplayName = null;
    if (SignInManager.IsSignedIn(User))
    {
        var user = await UserManager.GetUserAsync(User);
        if (user != null)
        {
            var customer = await UnitOfWork.Repository<Customer>().Find(c => c.UserId == user.Id).FirstOrDefaultAsync();
            userDisplayName = customer?.FullName;

            // Nếu chưa có FullName thì mới dùng UserName (Email)
            if (string.IsNullOrEmpty(userDisplayName))
            {
                userDisplayName = user.UserName;
            }

            // Nếu tên quá dài (ví dụ có họ và tên), lấy từ cuối cùng cho gọn
            if (!string.IsNullOrEmpty(userDisplayName) && userDisplayName.Contains(" "))
            {
                var names = userDisplayName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                userDisplayName = names[^1];
            }
        }
    }
}

<div class="top-header">
    <div class="container d-flex justify-content-between align-items-center">
        <div>
            <span class="me-3"><i class='bx bx-phone'></i> 028 123 4567</span>
            <span><i class='bx bx-envelope'></i> support@motoshop.vn</span>
        </div>
        <div class="fw-bold text-danger d-none d-md-block">Miễn phí vận chuyển cho đơn hàng từ 500k</div>
    </div>
</div>

<div class="container">
    <header class="main-header">
        <div class="header-logo">
            <a asp-area="" asp-controller="Home" asp-action="Index" class="text-decoration-none d-flex align-items-center">
                <i class='bx bxs-bolt-circle text-danger fs-1'></i>
                <span class="fs-3 fw-bolder text-dark ms-2">MOTO<span class="text-danger">SHOP</span></span>
            </a>
        </div>

        <div class="header-search">
            <form class="input-group" asp-area="" asp-controller="Product" asp-action="Index" method="get">
                <input type="text" name="searchTerm" class="form-control search-input" placeholder="Tìm tên phụ tùng, thương hiệu..." value="@Context.Request.Query["searchTerm"]">
                <button class="btn search-btn" type="submit"><i class='bx bx-search'></i></button>
            </form>
        </div>

        <div class="header-actions">
            <div class="action-item">
                <a asp-area="" asp-controller="Account" asp-action="Profile" class="text-dark d-flex align-items-center text-decoration-none user-action-link">
                    <i class='bx bx-user fs-4'></i>
                    @if (userDisplayName != null)
                    {
                        <span class="ms-1 fw-semibold user-name-text d-none d-md-inline">@userDisplayName</span>
                    }
                </a>
                <div class="dropdown-menu-custom shadow-lg">
                    <ul class="list-unstyled mb-0">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            <li><a asp-controller="Account" asp-action="Profile" class="dropdown-item-custom"><i class='bx bx-user me-2'></i> Hồ sơ</a></li>
                            <li><a asp-controller="Account" asp-action="Orders" class="dropdown-item-custom"><i class='bx bx-package me-2'></i> Đơn hàng</a></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="dropdown-item-custom border-0 bg-transparent w-100 text-start text-danger"><i class='bx bx-log-out me-2'></i> Đăng xuất</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li><a asp-controller="Account" asp-action="Login" class="dropdown-item-custom"><i class='bx bx-log-in me-2'></i> Đăng nhập</a></li>
                            <li><a asp-controller="Account" asp-action="Register" class="dropdown-item-custom"><i class='bx bx-user-plus me-2'></i> Đăng ký</a></li>
                        }
                    </ul>
                </div>
            </div>

            <div class="action-item cart-action-item">
                <a asp-controller="Cart" asp-action="Index" class="text-dark position-relative">
                    <i class='bx bx-cart fs-4'></i>
                    <span class="badge rounded-pill bg-danger cart-badge-floating" id="cartBadge">0</span>
                </a>
            </div>
        </div>
    </header>
</div>

<nav class="nav-header d-none d-lg-block sticky-top shadow-sm">
    <div class="container position-relative">
        <ul class="nav-list">
            <li><a asp-controller="Home" asp-action="Index" class="nav-link-main @(currentController == "Home" ? "active" : "")">TRANG CHỦ</a></li>
            <li class="mega-menu-wrapper position-static">
                <a href="/Product" class="nav-link-main">DANH MỤC <i class='bx bx-chevron-down ms-1'></i></a>
                @await Component.InvokeAsync("CategoryMenu")
            </li>
            <li><a asp-controller="Service" asp-action="Index" class="nav-link-main">DỊCH VỤ</a></li>
            <li><a asp-controller="Product" asp-action="Promotion" class="nav-link-main">KHUYẾN MÃI</a></li>
            <li><a asp-controller="Blog" asp-action="Index" class="nav-link-main @(currentController == "Blog" ? "active" : "")">TIN TỨC</a></li>
            <li><a asp-controller="Info" asp-action="Contact" class="nav-link-main">LIÊN HỆ</a></li>
        </ul>
    </div>
</nav>

<style>
    /* CSS cho Header và Mega Menu */
    .nav-header { background: #fff; border-bottom: 1px solid #eee; z-index: 1000; }
    .nav-list { display: flex; justify-content: center; list-style: none; margin: 0; padding: 0; }
    .nav-link-main { 
        color: #333; font-weight: 700; padding: 15px 25px; display: block; 
        text-decoration: none; transition: 0.3s; font-size: 0.9rem;
        text-transform: uppercase;
    }
    .nav-link-main:hover, .nav-link-main.active { color: #dc3545; }

    .main-header { display: flex; align-items: center; justify-content: space-between; padding: 18px 0; }
    .header-search { flex: 0 0 45%; }
    .search-input { border-radius: 50px 0 0 50px; border: 2px solid #eee; padding-left: 20px; height: 45px; }
    .search-btn { border-radius: 0 50px 50px 0; background: #333; color: #fff; padding: 0 25px; height: 45px; }
    
    .header-actions { display: flex; gap: 20px; }
    .action-item { position: relative; }
    .dropdown-menu-custom {
        position: absolute; top: 100%; right: 0; min-width: 180px;
        background: #fff; border-radius: 8px; display: none; z-index: 1060;
        padding: 10px 0; box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        border: 1px solid #f0f0f0;
    }
    .action-item:hover .dropdown-menu-custom { display: block; }
    .dropdown-item-custom {
        display: flex; align-items: center; padding: 10px 20px; color: #333;
        text-decoration: none; font-size: 0.85rem; transition: 0.2s;
    }
    .dropdown-item-custom:hover { background: #f8f9fa; color: #dc3545; }

    .cart-badge-floating {
        position: absolute; top: -8px; right: -12px; font-size: 0.7rem;
        padding: 3px 6px;
    }

    .user-name-text {
        font-size: 0.75rem;
        color: #555;
        max-width: 80px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        line-height: 1;
    }

    .user-action-link:hover .user-name-text {
        color: #dc3545;
    }
</style>

<script>
    // Xử lý lỗi ảnh toàn cục
    document.addEventListener('error', function (e) {
        if (e.target.tagName.toLowerCase() === 'img') {
            e.target.src = 'https://placehold.co/600x400/f8f9fa/dc3545?text=MotoShop+Part';
        }
    }, true);

    async function updateCartBadge() {
        try {
            const res = await fetch('/Cart/GetCartCount');
            const count = await res.json();
            document.getElementById('cartBadge').innerText = count;
        } catch (e) {}
    }
    document.addEventListener('DOMContentLoaded', updateCartBadge);
</script>
