@using Microsoft.AspNetCore.Identity
@using MotoShop.Data.Data
@using Microsoft.EntityFrameworkCore
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
@inject MotoShopDbContext _motoDb

@{
    var user = await UserManager.GetUserAsync(User);
    var customer = user != null ? await _motoDb.Customers.AsNoTracking().FirstOrDefaultAsync(c => c.UserId == user.Id) : null;
    var avatarUrl = !string.IsNullOrEmpty(customer?.AvatarUrl) ? customer.AvatarUrl : "/assets/img/avatars/1.png";
}

<div class="top-header">
    <div class="container d-flex justify-content-between align-items-center">
        <div>
            <a href="tel:0281234567" class="text-white text-decoration-none me-3"><i class='bx bx-phone'></i> 028 123 4567</a>
            <a href="mailto:support@motoshop.vn" class="text-white text-decoration-none"><i class='bx bx-envelope'></i> support@motoshop.vn</a>
        </div>
        <div class="fw-bold text-danger d-none d-md-block">🔥 Miễn phí vận chuyển cho đơn hàng từ 500k</div>
    </div>
</div>

<div class="container">
    <header class="main-header">
        <div class="header-logo">
            <a asp-area="" asp-controller="Home" asp-action="Index" class="text-decoration-none d-flex align-items-center">
                <i class='bx bxs-bolt-circle text-danger fs-1'></i>
                <span class="fs-3 fw-bolder text-dark ms-2">MOTO<span class="text-danger">SHOP</span></span>
            </a>
        </div>
        
        <div class="header-search">
            <form class="input-group" asp-area="" asp-controller="Product" asp-action="Index" method="get">
                <input type="text" name="searchTerm" class="form-control search-input" placeholder="Tìm tên phụ tùng, thương hiệu..." value="@Context.Request.Query["searchTerm"]">
                <button class="btn search-btn" type="submit"><i class='bx bx-search'></i></button>
            </form>
        </div>

        <div class="header-actions">
            <div class="action-item shrink-search-toggle" onclick="UI.toggleSearch()">
                <i class='bx bx-search'></i>
            </div>
            
            <div class="action-item">
                <a asp-area="" asp-controller="Account" asp-action="Profile" class="text-dark d-flex align-items-center">
                    <i class='bx bx-user'></i>
                </a>
                <div class="dropdown-menu-custom shadow-lg">
                    <div class="dropdown-header-custom">
                        <div class="d-flex align-items-center mb-2">
                            <div class="avatar-circle me-2">
                                <img src="@avatarUrl" class="rounded-circle w-100 h-100 object-fit-cover" alt="User" onerror="this.src='/assets/img/avatars/1.png'">
                            </div>
                            <div>
                                @if (SignInManager.IsSignedIn(User))
                                {
                                    <div class="fw-bold text-dark small text-truncate" style="max-width: 150px;">@User.Identity?.Name</div>
                                    <div class="text-muted" style="font-size: 0.7rem;">Thành viên</div>
                                }
                                else
                                {
                                    <div class="fw-bold text-dark small">Khách hàng</div>
                                    <div class="text-muted" style="font-size: 0.7rem;">Chào mừng bạn!</div>
                                }
                            </div>
                        </div>
                    </div>
                    <ul class="list-unstyled mb-0">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            @if (User.IsInRole("Admin"))
                            {
                                <li>
                                    <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="dropdown-item-custom text-primary fw-bold">
                                        <i class='bx bx-shield-quarter me-2'></i> <span>TRANG QUẢN TRỊ</span>
                                    </a>
                                </li>
                            }
                            <li>
                                <a asp-area="" asp-controller="Account" asp-action="Profile" class="dropdown-item-custom">
                                    <i class='bx bx-user me-2'></i> <span>Hồ sơ cá nhân</span>
                                </a>
                            </li>
                            <li>
                                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" id="logoutForm">
                                    <button type="submit" class="dropdown-item-custom border-0 bg-transparent w-100 text-start">
                                        <i class='bx bx-log-out-circle me-2'></i> <span>Đăng xuất</span>
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li>
                                <a asp-area="" asp-controller="Account" asp-action="Login" class="dropdown-item-custom">
                                    <i class='bx bx-log-in-circle me-2'></i> <span>Đăng nhập</span>
                                </a>
                            </li>
                            <li>
                                <a asp-area="" asp-controller="Account" asp-action="Register" class="dropdown-item-custom">
                                    <i class='bx bx-user-plus me-2'></i> <span>Đăng ký thành viên</span>
                                </a>
                            </li>
                        }
                        <li><hr class="dropdown-divider my-2"></li>
                        <li>
                            <a asp-area="" asp-controller="Order" asp-action="Index" class="dropdown-item-custom">
                                <i class='bx bx-package me-2'></i> <span>Đơn hàng của tôi</span>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>

            <div class="action-item">
                <a asp-area="" asp-controller="Account" asp-action="Wishlist" class="text-dark position-relative d-inline-block">
                    <i class='bx bx-heart'></i>
                    <span class="badge rounded-pill bg-danger cart-badge-floating" id="wishlistBadge" style="display: none;">0</span>
                </a>
            </div>

            <div class="action-item cart-action-item" id="cartActionItem">
                <a asp-area="" asp-controller="Cart" asp-action="Index" class="text-dark position-relative d-inline-block">
                    <i class='bx bx-cart'></i>
                    <span class="badge rounded-pill bg-danger cart-badge-floating" id="cartBadge">0</span>
                </a>
            </div>
        </div>
    </header>
</div>

<script>
    async function updateCartBadge() {
        try {
            const response = await fetch('/Cart/GetCartCount');
            const count = await response.json();
            const badge = document.getElementById('cartBadge');
            if (badge) {
                badge.innerText = count;
                badge.style.display = count > 0 ? 'block' : 'none';
            }
        } catch (error) {
            console.error('Error updating cart badge:', error);
        }
    }

    async function updateWishlistBadge() {
        try {
            const response = await fetch('/Wishlist/GetCount');
            const data = await response.json();
            const badge = document.getElementById('wishlistBadge');
            if (badge) {
                badge.innerText = data.count;
                badge.style.display = data.count > 0 ? 'block' : 'none';
            }
        } catch (error) {
            console.error('Error updating wishlist badge:', error);
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
        updateCartBadge();
        updateWishlistBadge();
    });
</script>

@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var currentArea = ViewContext.RouteData.Values["area"]?.ToString();
}

<nav class="nav-header d-none d-lg-block">
    <div class="container">
        <ul class="nav-list">
            <li><a asp-area="" asp-controller="Home" asp-action="Index" class="nav-link-main @(currentController == "Home" ? "active" : "")">TRANG CHỦ</a></li>
            <li><a asp-area="" asp-controller="Product" asp-action="Index" class="nav-link-main @(currentController == "Product" && currentAction == "Index" ? "active" : "")">DANH MỤC</a></li>
            <li><a asp-area="" asp-controller="Service" asp-action="Index" class="nav-link-main @(currentController == "Service" ? "active" : "")">DỊCH VỤ</a></li>
            <li><a asp-area="" asp-controller="Product" asp-action="Promotion" class="nav-link-main @(currentController == "Product" && currentAction == "Promotion" ? "active" : "")">KHUYẾN MÃI HOT</a></li>
            <li><a asp-area="" asp-controller="Blog" asp-action="Index" class="nav-link-main @(currentController == "Blog" ? "active" : "")">TIN TỨC</a></li>
            <li><a asp-area="" asp-controller="Info" asp-action="Contact" class="nav-link-main @(currentController == "Info" ? "active" : "")">LIÊN HỆ</a></li>
        </ul>
    </div>
</nav>

<style>
    .cart-badge-floating {
        position: absolute;
        top: -5px;
        right: -10px;
        font-size: 0.65rem;
        padding: 0.25em 0.5em;
        border: 2px solid white;
    }
    .cart-action-item {
        position: relative;
    }
    .cart-success-toast {
        position: absolute;
        top: calc(100% + 15px);
        right: -10px;
        min-width: 260px;
        max-width: 300px;
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 18px;
        background: #198754;
        color: #fff;
        border-radius: 16px;
        box-shadow: 0 20px 40px rgba(25, 135, 84, 0.3);
        font-size: 0.9rem;
        font-weight: 600;
        line-height: 1.4;
        opacity: 0;
        visibility: hidden;
        transform: translateY(10px) scale(0.95);
        transition: all 0.3s cubic-bezier(0.68, -0.55, 0.265, 1.55);
        z-index: 999999; /* Đẩy lên mức tối đa */
        pointer-events: auto;
    }
    .cart-success-toast::before {
        content: "";
        position: absolute;
        top: -6px;
        right: 24px;
        width: 12px;
        height: 12px;
        background: #198754;
        transform: rotate(45deg);
        border-radius: 2px;
    }
    .cart-success-toast.show {
        opacity: 1;
        visibility: visible;
        transform: translateY(0) scale(1);
    }
    .cart-success-toast i {
        font-size: 1.15rem;
        flex-shrink: 0;
    }
    .cart-highlight > a {
        color: #198754 !important;
    }
    .avatar-circle {
        width: 35px;
        height: 35px;
        border-radius: 50%;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 2px solid #eee;
    }
    .main-header { display: flex; align-items: center; justify-content: space-between; padding: 15px 0; }
    .header-actions { display: flex; align-items: center; gap: 15px; }
    .action-item { position: relative; cursor: pointer; }
    .dropdown-menu-custom { 
        position: absolute; top: 100%; right: 0; min-width: 220px; 
        background: white; border-radius: 8px; display: none; z-index: 1000;
    }
    .action-item:hover .dropdown-menu-custom { display: block; }
    .dropdown-item-custom { 
        display: flex; align-items: center; padding: 10px 15px; 
        color: #333; text-decoration: none; transition: 0.2s; 
    }
    .dropdown-item-custom:hover { background: #f8f9fa; color: #dc3545; }
    .nav-link-main {
        color: #333;
        font-weight: 600;
        font-size: 1.1rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        transition: 0.2s ease-in-out;
        text-decoration: none;
        padding: 10px 15px;
        display: inline-block;
    }
    .nav-link-main:hover, .nav-link-main.active {
        color: #dc3545 !important;
        background: transparent;
    }
    .nav-list {
        display: flex;
        justify-content: center;
        list-style: none;
        margin: 0;
        padding: 0;
        gap: 10px;
    }
    .nav-header {
        border-bottom: 1px solid #eee;
        background: #fff;
    }
    @@media (max-width: 991.98px) {
        .cart-success-toast {
            right: -8px;
            min-width: 220px;
            max-width: min(260px, 75vw);
        }
    }
</style>
