<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MotoShop</title>
    
    <!-- Fonts & Icons -->
    <link href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        .btn-wishlist-abs {
            position: absolute;
            top: 15px;
            right: 15px;
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: white;
            border: none;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #ccc;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            transition: all 0.3s ease;
            z-index: 5;
            cursor: pointer;
        }
        .btn-wishlist-abs:hover {
            color: #dc3545;
            transform: scale(1.1);
            box-shadow: 0 4px 12px rgba(220, 53, 69, 0.2);
        }
        .btn-wishlist-abs.active {
            color: #dc3545;
        }
        .product-img-wrapper:hover .btn-wishlist-abs {
            opacity: 1;
            visibility: visible;
        }
    </style>
    
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- UI UTILITIES -->
    <div id="pageLoader" style="display: none !important;"><div class="loader-spinner"></div></div>
    <div id="backToTop" class="back-to-top">
        <i class='bx bx-chevron-up'></i>
    </div>

    <!-- COMMON COMPONENTS -->
    <div id="mainHeaderWrapper" class="main-header-wrapper">
        <partial name="_Header" />
    </div>
    
    <div id="searchOverlay" class="search-overlay" style="display: none;">
        <partial name="_SearchOverlay" />
    </div>
    
    <div id="mobileMenu" class="offcanvas offcanvas-start mobile-menu-offcanvas" tabindex="-1">
        <partial name="_MobileMenu" />
    </div>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="bg-dark text-white py-5 mt-5">
        <partial name="_Footer" />
    </footer>

    <!-- Scripts Order: 1. jQuery, 2. Bootstrap, 3. UI Logic -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/header.js" asp-append-version="true"></script>
    <script src="~/js/components.js" asp-append-version="true"></script>
    
    <script>
        async function addToWishlist(productId) {
            try {
                const response = await fetch('/Wishlist/Add', {
                    method: 'POST',
                    headers: { 
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                    },
                    body: JSON.stringify(productId)
                });
                
                const data = await response.json();
                
                if (data.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Thành công!',
                        text: data.message,
                        showConfirmButton: false,
                        timer: 1500,
                        toast: true,
                        position: 'top-end'
                    });
                    
                    // Cập nhật con số trên header
                    if (typeof updateWishlistBadge === 'function') {
                        updateWishlistBadge();
                    }
                    
                    // Tìm tất cả các nút wishlist có productId này và đổi màu
                    document.querySelectorAll(`button[onclick="addToWishlist(${productId})"]`).forEach(btn => {
                        btn.classList.add('active');
                        btn.querySelector('i').classList.replace('bx-heart', 'bxs-heart');
                    });
                } else {
                    if (response.status === 401 || (data.message && data.message.includes('đăng nhập'))) {
                        Swal.fire({
                            title: 'Yêu cầu đăng nhập',
                            text: 'Vui lòng đăng nhập để sử dụng tính năng này!',
                            icon: 'info',
                            showCancelButton: true,
                            confirmButtonText: 'Đăng nhập ngay',
                            cancelButtonText: 'Để sau'
                        }).then((result) => {
                            if (result.isConfirmed) {
                                window.location.href = '/Account/Login?returnUrl=' + encodeURIComponent(window.location.pathname);
                            }
                        });
                    } else {
                        Swal.fire('Thông báo', data.message, 'info');
                    }
                }
            } catch (error) {
                console.error('Lỗi Wishlist:', error);
                Swal.fire('Lỗi', 'Không thể kết nối đến máy chủ.', 'error');
            }
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
