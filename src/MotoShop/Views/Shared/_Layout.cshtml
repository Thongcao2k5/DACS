<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MotoShop</title>
    
    <!-- Preconnect để rút ngắn DNS/TLS handshake cho CDN -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preconnect" href="https://unpkg.com">
    <link rel="preconnect" href="https://cdn.jsdelivr.net">
    <link rel="preconnect" href="https://code.jquery.com">

    <!-- Google Fonts: async để không block rendering -->
    <link rel="preload" as="style"
          href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@300;400;500;600;700;800&display=swap"
          onload="this.rel='stylesheet'">
    <noscript>
        <link href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    </noscript>

    <!-- Boxicons: async -->
    <link rel="preload" as="style"
          href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css"
          onload="this.rel='stylesheet'">
    <noscript>
        <link href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet">
    </noscript>

    <!-- Font Awesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true">
    <!-- SweetAlert2 đã chuyển xuống cuối body -->
    <style>
        .btn-wishlist-abs {
            position: absolute;
            top: 15px;
            right: 15px;
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: white;
            border: none;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #ccc;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            transition: all 0.3s ease;
            z-index: 5;
            cursor: pointer;
        }
        .btn-wishlist-abs:hover {
            color: #dc3545;
            transform: scale(1.1);
            box-shadow: 0 4px 12px rgba(220, 53, 69, 0.2);
        }
        .btn-wishlist-abs.active {
            color: #dc3545;
        }
        .product-img-wrapper:hover .btn-wishlist-abs {
            opacity: 1;
            visibility: visible;
        }
    </style>
    
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @Html.AntiForgeryToken()
    <!-- UI UTILITIES -->
    <div id="pageLoader" style="display: none !important;"><div class="loader-spinner"></div></div>

    <!-- UNIFIED TOAST CONTAINER -->
    <div id="toastContainer" style="position:fixed;top:20px;right:20px;z-index:9999;display:flex;flex-direction:column;gap:8px"></div>

    <!-- COMMON COMPONENTS -->
    <div id="mainHeaderWrapper" class="main-header-wrapper">
        <partial name="_Header" />
    </div>
    
    <div id="searchOverlay" class="search-overlay" style="display: none;">
        <partial name="_SearchOverlay" />
    </div>
    
    <div id="mobileMenu" class="offcanvas offcanvas-start mobile-menu-offcanvas" tabindex="-1">
        <partial name="_MobileMenu" />
    </div>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="bg-dark text-white py-5 mt-5">
        <partial name="_Footer" />
    </footer>

    <!-- Scripts Order: 1. jQuery, 2. Bootstrap, 3. SweetAlert2, 4. UI Logic -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>

    <script>
        // GLOBAL AJAX ANTI-FORGERY TOKEN SETUP
        (function() {
            function getAntiforgeryToken() {
                return document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            }
            
            // 1. Setup cho jQuery AJAX
            if (typeof $ !== 'undefined') {
                $.ajaxSetup({
                    beforeSend: function(xhr, settings) {
                        if (!/^(GET|HEAD|OPTIONS|TRACE)$/i.test(settings.type) && !this.crossDomain) {
                            const token = getAntiforgeryToken();
                            if (token) xhr.setRequestHeader("X-XSRF-TOKEN", token);
                        }
                    }
                });
            }

            // 2. Intercept Fetch API
            const originalFetch = window.fetch;
            window.fetch = async function(resource, config) {
                if (config && config.method && !/^(GET|HEAD|OPTIONS|TRACE)$/i.test(config.method)) {
                    const token = getAntiforgeryToken();
                    if (token) {
                        config.headers = config.headers || {};
                        if (config.headers instanceof Headers) {
                            if (!config.headers.has('X-XSRF-TOKEN')) config.headers.append('X-XSRF-TOKEN', token);
                        } else {
                            if (!config.headers['X-XSRF-TOKEN']) config.headers['X-XSRF-TOKEN'] = token;
                        }
                    }
                }
                return originalFetch(resource, config);
            };
        })();
    </script>

    <script src="~/js/header.js" asp-append-version="true"></script>
    <script src="~/js/components.js" asp-append-version="true"></script>
    
    <script>
        async function addToWishlist(productId) {
            try {
                const response = await fetch('/Wishlist/Add', {
                    method: 'POST',
                    headers: { 
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                    },
                    body: JSON.stringify(productId)
                });
                
                const data = await response.json();
                
                if (data.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Thành công!',
                        text: data.message,
                        showConfirmButton: false,
                        timer: 1500,
                        toast: true,
                        position: 'top-end'
                    });
                    
                    // Cập nhật con số trên header
                    if (typeof updateWishlistBadge === 'function') {
                        updateWishlistBadge();
                    }
                } else {
                    Swal.fire('Thông báo', data.message, 'info');
                }
            } catch (error) {
                console.error('Lỗi Wishlist:', error);
            }
        }
    </script>

    <!-- MOTO-SHOP ADD-ONS (Tính năng bổ sung) -->
    <script src="~/js/review-addon.js" asp-append-version="true"></script>
    <script src="~/js/cart-handler.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <partial name="_ChatWidget" />
</body>
</html>
