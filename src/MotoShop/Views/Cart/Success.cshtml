@model MotoShop.Data.Models.Order
@{
    ViewData["Title"] = "Đặt hàng thành công";
}

<main class="container">
    <div class="success-container">
        <!-- 1. SUCCESS MESSAGE -->
        <div class="success-icon-wrapper">
            <i class='bx bx-check'></i>
        </div>
        <h1 class="fw-bold text-dark mb-2">ĐẶT HÀNG THÀNH CÔNG!</h1>
        <p class="text-muted mb-5">Cảm ơn bạn đã mua sắm tại <span class="text-danger fw-bold">MotoShop</span>. Đơn hàng của bạn đã được ghi nhận và đang được xử lý.</p>

        <div class="row g-4 text-start">
            <div class="col-lg-7">
                <!-- 2. ORDER INFORMATION -->
                <div class="order-info-card">
                    <h5 class="fw-bold mb-4 border-bottom pb-3">THÔNG TIN ĐƠN HÀNG</h5>
                    <div class="info-grid">
                        <div>
                            <span class="info-label">Mã đơn hàng</span>
                            <span class="info-value">#@(Model.OrderCode ?? Model.OrderId.ToString("D6"))</span>
                        </div>
                        <div>
                            <span class="info-label">Ngày đặt hàng</span>
                            <span class="info-value">@Model.OrderDate.ToString("dd/MM/yyyy")</span>
                        </div>
                        <div>
                            <span class="info-label">Phương thức thanh toán</span>
                            <span class="info-value">@(Model.PaymentMethod == "VNPay" ? "Thanh toán VNPay" : (Model.PaymentMethod ?? "Thanh toán khi nhận hàng (COD)"))</span>
                        </div>
                    </div>

                    <div class="mt-4 pt-4 border-top">
                        <span class="info-label">Địa chỉ giao hàng</span>
                        <span class="info-value">@Model.ShippingAddress</span>
                        @if (!string.IsNullOrEmpty(Model.Note))
                        {
                            <div class="mt-2">
                                <span class="info-label">Ghi chú:</span>
                                <span class="info-value text-muted small">@Model.Note</span>
                            </div>
                        }
                    </div>
                </div>

                <!-- 3. ORDER SUMMARY -->
                <div class="order-info-card">
                    <h5 class="fw-bold mb-4 border-bottom pb-3">SẢN PHẨM ĐÃ ĐẶT (@(Model.OrderItems?.Count ?? 0))</h5>
                    <ul class="summary-items-list mb-0 list-unstyled">
                        @if (Model.OrderItems != null)
                        {
                            foreach (var item in Model.OrderItems)
                            {
                                <li class="summary-item-product d-flex align-items-center gap-3 mb-3 pb-3 border-bottom">
                                    <div class="summary-item-img" style="width: 60px; height: 60px; flex-shrink: 0;">
                                        <img src="@(string.IsNullOrEmpty(item.ProductVariant?.ImageUrl) ? "/assets/img/elements/18.jpg" : item.ProductVariant.ImageUrl)" 
                                             class="w-100 h-100 object-fit-cover rounded" alt="Product">
                                    </div>
                                    <div class="summary-item-info flex-grow-1">
                                        <span class="name fw-bold d-block">@(item.ProductVariant?.Product?.ProductName ?? "Sản phẩm")</span>
                                        <span class="qty-price text-muted small">@(item.ProductVariant?.VariantName) | Số lượng: @item.Quantity x @item.Price.ToString("N0")đ</span>
                                    </div>
                                    <div class="fw-bold">@((item.Quantity * item.Price).ToString("N0"))đ</div>
                                </li>
                            }
                        }
                    </ul>
                    <div class="mt-4 pt-4 border-top">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Tạm tính (Giá niêm yết)</span>
                            @{
                                // Tính tổng giá gốc của các sản phẩm (trước khi có bất kỳ khuyến mãi nào)
                                decimal subtotalOriginal = Model.OrderItems?.Sum(i => (i.ProductVariant?.Price ?? i.Price) * i.Quantity) ?? 0;
                                // Tính tổng khuyến mãi sản phẩm (Promotion)
                                decimal promotionSavings = Model.OrderItems?.Sum(i => ((i.ProductVariant?.Price ?? i.Price) - i.Price) * i.Quantity) ?? 0;
                            }
                            <span class="fw-bold">@subtotalOriginal.ToString("N0")đ</span>
                        </div>
                        
                        @if (promotionSavings > 0)
                        {
                            <div class="d-flex justify-content-between mb-2 text-danger">
                                <span class="fw-bold"><i class='bx bxs-hot me-1'></i> Khuyến mãi sản phẩm</span>
                                <span class="fw-bold">-@promotionSavings.ToString("N0")đ</span>
                            </div>
                        }

                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Phí vận chuyển (@(Model.ShippingMethod?.Name ?? "Tiêu chuẩn"))</span>
                            <span class="fw-bold">@(Model.ShippingMethod?.Cost.ToString("N0") ?? "0")đ</span>
                        </div>
                        
                        @if (Model.DiscountAmount > 0)
                        {
                            <div class="d-flex justify-content-between mb-2 text-success">
                                <span class="fw-bold">
                                    <i class='bx bxs-coupon me-1'></i> Giảm giá Voucher
                                </span>
                                <span class="fw-bold">-@Model.DiscountAmount.ToString("N0")đ</span>
                            </div>
                        }
                        
                        <div class="d-flex justify-content-between mt-2 pt-2 border-top">
                            <span class="fw-bold fs-5">TỔNG CỘNG</span>
                            <span class="fw-bold fs-5 text-danger">@Model.TotalAmount.ToString("N0")đ</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 4. NEXT ACTIONS -->
            <div class="col-lg-5">
                <div class="action-buttons-group">
                    <h5 class="fw-bold mb-3 text-center text-lg-start">BƯỚC TIẾP THEO?</h5>
                    <a href="/Order/Tracking/@Model.OrderId" class="btn btn-danger btn-lg rounded-pill fw-bold w-100 d-flex align-items-center justify-content-center mb-3">
                        <i class='bx bx-map-pin me-2 fs-4'></i> THEO DÕI ĐƠN HÀNG
                    </a>
                    <a href="/Product" class="btn btn-outline-dark btn-lg rounded-pill fw-bold w-100 d-flex align-items-center justify-content-center">
                        <i class='bx bx-shopping-bag me-2 fs-4'></i> TIẾP TỤC MUA HÀNG
                    </a>
                </div>

                <div class="mt-5 p-4 bg-light rounded-4">
                    <h6 class="fw-bold mb-3"><i class='bx bx-support text-danger me-2'></i> Cần hỗ trợ ngay?</h6>
                    <p class="small text-muted mb-0">Nếu bạn có bất kỳ thắc mắc nào về đơn hàng, vui lòng liên hệ Hotline: <span class="fw-bold text-dark">028 123 4567</span> hoặc chat trực tiếp với chúng tôi.</p>
                </div>
            </div>
        </div>
    </div>
</main>

<style>
    .success-container { text-align: center; padding: 40px 0; }
    .success-icon-wrapper { width: 80px; height: 80px; background: #e8f5e9; color: #4caf50; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 50px; margin: 0 auto 20px; }
    .order-info-card { background: #fff; border-radius: 20px; border: 1px solid #eee; padding: 30px; margin-bottom: 24px; }
    .info-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
    .info-label { display: block; color: #888; font-size: 13px; margin-bottom: 4px; }
    .info-value { display: block; color: #333; font-weight: 600; }
    
    .summary-item-product:last-child { border-bottom: none !important; margin-bottom: 0 !important; padding-bottom: 0 !important; }
</style>
