@using MotoShop.Business.DTOs
@using MotoShop.Data.Models
@model CheckoutDto
@{
    ViewData["Title"] = "Thanh toán";
    var cartItems = ViewBag.CartItems as List<CartItemDto> ?? new List<CartItemDto>();
    var totalAmount = (decimal)ViewBag.TotalAmount;
    var shippingMethods = ViewBag.ShippingMethods as List<ShippingMethod> ?? new List<ShippingMethod>();
}

<div class="breadcrumb-wrapper">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
                <li class="breadcrumb-item"><a href="/Cart">Giỏ hàng</a></li>
                <li class="breadcrumb-item active" aria-current="page">Thanh toán</li>
            </ol>
        </nav>
    </div>
</div>

<main class="container mb-5">
    <!-- 2. CHECKOUT STEPS -->
    <div class="checkout-steps">
        <div class="step-item completed">
            <div class="step-number"><i class='bx bx-check'></i></div>
            <span>Giỏ hàng</span>
        </div>
        <div class="step-line"></div>
        <div class="step-item active">
            <div class="step-number">2</div>
            <span>Thanh toán</span>
        </div>
        <div class="step-line"></div>
        <div class="step-item">
            <div class="step-number">3</div>
            <span>Hoàn tất</span>
        </div>
    </div>

    <form id="checkoutForm" method="post">
        @Html.AntiForgeryToken()
        <div class="row g-4">
            <!-- 3. LEFT COLUMN: INFORMATION -->
            <div class="col-lg-7">
                <!-- Customer Information -->
                <div class="checkout-section">
                    <h5 class="section-subtitle"><i class='bx bx-user-circle'></i> THÔNG TIN KHÁCH HÀNG</h5>
                    <div class="row g-3">
                        <div class="col-md-12">
                            <label asp-for="FullName" class="form-label-custom">Họ và tên *</label>
                            <input asp-for="FullName" type="text" class="form-control form-control-custom" placeholder="Nhập đầy đủ họ tên" required>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label-custom">Số điện thoại *</label>
                            <input asp-for="Phone" type="tel" class="form-control form-control-custom" placeholder="Nhập số điện thoại" required>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label-custom">Email (Không bắt buộc)</label>
                            <input asp-for="Email" type="email" class="form-control form-control-custom" placeholder="Nhập địa chỉ email">
                        </div>
                        
                        <!-- Address Selectors -->
                        <div class="col-md-4">
                            <label class="form-label-custom">Tỉnh/Thành phố *</label>
                            <select asp-for="Province" id="province" class="form-select form-control-custom" required>
                                <option value="">Chọn Tỉnh/Thành</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label-custom">Quận/Huyện *</label>
                            <select asp-for="District" id="district" class="form-select form-control-custom" required disabled>
                                <option value="">Chọn Quận/Huyện</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label-custom">Phường/Xã *</label>
                            <select asp-for="Ward" id="ward" class="form-select form-control-custom" required disabled>
                                <option value="">Chọn Phường/Xã</option>
                            </select>
                        </div>

                        <div class="col-md-12">
                            <label asp-for="Address" class="form-label-custom">Số nhà, tên đường *</label>
                            <input asp-for="Address" class="form-control form-control-custom" placeholder="Ví dụ: 123 Đường ABC..." required>
                        </div>
                        <div class="col-md-12">
                            <label asp-for="Note" class="form-label-custom">Ghi chú đơn hàng</label>
                            <textarea asp-for="Note" class="form-control form-control-custom" style="height: 80px; padding-top: 15px;" placeholder="Ví dụ: Giao sau 5h chiều, gọi trước khi giao..."></textarea>
                        </div>
                    </div>
                </div>

                <!-- Shipping Method -->
                <div class="checkout-section">
                    <h5 class="section-subtitle"><i class='bx bx-package'></i> PHƯƠNG THỨC VẬN CHUYỂN</h5>
                    @if (shippingMethods.Any())
                    {
                        @foreach (var method in shippingMethods)
                        {
                            <div class="method-card @(shippingMethods.First() == method ? "active" : "") mb-3" onclick="setShippingMethod(@method.Id, @method.Cost, this)">
                                <input type="radio" name="ShippingMethodId" value="@method.Id" id="ship_@method.Id" @(shippingMethods.First() == method ? "checked" : "")>
                                <div class="method-info">
                                    <label for="ship_@method.Id" class="name">@method.Name - @(method.Cost == 0 ? "Miễn phí" : method.Cost.ToString("N0") + "đ")</label>
                                    <span class="desc">@method.Description (@method.EstimatedDays)</span>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted">Không có phương thức vận chuyển khả dụng.</p>
                    }
                </div>

                <!-- Payment Method -->
                <div class="checkout-section">
                    <h5 class="section-subtitle"><i class='bx bx-credit-card-front'></i> PHƯƠNG THỨC THANH TOÁN</h5>
                    <div class="method-card active" onclick="setPayment('COD', 'cod-detail', this)">
                        <input type="radio" asp-for="PaymentMethod" value="COD" id="pay1" checked>
                        <div class="method-info">
                            <label for="pay1" class="name">Thanh toán khi nhận hàng (COD)</label>
                            <span class="desc">Thanh toán bằng tiền mặt khi shipper giao hàng</span>
                        </div>
                    </div>
                    <div id="cod-detail" class="payment-detail" style="display: block;">
                        Vui lòng chuẩn bị sẵn số tiền mặt tương ứng khi shipper liên hệ giao hàng.
                    </div>

                    <div class="method-card mt-3" onclick="setPayment('BankTransfer', 'bank-detail', this)">
                        <input type="radio" asp-for="PaymentMethod" value="BankTransfer" id="pay2">
                        <div class="method-info">
                            <label for="pay2" class="name">Chuyển khoản ngân hàng</label>
                            <span class="desc">Chuyển khoản qua ứng dụng ngân hàng hoặc cây ATM</span>
                        </div>
                    </div>
                    <div id="bank-detail" class="payment-detail">
                        <strong>Thông tin chuyển khoản:</strong><br>
                        Ngân hàng: Vietcombank - CN TP.HCM<br>
                        Số tài khoản: 0123 456 789<br>
                        Chủ TK: CTY TNHH MOTOSHOP<br>
                        Nội dung: [Họ tên] - [Số điện thoại]
                    </div>
                </div>
            </div>

            <!-- 4. RIGHT COLUMN: SUMMARY -->
            <div class="col-lg-5">
                <div class="cart-summary-card shadow-sm border-0 rounded-4 p-4 sticky-top" style="top: 100px;">
                    <h5 class="fw-bold mb-4">TÓM TẮT ĐƠN HÀNG</h5>
                    
                    <ul class="summary-items-list list-unstyled">
                        @foreach(var item in cartItems)
                        {
                            <li class="summary-item-product d-flex gap-3 mb-3 pb-3 border-bottom">
                                <div class="summary-item-img" style="width: 60px; height: 60px;">
                                    <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/assets/img/elements/no-image.png" : item.ImageUrl)" class="w-100 h-100 object-fit-cover rounded" alt="@item.ProductName">
                                </div>
                                <div class="summary-item-info flex-grow-1">
                                    <div class="name fw-bold small">@item.ProductName</div>
                                    <div class="qty-price text-muted x-small">
                                        Số lượng: @item.Quantity x 
                                        @if (item.PromotionDiscount > 0)
                                        {
                                            <span class="text-decoration-line-through me-1">@item.OriginalPrice.ToString("N0")đ</span>
                                            <span class="text-danger fw-bold">@item.Price.ToString("N0")đ</span>
                                        }
                                        else
                                        {
                                            <span>@item.Price.ToString("N0")đ</span>
                                        }
                                    </div>
                                </div>
                                <div class="fw-bold small">@item.Total.ToString("N0")đ</div>
                            </li>
                        }
                    </ul>

                    <!-- Coupon Input -->
                    <div class="coupon-section mb-4">
                        <label class="form-label small fw-bold">Mã giảm giá</label>
                        <div class="input-group">
                            <input type="text" asp-for="CouponCode" id="couponCode" class="form-control" placeholder="Nhập mã giảm giá">
                            <button type="button" class="btn btn-dark" onclick="applyCoupon()">Áp dụng</button>
                        </div>
                        <div id="couponMessage" class="small mt-1"></div>
                    </div>

                    <div class="mt-4 pt-2">
                        <div class="summary-item d-flex justify-content-between mb-2">
                            <span class="text-muted">Tạm tính (Giá niêm yết)</span>
                            <span class="fw-bold">@cartItems.Sum(i => i.TotalOriginal).ToString("N0")đ</span>
                        </div>
                        
                        @if (cartItems.Sum(i => i.TotalDiscount) > 0)
                        {
                            <div class="summary-item d-flex justify-content-between mb-2 text-danger">
                                <span class="fw-bold"><i class='bx bxs-hot me-1'></i> Khuyến mãi sản phẩm</span>
                                <span class="fw-bold">-@cartItems.Sum(i => i.TotalDiscount).ToString("N0")đ</span>
                            </div>
                        }

                        <div class="summary-item d-flex justify-content-between mb-2">
                            <span class="text-muted">Phí vận chuyển</span>
                            <span class="fw-bold" id="shippingFee" data-value="0">0đ</span>
                        </div>
                        
                        <div class="summary-item d-flex justify-content-between mb-2 d-none" id="discountRow">
                            <span class="text-muted">Mã giảm giá (Voucher)</span>
                            <span class="fw-bold text-success" id="discountAmount" data-value="0">-0đ</span>
                        </div>
                        
                        <div class="summary-item d-flex justify-content-between mb-2 d-none">
                            <!-- Hidden subtotal for JS calculations -->
                            <span id="subtotal" data-value="@totalAmount.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"></span>
                        </div>
                        <hr>
                        <div class="summary-total d-flex justify-content-between align-items-center mt-3">
                            <span class="fw-bold">TỔNG CỘNG</span>
                            <span class="price fs-4 fw-bolder text-danger" id="totalOrder" data-value="@totalAmount">@totalAmount.ToString("N0")đ</span>
                        </div>
                    </div>

                    <button type="submit" id="btnPlaceOrder" class="btn btn-danger btn-lg w-100 rounded-pill fw-bold mt-4 py-3 shadow-sm">
                        XÁC NHẬN ĐẶT HÀNG
                    </button>
                    
                    <p class="text-center mt-3 small text-muted">Bằng cách nhấn Đặt hàng, bạn đồng ý với <a href="#" class="text-dark">Điều khoản dịch vụ</a> của chúng tôi.</p>
                </div>
            </div>
        </div>
    </form>
</main>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // --- Address Data ---
        const provinceSelect = document.getElementById('province');
        const districtSelect = document.getElementById('district');
        const wardSelect = document.getElementById('ward');

        async function loadProvinces() {
            try {
                const response = await fetch('https://provinces.open-api.vn/api/p/');
                const data = await response.json();
                data.forEach(p => {
                    const option = document.createElement('option');
                    option.value = p.name;
                    option.text = p.name;
                    option.dataset.code = p.code;
                    provinceSelect.appendChild(option);
                });
            } catch (error) {
                console.error('Error loading provinces:', error);
            }
        }

        provinceSelect.addEventListener('change', async function() {
            const selectedOption = this.options[this.selectedIndex];
            const code = selectedOption.dataset.code;
            
            districtSelect.innerHTML = '<option value="">Chọn Quận/Huyện</option>';
            wardSelect.innerHTML = '<option value="">Chọn Phường/Xã</option>';
            districtSelect.disabled = true;
            wardSelect.disabled = true;

            if (code) {
                try {
                    const response = await fetch(`https://provinces.open-api.vn/api/p/${code}?depth=2`);
                    const data = await response.json();
                    data.districts.forEach(d => {
                        const option = document.createElement('option');
                        option.value = d.name;
                        option.text = d.name;
                        option.dataset.code = d.code;
                        districtSelect.appendChild(option);
                    });
                    districtSelect.disabled = false;
                } catch (error) {
                    console.error('Error loading districts:', error);
                }
            }
        });

        districtSelect.addEventListener('change', async function() {
            const selectedOption = this.options[this.selectedIndex];
            const code = selectedOption.dataset.code;
            
            wardSelect.innerHTML = '<option value="">Chọn Phường/Xã</option>';
            wardSelect.disabled = true;

            if (code) {
                try {
                    const response = await fetch(`https://provinces.open-api.vn/api/d/${code}?depth=2`);
                    const data = await response.json();
                    data.wards.forEach(w => {
                        const option = document.createElement('option');
                        option.value = w.name;
                        option.text = w.name;
                        option.dataset.code = w.code;
                        wardSelect.appendChild(option);
                    });
                    wardSelect.disabled = false;
                } catch (error) {
                    console.error('Error loading wards:', error);
                }
            }
        });

        loadProvinces();

        // --- Interaction Logic ---
        function setPayment(method, detailId, element) {
            document.querySelectorAll('.payment-detail').forEach(d => d.style.display = 'none');
            const detail = document.getElementById(detailId);
            if (detail) detail.style.display = 'block';
            
            const section = element.closest('.checkout-section');
            section.querySelectorAll('.method-card').forEach(c => c.classList.remove('active'));
            element.classList.add('active');
            element.querySelector('input').checked = true;
        }

        function setShippingMethod(id, cost, element) {
            const section = element.closest('.checkout-section');
            section.querySelectorAll('.method-card').forEach(c => c.classList.remove('active'));
            element.classList.add('active');
            element.querySelector('input').checked = true;

            document.getElementById('shippingFee').dataset.value = cost;
            document.getElementById('shippingFee').innerText = cost === 0 ? 'Miễn phí' : cost.toLocaleString('vi-VN') + 'đ';
            updateTotal();
        }

        function updateTotal() {
            const subtotal = parseFloat(document.getElementById('subtotal').dataset.value);
            const shipping = parseFloat(document.getElementById('shippingFee').dataset.value);
            const discount = parseFloat(document.getElementById('discountAmount').dataset.value);
            
            const total = subtotal + shipping - discount;
            const totalEl = document.getElementById('totalOrder');
            totalEl.dataset.value = total;
            totalEl.innerText = total.toLocaleString('vi-VN') + 'đ';
        }

        async function applyCoupon() {
            const code = document.getElementById('couponCode').value;
            const subtotal = parseFloat(document.getElementById('subtotal').dataset.value);
            const msgEl = document.getElementById('couponMessage');
            
            if (!code) return;

            // Simplified: This should ideally call an API to validate coupon
            // For now, we rely on the server side validation during checkout
            // But to give feedback to UI, we can call a quick check
            try {
                const response = await fetch(`/Cart/CheckCoupon?code=${code}&orderValue=${subtotal}`);
                const data = await response.json();
                
                if (data.success) {
                    msgEl.innerText = 'Áp dụng mã thành công: ' + data.message;
                    msgEl.className = 'small mt-1 text-success';
                    
                    const discRow = document.getElementById('discountRow');
                    const discEl = document.getElementById('discountAmount');
                    
                    discRow.classList.remove('d-none');
                    discEl.dataset.value = data.discountAmount;
                    discEl.innerText = '-' + data.discountAmount.toLocaleString('vi-VN') + 'đ';
                    updateTotal();
                } else {
                    msgEl.innerText = data.message;
                    msgEl.className = 'small mt-1 text-danger';
                }
            } catch (error) {
                msgEl.innerText = 'Không thể kiểm tra mã.';
                msgEl.className = 'small mt-1 text-danger';
            }
        }

        // Initialize first shipping method
        window.addEventListener('load', () => {
            const activeShip = document.querySelector('input[name="ShippingMethodId"]:checked');
            if (activeShip) {
                // Find parent method-card to get the cost if we had it there
                // For simplicity, let's trigger the click if it's already checked
                activeShip.closest('.method-card').click();
            }
        });

        document.getElementById('checkoutForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            
            const btn = document.getElementById('btnPlaceOrder');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Đang xử lý...';

            const formData = new FormData(this);

            try {
                const response = await fetch('/Cart/Checkout', {
                    method: 'POST',
                    body: formData
                });

                const data = await response.json();

                if (data.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Đặt hàng thành công!',
                        text: data.message,
                        showConfirmButton: false,
                        timer: 2000
                    }).then(() => {
                        window.location.href = '/Cart/Success/' + data.orderId;
                    });
                } else {
                    Swal.fire('Lỗi', data.message, 'error');
                    btn.disabled = false;
                    btn.innerHTML = 'XÁC NHẬN ĐẶT HÀNG';
                }
            } catch (error) {
                Swal.fire('Lỗi', 'Không thể kết nối đến máy chủ.', 'error');
                btn.disabled = false;
                btn.innerHTML = 'XÁC NHẬN ĐẶT HÀNG';
            }
        });
    </script>
}
