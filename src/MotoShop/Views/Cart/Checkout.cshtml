@using MotoShop.Business.DTOs
@using MotoShop.Data.Models
@model CheckoutDto
@{
    ViewData["Title"] = "Thanh toán";
    var cartItems = ViewBag.CartItems as List<CartItemDto> ?? new List<CartItemDto>();
    var totalAmount = (decimal)ViewBag.TotalAmount;
    var originalTotal = cartItems.Sum(i => i.TotalOriginal);
    var productDiscountTotal = cartItems.Sum(i => i.TotalDiscount);
    var shippingMethods = ViewBag.ShippingMethods as List<ShippingMethod> ?? new List<ShippingMethod>();
    var savedAddresses = ViewBag.SavedAddresses as List<AddressNew> ?? new List<AddressNew>();
    var defaultAddr = savedAddresses.FirstOrDefault(a => a.IsDefault) ?? savedAddresses.FirstOrDefault();
}

<div class="breadcrumb-wrapper">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
                <li class="breadcrumb-item"><a href="/Cart">Giỏ hàng</a></li>
                <li class="breadcrumb-item active" aria-current="page">Thanh toán</li>
            </ol>
        </nav>
    </div>
</div>

<main class="container mb-5">
    <div class="checkout-steps">
        <div class="step-item completed">
            <div class="step-number"><i class='bx bx-check'></i></div>
            <span>Giỏ hàng</span>
        </div>
        <div class="step-line"></div>
        <div class="step-item active">
            <div class="step-number">2</div>
            <span>Thanh toán</span>
        </div>
        <div class="step-line"></div>
        <div class="step-item">
            <div class="step-number">3</div>
            <span>Hoàn tất</span>
        </div>
    </div>

    <form id="checkoutForm" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="AddressId" id="inputAddressId" value="@defaultAddr?.Id">
        
        @if (ViewBag.IsDirectCheckout == true)
        {
            <input type="hidden" asp-for="DirectVariantId" value="@ViewBag.DirectVariantId">
            <input type="hidden" asp-for="DirectQuantity" value="@ViewBag.DirectQuantity">
        }

        <div class="row g-4">
            <!-- LEFT COLUMN -->
            <div class="col-lg-7">
                <div class="checkout-section">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="section-subtitle mb-0"><i class='bx bx-map'></i> ĐỊA CHỈ GIAO HÀNG</h5>
                        @if (savedAddresses.Any())
                        {
                            <button type="button" class="btn btn-link text-danger fw-bold p-0 text-decoration-none" data-bs-toggle="modal" data-bs-target="#addressModal">
                                Thay đổi
                            </button>
                        }
                    </div>

                    <div id="addressSummary" class="p-3 border rounded-3 bg-light @(savedAddresses.Any() ? "" : "d-none")">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="fw-bold" id="summaryName">@(defaultAddr?.FullName ?? "")</span>
                            <span class="text-muted">|</span>
                            <span class="fw-bold" id="summaryPhone">@(defaultAddr?.Phone ?? "")</span>
                            @if (defaultAddr?.IsDefault == true)
                            {
                                <span class="badge bg-danger x-small">Mặc định</span>
                            }
                        </div>
                        <div class="text-muted small" id="summaryAddress">
                            @(defaultAddr != null ? defaultAddr.Address : "Chưa có địa chỉ")
                        </div>
                    </div>

                    <div id="formInputs" class="@(savedAddresses.Any() ? "d-none" : "") mt-3">
                        <div class="row g-3">
                            <div class="col-md-12">
                                <label class="form-label-custom small fw-bold">Họ và tên *</label>
                                <input asp-for="FullName" id="inputFullName" class="form-control form-control-custom" placeholder="Nhập họ tên người nhận" value="@defaultAddr?.FullName">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label-custom small fw-bold">Số điện thoại *</label>
                                <input asp-for="Phone" id="inputPhone" class="form-control form-control-custom" placeholder="Nhập số điện thoại" value="@defaultAddr?.Phone">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label-custom small fw-bold">Email</label>
                                <input asp-for="Email" class="form-control form-control-custom" placeholder="Địa chỉ email (tùy chọn)">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label-custom small fw-bold">Tỉnh/Thành phố *</label>
                                <select asp-for="Province" id="province" class="form-select form-control-custom">
                                    <option value="">Chọn Tỉnh/Thành</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label-custom small fw-bold">Quận/Huyện *</label>
                                <select asp-for="District" id="district" class="form-select form-control-custom">
                                    <option value="">Chọn Quận/Huyện</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label-custom small fw-bold">Phường/Xã *</label>
                                <select asp-for="Ward" id="ward" class="form-select form-control-custom">
                                    <option value="">Chọn Phường/Xã</option>
                                </select>
                            </div>
                            <div class="col-md-12">
                                <label class="form-label-custom small fw-bold">Địa chỉ chi tiết *</label>
                                <input asp-for="Address" id="inputStreet" class="form-control form-control-custom" placeholder="Số nhà, tên đường..." value="@defaultAddr?.Street">
                            </div>
                            <div class="col-md-12">
                                <button type="button" id="btn-calc-ship"
                                        onclick="saveAddressAndCalcShip()"
                                        style="margin-top:10px;padding:9px 20px;background:#E60023;color:#fff;border:none;
                                               border-radius:8px;font-size:13px;font-weight:500;cursor:pointer;
                                               display:flex;align-items:center;gap:6px;">
                                    <i class='bx bx-map-pin'></i> Lưu & Tính phí ship
                                </button>
                                <div id="addr-save-status" style="font-size:12px;margin-top:6px;"></div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-3">
                        <label asp-for="Note" class="form-label-custom small fw-bold">Ghi chú đơn hàng</label>
                        <textarea asp-for="Note" class="form-control form-control-custom" style="height: 60px;" placeholder="Lời nhắn cho shipper..."></textarea>
                    </div>
                </div>

                <div class="checkout-section">
                    <h5 class="section-subtitle"><i class='bx bx-package'></i> VẬN CHUYỂN</h5>

                    <div id="shipping-options">
                        <div class="p-3 rounded-3 bg-light text-muted small">
                            <span class="spinner-border spinner-border-sm me-1"></span>Đang tải phí ship...
                        </div>
                    </div>

                    <input type="hidden" name="ShippingDistrictId" id="inp-district-id" value="" />
                    <input type="hidden" name="ShippingWardCode" id="inp-ward-code" value="" />
                    <input type="hidden" name="ShippingFee" id="inp-shipping-fee" value="0" />
                    <input type="hidden" name="ShippingMethodId" id="inp-shipping-method" value="" />
                </div>

                <div class="checkout-section">
                    <h5 class="section-subtitle"><i class='bx bx-credit-card'></i> THANH TOÁN</h5>
                    <div class="method-card payment-method-card active" onclick="setPayment('COD', this)">
                        <input type="radio" asp-for="PaymentMethod" value="COD" id="pay1" checked>
                        <div class="method-info"><label for="pay1" class="name">Tiền mặt (COD)</label></div>
                    </div>
                    <div class="method-card payment-method-card mt-2" onclick="setPayment('VNPay', this)">
                        <input type="radio" asp-for="PaymentMethod" value="VNPay" id="pay3">
                        <div class="method-info">
                            <label for="pay3" class="name d-flex align-items-center gap-2">
                                Thanh toán qua VNPay
                                <span class="vnpay-badge" aria-label="VNPay">VN<span>Pay</span></span>
                            </label>
                        </div>
                    </div>
                </div>
            </div>

            <!-- RIGHT COLUMN -->
            <div class="col-lg-5">
                <div class="cart-summary-card shadow-sm rounded-4 p-4 sticky-top" style="top: 100px;">
                    <h5 class="fw-bold mb-4">TÓM TẮT ĐƠN HÀNG</h5>
                    <ul class="list-unstyled mb-4">
                        @foreach(var item in cartItems) {
                            <li class="d-flex gap-3 mb-3 pb-3 border-bottom">
                                <div class="position-relative">
                                    <img src="@(item.ImageUrl ?? "/assets/img/elements/18.jpg")" class="rounded border" style="width: 70px; height: 70px; object-fit: cover;">
                                    @if(item.PromotionDiscount > 0) {
                                        <span class="badge bg-danger position-absolute top-0 start-0 translate-middle-y x-small" style="font-size: 10px;">GIẢM GIÁ</span>
                                    }
                                </div>
                                <div class="flex-grow-1">
                                    <div class="fw-bold small text-truncate-2">@item.ProductName</div>
                                    <div class="x-small text-muted mb-1">Phân loại: @item.VariantName</div>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="text-danger fw-bold small">@item.Price.ToString("N0")đ</span>
                                        @if(item.OriginalPrice > item.Price) {
                                            <del class="text-muted x-small">@item.OriginalPrice.ToString("N0")đ</del>
                                        }
                                        <span class="x-small text-dark fw-medium ms-auto">x @item.Quantity</span>
                                    </div>
                                    @if(item.PromotionDiscount > 0) {
                                        <div class="text-success x-small fw-bold mt-1 animate__animated animate__pulse animate__infinite">
                                            <i class='bx bxs-check-shield'></i> Flash Sale - Tiết kiệm @((item.PromotionDiscount * item.Quantity).ToString("N0"))đ
                                        </div>
                                    }
                                </div>
                            </li>
                        }
                    </ul>
                    <div class="summary-total d-flex justify-content-between align-items-center mb-2">
                        <span class="fw-bold">Tạm tính</span>
                        <span class="fw-bold">@originalTotal.ToString("N0")đ</span>
                    </div>
                    @if (productDiscountTotal > 0)
                    {
                        <div class="summary-total d-flex justify-content-between align-items-center mb-2 text-success">
                            <span class="fw-bold">Flash Sale / Sale</span>
                            <span class="fw-bold">-@productDiscountTotal.ToString("N0")đ</span>
                        </div>
                    }

                    <div class="summary-total d-flex justify-content-between align-items-center mb-2"
                         id="shippingRow" style="display:none">
                        <span class="fw-bold">
                            <i class='bx bx-package'></i> Phí vận chuyển
                        </span>
                        <span id="shippingDisplay" class="fw-bold">—</span>
                    </div>

                    <!-- Voucher Section -->
                    <div class="voucher-section mb-4 p-3 bg-light rounded-3">
                        <label class="form-label small fw-bold text-uppercase mb-2"><i class='bx bxs-coupon text-danger'></i> Mã giảm giá</label>
                        <div class="input-group">
                            <input type="text" id="couponInput" asp-for="CouponCode" class="form-control form-control-custom border-end-0" placeholder="Nhập mã...">
                            <button type="button" id="btnApplyCoupon" class="btn btn-outline-danger px-3 fw-bold">ÁP DỤNG</button>
                        </div>
                        <div id="couponMessage" class="small mt-2" style="display:none;"></div>
                        
                        <div id="discountRow" class="justify-content-between align-items-center mt-3 text-success fw-bold" style="display:none;">
                            <span>Voucher <span id="appliedVoucherCode"></span>:</span>
                            <span id="discountAmount">-0đ</span>
                        </div>
                    </div>

                    <div class="summary-total d-flex justify-content-between align-items-center pt-3 border-top">
                        <span class="fw-bold fs-5">TỔNG CỘNG</span>
                        <span class="price fs-4 fw-bolder text-danger" id="totalOrder">@totalAmount.ToString("N0")đ</span>
                    </div>
                    <!-- Subtotal hidden for JS -->
                    <span id="subtotal" class="d-none" data-value="@totalAmount.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"></span>
                    <span id="shippingFee" class="d-none" data-value="0"></span>

                    <button type="submit" id="btnPlaceOrder" class="btn btn-danger btn-lg w-100 rounded-pill fw-bold mt-4 py-3">ĐẶT HÀNG NGAY</button>
                </div>
            </div>
        </div>
    </form>
</main>

<!-- ADDRESS SELECTION MODAL -->
<div class="modal fade" id="addressModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Địa chỉ của tôi</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="address-list-modal">
                    @foreach (var addr in savedAddresses)
                    {
                        <div class="saved-addr-option p-3 border rounded-3 mb-3 cursor-pointer @(addr.Id == defaultAddr?.Id ? "active" : "")"
                             onclick="selectSavedAddress(this)"
                             data-id="@addr.Id"
                             data-fullname="@addr.FullName"
                             data-phone="@addr.Phone"
                             data-province="@addr.Province"
                             data-district="@addr.District"
                             data-ward="@addr.Ward"
                             data-street="@addr.Street"
                             data-address="@addr.Address"
                             data-district-id="@addr.DistrictId"
                             data-ward-code="@addr.WardCode">
                            <div class="d-flex justify-content-between">
                                <span class="fw-bold">@addr.FullName</span>
                                @if (addr.IsDefault) { <span class="text-danger x-small fw-bold">Mặc định</span> }
                            </div>
                            <div class="text-muted small">@addr.Phone</div>
                            <div class="small">@addr.Address</div>
                        </div>
                    }
                    <button type="button" class="btn btn-outline-dark w-100 rounded-pill py-2 fw-bold mt-2" onclick="useNewAddress()">
                        <i class='bx bx-plus'></i> Thêm địa chỉ mới
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .saved-addr-option.active { border-color: #dc3545; background: #fff5f5; border-width: 2px; }
        .cursor-pointer { cursor: pointer; }
        .payment-method-card.active,
        .payment-method-card:has(input:checked) {
            border-color: #E60023 !important;
            background: rgba(230, 0, 35, 0.04) !important;
        }
        .payment-method-card:hover {
            border-color: #E60023 !important;
        }
        .vnpay-badge {
            display: inline-flex;
            align-items: center;
            height: 22px;
            padding: 0 8px;
            border-radius: 5px;
            background: #005baa;
            color: #fff;
            font-size: 12px;
            font-weight: 800;
            letter-spacing: .2px;
            line-height: 1;
        }
        .vnpay-badge span {
            color: #ed1c24;
            margin-left: 1px;
        }
    </style>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        const provinceSelect = document.getElementById('province');
        const districtSelect = document.getElementById('district');
        const wardSelect = document.getElementById('ward');
        const addressModal = new bootstrap.Modal(document.getElementById('addressModal'));

        async function loadProvinces() {
            try {
                const res = await fetch('/api/shipping/provinces');
                const data = await res.json();
                data.forEach(p => {
                    const opt = new Option(p.provinceName, p.provinceId);
                    provinceSelect.add(opt);
                });
                @if (defaultAddr != null) {
                    <text>
                    window.pendingDistrict = "@defaultAddr.District"; window.pendingWard = "@defaultAddr.Ward";
                    const pOpt = [...provinceSelect.options].find(o => o.text === "@defaultAddr.Province");
                    if (pOpt) { provinceSelect.value = pOpt.value; provinceSelect.onchange(); }
                    </text>
                }
            } catch (e) {}
        }

        provinceSelect.onchange = async () => {
            const id = provinceSelect.value;
            districtSelect.innerHTML = '<option value="">Chọn Quận/Huyện</option>';
            wardSelect.innerHTML = '<option value="">Chọn Phường/Xã</option>';
            districtSelect.disabled = wardSelect.disabled = true;
            if (id) {
                const res = await fetch(`/api/shipping/districts?provinceId=${id}`);
                const data = await res.json();
                data.forEach(d => {
                    const opt = new Option(d.districtName, d.districtId);
                    districtSelect.add(opt);
                });
                districtSelect.disabled = false;
                if (window.pendingDistrict) { 
                    const opt = [...districtSelect.options].find(o => o.text === window.pendingDistrict);
                    if(opt) { districtSelect.value = opt.value; window.pendingDistrict = null; districtSelect.onchange(); }
                }
            }
        };

        districtSelect.onchange = async () => {
            const id = districtSelect.value;
            wardSelect.innerHTML = '<option value="">Chọn Phường/Xã</option>';
            wardSelect.disabled = true;
            if (id) {
                const res = await fetch(`/api/shipping/wards?districtId=${id}`);
                const data = await res.json();
                data.forEach(w => wardSelect.add(new Option(w.wardName, w.wardCode)));
                wardSelect.disabled = false;
                if (window.pendingWard) {
                    const opt = [...wardSelect.options].find(o => o.text === window.pendingWard);
                    if(opt) { wardSelect.value = opt.value; }
                    window.pendingWard = null;
                }
            }
        };

        function selectSavedAddress(el) {
            const d = el.dataset;
            document.getElementById('inputAddressId').value = d.id;
            document.getElementById('summaryName').innerText = d.fullname;
            document.getElementById('summaryPhone').innerText = d.phone;
            document.getElementById('summaryAddress').innerText = d.address;

            document.getElementById('inputFullName').value = d.fullname;
            document.getElementById('inputPhone').value = d.phone;
            document.getElementById('inputStreet').value = d.street;

            window.pendingDistrict = d.district; window.pendingWard = d.ward;
            const pOpt = [...provinceSelect.options].find(o => o.text === d.province);
            if (pOpt) { provinceSelect.value = pOpt.value; provinceSelect.onchange(); }

            document.getElementById('addressSummary').classList.remove('d-none');
            document.getElementById('formInputs').classList.add('d-none');
            addressModal.hide();

            // Reload shipping options for the newly selected address
            const districtId = parseInt(d.districtId) || 0;
            const wardCode = d.wardCode || '';
            loadShippingOptions(districtId, wardCode);
        }

        function useNewAddress() {
            document.getElementById('inputAddressId').value = '';
            document.getElementById('addressSummary').classList.add('d-none');
            document.getElementById('formInputs').classList.remove('d-none');
            document.getElementById('inputFullName').value = ''; document.getElementById('inputPhone').value = '';
            document.getElementById('inputStreet').value = ''; provinceSelect.value = ''; provinceSelect.onchange();
            addressModal.hide();

            // Reset shipping khi nhập địa chỉ mới — không còn districtId/wardCode hợp lệ
            document.getElementById('inp-district-id').value = '';
            document.getElementById('inp-ward-code').value = '';
            document.getElementById('inp-shipping-fee').value = '0';
            document.getElementById('inp-shipping-method').value = '';
            document.getElementById('shippingFee').dataset.value = '0';
            document.getElementById('shipping-options').innerHTML =
                '<div class="alert alert-warning small mb-0"><i class=\'bx bx-error-circle me-1\'></i>' +
                'Vui lòng lưu địa chỉ mới trong <a href="/Address">trang địa chỉ</a> để tính phí ship tự động.</div>';
            updateTotal();
        }

        function updateTotal() {
            const sub = parseFloat(document.getElementById('subtotal').dataset.value);
            const ship = parseFloat(document.getElementById('shippingFee').dataset.value || 0);
            const discount = window.currentDiscountAmount || 0;
            const total = Math.max(0, sub + ship - discount);

            document.getElementById('totalOrder').innerText = total.toLocaleString('vi-VN') + 'đ';

            // Hiển thị dòng phí ship khi đã có kết quả tính (districtId được gán)
            const shippingRow     = document.getElementById('shippingRow');
            const shippingDisplay = document.getElementById('shippingDisplay');
            const hasCalculated   = document.getElementById('inp-district-id').value !== '';
            if (shippingRow && shippingDisplay && hasCalculated) {
                shippingRow.style.display = 'flex';
                shippingDisplay.textContent = ship === 0
                    ? 'Miễn phí'
                    : ship.toLocaleString('vi-VN') + 'đ';
                shippingDisplay.style.color = ship === 0 ? '#20c997' : '#E60023';
            } else if (shippingRow && !hasCalculated) {
                shippingRow.style.display = 'none';
            }
        }

        function applyFallbackShipping(message) {
            const fallbackFee = orderSubtotal >= freeShipDefault ? 0 : 30000;
            document.getElementById('inp-district-id').value = '0';
            document.getElementById('inp-ward-code').value = '';
            document.getElementById('inp-shipping-fee').value = fallbackFee;
            document.getElementById('inp-shipping-method').value = '';
            document.getElementById('shippingFee').dataset.value = fallbackFee;
            document.getElementById('shipping-options').innerHTML = `
                <label id="ship-opt-fallback" style="display:flex;align-items:flex-start;gap:12px;
                    padding:12px 14px;border:1.5px solid #E60023;border-radius:10px;margin-bottom:8px;
                    cursor:pointer;background:rgba(230,0,35,0.04);transition:all .15s;">
                    <input type="radio" name="_shipChoice" value="fallback" checked
                           style="accent-color:#E60023;margin-top:3px"/>
                    <div style="flex:1">
                        <div style="display:flex;justify-content:space-between;align-items:center">
                            <span style="font-weight:600;font-size:14px;color:#1a1a1a">Tiêu chuẩn</span>
                            <span style="font-weight:700;color:${fallbackFee === 0 ? '#20c997' : '#E60023'};font-size:15px">
                                ${fallbackFee === 0 ? 'Miễn phí' : fallbackFee.toLocaleString('vi-VN') + 'đ'}
                            </span>
                        </div>
                        <div style="font-size:12px;color:#a1acb8;margin-top:3px">
                            <i class='bx bx-time' style="font-size:11px"></i> Dự kiến 3 ngày
                        </div>
                        ${message ? `<div style="font-size:11px;color:#fd7e14;margin-top:3px"><i class='bx bx-info-circle'></i> ${message}</div>` : ''}
                    </div>
                </label>`;
            updateTotal();
        }

        function setShippingMethod(id, cost, el) {
            // Update UI class
            const section = el.closest('.checkout-section');
            section.querySelectorAll('.method-card').forEach(c => c.classList.remove('active'));
            el.classList.add('active');

            // Update Radio input
            el.querySelector('input').checked = true;

            // Update logic giá
            document.getElementById('shippingFee').dataset.value = cost;
            updateTotal();
        }

        function setPayment(method, el) {
            const section = el.closest('.checkout-section');
            section.querySelectorAll('.payment-method-card').forEach(c => c.classList.remove('active'));
            el.classList.add('active');

            const radio = el.querySelector('input[type="radio"]');
            if (radio) {
                radio.checked = true;
                radio.dispatchEvent(new Event('change', { bubbles: true }));
            }
        }

        // ── GHN Shipping Logic ──────────────────────────────────────────────
        const orderSubtotal = parseFloat(document.getElementById('subtotal').dataset.value || 0);
        const freeShipDefault = 500000;
        const defaultDistrictId = @(ViewBag.DefaultDistrictId ?? 0);
        const defaultWardCode = '@(ViewBag.DefaultWardCode ?? "")';
        const defaultWeight = @(ViewBag.DefaultWeight ?? 500);
        const cartItemCount = @(ViewBag.CartItemCount ?? 1);

        async function loadShippingOptions(districtId, wardCode) {
            if (!districtId || !wardCode) {
                applyFallbackShipping('Chưa có mã GHN cho địa chỉ này nên hệ thống tạm tính phí tiêu chuẩn.');
                return;
            }

            document.getElementById('inp-district-id').value = districtId;
            document.getElementById('inp-ward-code').value = wardCode;
            document.getElementById('shipping-options').innerHTML =
                '<div class="p-3 rounded-3 bg-light text-muted small"><span class="spinner-border spinner-border-sm me-1"></span>Đang tính phí ship...</div>';

            const res = await fetch('/api/shipping/calculate', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ toDistrictId: districtId, toWardCode: wardCode, weightGram: defaultWeight, itemCount: cartItemCount, orderTotal: orderSubtotal, freeShipThreshold: freeShipDefault })
            }).then(r => r.json()).catch(() => []);

            if (!res.length) {
                applyFallbackShipping('Không thể kết nối GHN, hệ thống tạm tính phí tiêu chuẩn.');
                return;
            }

            const html = res.map((opt, i) => {
                const isDisabled = opt.unavailableReason != null;
                const isExpress  = opt.isExpress === true;
                const isFirst    = i === 0 && !isDisabled;
                return `
                <label id="ship-opt-${opt.serviceId}-${i}" style="display:flex;align-items:flex-start;gap:12px;
                    padding:12px 14px;
                    border:1.5px solid ${isFirst ? '#E60023' : '#eee'};
                    border-radius:10px;margin-bottom:8px;
                    cursor:${isDisabled ? 'not-allowed' : 'pointer'};
                    background:${isFirst ? 'rgba(230,0,35,0.04)' : '#fff'};
                    opacity:${isDisabled ? '0.6' : '1'};transition:all .15s;">
                    <input type="radio" name="_shipChoice"
                           value="${opt.serviceId}"
                           ${isFirst ? 'checked' : ''}
                           ${isDisabled ? 'disabled' : ''}
                           onchange="selectShipOption(${opt.serviceId},${opt.fee},'${opt.serviceName}')"
                           style="accent-color:#E60023;margin-top:3px"/>
                    <div style="flex:1">
                        <div style="display:flex;justify-content:space-between;align-items:center">
                            <span style="font-weight:600;font-size:14px;color:#1a1a1a">
                                ${opt.serviceName}
                                ${isExpress ? '<span style="background:#E60023;color:#fff;font-size:10px;padding:2px 6px;border-radius:4px;margin-left:6px;font-weight:500">HOT</span>' : ''}
                            </span>
                            <span style="font-weight:700;color:${opt.isFree ? '#20c997' : '#E60023'};font-size:15px">
                                ${opt.isFree ? 'Miễn phí' : opt.fee.toLocaleString('vi-VN') + 'đ'}
                            </span>
                        </div>
                        <div style="font-size:12px;color:#a1acb8;margin-top:3px">
                            <i class='bx bx-time' style="font-size:11px"></i>
                            ${opt.estimatedLabel || ('Dự kiến ' + opt.estimatedDays + ' ngày')}
                        </div>
                        ${opt.unavailableReason ? `<div style="font-size:11px;color:#fd7e14;margin-top:3px"><i class='bx bx-info-circle'></i> ${opt.unavailableReason}</div>` : ''}
                        ${opt.freeShipRemaining ? `<div style="font-size:11px;color:#20c997;margin-top:3px"><i class='bx bx-gift'></i> Mua thêm ${opt.freeShipRemaining.toLocaleString('vi-VN')}đ để miễn phí ship</div>` : ''}
                    </div>
                </label>`;
            }).join('');

            document.getElementById('shipping-options').innerHTML = html;
            // Auto-select first enabled option
            const firstEnabled = res.find(o => !o.unavailableReason);
            if (firstEnabled) selectShipOption(firstEnabled.serviceId, firstEnabled.fee, firstEnabled.serviceName);
        }

        function selectShipOption(serviceId, fee, name) {
            document.getElementById('inp-shipping-fee').value = fee;
            document.getElementById('inp-shipping-method').value = serviceId || '';
            document.getElementById('shippingFee').dataset.value = fee;
            updateTotal();
            document.querySelectorAll('[id^="ship-opt-"]').forEach(el => {
                // id format: ship-opt-{serviceId}-{index}
                const parts = el.id.split('-');
                const elServiceId = parts[2];
                const sel = elServiceId == serviceId;
                el.style.borderColor = sel ? '#E60023' : '#eeeeee';
                el.style.background  = sel ? 'rgba(230,0,35,0.04)' : '#fff';
            });
        }

        function normalizeName(s) {
            return (s || '').trim().toLowerCase()
                .replace(/\s*-\s*/g, '-')
                .replace(/\s+/g, ' ');
        }

        function fuzzyMatch(a, b) {
            const na = normalizeName(a), nb = normalizeName(b);
            return na.includes(nb) || nb.includes(na);
        }

        async function saveAddressAndCalcShip() {
            const btn = document.getElementById('btn-calc-ship');
            const status = document.getElementById('addr-save-status');

            const provinceSel = document.getElementById('province');
            const districtSel = document.getElementById('district');
            const wardSel     = document.getElementById('ward');
            const provinceName = provinceSel?.options[provinceSel?.selectedIndex]?.text || '';
            const districtName = districtSel?.options[districtSel?.selectedIndex]?.text || '';
            const wardName     = wardSel?.options[wardSel?.selectedIndex]?.text || '';
            const fullName = document.getElementById('inputFullName')?.value?.trim() || '';
            const phone    = document.getElementById('inputPhone')?.value?.trim() || '';
            const street   = document.getElementById('inputStreet')?.value?.trim() || '';
            const token    = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

            if (!districtName || districtName === 'Chọn Quận/Huyện' ||
                !wardName     || wardName === 'Chọn Phường/Xã') {
                status.innerHTML = '<span style="color:#E60023">Vui lòng chọn đủ Quận/Huyện và Phường/Xã</span>';
                return;
            }

            if (!fullName || !phone || !street) {
                status.innerHTML = '<span style="color:#E60023">Vui lòng nhập họ tên, số điện thoại và địa chỉ chi tiết</span>';
                return;
            }

            async function persistCheckoutAddress(districtId = null, wardCode = null) {
                const saveRes = await fetch('/Address/AddAddress', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify({
                        fullName, phone,
                        province: provinceName,
                        district: districtName,
                        ward: wardName,
                        street,
                        isDefault: true,
                        districtId,
                        wardCode
                    })
                }).then(r => r.ok ? r.json() : null).catch(() => null);

                if (!saveRes?.success) {
                    status.innerHTML = '<span style="color:#E60023">' + (saveRes?.message || 'Không thể lưu địa chỉ. Vui lòng kiểm tra lại thông tin.') + '</span>';
                    return false;
                }

                document.getElementById('inputAddressId').value = saveRes.id;
                document.getElementById('summaryName').innerText    = fullName;
                document.getElementById('summaryPhone').innerText   = phone;
                document.getElementById('summaryAddress').innerText =
                    `${street}, ${wardName}, ${districtName}, ${provinceName}`;
                document.getElementById('addressSummary').classList.remove('d-none');
                document.getElementById('formInputs').classList.add('d-none');
                return true;
            }

            btn.disabled = true;
            btn.innerHTML = "<i class='bx bx-loader-alt bx-spin'></i> Đang tính...";
            status.innerHTML = '';

            try {
                const ghnProvinceId = provinceSel.value;
                const ghnDistrictId = districtSel.value;
                const ghnWardCode = wardSel.value;

                if (!ghnProvinceId || !ghnDistrictId || !ghnWardCode) {
                    if (!await persistCheckoutAddress()) return;
                    applyFallbackShipping('Chưa chọn đủ thông tin địa chỉ GHN, hệ thống tạm tính phí tiêu chuẩn.');
                    status.innerHTML = '<span style="color:#fd7e14"><i class="bx bx-info-circle"></i> Chưa chọn đủ thông tin GHN, đã tạm tính phí tiêu chuẩn.</span>';
                    return;
                }

                // Bước 4: Gán vào hidden inputs
                document.getElementById('inp-district-id').value = ghnDistrictId;
                document.getElementById('inp-ward-code').value   = ghnWardCode;

                // Bước 4.5: Lưu địa chỉ mới vào DB và đặt làm mặc định
                if (!await persistCheckoutAddress(ghnDistrictId, ghnWardCode)) return;

                status.innerHTML = '<span style="color:#20c997"><i class="bx bx-check"></i> Đã xác định vị trí, đang tính phí...</span>';

                // Bước 5: Gọi tính phí (loadShippingOptions đọc orderSubtotal từ module scope)
                await loadShippingOptions(ghnDistrictId, ghnWardCode);

                status.innerHTML = '<span style="color:#20c997"><i class="bx bx-check-circle"></i> Đã tính phí ship thành công!</span>';
            } catch (err) {
                if (await persistCheckoutAddress()) {
                    applyFallbackShipping('Không thể kết nối dịch vụ vận chuyển, hệ thống tạm tính phí tiêu chuẩn.');
                    status.innerHTML = '<span style="color:#fd7e14"><i class="bx bx-info-circle"></i> Đã lưu địa chỉ và tạm tính phí tiêu chuẩn.</span>';
                } else {
                    status.innerHTML = '<span style="color:#E60023">Lỗi: ' + err.message + '</span>';
                }
            } finally {
                btn.disabled = false;
                btn.innerHTML = "<i class='bx bx-map-pin'></i> Lưu & Tính phí ship";
            }
        }

        window.addEventListener('DOMContentLoaded', async () => {
            if (defaultDistrictId > 0 && defaultWardCode) {
                await loadShippingOptions(defaultDistrictId, defaultWardCode);
            } else {
                applyFallbackShipping('Địa chỉ hiện tại chưa có mã GHN, hệ thống tạm tính phí tiêu chuẩn.');
            }
        });
        // ── End GHN Shipping Logic ──────────────────────────────────────────

        // Voucher Logic
        document.getElementById('btnApplyCoupon').onclick = async function() {
            const code = document.getElementById('couponInput').value.trim();
            const orderValue = document.getElementById('subtotal').dataset.value;
            const msgEl = document.getElementById('couponMessage');
            const discRow = document.getElementById('discountRow');
            const discAmtEl = document.getElementById('discountAmount');
            
            if (!code) return;

            this.disabled = true;
            this.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';

            try {
                const directVariantId = document.querySelector('[name="DirectVariantId"]')?.value || '';
                const directQuantity = document.querySelector('[name="DirectQuantity"]')?.value || '1';
                const directQuery = directVariantId ? `&directVariantId=${directVariantId}&directQuantity=${directQuantity}` : '';
                const res = await fetch(`/Cart/CheckCoupon?code=${code}&orderValue=${orderValue}${directQuery}`);
                const data = await res.json();
                
                if (data.success) {
                    window.currentDiscountAmount = data.discountAmount;
                    discAmtEl.innerText = '-' + data.discountAmount.toLocaleString('vi-VN') + 'đ';
                    document.getElementById('appliedVoucherCode').innerText = code.toUpperCase();
                    discRow.style.display = 'flex';
                    msgEl.innerText = data.message;
                    msgEl.className = 'small mt-2 text-success';
                    msgEl.style.display = 'block';
                    updateTotal();
                } else {
                    window.currentDiscountAmount = 0;
                    document.getElementById('appliedVoucherCode').innerText = '';
                    discRow.style.display = 'none';
                    msgEl.innerText = data.message;
                    msgEl.className = 'small mt-2 text-danger';
                    msgEl.style.display = 'block';
                    updateTotal();
                }
            } catch (e) {
                console.error(e);
            } finally {
                this.disabled = false;
                this.innerHTML = 'ÁP DỤNG';
            }
        };

        window.onload = loadProvinces;

        document.getElementById('checkoutForm').onsubmit = async function(e) {
            e.preventDefault();
            
            // Đảm bảo dữ liệu input được nạp đầy đủ từ Summary nếu đang ở chế độ xem tóm tắt
            if (!$('#addressSummary').hasClass('d-none')) {
                // Nếu đang dùng địa chỉ lưu sẵn, ta cần đảm bảo các input ẩn có giá trị
                // (Trong thực tế nên lấy từ data attribute hoặc object JS lưu địa chỉ đang chọn)
                const currentAddrText = document.getElementById('summaryAddress').innerText;
                const parts = currentAddrText.split(',').map(p => p.trim());
                
                // Cố gắng "đoán" các phần nếu chưa được nạp (hoặc tốt hơn là nạp lúc chọn địa chỉ)
                // Tuy nhiên cách an toàn nhất là kích hoạt lại các input này lúc gửi
            }

            const btn = document.getElementById('btnPlaceOrder'); 
            btn.disabled = true; 
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> ĐANG XỬ LÝ...';
            
            const formData = new FormData(this);
            const paymentMethod = formData.get('PaymentMethod');

            try {
                const res = await fetch('/Cart/Checkout', { method: 'POST', body: formData });
                const data = await res.json();
                
                if (data.success) {
                    if (paymentMethod === 'VNPay') {
                        // Chuyển hướng sang cổng VNPay
                        window.location.href = '/Payment/CreatePayment?orderId=' + data.orderId;
                    } else {
                        // Hiển thị thông báo thành công cho COD/Chuyển khoản
                        Swal.fire({ 
                            icon: 'success', 
                            title: 'Thành công!', 
                            text: data.message, 
                            timer: 2000, 
                            showConfirmButton: false 
                        }).then(() => {
                            window.location.href = '/Cart/Success/' + data.orderId;
                        });
                    }
                } else { 
                    Swal.fire('Lỗi', data.message, 'error'); 
                    btn.disabled = false; 
                    btn.innerHTML = 'ĐẶT HÀNG NGAY'; 
                }
            } catch (e) { 
                Swal.fire('Lỗi', 'Không thể kết nối với máy chủ.', 'error'); 
                btn.disabled = false; 
                btn.innerHTML = 'ĐẶT HÀNG NGAY'; 
            }
        };
    </script>
}
