@{
    ViewData["Title"] = "Đổi mật khẩu";
}

<div class="breadcrumb-wrapper">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
                <li class="breadcrumb-item"><a href="/Account/Profile">Tài khoản</a></li>
                <li class="breadcrumb-item active" aria-current="page">Đổi mật khẩu</li>
            </ol>
        </nav>
    </div>
</div>

<main class="container mb-5">
    <div class="row g-4">
        <!-- SIDEBAR MENU -->
        <aside class="col-lg-3">
            <div class="account-sidebar">
                <div class="d-flex align-items-center gap-3 mb-4 pb-4 border-bottom">
                    <div style="width: 50px; height: 50px;">
                        <img src="/assets/img/avatars/1.png" class="rounded-circle w-100 h-100 object-fit-cover" alt="User">
                    </div>
                    <div>
                        <h6 class="fw-bold mb-0">Tài khoản của tôi</h6>
                        <p class="text-muted small mb-0">Thành viên</p>
                    </div>
                </div>
                <ul class="account-nav">
                    <li class="account-nav-item"><a href="/Account/Profile" class="account-nav-link"><i class='bx bx-user'></i> Thông tin cá nhân</a></li>
                    <li class="account-nav-item"><a href="/Order/Index" class="account-nav-link"><i class='bx bx-package'></i> Đơn hàng của tôi</a></li>
                    <li class="account-nav-item"><a href="/Address/Index" class="account-nav-link"><i class='bx bx-map'></i> Địa chỉ giao hàng</a></li>
                    <li class="account-nav-item"><a href="/Account/Wishlist" class="account-nav-link"><i class='bx bx-heart'></i> Sản phẩm yêu thích</a></li>
                    <li class="account-nav-item"><a href="/Account/ChangePassword" class="account-nav-link active"><i class='bx bx-lock-alt'></i> Đổi mật khẩu</a></li>
                    <li class="account-nav-item mt-3 pt-3 border-top">
                        <form asp-controller="Account" asp-action="Logout" method="post" id="logoutForm" class="d-none"></form>
                        <a href="javascript:void(0)" class="account-nav-link text-danger" onclick="document.getElementById('logoutForm').submit()"><i class='bx bx-log-out'></i> Đăng xuất</a>
                    </li>
                </ul>
            </div>
        </aside>

        <!-- MAIN CONTENT -->
        <div class="col-lg-9">
            <div style="max-width: 550px;">
                <div class="profile-section-card">
                    <h4 class="fw-bold mb-2 text-uppercase">ĐỔI MẬT KHẨU</h4>
                    <p class="text-muted small mb-4">Để bảo mật tài khoản, vui lòng không chia sẻ mật khẩu cho người khác.</p>

                    <form id="changePasswordForm">
                        @Html.AntiForgeryToken()
                        <!-- Current Password -->
                        <div class="mb-3">
                            <label class="form-label-custom">Mật khẩu hiện tại *</label>
                            <div class="password-group position-relative">
                                <input type="password" id="currentPassword" class="form-control form-control-custom" placeholder="Nhập mật khẩu đang dùng" required>
                                <i class='bx bx-hide password-toggle-icon toggle-password'></i>
                            </div>
                        </div>

                        <!-- New Password -->
                        <div class="mb-3">
                            <label class="form-label-custom">Mật khẩu mới *</label>
                            <div class="password-group position-relative">
                                <input type="password" id="newPassword" class="form-control form-control-custom" placeholder="Nhập mật khẩu mới" required>
                                <i class='bx bx-hide password-toggle-icon toggle-password'></i>
                            </div>
                            <!-- Realtime Rules -->
                            <ul class="password-requirements list-unstyled mt-2">
                                <li id="rule-length" class="rule-fail small"><i class='bx bx-circle me-1'></i> Ít nhất 8 ký tự</li>
                                <li id="rule-upper" class="rule-fail small"><i class='bx bx-circle me-1'></i> Có chữ cái in hoa</li>
                                <li id="rule-number" class="rule-fail small"><i class='bx bx-circle me-1'></i> Có ít nhất 1 chữ số</li>
                            </ul>
                        </div>

                        <!-- Confirm New Password -->
                        <div class="mb-4">
                            <label class="form-label-custom">Xác nhận mật khẩu mới *</label>
                            <div class="password-group position-relative">
                                <input type="password" id="confirmPassword" class="form-control form-control-custom" placeholder="Nhập lại mật khẩu mới" required>
                                <i class='bx bx-hide password-toggle-icon toggle-password'></i>
                            </div>
                        </div>

                        <div class="d-flex gap-3">
                            <button type="submit" id="btnSave" class="btn btn-danger rounded-pill px-5 fw-bold">LƯU THAY ĐỔI</button>
                            <button type="reset" class="btn btn-outline-dark rounded-pill px-4 fw-bold">HỦY</button>
                        </div>
                    </form>
                </div>

                <!-- SECURITY TIPS -->
                <div class="security-tips-box mt-4 p-3 rounded" style="background-color: #fff9e6; border-left: 4px solid #ffc107;">
                    <h6 class="fw-bold"><i class='bx bxs-shield-alt me-2 text-warning'></i> MẸO BẢO MẬT</h6>
                    <ul class="small mb-0 text-muted">
                        <li>Sử dụng mật khẩu mạnh kết hợp chữ cái, số và ký tự đặc biệt.</li>
                        <li>Không nên sử dụng thông tin dễ đoán như ngày sinh, số điện thoại.</li>
                        <li>Thay đổi mật khẩu định kỳ 6 tháng một lần để đảm bảo an toàn.</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <script>
        const token = () => document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

        // 1. Realtime validation rules
        document.getElementById('newPassword').addEventListener('input', function () {
            const val = this.value;
            setRule('rule-length', val.length >= 8);
            setRule('rule-upper',  /[A-Z]/.test(val));
            setRule('rule-number', /\d/.test(val));
        });

        function setRule(id, passed) {
            const el = document.getElementById(id);
            if (!el) return;
            const icon = el.querySelector('i');
            if (passed) {
                el.classList.replace('rule-fail', 'text-success');
                icon.classList.replace('bx-circle', 'bx-check-circle');
            } else {
                el.classList.replace('text-success', 'rule-fail');
                icon.classList.replace('bx-check-circle', 'bx-circle');
            }
        }

        // 2. Toggle ẩn/hiện mật khẩu
        document.querySelectorAll('.toggle-password').forEach(btn => {
            btn.addEventListener('click', function () {
                const input = this.previousElementSibling;
                if (input.type === 'password') {
                    input.type = 'text';
                    this.classList.replace('bx-hide', 'bx-show');
                } else {
                    input.type = 'password';
                    this.classList.replace('bx-show', 'bx-hide');
                }
            });
        });

        // 3. Submit form bằng AJAX
        document.getElementById('changePasswordForm').addEventListener('submit', async function (e) {
            e.preventDefault();
            const btn = document.getElementById('btnSave');
            const originalHtml = btn.innerHTML;
            
            const payload = {
                currentPassword: document.getElementById('currentPassword').value,
                newPassword:     document.getElementById('newPassword').value,
                confirmPassword: document.getElementById('confirmPassword').value
            };

            // Client-side simple check
            if (payload.newPassword !== payload.confirmPassword) {
                Swal.fire({ icon: 'error', title: 'Lỗi', text: 'Mật khẩu xác nhận không khớp!' });
                return;
            }

            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Đang lưu...';

            try {
                const res = await fetch('/Account/ChangePassword', {
                    method: 'POST',
                    headers: { 
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token()
                    },
                    body: JSON.stringify(payload)
                });
                const data = await res.json();

                if (data.success) {
                    Swal.fire({ icon: 'success', title: 'Thành công', text: data.message });
                    this.reset();
                    // Reset rules
                    ['rule-length','rule-upper','rule-number'].forEach(id => {
                        const el = document.getElementById(id);
                        el.classList.replace('text-success', 'rule-fail');
                        el.querySelector('i').classList.replace('bx-check-circle', 'bx-circle');
                    });
                } else {
                    Swal.fire({ icon: 'error', title: 'Lỗi', text: data.message || 'Có lỗi xảy ra' });
                }
            } catch (err) {
                Swal.fire({ icon: 'error', title: 'Lỗi', text: 'Không thể kết nối máy chủ' });
            } finally {
                btn.disabled = false;
                btn.innerHTML = originalHtml;
            }
        });
    </script>
    <style>
        .password-toggle-icon {
            position: absolute; right: 15px; top: 12px; cursor: pointer; color: #999; font-size: 1.2rem;
        }
        .rule-fail { color: #ccc; }
        .password-requirements li { transition: all 0.3s ease; }
    </style>
}
