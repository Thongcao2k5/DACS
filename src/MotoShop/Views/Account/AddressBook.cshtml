@{
    ViewData["Title"] = "Sổ địa chỉ";
}

<div class="breadcrumb-wrapper">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
                <li class="breadcrumb-item"><a href="/Account/Profile">Tài khoản</a></li>
                <li class="breadcrumb-item active" aria-current="page">Sổ địa chỉ</li>
            </ol>
        </nav>
    </div>
</div>

<main class="container py-5">
    <div class="row g-4">
        <!-- Sidebar -->
        <aside class="col-lg-3">
            <partial name="_AccountSidebar" />
        </aside>

        <!-- Main Content -->
        <div class="col-lg-9">
            <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
                <h4 class="fw-bold mb-0 text-uppercase"><i class='bx bx-map me-2'></i>ĐỊA CHỈ GIAO HÀNG</h4>
                <button class="btn btn-danger rounded-pill fw-bold px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#addressModal">
                    <i class='bx bx-plus-circle me-2'></i> THÊM ĐỊA CHỈ MỚI
                </button>
            </div>

            <!-- Loading Placeholder -->
            <div id="addressLoading">
                <div class="row g-3">
                    <div class="col-md-6"><div class="skeleton-loading shadow-sm" style="height: 180px; border-radius: 15px;"></div></div>
                    <div class="col-md-6"><div class="skeleton-loading shadow-sm" style="height: 180px; border-radius: 15px;"></div></div>
                </div>
            </div>

            <!-- Address List -->
            <div id="addressList" class="row g-4 d-none">
                <!-- Dữ liệu nạp từ API -->
            </div>

            <!-- Empty State -->
            <div id="emptyAddresses" class="d-none text-center py-5 shadow-sm rounded-4 bg-white border">
                <div class="py-4">
                    <img src="/assets/img/illustrations/address-empty.png" alt="Empty" style="width: 150px; opacity: 0.6;" class="mb-3">
                    <h5 class="fw-bold">Bạn chưa có địa chỉ giao hàng nào</h5>
                    <p class="text-muted mb-4">Thêm địa chỉ ngay để thanh toán nhanh chóng hơn.</p>
                    <button class="btn btn-danger rounded-pill px-5 fw-bold" data-bs-toggle="modal" data-bs-target="#addressModal">THÊM ĐỊA CHỈ</button>
                </div>
            </div>
        </div>
    </div>
</main>

<!-- ADD / EDIT ADDRESS MODAL -->
<div class="modal fade" id="addressModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold mt-2 ms-2">THÊM ĐỊA CHỈ MỚI</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form id="addressForm">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label-custom">Họ và tên người nhận *</label>
                            <input type="text" class="form-control form-control-custom" placeholder="Nhập tên người nhận" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-custom">Số điện thoại *</label>
                            <input type="tel" class="form-control form-control-custom" placeholder="Nhập số điện thoại" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label-custom">Tỉnh / Thành phố *</label>
                            <select class="form-select form-control-custom" id="province" required>
                                <option value="" selected disabled>Chọn Tỉnh/Thành</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label-custom">Quận / Huyện *</label>
                            <select class="form-select form-control-custom" id="district" required>
                                <option value="" selected disabled>Chọn Quận/Huyện</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label-custom">Phường / Xã *</label>
                            <select class="form-select form-control-custom" id="ward" required>
                                <option value="" selected disabled>Chọn Phường/Xã</option>
                            </select>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label-custom">Địa chỉ chi tiết *</label>
                            <textarea class="form-control form-control-custom" style="height: 100px;" placeholder="Số nhà, tên đường..." required></textarea>
                        </div>
                        <div class="col-md-12">
                            <div class="form-check custom-checkbox">
                                <input class="form-check-input" type="checkbox" id="setDefault">
                                <label class="form-check-label text-muted" for="setDefault">Đặt làm địa chỉ mặc định</label>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0 p-4 pt-0">
                <button type="button" class="btn btn-light rounded-pill px-4 fw-bold" data-bs-dismiss="modal">HỦY BỎ</button>
                <button type="submit" form="addressForm" class="btn btn-danger rounded-pill px-4 fw-bold shadow-sm">LƯU ĐỊA CHỈ</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            initProvinceSelector();
            
            setTimeout(() => {
                $('#addressLoading').addClass('d-none');
                loadAddressData();
            }, 800);
        });

        function initProvinceSelector() {
            const $province = $('#province');
            const $district = $('#district');
            const $ward = $('#ward');

            // 1. Load Provinces
            $.getJSON('https://provinces.open-api.vn/api/p/', function(data) {
                data.forEach(p => {
                    $province.append(`<option value="${p.code}">${p.name}</option>`);
                });
            });

            // 2. Province Change -> Load Districts
            $province.on('change', function() {
                const pCode = $(this).val();
                $district.html('<option value="" selected disabled>Chọn Quận/Huyện</option>');
                $ward.html('<option value="" selected disabled>Chọn Phường/Xã</option>');
                
                if (pCode) {
                    $.getJSON(`https://provinces.open-api.vn/api/p/${pCode}?depth=2`, function(data) {
                        data.districts.forEach(d => {
                            $district.append(`<option value="${d.code}">${d.name}</option>`);
                        });
                    });
                }
            });

            // 3. District Change -> Load Wards
            $district.on('change', function() {
                const dCode = $(this).val();
                $ward.html('<option value="" selected disabled>Chọn Phường/Xã</option>');
                
                if (dCode) {
                    $.getJSON(`https://provinces.open-api.vn/api/d/${dCode}?depth=2`, function(data) {
                        data.wards.forEach(w => {
                            $ward.append(`<option value="${w.code}">${w.name}</option>`);
                        });
                    });
                }
            });
        }

        function loadAddressData() {
            const hasData = true; // Giả lập có dữ liệu
            if(hasData) {
                $('#addressList').removeClass('d-none').addClass('animate__animated animate__fadeIn');
                renderAddresses();
            } else {
                $('#emptyAddresses').removeClass('d-none');
            }
        }

        function renderAddresses() {
            const html = `
                <div class="col-md-6 animate__animated animate__zoomIn">
                    <div class="address-card default shadow-sm">
                        <div class="address-name">
                            Nguyễn Văn An 
                            <span class="address-badge-default">Mặc định</span>
                        </div>
                        <div class="address-phone"><i class='bx bx-phone me-1'></i> 0901 234 567</div>
                        <div class="address-detail-text">
                            123 Đường ABC, Phường 5, Quận 1<br>
                            Thành phố Hồ Chí Minh
                        </div>
                        <div class="address-actions mt-3 pt-3 border-top">
                            <button class="btn-address-action" data-bs-toggle="modal" data-bs-target="#addressModal"><i class='bx bx-edit-alt'></i> Sửa</button>
                            <button class="btn-address-action delete"><i class='bx bx-trash'></i> Xóa</button>
                        </div>
                    </div>
                </div>
            `;
            $('#addressList').html(html);
        }
    </script>
}
