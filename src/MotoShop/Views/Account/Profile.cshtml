@model MotoShop.Models.ViewModels.ProfileViewModel
@{
    ViewData["Title"] = "Hồ sơ của tôi";
}

<div class="breadcrumb-wrapper">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
                <li class="breadcrumb-item active" aria-current="page">Hồ sơ của tôi</li>
            </ol>
        </nav>
    </div>
</div>

<main class="container py-5">
    <div class="row g-4">
        <!-- 2. SIDEBAR MENU (Left) -->
        <aside class="col-lg-3">
            <partial name="_AccountSidebar" />
        </aside>

        <!-- 3. MAIN CONTENT (Right) -->
        <div class="col-lg-9">
            <!-- Loading Overlay -->
            <div id="pageLoading" class="skeleton-container">
                <div class="profile-section-card skeleton-loading mb-4" style="height: 300px;"></div>
                <div class="row g-4 mb-4">
                    <div class="col-4"><div class="skeleton-loading" style="height: 100px;"></div></div>
                    <div class="col-4"><div class="skeleton-loading" style="height: 100px;"></div></div>
                    <div class="col-4"><div class="skeleton-loading" style="height: 100px;"></div></div>
                </div>
            </div>

            <div id="pageContent" class="d-none">
                <!-- Profile Information Card -->
                <div class="profile-section-card shadow-sm border-0 mb-4">
                    <h5 class="fw-bold mb-4"><i class='bx bx-id-card me-2'></i>THÔNG TIN CÁ NHÂN</h5>
                    <div class="row g-4">
                        <div class="col-md-auto text-center">
                            <div class="avatar-wrapper mx-auto">
                                @{
                                    var displayAvatar = !string.IsNullOrEmpty(Model.AvatarUrl) 
                                        ? Model.AvatarUrl 
                                        : $"https://ui-avatars.com/api/?name={Model.FullName}&background=random&size=150";
                                }
                                <img src="@displayAvatar" class="avatar-img shadow-sm" id="userAvatar" alt="Avatar">
                                <label for="avatarUpload" class="btn-change-avatar">
                                    <i class='bx bx-camera'></i>
                                    <input type="file" id="avatarUpload" class="d-none" accept="image/*">
                                </label>
                            </div>
                            <p class="mt-3 text-muted small">JPG, PNG tối đa 2MB</p>
                        </div>
                        <div class="col-md">
                            <form id="profileForm">
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="form-label-custom">Họ và tên</label>
                                        <input type="text" id="fullName" class="form-control form-control-custom" placeholder="Nhập họ tên" value="@Model.FullName">
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label-custom">Số điện thoại</label>
                                        <input type="tel" id="phoneNumber" class="form-control form-control-custom" placeholder="Nhập số điện thoại" value="@Model.PhoneNumber">
                                    </div>
                                    <div class="col-md-12">
                                        <label class="form-label-custom">Địa chỉ hiện tại</label>
                                        <textarea id="address" class="form-control form-control-custom" rows="2" placeholder="Nhập địa chỉ của bạn">@Model.Address</textarea>
                                    </div>
                                    <div class="col-md-12">
                                        <label class="form-label-custom">Địa chỉ Email</label>
                                        <input type="email" id="email" class="form-control form-control-custom bg-light" readonly value="@Model.Email">
                                        <div class="form-text">Email không thể thay đổi để bảo mật tài khoản.</div>
                                    </div>
                                    <div class="col-md-12 pt-3">
                                        <button type="submit" id="btnUpdateProfile" class="btn btn-danger rounded-pill px-5 fw-bold shadow-sm">
                                            <i class='bx bx-save me-2'></i> LƯU THAY ĐỔI
                                        </button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- Order Stats Grid -->
                <div class="order-stats-grid mb-4">
                    <a href="/Account/Orders?status=Pending" class="stat-box text-decoration-none shadow-sm border-0">
                        <span class="stat-count text-warning" id="pendingCount">@Model.PendingOrders</span>
                        <span class="stat-label">Chờ xác nhận</span>
                    </a>
                    <a href="/Account/Orders?status=Shipping" class="stat-box text-decoration-none shadow-sm border-0">
                        <span class="stat-count text-primary" id="shippingCount">@Model.ShippingOrders</span>
                        <span class="stat-label">Đang giao</span>
                    </a>
                    <a href="/Account/Orders?status=Completed" class="stat-box text-decoration-none shadow-sm border-0">
                        <span class="stat-count text-success" id="completedCount">@Model.CompletedOrders</span>
                        <span class="stat-label">Đã hoàn thành</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <script src="~/js/components.js"></script>
    <script>
        $(document).ready(function() {
            // Giả lập loading 0.6s để người dùng thấy hiệu ứng Skeleton
            setTimeout(() => {
                $('#pageLoading').fadeOut(200, function() {
                    $('#pageContent').removeClass('d-none').addClass('animate__animated animate__fadeIn');
                });
            }, 600);

            // Xử lý lưu Profile qua AJAX
            $('#profileForm').on('submit', async function(e) {
                e.preventDefault();
                
                const btn = $('#btnUpdateProfile');
                const originalContent = btn.html();
                
                btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span> Đang lưu...');

                const formData = new FormData();
                formData.append('FullName', $('#fullName').val());
                formData.append('PhoneNumber', $('#phoneNumber').val());
                formData.append('Address', $('#address').val());
                formData.append('Email', $('#email').val());
                
                const avatarFile = document.getElementById('avatarUpload').files[0];
                if (avatarFile) {
                    formData.append('Avatar', avatarFile);
                }

                try {
                    const response = await fetch('/Account/UpdateProfile', {
                        method: 'POST',
                        headers: {
                            'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                        },
                        body: formData
                    });

                    const result = await response.json();

                    if (result.success) {
                        if (typeof UI !== 'undefined') {
                            UI.showToast(result.message, 'success');
                        }
                        
                        // Cập nhật lại ảnh đại diện nếu có thay đổi
                        if (result.avatarUrl) {
                            $('#userAvatar').attr('src', result.avatarUrl);
                            // Cập nhật cả avatar trên header nếu có
                            $('.header-avatar').attr('src', result.avatarUrl);
                        }
                    } else {
                        if (typeof UI !== 'undefined') {
                            UI.showToast(result.message, 'error');
                        }
                    }
                } catch (error) {
                    console.error('Lỗi cập nhật hồ sơ:', error);
                    if (typeof UI !== 'undefined') {
                        UI.showToast('Không thể kết nối đến máy chủ.', 'error');
                    }
                } finally {
                    btn.prop('disabled', false).html(originalContent);
                }
            });
        });

        // Xử lý upload avatar
        document.getElementById('avatarUpload').addEventListener('change', function(e) {
            if (e.target.files && e.target.files[0]) {
                const reader = new FileReader();
                reader.onload = function(ex) {
                    document.getElementById('userAvatar').src = ex.target.result;
                }
                reader.readAsDataURL(e.target.files[0]);
            }
        });
    </script>
}
