@model MotoShop.Data.Models.Customer
@{
    ViewData["Title"] = "Hồ sơ của tôi - MotoShop";
}

<!-- 1. BREADCRUMB -->
<div class="breadcrumb-wrapper">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
                <li class="breadcrumb-item active" aria-current="page">Tài khoản của tôi</li>
            </ol>
        </nav>
    </div>
</div>

<main class="container mb-5">
    <div class="row g-4">
        <!-- 2. SIDEBAR MENU (Left) -->
        <aside class="col-lg-3">
            <div class="account-sidebar">
                <div class="d-flex align-items-center gap-3 mb-4 pb-4 border-bottom">
                    <div style="width: 50px; height: 50px;">
                        <img src="@(Model.AvatarUrl ?? "/assets/img/avatars/default.png")" id="sideAvatar" class="rounded-circle w-100 h-100 object-fit-cover" alt="User">
                    </div>
                    <div>
                        <h6 class="fw-bold mb-0">@Model.FullName</h6>
                        <p class="text-muted small mb-0">Thành viên</p>
                    </div>
                </div>
                <ul class="account-nav">
                    <li class="account-nav-item">
                        <a href="/Account/Profile" class="account-nav-link active">
                            <i class='bx bx-user'></i> Thông tin cá nhân
                        </a>
                    </li>
                    <li class="account-nav-item">
                        <a href="/Order/Index" class="account-nav-link">
                            <i class='bx bx-package'></i> Đơn hàng của tôi
                        </a>
                    </li>
                    <li class="account-nav-item">
                        <a href="/Address/Index" class="account-nav-link">
                            <i class='bx bx-map'></i> Địa chỉ giao hàng
                        </a>
                    </li>
                    <li class="account-nav-item">
                        <a href="/Wishlist/Index" class="account-nav-link">
                            <i class='bx bx-heart'></i> Sản phẩm yêu thích
                        </a>
                    </li>
                    <li class="account-nav-item">
                        <a href="/Account/ChangePassword" class="account-nav-link">
                            <i class='bx bx-lock-alt'></i> Đổi mật khẩu
                        </a>
                    </li>
                    <li class="account-nav-item mt-3 pt-3 border-top">
                        <form asp-action="Logout" asp-controller="Account" method="post" id="logoutForm">
                            <a href="javascript:void(0)" class="account-nav-link text-danger" onclick="document.getElementById('logoutForm').submit()">
                                <i class='bx bx-log-out'></i> Đăng xuất
                            </a>
                        </form>
                    </li>
                </ul>
            </div>
        </aside>

        <!-- 3. MAIN CONTENT (Right) -->
        <div class="col-lg-9">
            <!-- Profile Information Card -->
            <div class="profile-section-card">
                <h5 class="fw-bold mb-4">THÔNG TIN CÁ NHÂN</h5>
                <div class="row g-4">
                    <div class="col-md-auto">
                        <div class="avatar-wrapper">
                            <img src="@(Model.AvatarUrl ?? "/assets/img/avatars/default.png")" class="avatar-img" id="userAvatar" alt="Avatar">
                            <label for="avatarUpload" class="btn-change-avatar">
                                <i class='bx bx-camera'></i>
                                <input type="file" id="avatarUpload" class="d-none" accept="image/*" onchange="uploadAvatar(this)">
                            </label>
                        </div>
                    </div>
                    <div class="col-md">
                        <form id="profileForm">
                            @Html.AntiForgeryToken()
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label-custom">Họ và tên</label>
                                    <input type="text" name="fullName" class="form-control form-control-custom" value="@Model.FullName" required>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label-custom">Số điện thoại</label>
                                    <input type="tel" name="phone" class="form-control form-control-custom" value="@Model.Phone" required>
                                </div>
                                <div class="col-md-12">
                                    <label class="form-label-custom">Địa chỉ Email</label>
                                    <input type="email" name="email" class="form-control form-control-custom" value="@Model.Email" required>
                                </div>
                                <div class="col-md-12">
                                    <label class="form-label-custom">Địa chỉ giao hàng mặc định</label>
                                    <input type="text" name="address" class="form-control form-control-custom" value="@Model.Address" placeholder="Nhập địa chỉ của bạn">
                                </div>
                                <div class="col-md-12 pt-2">
                                    <button type="button" class="btn btn-danger rounded-pill px-5 fw-bold" onclick="updateProfile()">LƯU THAY ĐỔI</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Orders Quick View (Stats) -->
            <div class="order-stats-grid">
                <a href="/Order/Index?status=DangXuLy" class="stat-box text-decoration-none">
                    <span class="stat-count">@ViewBag.Pending.ToString("D2")</span>
                    <span class="stat-label">Đang xử lý</span>
                </a>
                <a href="/Order/Index?status=DangGiao" class="stat-box text-decoration-none">
                    <span class="stat-count">@ViewBag.Shipping.ToString("D2")</span>
                    <span class="stat-label">Đang giao</span>
                </a>
                <a href="/Order/Index?status=DaHoanThanh" class="stat-box text-decoration-none">
                    <span class="stat-count">@ViewBag.Completed.ToString("D2")</span>
                    <span class="stat-label">Đã hoàn thành</span>
                </a>
            </div>

            <!-- Recent Orders Table -->
            <div class="profile-section-card p-0 overflow-hidden">
                <div class="p-4 border-bottom d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0">ĐƠN HÀNG GẦN ĐÂY</h5>
                    <a href="/Order/Index" class="text-danger fw-bold small text-decoration-none">Xem tất cả <i class='bx bx-right-arrow-alt'></i></a>
                </div>
                <div class="table-responsive">
                    <table class="table-custom">
                        <thead>
                            <tr>
                                <th>Mã đơn</th>
                                <th>Ngày đặt</th>
                                <th>Tổng tiền</th>
                                <th>Trạng thái</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Orders != null && Model.Orders.Any())
                            {
                                foreach (var order in Model.Orders.OrderByDescending(o => o.OrderDate).Take(5))
                                {
                                    <tr>
                                        <td class="fw-bold">#@(order.OrderCode ?? $"MS-{order.OrderId}")</td>
                                        <td>@order.OrderDate.ToString("dd/MM/yyyy")</td>
                                        <td class="fw-bold text-danger">@order.TotalAmount.ToString("N0")đ</td>
                                        <td>
                                            @{
                                                var statusClass = order.Status switch
                                                {
                                                    "Pending" or "DangXuLy" => "badge-pending",
                                                    "Shipping" or "DangGiao" => "badge-shipping",
                                                    "Completed" or "DaHoanThanh" => "badge-completed",
                                                    "Cancelled" or "DaHuy" => "badge-danger",
                                                    _ => "badge-dark"
                                                };
                                                var statusText = order.Status switch
                                                {
                                                    "Pending" or "DangXuLy" => "Đang xử lý",
                                                    "Shipping" or "DangGiao" => "Đang giao",
                                                    "Completed" or "DaHoanThanh" => "Đã nhận",
                                                    "Cancelled" or "DaHuy" => "Đã hủy",
                                                    _ => order.Status
                                                };
                                            }
                                            <span class="status-badge @statusClass">@statusText</span>
                                        </td>
                                        <td><a href="/Order/Detail/@order.OrderId" class="btn btn-sm btn-outline-dark rounded-pill px-3">Chi tiết</a></td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-4">Bạn chưa có đơn hàng nào.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <script>
        // Lấy Anti-forgery Token
        function getAntiForgeryToken() {
            return document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        }

        // Cập nhật Profile qua AJAX
        async function updateProfile() {
            const form = document.getElementById('profileForm');
            const formData = new FormData(form);
            
            try {
                const res = await fetch('/Account/UpdateProfile', {
                    method: 'POST',
                    body: formData
                });
                const data = await res.json();
                
                if (data.success) {
                    alert('Cập nhật hồ sơ thành công!');
                } else {
                    alert(data.message || 'Có lỗi xảy ra');
                }
            } catch (err) {
                alert('Lỗi kết nối máy chủ');
            }
        }

        // Upload Avatar qua AJAX
        async function uploadAvatar(input) {
            if (!input.files || !input.files[0]) return;

            // Preview local
            const reader = new FileReader();
            reader.onload = e => {
                document.getElementById('userAvatar').src = e.target.result;
                const sideAvatar = document.getElementById('sideAvatar');
                if(sideAvatar) sideAvatar.src = e.target.result;
            };
            reader.readAsDataURL(input.files[0]);

            // Server upload
            const formData = new FormData();
            formData.append('file', input.files[0]);
            formData.append('__RequestVerificationToken', getAntiForgeryToken());

            try {
                const res = await fetch('/Account/UploadAvatar', {
                    method: 'POST',
                    body: formData
                });
                const data = await res.json();
                if (!data.success) {
                    alert('Lỗi khi tải ảnh lên');
                }
            } catch (err) {
                alert('Lỗi kết nối máy chủ khi upload');
            }
        }
    </script>
}
