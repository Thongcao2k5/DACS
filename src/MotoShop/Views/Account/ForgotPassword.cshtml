@{
    ViewData["Title"] = "Quên mật khẩu";
}

<div class="breadcrumb-wrapper">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
                <li class="breadcrumb-item active" aria-current="page">Quên mật khẩu</li>
            </ol>
        </nav>
    </div>
</div>

<main class="auth-wrapper">
    <div class="container">
        <div class="auth-card shadow-lg border-0 rounded-4 p-4" style="max-width: 500px; margin: 0 auto;">
            <div class="auth-header text-center mb-4">
                <div class="mb-3 text-danger fs-1">
                    <i class='bx bx-lock-open-alt'></i>
                </div>
                <h2 class="fw-bold text-dark">QUÊN MẬT KHẨU?</h2>
                <p id="authDesc" class="text-muted">Nhập email của bạn để nhận mã xác nhận khôi phục mật khẩu.</p>
            </div>

            <!-- STEP 1: ENTER EMAIL -->
            <form id="step1Form" onsubmit="handleStep1(event)">
                <div class="mb-4">
                    <label class="form-label-custom">Email tài khoản *</label>
                    <input type="email" id="forgotEmail" class="form-control form-control-custom" placeholder="example@email.com" required>
                </div>
                <button type="submit" id="btnStep1" class="btn btn-danger btn-lg w-100 rounded-pill fw-bold mb-3">TIẾP TỤC</button>
            </form>

            <!-- STEP 2: ENTER OTP -->
            <form id="step2Form" class="d-none animate__animated animate__fadeIn" onsubmit="handleStep2(event)">
                <div class="text-center mb-4">
                    <p class="small text-muted">Chúng tôi đã gửi mã 6 số đến email: <br><b id="displayEmail" class="text-dark"></b></p>
                </div>
                <div class="mb-4">
                    <input type="text" id="otpCode" class="form-control text-center fs-2 fw-bold border-danger" maxlength="6" placeholder="000000" pattern="\d{6}" required>
                </div>
                <button type="submit" id="btnStep2" class="btn btn-danger btn-lg w-100 rounded-pill fw-bold mb-3">XÁC NHẬN MÃ</button>
                <div class="text-center">
                    <button type="button" class="btn btn-link btn-sm text-muted" onclick="location.reload()">Quay lại</button>
                </div>
            </form>

            <!-- STEP 3: NEW PASSWORD -->
            <form id="step3Form" class="d-none animate__animated animate__fadeIn" onsubmit="handleStep3(event)">
                <div class="mb-3">
                    <label class="form-label-custom">Mật khẩu mới *</label>
                    <input type="password" id="newPassword" class="form-control form-control-custom" required minlength="6">
                </div>
                <div class="mb-4">
                    <label class="form-label-custom">Xác nhận mật khẩu mới *</label>
                    <input type="password" id="confirmPassword" class="form-control form-control-custom" required minlength="6">
                </div>
                <button type="submit" id="btnStep3" class="btn btn-success btn-lg w-100 rounded-pill fw-bold mb-3">ĐỔI MẬT KHẨU</button>
            </form>

            <!-- ADDITIONAL LINKS -->
            <div class="mt-4 pt-3 border-top text-center">
                <p class="mb-0 small text-muted">Quay lại <a href="/Account/Login" class="text-danger fw-bold text-decoration-none">Đăng nhập</a></p>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

    <script>
        let currentEmail = '';
        let currentOtp = '';

        async function handleStep1(e) {
            e.preventDefault();
            const email = document.getElementById('forgotEmail').value;
            const btn = document.getElementById('btnStep1');

            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Đang xử lý...';

            try {
                const response = await fetch('/api/AccountApi/forgot-password-step1', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email })
                });
                const data = await response.json();

                if (response.ok) {
                    currentEmail = email;
                    document.getElementById('step1Form').classList.add('d-none');
                    document.getElementById('step2Form').classList.remove('d-none');
                    document.getElementById('displayEmail').innerText = email;
                    document.getElementById('authDesc').innerText = 'Vui lòng nhập mã xác nhận 6 chữ số.';
                } else {
                    Swal.fire('Lỗi!', data.message, 'error');
                }
            } catch (error) {
                Swal.fire('Lỗi!', 'Không thể kết nối máy chủ', 'error');
            } finally {
                btn.disabled = false;
                btn.innerText = 'TIẾP TỤC';
            }
        }

        async function handleStep2(e) {
            e.preventDefault();
            const code = document.getElementById('otpCode').value;
            const btn = document.getElementById('btnStep2');

            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Đang xác thực...';

            try {
                const response = await fetch('/api/AccountApi/verify-forgot-otp', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email: currentEmail, code: code })
                });

                if (response.ok) {
                    currentOtp = code;
                    document.getElementById('step2Form').classList.add('d-none');
                    document.getElementById('step3Form').classList.remove('d-none');
                    document.getElementById('authDesc').innerText = 'Thiết lập mật khẩu mới cho tài khoản của bạn.';
                } else {
                    const data = await response.json();
                    Swal.fire('Lỗi!', data.message, 'error');
                }
            } catch (error) {
                Swal.fire('Lỗi!', 'Không thể xác thực mã', 'error');
            } finally {
                btn.disabled = false;
                btn.innerText = 'XÁC NHẬN MÃ';
            }
        }

        async function handleStep3(e) {
            e.preventDefault();
            const newPassword = document.getElementById('newPassword').value;
            const confirmPassword = document.getElementById('confirmPassword').value;
            const btn = document.getElementById('btnStep3');

            if (newPassword !== confirmPassword) {
                Swal.fire('Chú ý!', 'Mật khẩu xác nhận không khớp.', 'warning');
                return;
            }

            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Đang cập nhật...';

            try {
                const response = await fetch('/api/AccountApi/reset-password', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ 
                        email: currentEmail, 
                        code: currentOtp,
                        newPassword: newPassword,
                        confirmPassword: confirmPassword
                    })
                });
                const data = await response.json();

                if (response.ok) {
                    Swal.fire({
                        title: '<span class="fw-bold text-success">Thành công!</span>',
                        text: 'Mật khẩu của bạn đã được thay đổi. Hãy đăng nhập để tiếp tục.',
                        icon: 'success',
                        confirmButtonText: 'ĐẾN TRANG ĐĂNG NHẬP',
                        customClass: { confirmButton: 'btn btn-success rounded-pill px-4' },
                        buttonsStyling: false,
                        showClass: { popup: 'animate__animated animate__zoomIn' }
                    }).then(() => {
                        window.location.href = '/Account/Login';
                    });
                } else {
                    Swal.fire({
                        title: '<span class="fw-bold text-danger">Thất bại!</span>',
                        text: data.message,
                        icon: 'error',
                        confirmButtonText: 'Kiểm tra lại',
                        customClass: { confirmButton: 'btn btn-danger rounded-pill px-4' },
                        buttonsStyling: false
                    });
                }
            } catch (error) {
                Swal.fire('Lỗi!', 'Không thể cập nhật mật khẩu', 'error');
            } finally {
                btn.disabled = false;
                btn.innerText = 'ĐỔI MẬT KHẨU';
            }
        }
    </script>
}
