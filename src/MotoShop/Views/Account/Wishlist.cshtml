@model IEnumerable<MotoShop.Data.Models.WishlistNew>
@{
    ViewData["Title"] = "Sản phẩm yêu thích - MotoShop";
    var customer = ViewBag.Customer as MotoShop.Data.Models.Customer;
}

<!-- 1. BREADCRUMB -->
<div class="breadcrumb-wrapper">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
                <li class="breadcrumb-item"><a href="/Account/Profile">Tài khoản</a></li>
                <li class="breadcrumb-item active" aria-current="page">Sản phẩm yêu thích</li>
            </ol>
        </nav>
    </div>
</div>

<main class="container mb-5">
    <div class="row g-4">
        <!-- 2. SIDEBAR MENU (Left) -->
        <aside class="col-lg-3">
            <div class="account-sidebar">
                <div class="d-flex align-items-center gap-3 mb-4 pb-4 border-bottom">
                    <div style="width: 50px; height: 50px;">
                        <img src="@(customer?.AvatarUrl ?? "/assets/img/avatars/default.png")" class="rounded-circle w-100 h-100 object-fit-cover" alt="User">
                    </div>
                    <div>
                        <h6 class="fw-bold mb-0">@customer?.FullName</h6>
                        <p class="text-muted small mb-0">Thành viên</p>
                    </div>
                </div>
                <ul class="account-nav">
                    <li class="account-nav-item">
                        <a href="/Account/Profile" class="account-nav-link">
                            <i class='bx bx-user'></i> Thông tin cá nhân
                        </a>
                    </li>
                    <li class="account-nav-item">
                        <a href="/Order/Index" class="account-nav-link">
                            <i class='bx bx-package'></i> Đơn hàng của tôi
                        </a>
                    </li>
                    <li class="account-nav-item">
                        <a href="/Address/Index" class="account-nav-link">
                            <i class='bx bx-map'></i> Địa chỉ giao hàng
                        </a>
                    </li>
                    <li class="account-nav-item">
                        <a href="/Account/Wishlist" class="account-nav-link active">
                            <i class='bx bx-heart'></i> Sản phẩm yêu thích
                        </a>
                    </li>
                    <li class="account-nav-item">
                        <a href="/Account/ChangePassword" class="account-nav-link">
                            <i class='bx bx-lock-alt'></i> Đổi mật khẩu
                        </a>
                    </li>
                    <li class="account-nav-item mt-3 pt-3 border-top">
                        <form asp-action="Logout" asp-controller="Account" method="post" id="logoutForm">
                            <a href="javascript:void(0)" class="account-nav-link text-danger" onclick="document.getElementById('logoutForm').submit()">
                                <i class='bx bx-log-out'></i> Đăng xuất
                            </a>
                        </form>
                    </li>
                </ul>
            </div>
        </aside>

        <!-- 3. MAIN CONTENT (Right) -->
        <div class="col-lg-9">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4 class="fw-bold mb-0 text-uppercase">SẢN PHẨM YÊU THÍCH (<span id="wishlistCount">@Model.Count()</span>)</h4>
                @if (Model.Any())
                {
                    <div class="d-flex gap-2">
                        <button class="btn btn-outline-danger btn-sm rounded-pill px-3" onclick="clearWishlist()">
                            <i class='bx bx-trash'></i> Xóa tất cả
                        </button>
                        <button class="btn btn-danger btn-sm rounded-pill px-3 fw-bold" onclick="addAllToCart(event)">
                            <i class='bx bx-cart-add'></i> THÊM TẤT CẢ VÀO GIỎ
                        </button>
                    </div>
                }
            </div>

            @if (!Model.Any())
            {
                <div id="emptyWishlist" class="text-center py-5 bg-white rounded-4 shadow-sm">
                    <i class='bx bx-heart display-1 text-muted mb-3'></i>
                    <p class="lead">Bạn chưa có sản phẩm yêu thích nào.</p>
                    <a href="/Product" class="btn btn-danger rounded-pill px-5 fw-bold">KHÁM PHÁ NGAY</a>
                </div>
            }

            <div class="row g-3" id="wishlistContainer">
                @foreach (var item in Model)
                {
                    var product = item.Product;
                    if (product == null) continue;
                    var variant = product.Variants.FirstOrDefault();
                    var primaryImg = product.Images?.FirstOrDefault(i => i.IsPrimary)?.ImageUrl ?? "/assets/img/elements/18.jpg";
                    
                    <div class="col-6 col-md-4 wishlist-card" data-product-id="@product.ProductId">
                        <div class="card h-100 shadow-sm border-0 product-card rounded-4 overflow-hidden">
                            <div class="position-relative overflow-hidden" style="aspect-ratio: 1/1;">
                                <img src="@primaryImg" 
                                     class="card-img-top w-100 h-100 object-fit-cover transition-scale" alt="@product.ProductName"
                                     onerror="this.src='/assets/img/elements/18.jpg'">
                                
                                <button class="btn btn-light btn-sm position-absolute top-0 end-0 m-2 rounded-circle shadow-sm btn-remove" 
                                        onclick="removeWishlistItem(event, @product.ProductId, this.closest('.wishlist-card'))"
                                        title="Xóa khỏi yêu thích">
                                    <i class='bx bx-x text-danger fs-5'></i>
                                </button>
                            </div>
                            
                            <div class="card-body p-3 d-flex flex-column text-center">
                                <small class="text-muted text-uppercase" style="font-size: 10px;">@product.Brand?.BrandName</small>
                                <h6 class="card-title text-truncate mb-2 mt-1 fw-bold" title="@product.ProductName" style="font-size: 14px;">
                                    <a href="/Product/Details?slug=@product.Slug" class="text-decoration-none text-dark">@product.ProductName</a>
                                </h6>
                                
                                <div class="mt-auto">
                                    @if (variant != null)
                                    {
                                        <div class="mb-2">
                                            <span class="text-danger fw-bold">@variant.Price.ToString("N0")đ</span>
                                        </div>
                                        
                                        @if (variant.StockQuantity > 0)
                                        {
                                            <button class="btn btn-danger btn-sm w-100 rounded-pill fw-bold py-2 btn-add-cart" onclick="addToCart(event, @product.ProductId)">
                                                <i class='bx bx-cart-add'></i> THÊM GIỎ
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-secondary btn-sm w-100 rounded-pill disabled" disabled>HẾT HÀNG</button>
                                        }
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</main>

@Html.AntiForgeryToken()

@section Styles {
    <style>
        .product-card { transition: all 0.3s ease; border: 1px solid #f8f9fa !important; }
        .product-card:hover { transform: translateY(-5px); box-shadow: 0 10px 20px rgba(0,0,0,0.08) !important; }
        .transition-scale { transition: transform 0.5s ease; }
        .product-card:hover .transition-scale { transform: scale(1.08); }
        .btn-remove { width: 30px; height: 30px; display: flex; align-items: center; justify-content: center; padding: 0; border: none; z-index: 10; }
        
        .account-sidebar {
            background: #fff;
            border-radius: 16px;
            padding: 24px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.05);
        }
        .account-nav { list-style: none; padding: 0; margin: 0; }
        .account-nav-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 16px;
            color: #555;
            text-decoration: none;
            font-weight: 600;
            border-radius: 12px;
            transition: all 0.2s;
            margin-bottom: 4px;
        }
        .account-nav-link:hover { background: #f8f9fa; color: #dc3545; }
        .account-nav-link.active { background: #fff5f5; color: #dc3545; }
        .account-nav-link i { font-size: 1.25rem; }
    </style>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function getAntiForgeryToken() { return document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''; }

        async function removeWishlistItem(e, productId, cardElement) {
            if (e) e.preventDefault();
            
            const result = await Swal.fire({
                title: 'Xác nhận',
                text: "Bỏ sản phẩm này khỏi danh sách yêu thích?",
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Đồng ý',
                cancelButtonText: 'Hủy'
            });

            if (result.isConfirmed) {
                const res = await fetch('/Wishlist/Remove', {
                    method: 'POST',
                    headers: { 
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': getAntiForgeryToken() 
                    },
                    body: JSON.stringify({ productId: productId })
                });
                const data = await res.json();
                if (data.success) {
                    cardElement.style.opacity = '0';
                    cardElement.style.transform = 'scale(0.8)';
                    setTimeout(() => { 
                        cardElement.remove(); 
                        updateCount(); 
                        if (document.querySelectorAll('.wishlist-card').length === 0) location.reload();
                        if (typeof updateWishlistBadge === 'function') updateWishlistBadge();
                    }, 300);
                }
            }
        }

        async function addToCart(e, productId) {
            if (e) e.preventDefault();
            const btn = e.target.closest('.btn-add-cart');
            const originalHtml = btn.innerHTML;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';
            btn.disabled = true;

            try {
                const res = await fetch('/Wishlist/AddToCart', {
                    method: 'POST',
                    headers: { 
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': getAntiForgeryToken() 
                    },
                    body: JSON.stringify({ productId: productId, quantity: 1 })
                });
                const data = await res.json();
                if (data.success) {
                    if (typeof updateCartBadge === 'function') updateCartBadge();
                    Swal.fire({ icon: 'success', title: 'Thành công', text: 'Đã thêm vào giỏ hàng', timer: 1500, toast: true, position: 'top-end', showConfirmButton: false });
                } else {
                    Swal.fire('Thông báo', data.message || 'Lỗi khi thêm vào giỏ', 'info');
                }
            } catch (err) {
                Swal.fire('Lỗi', 'Lỗi hệ thống', 'error');
            } finally {
                btn.innerHTML = originalHtml;
                btn.disabled = false;
            }
        }

        async function clearWishlist() {
            const result = await Swal.fire({
                title: 'Xác nhận',
                text: "Xóa tất cả sản phẩm trong danh sách yêu thích?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Xóa hết',
                cancelButtonText: 'Hủy'
            });

            if (result.isConfirmed) {
                const res = await fetch('/Wishlist/Clear', { method: 'POST', headers: { 'RequestVerificationToken': getAntiForgeryToken() } });
                if ((await res.json()).success) location.reload();
            }
        }

        async function addAllToCart(e) {
            if (e) e.preventDefault();
            const btn = e.target.closest('button');
            const originalHtml = btn.innerHTML;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Đang thêm...';
            btn.disabled = true;

            try {
                const res = await fetch('/Wishlist/AddAllToCart', { method: 'POST', headers: { 'RequestVerificationToken': getAntiForgeryToken() } });
                const data = await res.json();
                if (data.success) {
                    if (typeof updateCartBadge === 'function') updateCartBadge();
                    Swal.fire('Thành công', `Đã thêm ${data.added} sản phẩm vào giỏ hàng`, 'success');
                }
            } catch (err) {
                Swal.fire('Lỗi', 'Lỗi hệ thống', 'error');
            } finally {
                btn.innerHTML = originalHtml;
                btn.disabled = false;
            }
        }

        function updateCount() {
            const count = document.querySelectorAll('.wishlist-card').length;
            const countEl = document.getElementById('wishlistCount');
            if (countEl) countEl.innerText = count;
        }
    </script>
}
