@model IEnumerable<MotoShop.Data.Models.Blog>
@{
    ViewData["Title"] = "Tin tức & Kiến thức xe máy";
    var categories = ViewBag.Categories;
    var recentPosts = ViewBag.RecentPosts as IEnumerable<MotoShop.Data.Models.Blog>;
}

<div class="breadcrumb-wrapper">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                <li class="breadcrumb-item active" aria-current="page">Tin tức</li>
            </ol>
        </nav>
    </div>
</div>

<main class="container mb-5">
    <section class="p-0 mb-5">
        <div class="blog-banner" style="background: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.6)), url('https://images.unsplash.com/photo-1558981403-c5f9899a28bc?auto=format&fit=crop&w=1200&q=80'); background-size: cover; background-position: center; padding: 100px 0; border-radius: 20px; color: white;">
            <div class="container text-center">
                <h1 class="display-4 fw-bolder mb-3">TIN TỨC & KIẾN THỨC</h1>
                <p class="fs-5 opacity-75">Chia sẻ kinh nghiệm sử dụng, bảo dưỡng và review phụ tùng xe máy chuyên sâu.</p>
            </div>
        </div>
    </section>

    <div class="row g-4">
        <!-- LEFT COLUMN: BLOG POSTS -->
        <div class="col-lg-8">
            @if (Model != null && Model.Any())
            {
                <div class="row g-4">
                    @foreach (var item in Model)
                    {
                        <div class="col-md-6">
                            <article class="blog-card h-100 shadow-sm border-0 rounded-4 overflow-hidden bg-white">
                                <div class="post-img-wrapper" style="height: 200px; overflow: hidden;">
                                    <a asp-controller="Blog" asp-action="Detail" asp-route-slug="@item.Slug">
                                        <img src="@(string.IsNullOrEmpty(item.Thumbnail) ? "/assets/img/elements/1.jpg" : item.Thumbnail)" 
                                             class="w-100 h-100 object-fit-cover transition-transform" alt="@item.Title">
                                    </a>
                                </div>
                                <div class="post-content p-4">
                                    <div class="post-meta small text-muted mb-2 d-flex gap-3">
                                        <span><i class='bx bx-calendar me-1'></i>@item.CreatedDate.ToString("dd/MM/yyyy")</span>
                                        <span><i class='bx bx-folder me-1'></i>@item.Category?.Name</span>
                                    </div>
                                    <h5 class="post-title fw-bold mb-3">
                                        <a asp-controller="Blog" asp-action="Detail" asp-route-slug="@item.Slug" class="text-dark text-decoration-none hover-danger">@item.Title</a>
                                    </h5>
                                    <p class="post-excerpt text-muted small mb-4">
                                        @if (!string.IsNullOrEmpty(item.Content))
                                        {
                                            var plainText = System.Text.RegularExpressions.Regex.Replace(item.Content, "<.*?>", String.Empty);
                                            @(plainText.Length > 120 ? plainText.Substring(0, 120) + "..." : plainText)
                                        }
                                    </p>
                                    <a asp-controller="Blog" asp-action="Detail" asp-route-slug="@item.Slug" class="btn btn-outline-danger btn-sm rounded-pill px-4 fw-bold">ĐỌC TIẾP</a>
                                </div>
                            </article>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class='bx bx-news fs-1 text-muted mb-3'></i>
                    <h4 class="text-muted">Chưa có bài viết nào được đăng.</h4>
                </div>
            }
        </div>

        <!-- RIGHT COLUMN: SIDEBAR -->
        <aside class="col-lg-4 blog-sidebar">
            <!-- Search Widget -->
            <div class="sidebar-widget bg-white p-4 rounded-4 shadow-sm mb-4">
                <h5 class="widget-title fw-bold border-bottom pb-2 mb-3">Tìm kiếm</h5>
                <form asp-action="Index" method="get">
                    <div class="input-group">
                        <input type="text" name="searchTerm" class="form-control" placeholder="Nhập từ khóa..." value="@ViewBag.SearchTerm">
                        <button class="btn btn-danger" type="submit"><i class='bx bx-search'></i></button>
                    </div>
                </form>
            </div>

            <!-- Categories Widget -->
            <div class="sidebar-widget bg-white p-4 rounded-4 shadow-sm mb-4">
                <h5 class="widget-title fw-bold border-bottom pb-2 mb-3">Danh mục tin tức</h5>
                <ul class="list-unstyled mt-3">
                    @foreach (var cat in categories)
                    {
                        <li class="mb-2">
                            <a asp-action="Index" asp-route-categoryId="@cat.Id" 
                               class="text-decoration-none d-flex justify-content-between align-items-center @(ViewBag.CurrentCategoryId == cat.Id ? "text-danger fw-bold" : "text-muted")">
                                @cat.Name <span class="badge bg-light text-dark rounded-pill">@cat.Count</span>
                            </a>
                        </li>
                    }
                </ul>
            </div>

            <!-- Recent Posts Widget -->
            @if (recentPosts != null && recentPosts.Any())
            {
                <div class="sidebar-widget bg-white p-4 rounded-4 shadow-sm mb-4">
                    <h5 class="widget-title fw-bold border-bottom pb-2 mb-3">Bài viết mới nhất</h5>
                    <div class="mt-3">
                        @foreach (var post in recentPosts)
                        {
                            <a asp-action="Detail" asp-route-slug="@post.Slug" class="d-flex gap-3 text-decoration-none mb-3 align-items-center">
                                <img src="@(string.IsNullOrEmpty(post.Thumbnail) ? "/assets/img/elements/1.jpg" : post.Thumbnail)" 
                                     style="width: 70px; height: 50px; object-fit: cover; border-radius: 8px;" alt="P">
                                <div>
                                    <div class="text-dark fw-bold small line-clamp-2">@post.Title</div>
                                    <span class="text-muted" style="font-size: 11px;">@post.CreatedDate.ToString("dd/MM/yyyy")</span>
                                </div>
                            </a>
                        }
                    </div>
                </div>
            }
        </aside>
    </div>
</main>

<style>
    .hover-danger:hover { color: #dc3545 !important; }
    .transition-transform:hover { transform: scale(1.05); }
    .line-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .object-fit-cover { object-fit: cover; }
</style>
