@model IEnumerable<MotoShop.Data.Models.Blog>
@using MotoShop.Business.DTOs
@{
    ViewData["Title"] = "Tin tức & Kiến thức xe máy";
    var categories = ViewBag.Categories as IEnumerable<BlogCategoryDto> ?? new List<BlogCategoryDto>();
    var recentPosts = ViewBag.RecentPosts as IEnumerable<MotoShop.Data.Models.Blog>;
}

<div class="breadcrumb-wrapper">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
                <li class="breadcrumb-item active" aria-current="page">Tin tức</li>
            </ol>
        </nav>
    </div>
</div>

<main class="container py-5">
    <div class="text-center mb-5">
        <h2 class="fw-bold text-uppercase">TIN TỨC & CHIA SẺ KỸ THUẬT</h2>
        <div class="mx-auto bg-danger mb-3" style="height: 3px; width: 60px;"></div>
        <p class="text-muted">Cập nhật những thông tin mới nhất về phụ tùng và mẹo bảo dưỡng xe máy chuyên nghiệp.</p>
    </div>

    <div class="row g-4">
        <!-- LEFT COLUMN: BLOG POSTS -->
        <div class="col-lg-8">
            @if (Model != null && Model.Any())
            {
                <div class="row g-4">
                    @foreach (var item in Model)
                    {
                        <div class="col-md-6">
                            <article class="blog-card h-100 shadow-sm border-0 rounded-4 overflow-hidden bg-white">
                                <div class="post-img-wrapper" style="height: 200px; overflow: hidden;">
                                    <a asp-controller="Blog" asp-action="Detail" asp-route-slug="@item.Slug">
                                        <img src="@(string.IsNullOrEmpty(item.Thumbnail) ? "/assets/img/elements/1.jpg" : item.Thumbnail)" 
                                             class="w-100 h-100 object-fit-cover transition-transform" alt="@item.Title">
                                    </a>
                                </div>
                                <div class="post-content p-4">
                                    <div class="post-meta small text-muted mb-2 d-flex gap-3">
                                        <span><i class='bx bx-calendar me-1'></i>@item.CreatedDate.ToString("dd/MM/yyyy")</span>
                                        <span><i class='bx bx-folder me-1'></i>@item.Category?.Name</span>
                                    </div>
                                    <h5 class="post-title fw-bold mb-3">
                                        <a asp-controller="Blog" asp-action="Detail" asp-route-slug="@item.Slug" class="text-dark text-decoration-none hover-danger">@item.Title</a>
                                    </h5>
                                    <p class="post-excerpt text-muted small mb-4">
                                        @if (!string.IsNullOrEmpty(item.Content))
                                        {
                                            var plainText = System.Text.RegularExpressions.Regex.Replace(item.Content, "<.*?>", String.Empty);
                                            @(plainText.Length > 120 ? plainText.Substring(0, 120) + "..." : plainText)
                                        }
                                    </p>
                                    <a asp-controller="Blog" asp-action="Detail" asp-route-slug="@item.Slug" class="btn btn-outline-danger btn-sm rounded-pill px-4 fw-bold">ĐỌC TIẾP</a>
                                </div>
                            </article>
                        </div>
                    }
                </div>

                <!-- Pagination -->
                @if (ViewBag.TotalPages > 1)
                {
                    <nav class="mt-5">
                        <ul class="pagination justify-content-center">
                            <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link rounded-circle mx-1" href="/Blog?page=@(ViewBag.CurrentPage - 1)@(ViewBag.CurrentCategory != null ? $"&categoryId={ViewBag.CurrentCategory}" : "")"><i class='bx bx-chevron-left'></i></a>
                            </li>
                            @for (int i = 1; i <= ViewBag.TotalPages; i++)
                            {
                                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                    <a class="page-link rounded-circle mx-1" href="/Blog?page=@i@(ViewBag.CurrentCategory != null ? $"&categoryId={ViewBag.CurrentCategory}" : "")">@i</a>
                                </li>
                            }
                            <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                                <a class="page-link rounded-circle mx-1" href="/Blog?page=@(ViewBag.CurrentPage + 1)@(ViewBag.CurrentCategory != null ? $"&categoryId={ViewBag.CurrentCategory}" : "")"><i class='bx bx-chevron-right'></i></a>
                            </li>
                        </ul>
                    </nav>
                }
            }
            else
            {
                <div class="text-center py-5">
                    <i class='bx bx-news fs-1 text-muted mb-3'></i>
                    <h4 class="text-muted">Chưa có bài viết nào được đăng.</h4>
                </div>
            }
        </div>

        <!-- RIGHT COLUMN: SIDEBAR -->
        <aside class="col-lg-4 blog-sidebar">
            <!-- Search Widget -->
            <div class="sidebar-widget bg-white p-4 rounded-4 shadow-sm mb-4 border border-light">
                <h5 class="widget-title fw-bold border-bottom pb-2 mb-3">Tìm kiếm</h5>
                <form asp-action="Index" method="get">
                    <div class="input-group">
                        <input type="text" name="searchTerm" class="form-control rounded-start-pill ps-3" placeholder="Nhập từ khóa..." value="@ViewBag.SearchTerm">
                        <button class="btn btn-danger rounded-end-pill px-3" type="submit"><i class='bx bx-search'></i></button>
                    </div>
                </form>
            </div>

            <!-- Categories Widget -->
            <div class="sidebar-widget bg-white p-4 rounded-4 shadow-sm mb-4 border border-light">
                <h5 class="widget-title fw-bold border-bottom pb-2 mb-3">Danh mục tin tức</h5>
                <ul class="list-unstyled mt-3 mb-0">
                    <li class="mb-2">
                        <a href="/Blog" class="blog-sidebar-link text-decoration-none d-flex justify-content-between align-items-center @(ViewBag.CurrentCategoryId == null ? "active text-danger fw-bold" : "text-muted")">
                            <span>Tất cả bài viết</span>
                            <i class='bx bx-chevron-right'></i>
                        </a>
                    </li>
                    @foreach (var cat in categories)
                    {
                        <li class="mb-2">
                            <a asp-action="Index" asp-route-categoryId="@cat.Id" 
                               class="blog-sidebar-link text-decoration-none d-flex justify-content-between align-items-center @(ViewBag.CurrentCategoryId == cat.Id ? "active text-danger fw-bold" : "text-muted")">
                                <span>@cat.Name</span>
                                <span class="badge bg-light text-dark rounded-pill border">@cat.BlogCount</span>
                            </a>
                        </li>
                    }
                </ul>
            </div>

            <!-- Recent Posts Widget -->
            @if (recentPosts != null && recentPosts.Any())
            {
                <div class="sidebar-widget bg-white p-4 rounded-4 shadow-sm mb-4 border border-light">
                    <h5 class="widget-title fw-bold border-bottom pb-2 mb-3">Bài viết mới nhất</h5>
                    <div class="mt-3">
                        @foreach (var post in recentPosts)
                        {
                            <a asp-action="Detail" asp-route-slug="@post.Slug" class="d-flex gap-3 text-decoration-none mb-3 align-items-center group">
                                <img src="@(string.IsNullOrEmpty(post.Thumbnail) ? "/assets/img/elements/1.jpg" : post.Thumbnail)" 
                                     style="width: 70px; height: 50px; object-fit: cover; border-radius: 8px;" alt="P" class="shadow-sm">
                                <div>
                                    <div class="text-dark fw-bold small line-clamp-2 hover-danger transition-all">@post.Title</div>
                                    <span class="text-muted" style="font-size: 11px;">@post.CreatedDate.ToString("dd/MM/yyyy")</span>
                                </div>
                            </a>
                        }
                    </div>
                </div>
            }

            <div class="mt-5 p-4 rounded-4 text-white shadow" style="background: linear-gradient(135deg, #dc3545 0%, #a71d2a 100%);">
                <h6 class="fw-bold mb-2">Tư vấn kỹ thuật?</h6>
                <p class="small mb-3" style="opacity: 0.9;">Liên hệ ngay với chuyên gia MotoShop để được hỗ trợ tốt nhất.</p>
                <a href="tel:0281234567" class="btn btn-light rounded-pill w-100 fw-bold shadow-sm">GỌI NGAY</a>
            </div>
        </aside>
    </div>
</main>

@section Styles {
    <style>
        .blog-sidebar-link {
            display: flex;
            padding: 8px 12px;
            border-radius: 8px;
            color: #555;
            transition: all 0.2s ease;
        }
        .blog-sidebar-link:hover, .blog-sidebar-link.active {
            background-color: #fff5f5;
            color: #dc3545 !important;
            transform: translateX(5px);
        }
        .hover-danger:hover { color: #dc3545 !important; }
        .transition-transform { transition: transform 0.3s ease; }
        .blog-card:hover .transition-transform { transform: scale(1.05); }
        .line-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
        .page-link { color: #333; border: 1px solid #eee; width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; }
        .page-item.active .page-link { background-color: #dc3545; border-color: #dc3545; color: #fff; }
        .object-fit-cover { object-fit: cover; }
    </style>
}
