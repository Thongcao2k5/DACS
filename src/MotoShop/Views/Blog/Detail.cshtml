@model MotoShop.Data.Models.Blog
@{
    ViewData["Title"] = Model.Title;
    var relatedPosts = ViewBag.RelatedPosts as IEnumerable<MotoShop.Data.Models.Blog>;
    var categories = ViewBag.Categories as IEnumerable<MotoShop.Data.Models.BlogCategory>;
}

<!-- BREADCRUMB -->
<div class="breadcrumb-wrapper py-3 bg-light border-bottom mb-4">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-danger">Trang chủ</a></li>
                <li class="breadcrumb-item"><a href="/Blog" class="text-decoration-none text-danger">Tin tức</a></li>
                <li class="breadcrumb-item active text-truncate" style="max-width: 300px;" aria-current="page">@Model.Title</li>
            </ol>
        </nav>
    </div>
</div>

<main class="container py-4 mb-5">
    <div class="row g-4">
        <!-- NỘI DUNG CHÍNH (LEFT) -->
        <div class="col-lg-9">
            <article class="blog-detail-wrapper bg-white p-4 p-md-5 shadow-sm rounded-4 border">
                <header class="mb-5">
                    <div class="mb-3">
                        <span class="badge bg-danger rounded-pill px-3 py-2 text-uppercase shadow-sm" style="font-size: 0.75rem;">@Model.Category?.Name</span>
                    </div>
                    <h1 class="article-title fw-bold mb-4 display-6" style="line-height: 1.3;">@Model.Title</h1>
                    
                    <div class="d-flex flex-wrap align-items-center gap-4 text-muted border-top border-bottom py-3 small text-uppercase fw-bold" style="letter-spacing: 1px;">
                        <div class="d-flex align-items-center gap-2">
                            <i class='bx bx-calendar fs-5 text-danger'></i>
                            <span>@Model.CreatedDate.ToString("dd/MM/yyyy")</span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <i class='bx bx-user fs-5 text-danger'></i>
                            <span>Tác giả: Admin</span>
                        </div>
                    </div>
                </header>

                @if (!string.IsNullOrEmpty(Model.Thumbnail))
                {
                    <div class="blog-main-image mb-5 rounded-4 overflow-hidden shadow-sm">
                        <img src="@Model.Thumbnail" class="w-100 h-auto object-fit-cover" alt="@Model.Title" style="max-height: 600px;">
                    </div>
                }

                <div class="blog-content mb-5 ck-content fs-5">
                    @Html.Raw(Model.Content)
                </div>

                <div class="blog-footer border-top pt-5">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-4">
                        <div class="share-box d-flex align-items-center gap-2">
                            <span class="fw-bold text-uppercase small text-muted me-2">Chia sẻ:</span>
                            <button onclick="shareFacebook()" class="btn btn-sm btn-outline-primary rounded-circle shadow-sm" title="Chia sẻ Facebook"><i class='bx bxl-facebook'></i></button>
                            <button onclick="shareZalo()" class="btn btn-sm btn-outline-info rounded-circle shadow-sm" title="Chia sẻ Zalo">
                                <img src="https://upload.wikimedia.org/wikipedia/commons/9/91/Icon_of_Zalo.svg" alt="Zalo" width="16" style="filter: brightness(0) saturate(100%) invert(48%) sepia(87%) deg(198deg) saturate(2337%) hue-rotate(176deg) brightness(101%) contrast(101%);">
                            </button>
                            <button onclick="copyLink()" class="btn btn-sm btn-outline-secondary rounded-circle shadow-sm" title="Copy Link"><i class='bx bx-link'></i></button>
                        </div>
                        <a href="/Blog" class="btn btn-outline-secondary rounded-pill px-4 fw-bold btn-sm shadow-sm">
                            <i class='bx bx-chevron-left'></i> QUAY LẠI
                        </a>
                    </div>
                </div>
            </article>

            <!-- BÀI VIẾT LIÊN QUAN -->
            @if (relatedPosts != null && relatedPosts.Any())
            {
                <section class="related-blogs mt-5">
                    <h4 class="fw-bold mb-4 border-start border-danger border-4 ps-3 text-uppercase">Bài viết liên quan</h4>
                    <div class="row g-4">
                        @foreach (var related in relatedPosts)
                        {
                            <div class="col-md-4">
                                <div class="card border-0 shadow-sm rounded-4 h-100 transition-hover overflow-hidden border">
                                    <div style="height: 160px; overflow: hidden;">
                                        <img src="@(string.IsNullOrEmpty(related.Thumbnail) ? "/assets/img/elements/placeholder-image.png" : related.Thumbnail)" 
                                             class="w-100 h-100 object-fit-cover transition-img" alt="@related.Title">
                                    </div>
                                    <div class="card-body p-3 d-flex flex-column">
                                        <h6 class="fw-bold mb-2 line-clamp-2" style="height: 40px; font-size: 0.9rem;">
                                            <a asp-action="Detail" asp-route-slug="@related.Slug" class="text-dark text-decoration-none hover-danger">@related.Title</a>
                                        </h6>
                                        <div class="d-flex justify-content-between align-items-center mt-auto pt-2">
                                            <span class="text-muted extra-small">@related.CreatedDate.ToString("dd/MM/yyyy")</span>
                                            <span class="text-danger extra-small fw-bold">Chi tiết <i class='bx bx-right-arrow-alt'></i></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </section>
            }
        </div>

        <!-- SIDEBAR (RIGHT) -->
        <aside class="col-lg-3">
            <div class="blog-sidebar shadow-sm rounded-4 p-4 sticky-top border bg-white" style="top: 100px;">
                <h5 class="fw-bold mb-4 border-bottom pb-2 text-uppercase" style="font-size: 0.9rem; letter-spacing: 1px;">Danh mục tin</h5>
                <ul class="list-unstyled mb-0">
                    <li class="mb-2">
                        <a href="/Blog" class="blog-sidebar-link d-flex justify-content-between align-items-center">
                            Tất cả bài viết <i class='bx bx-chevron-right'></i>
                        </a>
                    </li>
                    @if (categories != null)
                    {
                        @foreach (var cat in categories)
                        {
                            <li class="mb-2">
                                <a href="/Blog?categoryId=@cat.Id" class="blog-sidebar-link d-flex justify-content-between align-items-center @(Model.CategoryId == cat.Id ? "active" : "")">
                                    @cat.Name <i class='bx bx-chevron-right'></i>
                                </a>
                            </li>
                        }
                    }
                </ul>

                <div class="mt-5 p-4 rounded-4 text-white shadow-sm" style="background: linear-gradient(135deg, #dc3545 0%, #a71d2a 100%);">
                    <h6 class="fw-bold mb-2">Tư vấn nhanh?</h6>
                    <p class="small mb-3" style="opacity: 0.9;">Gặp kỹ thuật viên của MotoShop ngay bây giờ.</p>
                    <a href="tel:0281234567" class="btn btn-light rounded-pill w-100 fw-bold shadow-sm">GỌI HOTLINE</a>
                </div>
            </div>
        </aside>
    </div>
</main>

<style>
    .blog-detail-wrapper { line-height: 1.8; color: #333; }
    .ck-content { font-size: 1.1rem; color: #444; }
    .ck-content img { max-width: 100%; height: auto !important; border-radius: 12px; margin: 25px 0; box-shadow: 0 10px 30px rgba(0,0,0,0.05); }
    .ck-content h2, .ck-content h3 { font-weight: 700; margin-top: 35px; margin-bottom: 15px; color: #222; }
    .ck-content blockquote { border-left: 5px solid #dc3545; padding: 20px; background: #f9f9f9; font-style: italic; border-radius: 0 10px 10px 0; margin: 25px 0; }
    
    .blog-sidebar-link { display: block; padding: 10px 15px; border-radius: 8px; color: #444; text-decoration: none; font-weight: 600; font-size: 0.85rem; transition: all 0.3s; }
    .blog-sidebar-link:hover, .blog-sidebar-link.active { background-color: #fff5f5; color: #dc3545; transform: translateX(5px); }
    
    .line-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .extra-small { font-size: 0.75rem; }
    .transition-hover:hover { transform: translateY(-5px); box-shadow: 0 10px 20px rgba(0,0,0,0.08) !important; }
    .transition-img { transition: transform 0.6s ease; }
    .transition-hover:hover .transition-img { transform: scale(1.05); }
    .hover-danger:hover { color: #dc3545 !important; }
    .object-fit-cover { object-fit: cover; }
</style>

@section Scripts {
    <script>
        function shareFacebook() {
            const url = encodeURIComponent(window.location.href);
            window.open(`https://www.facebook.com/sharer/sharer.php?u=${url}`, '_blank', 'width=600,height=400');
        }

        function shareZalo() {
            const url = encodeURIComponent(window.location.href);
            window.open(`https://zalo.me/share?url=${url}`, '_blank');
        }

        function copyLink() {
            navigator.clipboard.writeText(window.location.href).then(() => {
                if (typeof UI !== 'undefined' && UI.showToast) {
                    UI.showToast('Đã sao chép liên kết vào bộ nhớ tạm!', 'success');
                } else {
                    alert('Đã copy link!');
                }
            });
        }
    </script>
}
