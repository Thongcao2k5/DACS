@model MotoShop.Data.Models.Blog
@{
    ViewData["Title"] = Model.Title;
    var relatedPosts = ViewBag.RelatedPosts as IEnumerable<MotoShop.Data.Models.Blog>;
}

<div class="breadcrumb-wrapper">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                <li class="breadcrumb-item"><a asp-controller="Blog" asp-action="Index">Tin tức</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
            </ol>
        </nav>
    </div>
</div>

<main class="container mb-5">
    <div class="row g-4">
        <!-- ARTICLE CONTENT -->
        <div class="col-lg-8">
            <article class="blog-detail-wrapper bg-white p-4 p-md-5 rounded-4 shadow-sm border">
                <header class="article-header mb-4">
                    <div class="post-meta small text-muted mb-3 d-flex gap-3">
                        <span><i class='bx bx-calendar me-1 text-danger'></i>@Model.CreatedDate.ToString("dd/MM/yyyy")</span>
                        <span><i class='bx bx-folder me-1 text-danger'></i>@Model.Category?.Name</span>
                        <span><i class='bx bx-user me-1 text-danger'></i>Admin</span>
                    </div>
                    <h1 class="article-title fw-bold mb-4" style="line-height: 1.3;">@Model.Title</h1>
                    
                    @if (!string.IsNullOrEmpty(Model.Thumbnail))
                    {
                        <div class="post-img-wrapper rounded-4 overflow-hidden mb-4">
                            <img src="@Model.Thumbnail" alt="@Model.Title" class="w-100 h-auto">
                        </div>
                    }
                </header>

                <div class="article-body">
                    @Html.Raw(Model.Content)
                </div>

                <footer class="article-footer mt-5 pt-4 border-top">
                    <div class="share-group d-flex align-items-center gap-3">
                        <span class="small fw-bold text-muted">CHIA SẺ:</span>
                        <a href="#" class="share-btn border rounded-circle d-flex align-items-center justify-content-center" style="width: 35px; height: 35px;"><i class='bx bxl-facebook'></i></a>
                        <a href="#" class="share-btn border rounded-circle d-flex align-items-center justify-content-center" style="width: 35px; height: 35px;"><i class='bx bxl-twitter'></i></a>
                        <a href="#" class="share-btn border rounded-circle d-flex align-items-center justify-content-center" style="width: 35px; height: 35px;"><i class='bx bx-link'></i></a>
                    </div>
                </footer>
            </article>

            <!-- RELATED POSTS -->
            @if (relatedPosts != null && relatedPosts.Any())
            {
                <section class="mt-5 pt-5 border-top">
                    <h4 class="fw-bold mb-4 text-uppercase">BÀI VIẾT LIÊN QUAN</h4>
                    <div class="row g-4">
                        @foreach (var post in relatedPosts)
                        {
                            <div class="col-md-4">
                                <div class="related-post-card h-100">
                                    <a asp-action="Detail" asp-route-slug="@post.Slug" class="related-post-thumb rounded-3 overflow-hidden d-block mb-2" style="height: 120px;">
                                        <img src="@(string.IsNullOrEmpty(post.Thumbnail) ? "/assets/img/elements/1.jpg" : post.Thumbnail)" 
                                             class="w-100 h-100 object-fit-cover" alt="@post.Title">
                                    </a>
                                    <div class="related-post-info">
                                        <span class="text-muted" style="font-size: 11px;">@post.CreatedDate.ToString("dd/MM/yyyy")</span>
                                        <a asp-action="Detail" asp-route-slug="@post.Slug" class="title d-block fw-bold text-dark text-decoration-none mt-1 small hover-danger">@post.Title</a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </section>
            }
        </div>

        <!-- SIDEBAR -->
        <aside class="col-lg-4">
            <div class="sidebar-widget bg-white p-4 rounded-4 shadow-sm mb-4 border">
                <h5 class="widget-title fw-bold border-bottom pb-2 mb-3">Tìm kiến thức</h5>
                <form asp-action="Index" method="get">
                    <div class="input-group">
                        <input type="text" name="searchTerm" class="form-control" placeholder="Nhập từ khóa...">
                        <button class="btn btn-danger" type="submit"><i class='bx bx-search'></i></button>
                    </div>
                </form>
            </div>

            <!-- Widget danh mục có thể thêm ở đây nếu cần -->
        </aside>
    </div>
</main>

<style>
    .article-body { line-height: 1.8; font-size: 1.1rem; color: #333; }
    .article-body img { max-width: 100%; height: auto; border-radius: 12px; margin: 20px 0; }
    .hover-danger:hover { color: #dc3545 !important; }
    .object-fit-cover { object-fit: cover; }
</style>
