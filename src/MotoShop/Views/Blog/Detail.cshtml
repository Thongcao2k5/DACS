@model MotoShop.Data.Models.Blog
@{
    ViewData["Title"] = Model.Title;
    var relatedPosts = ViewBag.RelatedPosts as IEnumerable<MotoShop.Data.Models.Blog>;
    ViewData["Title"] = Model.Title;
}

<div class="breadcrumb-wrapper">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                <li class="breadcrumb-item"><a asp-controller="Blog" asp-action="Index">Tin tức</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
                <li class="breadcrumb-item"><a href="/Blog">Tin tức</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
            </ol>
        </nav>
    </div>
</div>

<main class="container mb-5">
    <div class="row g-4">
        <!-- ARTICLE CONTENT -->
        <div class="col-lg-8">
            <article class="blog-detail-wrapper bg-white p-4 p-md-5 rounded-4 shadow-sm border">
                <header class="article-header mb-4">
                    <div class="post-meta small text-muted mb-3 d-flex gap-3">
                        <span><i class='bx bx-calendar me-1 text-danger'></i>@Model.CreatedDate.ToString("dd/MM/yyyy")</span>
                        <span><i class='bx bx-folder me-1 text-danger'></i>@Model.Category?.Name</span>
                        <span><i class='bx bx-user me-1 text-danger'></i>Admin</span>
<main class="container py-5">
    <div class="row g-5">
        <!-- Nội dung chính bên trái (Rộng hơn) -->
        <div class="col-lg-9">
            <article class="blog-detail-wrapper bg-white p-4 p-md-5 shadow-sm rounded-4 border">
                <header class="mb-5">
                    <div class="mb-3">
                        <span class="badge bg-danger rounded-pill px-3 py-2 text-uppercase shadow-sm">@Model.Category?.Name</span>
                    </div>
                    <h1 class="article-title fw-bold mb-4" style="line-height: 1.3;">@Model.Title</h1>
                    
                    @if (!string.IsNullOrEmpty(Model.Thumbnail))
                    {
                        <div class="post-img-wrapper rounded-4 overflow-hidden mb-4">
                            <img src="@Model.Thumbnail" alt="@Model.Title" class="w-100 h-auto">
                        </div>
                    }
                    <h1 class="fw-bold mb-4 display-5">@Model.Title</h1>
                    <div class="d-flex align-items-center gap-4 text-muted border-top border-bottom py-3 small text-uppercase fw-bold" style="letter-spacing: 1px;">
                        <div class="d-flex align-items-center gap-2">
                            <i class='bx bx-calendar fs-5 text-danger'></i>
                            <span>@Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <i class='bx bx-user fs-5 text-danger'></i>
                            <span>Tác giả: Admin</span>
                        </div>
                    </div>
                </header>

                <div class="article-body">
                    @Html.Raw(Model.Content)
                @if (!string.IsNullOrEmpty(Model.Thumbnail))
                {
                    <div class="blog-main-image mb-5 rounded-4 overflow-hidden shadow-sm">
                        <img src="@Model.Thumbnail" class="w-100 h-100 object-fit-cover" alt="@Model.Title" style="max-height: 500px;">
                    </div>
                }

                <div class="blog-content mb-5 ck-content fs-5">
                    @Html.Raw(Model.Content)
                </div>

                <footer class="article-footer mt-5 pt-4 border-top">
                    <div class="share-group d-flex align-items-center gap-3">
                        <span class="small fw-bold text-muted">CHIA SẺ:</span>
                        <a href="#" class="share-btn border rounded-circle d-flex align-items-center justify-content-center" style="width: 35px; height: 35px;"><i class='bx bxl-facebook'></i></a>
                        <a href="#" class="share-btn border rounded-circle d-flex align-items-center justify-content-center" style="width: 35px; height: 35px;"><i class='bx bxl-twitter'></i></a>
                        <a href="#" class="share-btn border rounded-circle d-flex align-items-center justify-content-center" style="width: 35px; height: 35px;"><i class='bx bx-link'></i></a>
                <div class="blog-footer border-top pt-5 mb-2">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-4">
                        <div class="share-box d-flex align-items-center gap-3">
                            <span class="fw-bold text-uppercase small">Chia sẻ bài viết:</span>
                            <a href="#" class="btn btn-sm btn-outline-primary rounded-circle shadow-sm"><i class='bx bxl-facebook'></i></a>
                            <a href="#" class="btn btn-sm btn-outline-info rounded-circle shadow-sm"><i class='bx bxl-twitter'></i></a>
                            <a href="#" class="btn btn-sm btn-outline-success rounded-circle shadow-sm"><i class='bx bxl-whatsapp'></i></a>
                        </div>
                        <a href="/Blog" class="btn btn-outline-secondary rounded-pill px-4 fw-bold btn-sm shadow-sm border">
                            <i class='bx bx-chevron-left'></i> QUAY LẠI DANH SÁCH
                        </a>
                    </div>
                </div>
            </article>

            <!-- RELATED POSTS -->
            @if (relatedPosts != null && relatedPosts.Any())
            {
                <section class="mt-5 pt-5 border-top">
                    <h4 class="fw-bold mb-4 text-uppercase">BÀI VIẾT LIÊN QUAN</h4>
                    <div class="row g-4">
                        @foreach (var post in relatedPosts)
                        {
                            <div class="col-md-4">
                                <div class="related-post-card h-100">
                                    <a asp-action="Detail" asp-route-slug="@post.Slug" class="related-post-thumb rounded-3 overflow-hidden d-block mb-2" style="height: 120px;">
                                        <img src="@(string.IsNullOrEmpty(post.Thumbnail) ? "/assets/img/elements/1.jpg" : post.Thumbnail)" 
                                             class="w-100 h-100 object-fit-cover" alt="@post.Title">
                                    </a>
                                    <div class="related-post-info">
                                        <span class="text-muted" style="font-size: 11px;">@post.CreatedDate.ToString("dd/MM/yyyy")</span>
                                        <a asp-action="Detail" asp-route-slug="@post.Slug" class="title d-block fw-bold text-dark text-decoration-none mt-1 small hover-danger">@post.Title</a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </section>
            }
        </div>

        <!-- SIDEBAR -->
        <aside class="col-lg-4">
            <div class="sidebar-widget bg-white p-4 rounded-4 shadow-sm mb-4 border">
                <h5 class="widget-title fw-bold border-bottom pb-2 mb-3">Tìm kiến thức</h5>
                <form asp-action="Index" method="get">
                    <div class="input-group">
                        <input type="text" name="searchTerm" class="form-control" placeholder="Nhập từ khóa...">
                        <button class="btn btn-danger" type="submit"><i class='bx bx-search'></i></button>
                    </div>
                </form>
            </div>
            <!-- Related Posts (Bên dưới nội dung chính) -->
            @if (ViewBag.RelatedBlogs != null && ((IEnumerable<MotoShop.Data.Models.Blog>)ViewBag.RelatedBlogs).Any())
            {
                <section class="related-blogs py-5 mt-4">
                    <div class="d-flex align-items-center justify-content-between mb-4">
                        <h4 class="fw-bold mb-0 border-start border-danger border-4 ps-3 text-uppercase">Bài viết liên quan</h4>
                        <a href="/Blog" class="text-danger fw-bold text-decoration-none small">XEM TẤT CẢ <i class='bx bx-right-arrow-alt'></i></a>
                    </div>
                    <div class="row g-4">
                        @foreach (var related in ViewBag.RelatedBlogs as IEnumerable<MotoShop.Data.Models.Blog>)
                        {
                            <div class="col-md-4">
                                <div class="card border-0 shadow-sm rounded-4 h-100 transition-hover overflow-hidden border">
                                    <div style="height: 180px; overflow: hidden;">
                                        <img src="@(string.IsNullOrEmpty(related.Thumbnail) ? "/assets/img/elements/placeholder-image.png" : related.Thumbnail)" 
                                             class="w-100 h-100 object-fit-cover transition-img" alt="@related.Title">
                                    </div>
                                    <div class="card-body p-3">
                                        <h6 class="fw-bold mb-2 line-clamp-2" style="height: 44px; font-size: 0.95rem; line-height: 1.4;">
                                            <a asp-action="Detail" asp-route-slug="@related.Slug" class="text-dark text-decoration-none hover-danger">@related.Title</a>
                                        </h6>
                                        <div class="d-flex justify-content-between align-items-center mt-3">
                                            <span class="text-muted extra-small"><i class='bx bx-calendar me-1'></i> @related.CreatedDate.ToString("dd/MM/yyyy")</span>
                                            <span class="text-danger extra-small fw-bold">Chi tiết <i class='bx bx-right-arrow-alt'></i></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </section>
            }
        </div>

        <!-- Sidebar bên phải (Giống trang danh sách) -->
        <aside class="col-lg-3">
            <div class="blog-sidebar shadow-sm rounded-4 p-4 sticky-top border bg-white" style="top: 100px;">
                <h5 class="fw-bold mb-4 border-bottom pb-2 text-uppercase" style="font-size: 0.9rem; letter-spacing: 1px;">Danh mục tin</h5>
                <ul class="list-unstyled mb-0">
                    <li class="mb-2">
                        <a href="/Blog" class="blog-sidebar-link d-flex justify-content-between align-items-center">
                            Tất cả bài viết <i class='bx bx-chevron-right'></i>
                        </a>
                    </li>
                    @foreach (var cat in ViewBag.Categories as IEnumerable<MotoShop.Data.Models.BlogCategory>)
                    {
                        <li class="mb-2">
                            <a href="/Blog?categoryId=@cat.Id" class="blog-sidebar-link d-flex justify-content-between align-items-center @(Model.CategoryId == cat.Id ? "active" : "")">
                                @cat.Name <i class='bx bx-chevron-right'></i>
                            </a>
                        </li>
                    }
                </ul>

                <div class="mt-5 p-4 rounded-4 text-white shadow-sm" style="background: linear-gradient(135deg, #dc3545 0%, #a71d2a 100%);">
                    <h6 class="fw-bold mb-2">Tư vấn nhanh?</h6>
                    <p class="small mb-3" style="opacity: 0.9;">Gặp kỹ thuật viên của MotoShop ngay bây giờ.</p>
                    <a href="tel:0281234567" class="btn btn-light rounded-pill w-100 fw-bold shadow-sm">GỌI HOTLINE</a>
                </div>

            <!-- Widget danh mục có thể thêm ở đây nếu cần -->
                <div class="mt-4 text-center">
                    <p class="text-muted small">Cập nhật tin mới nhất qua Email</p>
                    <div class="input-group input-group-sm">
                        <input type="email" class="form-control" placeholder="Email của bạn">
                        <button class="btn btn-danger" type="button"><i class='bx bx-paper-plane'></i></button>
                    </div>
                </div>
            </div>
        </aside>
    </div>
</main>

<style>
    .article-body { line-height: 1.8; font-size: 1.1rem; color: #333; }
    .article-body img { max-width: 100%; height: auto; border-radius: 12px; margin: 20px 0; }
    .hover-danger:hover { color: #dc3545 !important; }
    .object-fit-cover { object-fit: cover; }
</style>

<style>
    .blog-detail-wrapper { line-height: 1.8; color: #333; }
    .ck-content { font-size: 1.15rem; color: #444; }
    .ck-content img { max-width: 100%; height: auto !important; border-radius: 12px; margin: 25px 0; box-shadow: 0 10px 30px rgba(0,0,0,0.08); border: 1px solid #eee; }
    .ck-content h2, .ck-content h3 { font-weight: 800; margin-top: 40px; margin-bottom: 20px; color: #222; position: relative; padding-bottom: 10px; }
    .ck-content h2:after { content: ''; position: absolute; bottom: 0; left: 0; width: 50px; height: 3px; background: #dc3545; }
    .ck-content blockquote { border-left: 5px solid #dc3545; padding: 25px; background: #fcfcfc; font-style: italic; border-radius: 0 15px 15px 0; margin: 30px 0; font-size: 1.2rem; color: #555; }
    
    .blog-sidebar-link { display: block; padding: 10px 15px; border-radius: 8px; color: #444; text-decoration: none; font-weight: 600; font-size: 0.85rem; transition: all 0.3s; }
    .blog-sidebar-link:hover, .blog-sidebar-link.active { background-color: #fff5f5; color: #dc3545; transform: translateX(5px); }
    
    .line-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .extra-small { font-size: 0.75rem; }
    .transition-hover:hover { transform: translateY(-8px); box-shadow: 0 20px 40px rgba(0,0,0,0.1) !important; }
    .transition-img { transition: transform 0.6s ease; }
    .transition-hover:hover .transition-img { transform: scale(1.08); }
    .hover-danger:hover { color: #dc3545 !important; }
</style>
