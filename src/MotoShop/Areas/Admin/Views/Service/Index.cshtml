@model IEnumerable<MotoShop.Data.Models.Service>
@{
    ViewData["Title"] = "Quản lý Dịch vụ";
    Layout = "_AdminLayout";
}

@section Styles {
    <style>
        .service-img-admin { width: 50px; height: 50px; object-fit: cover; border-radius: 8px; border: 1px solid #eee; transition: 0.3s; }
        .service-img-admin:hover { transform: scale(1.1); box-shadow: 0 4px 8px rgba(0,0,0,0.1); }
        .service-name-admin { font-weight: 600; color: #333; max-width: 350px; white-space: normal; line-height: 1.4; display: block; }
        .table > :not(caption) > * > * { padding: 1rem 0.5rem; vertical-align: middle; }
        .custom-input { border-radius: 10px !important; border: 1px solid #ddd; padding: 10px 15px; transition: 0.3s; }
        .btn-filter-red { background-color: #ff3e1d !important; border-color: #ff3e1d !important; color: #fff !important; box-shadow: 0 0.125rem 0.25rem 0 rgba(255, 62, 29, 0.4) !important; border-radius: 10px !important; }
        .btn-filter-red:hover { background-color: #e6381a !important; transform: translateY(-1px); }
        .service-editor { border: 1px solid #ddd; border-radius: 10px; overflow: hidden; background: #fff; }
        .service-editor-toolbar { display: flex; flex-wrap: wrap; gap: 4px; padding: 8px 10px; border-bottom: 1px solid #eee; background: #fafafa; }
        .service-editor-toolbar button { width: 34px; height: 32px; border: 1px solid transparent; border-radius: 8px; background: transparent; color: #6c757d; display: inline-flex; align-items: center; justify-content: center; }
        .service-editor-toolbar button:hover { border-color: #ff3e1d; color: #ff3e1d; background: #fff5f3; }
        .service-editor-body { min-height: 210px; max-height: 360px; overflow-y: auto; padding: 14px 16px; outline: none; line-height: 1.6; }
        .service-editor-body:empty:before { content: attr(data-placeholder); color: #a8b1bb; }
    </style>
}

<!-- Actions Bar (Y hệt Product) -->
<div class="d-flex justify-content-between align-items-center mb-4 bg-white p-3 rounded-4 shadow-sm">
    <div>
        <h4 class="fw-bold mb-0 text-uppercase">Quản lý Dịch vụ</h4>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a href="/Admin">Dashboard</a></li>
                <li class="breadcrumb-item active text-danger">Dịch vụ kỹ thuật</li>
            </ol>
        </nav>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-danger rounded-pill px-4 shadow-sm fw-bold" onclick="openServiceModal()">
            <i class="bx bx-plus-circle me-1"></i> THÊM DỊCH VỤ MỚI
        </button>
    </div>
</div>

<!-- Filter Bar (Y hệt Product 4-2-2-2 Style) -->
<div class="bg-white p-3 rounded-4 shadow-sm mb-4">
    <form method="get" class="row g-3 align-items-center">
        <div class="col-lg-4 col-md-6">
            <div class="input-group input-group-merge">
                <span class="input-group-text bg-light border-0"><i class="bx bx-search"></i></span>
                <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" class="form-control bg-light border-0" placeholder="Tìm tên dịch vụ hoặc từ khóa...">
            </div>
        </div>
        <div class="col-lg-2 col-md-3">
            <select name="categoryId" class="form-select bg-light border-0" asp-items="@(new SelectList(ViewBag.Categories, "CategoryId", "CategoryName"))">
                <option value="">Tất cả danh mục</option>
            </select>
        </div>
        <div class="col-lg-2 col-md-3">
            <select name="status" class="form-select bg-light border-0">
                <option value="">Trạng thái</option>
                <option value="Active" selected="@(ViewBag.Status == "Active")">Đang cung cấp</option>
                <option value="Inactive" selected="@(ViewBag.Status == "Inactive")">Tạm ngừng</option>
            </select>
        </div>
        <div class="col-lg-2 col-md-6">
            <button type="submit" class="btn btn-filter-red w-100 fw-bold py-2">
                <i class='bx bx-filter-alt me-1'></i> LỌC DỮ LIỆU
            </button>
        </div>
    </form>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="table-responsive text-nowrap">
        <table class="table table-hover align-middle m-0">
            <thead class="bg-light text-uppercase small fw-bold">
                <tr>
                    <th class="ps-4" style="width: 80px">Ảnh</th>
                    <th>Tên dịch vụ</th>
                    <th>Danh mục</th>
                    <th>Giá tiền</th>
                    <th>Thời gian / BH</th>
                    <th>Trạng thái</th>
                    <th class="text-end pe-4">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model) {
                    <tr>
                        <td class="ps-4">
                            <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/assets/img/elements/18.jpg" : item.ImageUrl)" class="service-img-admin">
                        </td>
                        <td>
                            <span class="service-name-admin">@item.ServiceName</span>
                        </td>
                        <td><span class="badge bg-label-info">@(item.ServiceCategory?.CategoryName ?? "Chưa phân loại")</span></td>
                        <td><span class="fw-bold text-danger">@item.Price.ToString("N0")đ</span></td>
                        <td>
                            <div class="small fw-bold text-dark">@item.Duration phút</div>
                            <div class="small text-muted">BH: @item.WarrantyDays ngày</div>
                        </td>
                        <td>
                            @if (item.IsActive == true) {
                                <span class="badge bg-label-success rounded-pill px-3">Hoạt động</span>
                            } else {
                                <span class="badge bg-label-secondary rounded-pill px-3">Tạm ngừng</span>
                            }
                        </td>
                        <td class="text-end pe-4">
                            <div class="d-flex justify-content-end gap-1">
                                <button class="btn btn-sm btn-icon btn-outline-primary rounded-circle btn-edit-service" 
                                        data-service='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new { 
                                            item.ServiceId, 
                                            item.ServiceName, 
                                            item.Price, 
                                            item.Duration, 
                                            item.WarrantyDays, 
                                            item.CategoryId, 
                                            item.IsActive, 
                                            item.ShortDescription, 
                                            item.Description, 
                                            item.ImageUrl 
                                        }))'><i class="bx bx-edit-alt"></i></button>
                                <button class="btn btn-sm btn-icon btn-outline-danger rounded-circle btn-delete-service" 
                                        data-id="@item.ServiceId"><i class="bx bx-trash"></i></button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Thêm/Sửa (Y hệt Product Modal Style) -->
<div class="modal fade" id="serviceModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <form id="serviceForm" enctype="multipart/form-data">
                <input type="hidden" name="ServiceId" id="sId">
                <div class="modal-header border-0 p-4 pb-0">
                    <h5 class="modal-title fw-bold text-uppercase fs-5" id="modalTitle">Thông tin dịch vụ</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row">
                        <div class="col-md-4">
                            <div class="text-center mb-4">
                                <img id="imgPreview" src="/assets/img/elements/18.jpg" class="rounded-4 shadow-sm mb-3 w-100" style="aspect-ratio: 1/1; object-fit: cover; border: 1px solid #eee;">
                                <div>
                                    <label for="imageFile" class="btn btn-sm btn-outline-primary rounded-pill px-3">Chọn ảnh đại diện</label>
                                    <input type="file" id="imageFile" name="imageFile" class="d-none" onchange="previewImage(this)">
                                </div>
                            </div>
                        </div>
                        <div class="col-md-8">
                            <div class="row g-3">
                                <div class="col-12">
                                    <label class="form-label fw-bold small text-muted text-uppercase">Tên dịch vụ *</label>
                                    <input type="text" name="ServiceName" id="sName" class="form-control custom-input" placeholder="Nhập tên dịch vụ" required>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-muted text-uppercase">Danh mục dịch vụ *</label>
                                    <select name="CategoryId" id="sCategory" class="form-select custom-input" required asp-items="@(new SelectList(ViewBag.Categories, "CategoryId", "CategoryName"))">
                                        <option value="">-- Chọn danh mục --</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-muted text-uppercase">Giá dự kiến (VNĐ) *</label>
                                    <input type="number" name="Price" id="sPrice" class="form-control custom-input" placeholder="0" required>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-muted text-uppercase">Thời gian thực hiện (Phút)</label>
                                    <input type="number" name="Duration" id="sDuration" class="form-control custom-input" value="30">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-muted text-uppercase">Bảo hành (Ngày)</label>
                                    <input type="number" name="WarrantyDays" id="sWarranty" class="form-control custom-input" value="30">
                                </div>
                            </div>
                        </div>
                        <div class="col-12 mt-3">
                            <label class="form-label fw-bold small text-muted text-uppercase">Mô tả chi tiết</label>
                            <textarea name="Description" id="sDesc" class="d-none"></textarea>
                            <div class="service-editor">
                                <div class="service-editor-toolbar" role="toolbar" aria-label="Thanh cong cu mo ta dich vu">
                                    <button type="button" data-cmd="undo" title="Hoàn tác"><i class="bx bx-undo"></i></button>
                                    <button type="button" data-cmd="redo" title="Làm lại"><i class="bx bx-redo"></i></button>
                                    <button type="button" data-cmd="bold" title="In đậm"><i class="bx bx-bold"></i></button>
                                    <button type="button" data-cmd="italic" title="In nghiêng"><i class="bx bx-italic"></i></button>
                                    <button type="button" data-cmd="underline" title="Gạch chân"><i class="bx bx-underline"></i></button>
                                    <button type="button" data-cmd="justifyLeft" title="Căn trái"><i class="bx bx-align-left"></i></button>
                                    <button type="button" data-cmd="justifyCenter" title="Căn giữa"><i class="bx bx-align-middle"></i></button>
                                    <button type="button" data-cmd="justifyRight" title="Căn phải"><i class="bx bx-align-right"></i></button>
                                    <button type="button" data-cmd="insertUnorderedList" title="Danh sách chấm"><i class="bx bx-list-ul"></i></button>
                                    <button type="button" data-cmd="insertOrderedList" title="Danh sách số"><i class="bx bx-list-ol"></i></button>
                                    <button type="button" data-cmd="createLink" title="Chèn liên kết"><i class="bx bx-link"></i></button>
                                    <button type="button" data-cmd="removeFormat" title="Xóa định dạng"><i class="bx bx-eraser"></i></button>
                                </div>
                                <div id="sDescEditor" class="service-editor-body" contenteditable="true" data-placeholder="Nhập mô tả chi tiết dịch vụ..."></div>
                            </div>
                        </div>
                        <div class="col-12 mt-3">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" name="IsActive" id="sActive" value="true" checked>
                                <label class="form-check-label fw-bold">Trạng thái: Đang kinh doanh</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 p-4 pt-0">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold shadow-sm">LƯU DỮ LIỆU</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const sModal = new bootstrap.Modal(document.getElementById('serviceModal'));
        let pendingEditorContent = '';

        function getEditor() {
            return document.getElementById('sDescEditor');
        }

        function setEditorContent(html) {
            const editor = getEditor();
            if (editor) editor.innerHTML = html || '';
            $('#sDesc').val(html || '');
        }

        function syncEditorToTextarea() {
            const editor = getEditor();
            const html = editor ? editor.innerHTML.trim() : '';
            $('#sDesc').val(html);
            return html;
        }

        document.getElementById('serviceModal').addEventListener('shown.bs.modal', function () {
            setEditorContent(pendingEditorContent);
            getEditor()?.focus();
        });

        document.querySelectorAll('.service-editor-toolbar button').forEach(button => {
            button.addEventListener('click', function () {
                const cmd = this.dataset.cmd;
                const editor = getEditor();
                editor?.focus();

                if (cmd === 'createLink') {
                    const url = prompt('Nhập đường dẫn liên kết:');
                    if (url) document.execCommand(cmd, false, url);
                } else {
                    document.execCommand(cmd, false, null);
                }

                syncEditorToTextarea();
            });
        });

        getEditor()?.addEventListener('input', syncEditorToTextarea);
        getEditor()?.addEventListener('blur', syncEditorToTextarea);

        function openServiceModal() {
            pendingEditorContent = '';
            $('#serviceForm')[0].reset();
            $('#sId').val(0);
            $('#imageFile').val('');
            $('#imgPreview').attr('src', '/assets/img/elements/18.jpg');
            $('#modalTitle').text('Thêm dịch vụ mới');
            $('#sActive').prop('checked', true);
            setEditorContent('');
            sModal.show();
        }

        $(document).on('click', '.btn-edit-service', function() {
            const data = $(this).data('service');
            if (!data) return;
            pendingEditorContent = data.Description || data.description || '';
            $('#serviceForm')[0].reset();
            $('#sId').val(data.ServiceId || data.serviceId || 0);
            $('#sName').val(data.ServiceName || data.serviceName || '');
            $('#sCategory').val(data.CategoryId || data.categoryId || '');
            $('#sPrice').val(data.Price || data.price || 0);
            $('#sDuration').val(data.Duration || data.duration || 30);
            $('#sWarranty').val(data.WarrantyDays || data.warrantyDays || 30);
            $('#sActive').prop('checked', data.IsActive ?? data.isActive ?? true);
            $('#imageFile').val('');
            $('#imgPreview').attr('src', data.ImageUrl || data.imageUrl || '/assets/img/elements/18.jpg');
            $('#modalTitle').text('Chỉnh sửa dịch vụ');
            setEditorContent(pendingEditorContent);
            sModal.show();
        });

        $('#serviceForm').on('submit', function(e) {
            e.preventDefault();
            syncEditorToTextarea();

            const form = this;
            const btn = $(form).find('button[type=submit]');
            const originalText = btn.html();
            btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span> ĐANG LƯU...');

            $.ajax({
                url: '/Admin/Service/Save',
                type: 'POST',
                data: new FormData(form),
                processData: false,
                contentType: false,
                success: function(res) {
                    if (res && res.success) {
                        window.location.href = '/Admin/Service?saved=1&_=' + Date.now();
                    } else {
                        Swal.fire('Lỗi', (res && res.message) || 'Không thể lưu dịch vụ', 'error');
                        btn.prop('disabled', false).html(originalText);
                    }
                },
                error: function(xhr) {
                    const message = xhr.responseJSON?.message || 'Không thể kết nối máy chủ';
                    Swal.fire('Lỗi', message, 'error');
                    btn.prop('disabled', false).html(originalText);
                }
            });
        });

        $(document).on('click', '.btn-delete-service', function() {
            const id = $(this).data('id');
            if(confirm('Bạn có chắc muốn xóa dịch vụ này?')) {
                $.post('/Admin/Service/Delete', { id: id }, function(res) {
                    if (res.success) {
                        Swal.fire('Thành công', res.message || 'Xóa thành công', 'success');
                        setTimeout(() => location.reload(), 1000);
                    } else {
                        Swal.fire('Lỗi', res.message || 'Không thể xóa dịch vụ', 'error');
                    }
                });
            }
        });

        function previewImage(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = (e) => $('#imgPreview').attr('src', e.target.result);
                reader.readAsDataURL(input.files[0]);
            }
        }

        if (new URLSearchParams(window.location.search).get('saved') === '1') {
            if (window.Swal) {
                Swal.fire({ icon: 'success', title: 'Thành công', text: 'Dịch vụ đã được lưu', timer: 1200, showConfirmButton: false });
            }
            window.history.replaceState({}, document.title, '/Admin/Service');
        }
    </script>
}
