@{
    ViewData["Title"] = "Bản đồ vùng vận chuyển";
    Layout = "_AdminLayout";
    var provinces = ViewBag.Provinces as List<MotoShop.Business.Services.GhnProvinceDto> ?? new List<MotoShop.Business.Services.GhnProvinceDto>();
}

<div class="p-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h4 class="fw-bold m-0"><i class='bx bx-map-pin me-2 text-danger'></i>Bản đồ vùng vận chuyển</h4>
            <p class="text-muted small mb-0 mt-1">Danh sách tỉnh/thành phố từ GHN API</p>
        </div>
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm">
            <i class='bx bx-arrow-back me-1'></i>Quay lại
        </a>
    </div>

    @if (!provinces.Any())
    {
        <div class="alert alert-warning d-flex align-items-center gap-2">
            <i class='bx bx-info-circle fs-5'></i>
            <span>Chưa tải được danh sách tỉnh/thành. Vui lòng kiểm tra GHN ApiKey trong <code>appsettings.json</code>.</span>
        </div>
    }
    else
    {
        <div class="mb-3">
            <span class="badge" style="background:#E60023;font-size:13px">
                <i class='bx bx-buildings me-1'></i>@provinces.Count tỉnh/thành
            </span>
        </div>
        <div class="row g-2">
            @foreach (var p in provinces)
            {
                <div class="col-md-3 col-sm-4 col-6">
                    <div class="d-flex align-items-center gap-2 p-2 rounded border bg-white" style="font-size:13px">
                        <i class='bx bx-map text-danger'></i>
                        <span>@p.ProvinceName</span>
                        <span class="text-muted ms-auto x-small">#@p.ProvinceId</span>
                    </div>
                </div>
            }
        </div>
    }
</div>
