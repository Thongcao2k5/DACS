@model IEnumerable<MotoShop.Data.Models.Customer>
@{
    ViewData["Title"] = "Quản lý Khách hàng";
    Layout = "_AdminLayout";
}

@section Styles {
    <style>
        :root { --ms-red: #E24B4A; --ms-red-dark: #c63d3c; }
        .btn-ms-red { background: var(--ms-red); color: white; border: none; }
        .btn-ms-red:hover { background: var(--ms-red-dark); color: white; }
        .avatar-circle { width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; color: white; text-transform: uppercase; }
        .filter-section { background: #fff; border-radius: 12px; padding: 20px; border: 1px solid #eee; margin-bottom: 25px; }
        .table-container { background: #fff; border-radius: 12px; border: 1px solid #eee; overflow: hidden; }
        .pagination-container { display: flex; justify-content: space-between; align-items: center; padding: 20px; border-top: 1px solid #eee; background: #fdfdfd; }
    </style>
}

<div class="p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold m-0 text-uppercase"><i class='bx bxs-user-detail me-2 text-danger'></i>Quản lý Khách hàng</h4>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-danger d-none" id="btnBulkDelete"><i class="bx bx-trash me-1"></i>Xóa đã chọn</button>
            <button class="btn btn-outline-success" onclick="exportToExcel()"><i class='bx bx-export me-1'></i>Xuất Excel</button>
            <div class="dropdown">
                <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown"><i class='bx bx-columns me-1'></i>Chọn cột</button>
                <ul class="dropdown-menu dropdown-menu-end p-3" style="min-width: 200px;">
                    <li><div class="form-check"><input class="form-check-input col-toggle" type="checkbox" value="1" id="col1" checked><label class="form-check-label" for="col1">Họ tên</label></div></li>
                    <li><div class="form-check"><input class="form-check-input col-toggle" type="checkbox" value="2" id="col2" checked><label class="form-check-label" for="col2">Email</label></div></li>
                    <li><div class="form-check"><input class="form-check-input col-toggle" type="checkbox" value="3" id="col3" checked><label class="form-check-label" for="col3">SĐT</label></div></li>
                    <li><div class="form-check"><input class="form-check-input col-toggle" type="checkbox" value="4" id="col4" checked><label class="form-check-label" for="col4">Ngày đăng ký</label></div></li>
                    <li><div class="form-check"><input class="form-check-input col-toggle" type="checkbox" value="5" id="col5" checked><label class="form-check-label" for="col5">Tổng đơn</label></div></li>
                    <li><div class="form-check"><input class="form-check-input col-toggle" type="checkbox" value="6" id="col6" checked><label class="form-check-label" for="col6">Trạng thái</label></div></li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Professional Filter Bar -->
    <div class="filter-section shadow-sm border-0 mb-4 bg-white p-3 rounded-3">
        <form id="filterForm" method="get">
            <div class="row g-3 align-items-end">
                <div class="col-lg-5 col-md-6">
                    <label class="form-label small text-uppercase fw-bold text-muted mb-1"><i class='bx bx-search-alt-2 me-1'></i>Tìm kiếm khách hàng</label>
                    <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" class="form-control bg-light border-0" placeholder="Tìm theo tên, email hoặc số điện thoại...">
                </div>
                <div class="col-lg-3 col-md-6">
                    <label class="form-label small text-uppercase fw-bold text-muted mb-1"><i class='bx bx-lock-alt me-1'></i>Trạng thái tài khoản</label>
                    <select name="status" class="form-select bg-light border-0">
                        <option value="">Tất cả trạng thái</option>
                        <option value="Active" selected="@(ViewBag.Status == "Active")">Đang hoạt động</option>
                        <option value="Locked" selected="@(ViewBag.Status == "Locked")">Bị khóa</option>
                    </select>
                </div>
                <div class="col-lg-4 col-md-12 text-end">
                    <div class="d-flex gap-2 justify-content-lg-end">
                        <button type="submit" class="btn btn-ms-red px-4 fw-bold"><i class='bx bx-filter-alt me-1'></i>Lọc dữ liệu</button>
                        <a href="/Admin/Customer" class="btn btn-light px-3 border"><i class='bx bx-refresh fs-4'></i></a>
                    </div>
                </div>
            </div>
        </form>
    </div>

    <div class="table-container shadow-sm">
        <div class="table-responsive text-nowrap">
            <table class="table table-hover align-middle m-0" id="customerTable">
                <thead class="bg-light">
                    <tr>
                        <th style="width: 40px"><input class="form-check-input" type="checkbox" id="checkAll"></th>
                        <th>Họ tên</th>
                        <th>Email</th>
                        <th>SĐT</th>
                        <th>Ngày đăng ký</th>
                        <th>Tổng đơn</th>
                        <th>Trạng thái</th>
                        <th class="text-end px-4">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model) {
                        <tr>
                            <td><input class="form-check-input row-checkbox" type="checkbox" value="@item.CustomerId"></td>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    @{
                                        var initials = item.FullName.Substring(0, 1).ToUpper();
                                        var colors = new[] { "#696cff", "#71dd37", "#03c3ec", "#ffab00", "#ff3e1d", "#8592a3" };
                                        var randomColor = colors[Math.Abs(item.FullName.GetHashCode()) % colors.Length];
                                    }
                                    <div class="avatar-circle" style="background-color: @randomColor">@initials</div>
                                    <div>
                                        <div class="fw-bold">@item.FullName</div>
                                        <small class="text-muted">ID: #@item.CustomerId</small>
                                    </div>
                                </div>
                            </td>
                            <td>@item.Email</td>
                            <td>@item.Phone</td>
                            <td>@item.CreatedDate.ToString("dd/MM/yyyy")</td>
                            <td class="fw-bold text-primary">@item.Orders.Count</td>
                            <td>
                                @if (item.IsLocked) {
                                    <span class="badge bg-label-danger">Bị khóa</span>
                                } else {
                                    <span class="badge bg-label-success">Hoạt động</span>
                                }
                            </td>
                            <td class="text-end px-4">
                                <a asp-action="Details" asp-route-id="@item.CustomerId" class="btn btn-sm btn-icon btn-outline-info" title="Xem chi tiết"><i class="bx bx-show"></i></a>
                                <button class="btn btn-sm btn-icon @(item.IsLocked ? "btn-outline-success" : "btn-outline-danger")" 
                                        onclick="confirmToggleStatus(@item.CustomerId, '@item.FullName', @(item.IsLocked ? "false" : "true"))"
                                        title="@(item.IsLocked ? "Mở khóa" : "Khóa tài khoản")">
                                    <i class="bx @(item.IsLocked ? "bx-lock-open-alt" : "bx-lock-alt")"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (ViewBag.TotalItems > 0) {
            <div class="pagination-container">
                <div><span class="text-muted small">Hiển thị <b>@Model.Count()</b> / <b>@ViewBag.TotalItems</b> khách hàng</span></div>
                <nav>
                    <ul class="pagination pagination-sm m-0 gap-1">
                        @for (int i = 1; i <= ViewBag.TotalPages; i++) {
                            <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">
                                <a class="page-link border-0 @(ViewBag.CurrentPage == i ? "btn-ms-red" : "bg-light")" href="?page=@i&searchTerm=@ViewBag.SearchTerm&status=@ViewBag.Status">@i</a>
                            </li>
                        }
                    </ul>
                </nav>
                <div><span class="text-muted small">Trang <b>@ViewBag.CurrentPage</b> / <b>@ViewBag.TotalPages</b></span></div>
            </div>
        }
    </div>
</div>

<!-- Modal Xác nhận Khóa/Mở khóa -->
<div class="modal fade" id="statusModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-body p-4 text-center">
                <i id="statusIcon" class='bx bx-error-circle text-danger' style="font-size: 4rem"></i>
                <h5 class="fw-bold mt-3" id="statusTitle">Xác nhận hành động?</h5>
                <p class="text-muted small" id="statusMsg"></p>
                <div class="d-flex gap-2 justify-content-center mt-4">
                    <button class="btn btn-outline-secondary border-0 px-4" data-bs-dismiss="modal">Hủy</button>
                    <button class="btn btn-danger px-4" id="btnConfirmToggle">Xác nhận</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const sModal = new bootstrap.Modal(document.getElementById('statusModal'));
        let targetId = 0;

        function confirmToggleStatus(id, name, willLock) {
            targetId = id;
            if (willLock) {
                $('#statusIcon').attr('class', 'bx bx-lock-alt text-danger');
                $('#statusTitle').text('Khóa tài khoản?');
                $('#statusMsg').html(`Khách hàng <b>${name}</b> sẽ không thể đăng nhập vào hệ thống.`);
                $('#btnConfirmToggle').attr('class', 'btn btn-danger px-4');
            } else {
                $('#statusIcon').attr('class', 'bx bx-lock-open-alt text-success');
                $('#statusTitle').text('Mở khóa tài khoản?');
                $('#statusMsg').html(`Khôi phục quyền truy cập cho khách hàng <b>${name}</b>.`);
                $('#btnConfirmToggle').attr('class', 'btn btn-success px-4');
            }
            sModal.show();
        }

        $('#btnConfirmToggle').on('click', function() {
            $.post('/Admin/Customer/ToggleStatus', { id: targetId }, function(res) {
                if (res.success) {
                    UI.toast(res.message, 'success');
                    setTimeout(() => location.reload(), 1000);
                }
            });
        });

        function exportToExcel() {
            const formData = $('#filterForm').serialize();
            window.location.href = '/Admin/Customer/ExportExcel?' + formData;
        }

        // Column Toggle
        $('.col-toggle').on('change', function() {
            const idx = parseInt($(this).val()) + 1;
            const check = $(this).is(':checked');
            $(`#customerTable thead th:nth-child(${idx}), #customerTable tbody td:nth-child(${idx})`).toggle(check);
        });
    </script>
}
