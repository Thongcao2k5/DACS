@model IEnumerable<MotoShop.Data.Models.Order>
@{
    ViewData["Title"] = "Bảng điều khiển Admin";
    Layout = "_AdminLayout";
    var revVsYes = (double)ViewBag.RevenueVsYesterday;
}

<div class="container-xxl flex-grow-1 container-p-y">
    <div class="row">
        <!-- 1. CHÀO MỪNG & THỐNG KÊ NHANH -->
        <div class="col-lg-8 mb-4 order-0">
            <div class="card shadow-none border-0 bg-primary text-white overflow-hidden rounded-4">
                <div class="d-flex align-items-end row">
                    <div class="col-sm-7">
                        <div class="card-body py-5 ps-4">
                            <h5 class="card-title text-white fw-bold mb-3">Xin chào Admin! 🎉</h5>
                            <p class="mb-4">Doanh thu hôm nay đã tăng <span class="fw-bold">@revVsYes.ToString("0.0")%</span> so với hôm qua. Hãy kiểm tra các đơn hàng mới nhất bên dưới.</p>
                            <a href="/Admin/Order" class="btn btn-white btn-sm fw-bold rounded-pill px-4 text-primary shadow-sm">XEM ĐƠN HÀNG</a>
                        </div>
                    </div>
                    <div class="col-sm-5 text-center text-sm-left">
                        <div class="card-body pb-0 px-0 px-md-4">
                            <img src="/assets/img/illustrations/man-with-laptop-light.png" height="180" alt="View Badge User">
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4 col-md-4 order-1">
            <div class="row">
                <div class="col-lg-6 col-md-12 col-6 mb-4">
                    <div class="card shadow-sm border-0 rounded-4">
                        <div class="card-body">
                            <div class="card-title d-flex align-items-start justify-content-between">
                                <div class="avatar flex-shrink-0">
                                    <span class="avatar-initial rounded bg-label-success"><i class="bx bx-dollar"></i></span>
                                </div>
                            </div>
                            <span class="fw-semibold d-block mb-1">Doanh thu</span>
                            <h4 class="card-title mb-2 fw-bold">@(((decimal)ViewBag.RevenueToday).ToString("N0"))</h4>
                            <small class="@(revVsYes >= 0 ? "text-success" : "text-danger") fw-semibold">
                                <i class="bx bx-up-arrow-alt"></i> @revVsYes.ToString("0.0")%
                            </small>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6 col-md-12 col-6 mb-4">
                    <div class="card shadow-sm border-0 rounded-4">
                        <div class="card-body">
                            <div class="card-title d-flex align-items-start justify-content-between">
                                <div class="avatar flex-shrink-0">
                                    <span class="avatar-initial rounded bg-label-info"><i class="bx bx-cart"></i></span>
                                </div>
                            </div>
                            <span class="fw-semibold d-block mb-1">Đơn hôm nay</span>
                            <h4 class="card-title mb-2 fw-bold">@ViewBag.TotalOrdersToday</h4>
                            <small class="text-info fw-semibold"><i class='bx bx-time-five'></i> @ViewBag.PendingOrdersToday chờ</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- 2. ĐƠN HÀNG GẦN ĐÂY -->
        <div class="col-md-12 col-lg-8 order-2 mb-4">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-white py-4 border-0">
                    <h5 class="mb-0 fw-bold"><i class='bx bx-history me-2'></i>ĐƠN HÀNG GẦN ĐÂY</h5>
                </div>
                <div class="table-responsive text-nowrap">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Mã đơn</th>
                                <th>Khách hàng</th>
                                <th>Tổng tiền</th>
                                <th>Trạng thái</th>
                                <th>Ngày đặt</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var o in Model)
                            {
                                <tr>
                                    <td class="fw-bold"><a href="/Admin/Order/Details/@o.OrderId">#@o.OrderCode</a></td>
                                    <td>@(o.Customer?.FullName ?? "N/A")</td>
                                    <td class="text-danger fw-bold">@o.TotalAmount.ToString("N0")đ</td>
                                    <td>
                                        @{
                                            var statusClass = o.Status switch {
                                                "Completed" => "bg-label-success",
                                                "Pending" => "bg-label-warning",
                                                "Cancelled" => "bg-label-danger",
                                                _ => "bg-label-primary"
                                            };
                                        }
                                        <span class="badge @statusClass">@o.Status</span>
                                    </td>
                                    <td class="small">@o.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="card-footer bg-white text-center py-3 border-0">
                    <a href="/Admin/Order" class="btn btn-link text-primary fw-bold text-decoration-none">Xem tất cả đơn hàng <i class='bx bx-right-arrow-alt'></i></a>
                </div>
            </div>
        </div>

        <!-- 3. THỐNG KÊ TỔNG QUAN -->
        <div class="col-md-12 col-lg-4 order-3 mb-4">
            <div class="card h-100 shadow-sm border-0 rounded-4">
                <div class="card-header bg-white py-4 border-0">
                    <h5 class="mb-0 fw-bold"><i class='bx bx-stats me-2'></i>CHỈ SỐ THÁNG NÀY</h5>
                </div>
                <div class="card-body">
                    <div class="d-flex align-items-center mb-4">
                        <div class="avatar bg-label-primary rounded p-2 me-3"><i class="bx bx-user fs-3"></i></div>
                        <div class="flex-grow-1">
                            <h6 class="mb-0 fw-bold">Tổng khách hàng</h6>
                            <small class="text-muted">Dữ liệu từ lúc bắt đầu</small>
                        </div>
                        <div class="fw-bold fs-5">@ViewBag.TotalCustomers</div>
                    </div>
                    <div class="d-flex align-items-center mb-4">
                        <div class="avatar bg-label-warning rounded p-2 me-3"><i class="bx bx-package fs-3"></i></div>
                        <div class="flex-grow-1">
                            <h6 class="mb-0 fw-bold">Sản phẩm đang bán</h6>
                            <small class="text-muted">IsActive = true</small>
                        </div>
                        <div class="fw-bold fs-5">@ViewBag.ActiveProducts</div>
                    </div>
                    <hr>
                    <div class="mt-4">
                        <h6 class="fw-bold mb-3">Hiệu suất đơn hàng tháng @DateTime.Now.Month</h6>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="small">Đã hoàn thành</span>
                            <span class="fw-bold">@ViewBag.CompletedOrdersMonth / @ViewBag.TotalOrdersMonth</span>
                        </div>
                        <div class="progress" style="height: 10px;">
                            @{
                                var completionRate = ViewBag.TotalOrdersMonth > 0 ? (int)(ViewBag.CompletedOrdersMonth * 100 / ViewBag.TotalOrdersMonth) : 0;
                            }
                            <div class="progress-bar bg-success" style="width: @completionRate%"></div>
                        </div>
                        <p class="x-small text-muted mt-2">Tỷ lệ hoàn thành: @completionRate%</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .rounded-4 { border-radius: 1rem !important; }
    .btn-white { background: white; color: var(--bs-primary); border: none; }
    .btn-white:hover { background: #f8f9fa; color: var(--bs-primary); }
    .avatar-initial { width: 45px; height: 45px; display: flex; align-items: center; justify-content: center; }
    .bg-label-success { background-color: #e8fadf !important; color: #71dd37 !important; }
    .bg-label-info { background-color: #d7f5fc !important; color: #03c3ec !important; }
    .bg-label-primary { background-color: #e7e7ff !important; color: #696cff !important; }
    .bg-label-warning { background-color: #fff2e2 !important; color: #ffab00 !important; }
    .bg-label-danger { background-color: #ffe5e5 !important; color: #ff3e1d !important; }
    .x-small { font-size: 11px; }
</style>
