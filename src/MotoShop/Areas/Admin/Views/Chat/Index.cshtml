@{
    ViewData["Title"] = "Quản lý Chat - MotoShop";
    Layout = "_AdminLayout";
}

<div class="container-xxl flex-grow-1 container-p-y">
    <div class="card overflow-hidden" style="height: calc(100vh - 200px);">
        <div class="row g-0 h-100">
            <!-- Sidebar: Danh sách phiên chat -->
            <div class="col-4 border-end h-100 d-flex flex-column">
                <div class="p-3 border-bottom bg-light">
                    <h5 class="mb-0 fw-bold"><i class='bx bx-message-square-dots me-2'></i>Hội thoại</h5>
                </div>
                <div class="flex-grow-1 overflow-auto" id="sessionList">
                    <div class="text-center p-5 text-muted">Đang tải danh sách...</div>
                </div>
            </div>

            <!-- Main: Khung Chat chi tiết -->
            <div class="col-8 h-100 d-flex flex-column bg-white">
                <div id="chatHeader" class="p-3 border-bottom d-none">
                    <div class="d-flex align-items-center">
                        <div class="avatar avatar-online me-2">
                            <img src="~/assets/img/avatars/1.png" class="rounded-circle">
                        </div>
                        <div>
                            <h6 class="mb-0" id="currentClientName">Khách hàng</h6>
                            <small class="text-muted" id="currentSessionId"></small>
                        </div>
                    </div>
                </div>

                <div class="flex-grow-1 overflow-auto p-4 d-flex flex-column gap-3" id="adminChatMsgs" style="background: #f4f7f6;">
                    <div class="h-100 d-flex align-items-center justify-content-center text-muted">
                        Chọn một cuộc hội thoại để bắt đầu trả lời
                    </div>
                </div>

                <div id="chatFooter" class="p-3 border-top d-none">
                    <div class="input-group">
                        <input type="text" id="replyInput" class="form-control" placeholder="Nhập tin nhắn phản hồi...">
                        <button class="btn btn-primary" id="btnReply"><i class='bx bxs-send'></i></button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let selectedSessionId = null;

        async function loadSessions() {
            const res = await fetch('/Admin/Chat/GetSessions');
            const sessions = await res.json();
            const list = document.getElementById('sessionList');
            list.innerHTML = '';

            sessions.forEach(s => {
                const div = document.createElement('div');
                div.className = `p-3 border-bottom cursor-pointer session-item ${selectedSessionId === s.sessionId ? 'bg-label-primary' : ''}`;
                div.style.cursor = 'pointer';
                div.innerHTML = `
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <strong class="text-truncate" style="max-width: 150px;">Khách ${s.sessionId.substring(0, 8)}</strong>
                        <small class="text-muted">${new Date(s.lastMsgTime).toLocaleTimeString()}</small>
                    </div>
                    <div class="d-flex justify-content-between">
                        <small class="text-muted text-truncate w-75">${s.lastMessage}</small>
                        ${s.unreadCount > 0 ? `<span class="badge bg-danger rounded-pill">${s.unreadCount}</span>` : ''}
                    </div>
                `;
                div.onclick = () => selectSession(s.sessionId);
                list.appendChild(div);
            });
        }

        async function selectSession(sessionId) {
            selectedSessionId = sessionId;
            document.getElementById('chatHeader').classList.remove('d-none');
            document.getElementById('chatFooter').classList.remove('d-none');
            document.getElementById('currentSessionId').innerText = sessionId;
            document.getElementById('currentClientName').innerText = "Khách hàng #" + sessionId.substring(0, 8);
            
            await loadMessages();
            loadSessions(); // Reload list to update unread count
        }

        async function loadMessages() {
            if (!selectedSessionId) return;
            const res = await fetch(`/Admin/Chat/GetMessages?sessionId=${selectedSessionId}`);
            const msgs = await res.json();
            const container = document.getElementById('adminChatMsgs');
            container.innerHTML = '';
            
            msgs.forEach(m => {
                const div = document.createElement('div');
                div.className = m.isFromAdmin ? 'msg-admin-reply' : 'msg-client-reply';
                div.innerHTML = `
                    <div class="msg-bubble ${m.isFromAdmin ? 'bg-primary text-white ms-auto' : 'bg-white border'}" 
                         style="max-width: 70%; padding: 10px 15px; border-radius: 15px; font-size: 14px;">
                        ${m.message}
                        <div class="text-end mt-1" style="font-size: 10px; opacity: 0.7;">
                            ${new Date(m.createdAt).toLocaleTimeString()}
                        </div>
                    </div>
                `;
                container.appendChild(div);
            });
            container.scrollTop = container.scrollHeight;
        }

        async function sendReply() {
            const msg = document.getElementById('replyInput').value.trim();
            if (!msg || !selectedSessionId) return;

            const res = await fetch('/Admin/Chat/Reply', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ sessionId: selectedSessionId, message: msg })
            });

            if (await res.json()) {
                document.getElementById('replyInput').value = '';
                await loadMessages();
                loadSessions();
            }
        }

        document.getElementById('btnReply').onclick = sendReply;
        document.getElementById('replyInput').onkeypress = (e) => { if(e.key === 'Enter') sendReply(); };

        // Polling mỗi 3 giây
        setInterval(loadSessions, 3000);
        setInterval(loadMessages, 3000);
        
        loadSessions();
    </script>
    <style>
        .msg-admin-reply { display: flex; justify-content: flex-end; width: 100%; }
        .msg-client-reply { display: flex; justify-content: flex-start; width: 100%; }
        .session-item:hover { background: #f8f9fa; }
    </style>
}
