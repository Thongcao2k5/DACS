@{
    ViewData["Title"] = "Quản lý Chat - MotoShop";
    Layout = "_AdminLayout";
}

<div class="container-xxl flex-grow-1 container-p-y">
    <div class="card overflow-hidden" style="height: calc(100vh - 200px);">
        <div class="row g-0 h-100">
            <!-- Sidebar: Danh sách hội thoại -->
            <div class="col-4 border-end h-100 d-flex flex-column">
                <div class="p-3 border-bottom bg-light d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold"><i class='bx bx-message-square-dots me-2'></i>Hội thoại</h5>
                    <span id="hubStatusDot" class="rounded-circle d-inline-block" style="width:10px;height:10px;background:#fbb;" title="Đang kết nối..."></span>
                </div>
                <div class="flex-grow-1 overflow-auto" id="conversationList">
                    <div class="text-center p-5 text-muted" id="sidebarLoading">Đang tải danh sách...</div>
                </div>
            </div>

            <!-- Main: Khung Chat chi tiết -->
            <div class="col-8 h-100 d-flex flex-column bg-white">
                <div id="chatHeader" class="p-3 border-bottom d-none">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center">
                            <div class="avatar avatar-online me-2">
                                <img src="/assets/img/avatars/1.png" class="rounded-circle" style="width:38px;height:38px;object-fit:cover;">
                            </div>
                            <div>
                                <h6 class="mb-0" id="currentCustomerName">Khách hàng</h6>
                                <small class="text-muted" id="currentConversationId"></small>
                            </div>
                        </div>
                        <button class="btn btn-outline-danger btn-sm" id="btnCloseConv">Đóng hội thoại</button>
                    </div>
                </div>

                <div class="flex-grow-1 overflow-auto p-4 d-flex flex-column gap-3" id="adminChatMsgs" style="background: #f4f7f6;">
                    <div class="h-100 d-flex align-items-center justify-content-center text-muted" id="emptyHint">
                        Chọn một cuộc hội thoại để bắt đầu trả lời
                    </div>
                </div>

                <div id="chatFooter" class="p-3 border-top d-none">
                    <div class="input-group">
                        <input type="text" id="replyInput" class="form-control border-0 shadow-none" placeholder="Nhập tin nhắn phản hồi...">
                        <button class="btn btn-primary" id="btnReply"><i class='bx bxs-send'></i></button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
<script>
(function () {
    'use strict';

    let activeConvId = null;
    let conversations = [];

    const connection = new signalR.HubConnectionBuilder()
        .withUrl('/chatHub')
        .withAutomaticReconnect()
        .build();

    // ── SignalR Events ──────────────────────────────────────────
    connection.on('ReceiveMessage', function (msg) {
        if (msg.conversationId === activeConvId) {
            appendBubble(msg.message, msg.senderType === 'Admin', new Date(msg.createdAt));
            markAsRead(activeConvId);
        }
    });

    connection.on('ConversationUpdated', function (conv) {
        const index = conversations.findIndex(c => c.id === conv.id);
        if (index !== -1) {
            conversations[index].lastMessage = conv.lastMessage;
            conversations[index].lastMessageAt = conv.lastMessageAt;
            conversations[index].unreadByAdminCount = conv.unreadByAdminCount;
        } else {
            conversations.unshift(conv);
        }
        renderSidebar();
    });

    connection.on('ConversationRead', function(id) {
        const conv = conversations.find(c => c.id === id);
        if (conv) {
            conv.unreadByAdminCount = 0;
            renderSidebar();
        }
    });

    async function startHub() {
        try {
            await connection.start();
            await connection.invoke('AdminJoinDashboard');
            setHubStatus(true);
        } catch (e) {
            setTimeout(startHub, 5000);
            setHubStatus(false);
        }
    }

    function setHubStatus(online) {
        const dot = document.getElementById('hubStatusDot');
        if (dot) dot.style.background = online ? '#68d391' : '#fc8181';
    }

    // ── API Calls ────────────────────────────────────────────────
    async function loadConversations() {
        try {
            const res = await fetch('/api/admin/chat/conversations');
            const result = await res.json();
            conversations = result.data || [];
            renderSidebar();
        } catch (e) {
            document.getElementById('conversationList').innerHTML = '<div class="text-center p-5 text-danger">Lỗi kết nối API.</div>';
        }
    }

    function renderSidebar() {
        const list = document.getElementById('conversationList');
        if (!list) return;
        if (conversations.length === 0) {
            list.innerHTML = '<div class="text-center p-5 text-muted">Chưa có hội thoại nào</div>';
            return;
        }
        conversations.sort((a, b) => new Date(b.lastMessageAt) - new Date(a.lastMessageAt));
        list.innerHTML = '';
        conversations.forEach(c => {
            const div = document.createElement('div');
            div.className = `p-3 border-bottom session-item ${c.id === activeConvId ? 'bg-label-primary' : ''}`;
            div.style.cursor = 'pointer';
            const time = c.lastMessageAt ? new Date(c.lastMessageAt).toLocaleTimeString('vi-VN', { hour:'2-digit', minute:'2-digit' }) : '';
            div.innerHTML = `
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <strong class="text-truncate">${esc(c.customerName || 'Khách hàng')}</strong>
                    <small class="text-muted">${time}</small>
                </div>
                <div class="d-flex justify-content-between">
                    <small class="text-muted text-truncate w-75">${esc(c.lastMessage || '...')}</small>
                    ${c.unreadByAdminCount > 0 ? `<span class="badge bg-danger rounded-pill">${c.unreadByAdminCount}</span>` : ''}
                </div>`;
            div.onclick = () => selectConversation(c.id);
            list.appendChild(div);
        });
    }

    async function selectConversation(id) {
        activeConvId = id;
        const conv = conversations.find(c => c.id === id);
        document.getElementById('chatHeader').classList.remove('d-none');
        document.getElementById('chatFooter').classList.remove('d-none');
        document.getElementById('currentCustomerName').innerText = conv?.customerName || 'Khách hàng';
        document.getElementById('currentConversationId').innerText = '#' + id;
        
        renderSidebar();
        await connection.invoke('AdminJoinConversation', id);
        markAsRead(id);

        const container = document.getElementById('adminChatMsgs');
        container.innerHTML = '<div class="text-center p-5 text-muted">Đang tải tin nhắn...</div>';
        
        try {
            const res = await fetch(`/api/admin/chat/conversations/${id}/messages`);
            const result = await res.json();
            const msgs = result.data || [];
            container.innerHTML = '';
            msgs.forEach(m => appendBubble(m.message, m.senderType === 'Admin', new Date(m.createdAt)));
        } catch (e) {
            container.innerHTML = '<div class="text-center p-5 text-danger">Lỗi tải tin nhắn.</div>';
        }
    }

    function appendBubble(text, isAdmin, time) {
        const container = document.getElementById('adminChatMsgs');
        const hint = document.getElementById('emptyHint');
        if (hint) hint.remove();

        const wrapper = document.createElement('div');
        wrapper.className = 'w-100 d-flex ' + (isAdmin ? 'justify-content-end' : 'justify-content-start');
        const timeStr = time.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' });
        
        wrapper.innerHTML = `
            <div class="p-3 rounded-3 shadow-sm ${isAdmin ? 'bg-primary text-white' : 'bg-white border'}" style="max-width: 75%;">
                <div style="word-break: break-word;">${esc(text)}</div>
                <div class="text-end mt-1 small opacity-75" style="font-size: 0.7rem;">${timeStr}</div>
            </div>`;
        container.appendChild(wrapper);
        container.scrollTop = container.scrollHeight;
    }

    async function sendReply() {
        const input = document.getElementById('replyInput');
        const msg = input.value.trim();
        if (!msg || !activeConvId) return;
        input.value = '';
        try {
            await connection.invoke('AdminSendMessage', activeConvId, msg, 'Quản trị viên');
        } catch (e) { alert('Lỗi gửi tin nhắn!'); }
    }

    async function markAsRead(id) {
        try {
            await fetch(`/api/admin/chat/conversations/${id}/read`, { method: 'POST' });
            await connection.invoke('MarkAsRead', id, 'Admin');
        } catch(e){}
    }

    function esc(s) { return String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); }

    document.getElementById('btnReply').onclick = sendReply;
    document.getElementById('replyInput').onkeypress = e => { if (e.key === 'Enter') sendReply(); };

    startHub();
    loadConversations();
}());
</script>
<style>
    .session-item:hover { background: rgba(0,0,0,0.03); }
    .bg-label-primary { background-color: #e7e7ff !important; border-left: 4px solid #696cff; }
</style>
}
