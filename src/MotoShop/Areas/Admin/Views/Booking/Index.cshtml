@model IEnumerable<MotoShop.Data.Models.ServiceBooking>
@{
    ViewData["Title"] = "Quản lý Lịch đặt";
    Layout = "_AdminLayout";
}

@section Styles {
    <style>
        :root { --ms-red: #E24B4A; }
        .badge-pending { background-color: #fff2e2; color: #fdac41; }
        .badge-processing { background-color: #e7e7ff; color: #696cff; }
        .badge-completed { background-color: #e8fadf; color: #71dd37; }
        .badge-cancelled { background-color: #ffe5e5; color: #ff3e1d; }
    </style>
}

<div class="p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div><h4 class="fw-bold m-0 text-uppercase"><i class='bx bx-calendar-check me-2 text-danger'></i>Lịch đặt dịch vụ</h4></div>
    </div>

    <!-- Filter Bar -->
    <div class="filter-section shadow-sm border-0 mb-4 bg-white p-3 rounded-3">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-lg-3 col-md-6">
                <label class="form-label small text-uppercase fw-bold text-muted mb-1">Tìm kiếm</label>
                <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" class="form-control bg-light border-0" placeholder="Mã lịch hoặc tên khách...">
            </div>
            <div class="col-lg-2 col-md-6">
                <label class="form-label small text-uppercase fw-bold text-muted mb-1">Trạng thái</label>
                <select name="status" class="form-select bg-light border-0">
                    <option value="">Tất cả</option>
                    <option value="Pending">Chờ xác nhận</option>
                    <option value="Processing">Đang thực hiện</option>
                    <option value="Completed">Hoàn thành</option>
                    <option value="Cancelled">Đã hủy</option>
                </select>
            </div>
            <div class="col-lg-2 col-md-6">
                <label class="form-label small text-uppercase fw-bold text-muted mb-1">Nhân viên</label>
                <select name="staffId" class="form-select bg-light border-0">
                    <option value="">Tất cả nhân viên</option>
                    @foreach(var s in ViewBag.Staffs as List<MotoShop.Data.Models.Staff>) {
                        <option value="@s.StaffId">@s.StaffCode</option>
                    }
                </select>
            </div>
            <div class="col-lg-3 col-md-6">
                <label class="form-label small text-uppercase fw-bold text-muted mb-1">Ngày thực hiện</label>
                <div class="d-flex gap-2">
                    <input type="date" name="fromDate" class="form-control bg-light border-0">
                    <input type="date" name="toDate" class="form-control bg-light border-0">
                </div>
            </div>
            <div class="col-lg-2 col-md-12 text-end">
                <button type="submit" class="btn btn-ms-red w-100 fw-bold">Lọc</button>
            </div>
        </form>
    </div>

    <div class="table-container shadow-sm bg-white rounded-3">
        <div class="table-responsive text-nowrap">
            <table class="table table-hover align-middle m-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">Mã lịch</th>
                        <th>Khách hàng</th>
                        <th>Dịch vụ</th>
                        <th>Ngày đặt</th>
                        <th>Lịch hẹn</th>
                        <th>Nhân viên</th>
                        <th>Trạng thái</th>
                        <th class="text-end px-4">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model) {
                        <tr>
                            <td class="ps-4 fw-bold">@item.BookingCode</td>
                            <td>
                                <div class="fw-bold">@item.Customer?.FullName</div>
                                <small class="text-muted">@item.Customer?.Phone</small>
                            </td>
                            <td><span class="badge bg-label-secondary">@item.Service?.ServiceName</span></td>
                            <td>@item.BookingDate.ToString("dd/MM/yyyy")</td>
                            <td class="text-primary fw-bold">@(item.ServiceDate?.ToString("dd/MM/yyyy HH:mm") ?? "Chưa đặt")</td>
                            <td>@(item.AssignedStaff?.StaffCode ?? "---")</td>
                            <td>
                                @{
                                    var (sClass, sText) = item.Status switch {
                                        "Processing" => ("processing", "Đang thực hiện"),
                                        "Completed" => ("completed", "Hoàn thành"),
                                        "Cancelled" => ("cancelled", "Đã hủy"),
                                        _ => ("pending", "Chờ xác nhận")
                                    };
                                }
                                <span class="badge badge-@sClass">@sText</span>
                            </td>
                            <td class="text-end px-4">
                                <button class="btn btn-sm btn-icon btn-outline-info" title="Phân công" onclick="openAssignModal(@item.BookingId)"><i class="bx bx-user-plus"></i></button>
                                <button class="btn btn-sm btn-icon btn-outline-primary" title="Trạng thái" onclick="openStatusModal(@item.BookingId, '@item.Status')"><i class="bx bx-sync"></i></button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Phân công -->
<div class="modal fade" id="assignModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm">
        <div class="modal-content border-0 shadow-lg">
            <form id="assignForm">
                <input type="hidden" name="bookingId" id="assignBookingId">
                <div class="modal-header border-bottom p-4">
                    <h5 class="modal-title fw-bold">Phân công kỹ thuật</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Chọn nhân viên</label>
                        <select name="staffId" class="form-select" required>
                            @foreach(var s in ViewBag.Staffs as List<MotoShop.Data.Models.Staff>) {
                                <option value="@s.StaffId">@s.StaffCode - @s.Position</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Ghi chú</label>
                        <textarea name="notes" class="form-control" rows="2"></textarea>
                    </div>
                </div>
                <div class="modal-footer border-top p-3 px-4">
                    <button type="submit" class="btn btn-ms-red w-100">Xác nhận phân công</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Cập nhật trạng thái -->
<div class="modal fade" id="statusModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm">
        <div class="modal-content border-0 shadow-lg">
            <form id="statusForm">
                <input type="hidden" name="bookingId" id="statusBookingId">
                <div class="modal-header border-bottom p-4">
                    <h5 class="modal-title fw-bold">Cập nhật tiến độ</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Trạng thái mới</label>
                        <select name="status" id="statusSelect" class="form-select">
                            <option value="Pending">Chờ xác nhận</option>
                            <option value="Processing">Đang thực hiện</option>
                            <option value="Completed">Hoàn thành</option>
                            <option value="Cancelled">Đã hủy</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Ghi chú nội bộ</label>
                        <textarea name="notes" class="form-control" rows="2"></textarea>
                    </div>
                </div>
                <div class="modal-footer border-top p-3 px-4">
                    <button type="submit" class="btn btn-primary w-100">Cập nhật ngay</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const aModal = new bootstrap.Modal(document.getElementById('assignModal'));
        const sModal = new bootstrap.Modal(document.getElementById('statusModal'));

        function openAssignModal(id) { $('#assignBookingId').val(id); aModal.show(); }
        function openStatusModal(id, current) { $('#statusBookingId').val(id); $('#statusSelect').val(current); sModal.show(); }

        $('#assignForm').on('submit', function(e) {
            e.preventDefault();
            $.post('/Admin/Booking/AssignStaff', $(this).serialize(), function(res) {
                if (res.success) { UI.toast(res.message, 'success'); setTimeout(() => location.reload(), 1000); }
            });
        });

        $('#statusForm').on('submit', function(e) {
            e.preventDefault();
            $.post('/Admin/Booking/UpdateStatus', $(this).serialize(), function(res) {
                if (res.success) { UI.toast(res.message, 'success'); setTimeout(() => location.reload(), 1000); }
            });
        });
    </script>
}
