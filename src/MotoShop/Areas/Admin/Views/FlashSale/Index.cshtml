@model IEnumerable<MotoShop.Business.DTOs.FlashSaleDto>
@{
    ViewData["Title"] = "Quản lý Flash Sale";
    Layout = "_AdminLayout";
}

@section Styles {
    <style>
        :root { --ms-warning: #ffab00; --ms-warning-dark: #e69a00; }
        .btn-ms-warning { background: var(--ms-warning); color: white; border: none; transition: 0.3s; }
        .btn-ms-warning:hover { background: var(--ms-warning-dark); color: white; box-shadow: 0 4px 12px rgba(255, 171, 0, 0.3); }
        
        .table-container { background: #fff; border-radius: 12px; border: 1px solid #eee; overflow: hidden; }
        .badge-active { background-color: #e8fadf; color: #71dd37; }
        .badge-upcoming { background-color: #e7e7ff; color: #696cff; }
        .badge-expired { background-color: #f5f5f9; color: #8592a3; }
        .badge-paused { background-color: #ffe5e5; color: #ff3e1d; }
        .product-count-badge { background: #f0f2f5; color: #475f7b; padding: 4px 10px; border-radius: 20px; font-weight: 600; font-size: 0.75rem; cursor: pointer; }
        
        .dashboard-card { border-radius: 15px; border: none; background: #fff; box-shadow: 0 4px 24px 0 rgba(34, 41, 47, 0.05); }
        .icon-box { width: 48px; height: 48px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 24px; }
        .countdown-timer { font-family: monospace; font-size: 0.85rem; font-weight: bold; color: #ff3e1d; background: #ffe5e5; padding: 2px 6px; border-radius: 4px; display: inline-block; margin-top: 4px; }
    </style>
    <!-- DataTables -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.4/css/dataTables.bootstrap5.min.css">
}

<div class="p-4">
    <!-- Dashboard Cards -->
    <div class="row mb-4 g-4">
        <div class="col-md-4">
            <div class="dashboard-card p-3 d-flex align-items-center">
                <div class="icon-box bg-label-primary me-3 text-primary"><i class="bx bx-box"></i></div>
                <div>
                    <h6 class="mb-0 text-muted">Tổng SP tham gia</h6>
                    <h4 class="mb-0 fw-bold">@ViewBag.TotalProducts</h4>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="dashboard-card p-3 d-flex align-items-center">
                <div class="icon-box bg-label-success me-3 text-success"><i class="bx bx-check-shield"></i></div>
                <div>
                    <h6 class="mb-0 text-muted">Tổng SP đã bán</h6>
                    <h4 class="mb-0 fw-bold">@ViewBag.TotalSold</h4>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="dashboard-card p-3 d-flex align-items-center">
                <div class="icon-box bg-label-warning me-3 text-warning"><i class="bx bx-money"></i></div>
                <div>
                    <h6 class="mb-0 text-muted">Doanh thu dự kiến</h6>
                    <h4 class="mb-0 fw-bold">@(((decimal)(ViewBag.TotalRevenue ?? 0)).ToString("N0"))₫</h4>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div><h4 class="fw-bold m-0 text-uppercase text-dark"><i class='bx bxs-bolt-circle me-2 text-warning'></i>Quản lý Flash Sale</h4></div>
        <div class="d-flex gap-2">
            <button class="btn btn-ms-warning px-4 shadow-sm" onclick="openFlashSaleModal()"><i class='bx bx-plus-circle me-1'></i>Thêm chương trình mới</button>
        </div>
    </div>

    <div class="table-container shadow-sm p-3">
        <div class="table-responsive text-nowrap">
            <table class="table table-hover align-middle m-0" id="flashSaleTable">
                <thead class="bg-light">
                    <tr>
                        <th>Tên chương trình</th>
                        <th>Thời gian áp dụng</th>
                        <th>Số lượng SP</th>
                        <th>Trạng thái</th>
                        <th class="text-end px-4">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any()) {
                        foreach (var item in Model) {
                            <tr data-end="@item.EndDate.ToString("yyyy-MM-ddTHH:mm:ss")" data-start="@item.StartDate.ToString("yyyy-MM-ddTHH:mm:ss")" data-active="@item.IsActive.ToString().ToLower()">
                                <td>
                                    <div class="fw-bold text-dark">@item.Title</div>
                                    <div class="small text-muted">@item.Description</div>
                                </td>
                                <td>
                                    <div class="small fw-bold text-dark"><i class='bx bx-calendar-event me-1'></i>@item.StartDate.ToString("dd/MM/yyyy HH:mm")</div>
                                    <div class="small text-muted"><i class='bx bx-calendar-x me-1'></i>@item.EndDate.ToString("dd/MM/yyyy HH:mm")</div>
                                    @if(item.IsActive && item.StartDate <= DateTime.Now && item.EndDate > DateTime.Now) {
                                        <div class="countdown-timer timer-display">Đang tính...</div>
                                    }
                                </td>
                                <td>
                                    <span class="product-count-badge" onclick="manageProducts(@item.FlashSaleId, '@item.Title')">
                                        <i class='bx bx-package me-1'></i>@item.ProductCount SP
                                    </span>
                                </td>
                                <td><span class="badge @item.StatusClass">@item.StatusText</span></td>
                                <td class="text-end px-4">
                                    <button class="btn btn-sm btn-icon btn-outline-warning" title="Quản lý sản phẩm" onclick="manageProducts(@item.FlashSaleId, '@item.Title')"><i class="bx bx-link"></i></button>
                                    <button class="btn btn-sm btn-icon btn-outline-primary" title="Sửa" onclick="editFlashSale(@item.FlashSaleId)"><i class="bx bx-edit-alt"></i></button>
                                    <button class="btn btn-sm btn-icon btn-outline-danger" title="Xóa" onclick="confirmDelete(@item.FlashSaleId)"><i class="bx bx-trash"></i></button>
                                </td>
                            </tr>
                        }
                    } else {
                        <tr>
                            <td colspan="5" class="text-center py-5">
                                <div class="text-muted">Chưa có chương trình Flash Sale nào.</div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Thêm/Sửa Chương trình -->
<div class="modal fade" id="flashSaleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow-lg">
            <form id="flashSaleForm" method="post" asp-area="Admin" asp-controller="FlashSale" asp-action="Upsert">
                @Html.AntiForgeryToken()
                <input type="hidden" name="FlashSaleId" id="fsId">
                <div class="modal-header border-bottom p-4">
                    <h5 class="modal-title fw-bold" id="modalTitle">Thiết lập Flash Sale</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Tiêu đề Flash Sale <span class="text-danger">*</span></label>
                        <input type="text" name="Title" id="fsTitle" class="form-control" required placeholder="Ví dụ: Flash Sale Giờ Vàng">
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Mô tả</label>
                        <textarea name="Description" id="fsDesc" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold small">Ngày bắt đầu</label>
                            <input type="datetime-local" name="StartDate" id="fsStart" class="form-control" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small">Ngày kết thúc</label>
                            <input type="datetime-local" name="EndDate" id="fsEnd" class="form-control" required>
                        </div>
                    </div>
                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" name="IsActive" id="fsActive" value="true" checked>
                        <label class="form-check-label fw-bold small">Kích hoạt chương trình</label>
                    </div>
                </div>
                <div class="modal-footer border-top p-4">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-ms-warning px-4">Lưu dữ liệu</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Quản lý Sản phẩm -->
<div class="modal fade" id="productManagerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">Quản lý sản phẩm Flash Sale: <span id="currentFsTitle" class="text-warning"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3 mb-4 p-3 bg-light rounded shadow-sm border">
                    <div class="col-md-6">
                        <label class="form-label small fw-bold">Chọn sản phẩm (Variant sẽ được gộp tự động)</label>
                        <select id="selectProduct" class="form-select"></select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-bold">Giá Flash Sale</label>
                        <input type="number" id="fsPrice" class="form-control" placeholder="₫">
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small fw-bold">Số lượng</label>
                        <input type="number" id="fsQty" class="form-control" value="10">
                    </div>
                    <div class="col-md-1 d-flex align-items-end">
                        <button class="btn btn-primary btn-icon" onclick="addProductToFs()"><i class="bx bx-plus"></i></button>
                    </div>
                </div>
                
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Sản phẩm</th>
                                <th>Giá gốc (Min)</th>
                                <th>Giá Flash Sale</th>
                                <th>Số lượng</th>
                                <th>Đã bán</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody id="fsProductList">
                            <!-- Data from AJAX -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.4/js/dataTables.bootstrap5.min.js"></script>
    <script>
        $(document).ready(function() {
            $('#flashSaleTable').DataTable({
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.13.4/i18n/vi.json"
                },
                "order": [],
                "pageLength": 10
            });
            
            // Countdown Logic
            setInterval(function() {
                $('.timer-display').each(function() {
                    var endStr = $(this).closest('tr').data('end');
                    if(endStr) {
                        var end = new Date(endStr).getTime();
                        var now = new Date().getTime();
                        var distance = end - now;
                        
                        if (distance < 0) {
                            $(this).text("Đã kết thúc");
                            $(this).removeClass('countdown-timer').addClass('text-muted small fw-bold');
                        } else {
                            var hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                            var minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
                            var seconds = Math.floor((distance % (1000 * 60)) / 1000);
                            $(this).text((hours<10?"0":"")+hours + "h " + (minutes<10?"0":"")+minutes + "m " + (seconds<10?"0":"")+seconds + "s");
                        }
                    }
                });
            }, 1000);
        });

        var fsModal = new bootstrap.Modal(document.getElementById('flashSaleModal'));
        var pmModal = new bootstrap.Modal(document.getElementById('productManagerModal'));
        var currentFsId = 0;

        document.getElementById('productManagerModal').addEventListener('hidden.bs.modal', function () {
            location.reload();
        });

        function openFlashSaleModal() {
            $('#flashSaleForm')[0].reset();
            $('#fsId').val('0');
            $('#modalTitle').text('Thêm Flash Sale mới');
            fsModal.show();
        }

        function editFlashSale(id) {
            $.get('/Admin/FlashSale/GetDetails', { id: id }, function(data) {
                $('#fsId').val(data.flashSaleId);
                $('#fsTitle').val(data.title);
                $('#fsDesc').val(data.description);
                $('#fsStart').val(data.startDate);
                $('#fsEnd').val(data.endDate);
                $('#fsActive').prop('checked', data.isActive);
                
                $('#modalTitle').text('Chỉnh sửa Flash Sale');
                fsModal.show();
            });
        }

        function manageProducts(id, title) {
            currentFsId = id;
            $('#currentFsTitle').text(title);
            loadFsProducts();
            loadAllProductsForSelect();
            pmModal.show();
        }

        function loadFsProducts() {
            $.get('/Admin/FlashSale/GetProducts', { flashSaleId: currentFsId }, function(data) {
                var html = '';
                data.forEach(function(p) {
                    html += `
                        <tr>
                            <td>${p.productName}</td>
                            <td>${new Intl.NumberFormat('vi-VN').format(p.originalPrice)}₫</td>
                            <td class="text-danger fw-bold">${new Intl.NumberFormat('vi-VN').format(p.flashSalePrice)}₫</td>
                            <td>${p.quantity}</td>
                            <td>${p.soldQuantity}</td>
                            <td>
                                <button class="btn btn-xs btn-outline-danger btn-icon" onclick="removeProductFromFs(${p.id})"><i class="bx bx-x"></i></button>
                            </td>
                        </tr>
                    `;
                });
                $('#fsProductList').html(html || '<tr><td colspan="6" class="text-center py-3">Chưa có sản phẩm nào</td></tr>');
            });
        }

        function loadAllProductsForSelect() {
            $.get('/Admin/FlashSale/GetAllProducts', function(data) {
                var html = '<option value="">-- Chọn sản phẩm --</option>';
                data.forEach(function(p) {
                    html += `<option value="${p.productId}">${p.productName}</option>`;
                });
                $('#selectProduct').html(html);
            });
        }

        function addProductToFs() {
            var pId = $('#selectProduct').val();
            var price = $('#fsPrice').val();
            var qty = $('#fsQty').val();

            if(!pId || !price || !qty) {
                alert('Vui lòng nhập đầy đủ thông tin');
                return;
            }

            $.post('/Admin/FlashSale/AddProduct', { 
                flashSaleId: currentFsId, 
                productId: pId, 
                price: price, 
                quantity: qty 
            }, function(res) {
                if(res.success) {
                    loadFsProducts();
                    $('#fsPrice').val('');
                } else {
                    alert(res.message);
                }
            });
        }

        function removeProductFromFs(id) {
            if(confirm('Xác nhận xóa sản phẩm này khỏi Flash Sale?')) {
                $.post('/Admin/FlashSale/RemoveProduct', { id: id }, function(res) {
                    if(res.success) loadFsProducts();
                });
            }
        }

        function confirmDelete(id) {
            if(confirm('Bạn có chắc chắn muốn xóa chương trình Flash Sale này không?')) {
                $.post('/Admin/FlashSale/Delete/' + id, function(res) {
                    if(res.success) {
                        location.reload();
                    } else {
                        alert(res.message || 'Có lỗi xảy ra');
                    }
                });
            }
        }
    </script>
}
