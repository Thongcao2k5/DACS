@{
    ViewData["Title"] = "Quản lý Banner & Slider";
    Layout = "_AdminLayout";
    var sliders = ViewBag.Sliders as List<MotoShop.Data.Models.Slider> ?? new List<MotoShop.Data.Models.Slider>();
    var banners = ViewBag.Banners as List<MotoShop.Data.Models.Banner> ?? new List<MotoShop.Data.Models.Banner>();
}

<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold py-3 mb-4"><span class="text-muted fw-light">Cấu hình /</span> Banner & Slider</h4>

    <div class="row">
        <!-- 1. SLIDER CHÍNH (HOME) -->
        <div class="col-md-7">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header d-flex justify-content-between align-items-center bg-primary bg-opacity-10 py-3">
                    <h5 class="mb-0 fw-bold"><i class='bx bx-slideshow me-2'></i>SLIDER TRANG CHỦ</h5>
                    <button class="btn btn-primary btn-sm rounded-pill px-3" onclick="openSliderModal()"><i class='bx bx-plus'></i> THÊM SLIDE</button>
                </div>
                <div class="card-body pt-3">
                    <div class="table-responsive text-nowrap">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Ảnh</th>
                                    <th>Tiêu đề</th>
                                    <th>Thứ tự</th>
                                    <th>Trạng thái</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody id="sliderTableBody">
                                @foreach (var s in sliders)
                                {
                                    <tr data-id="@s.SliderId">
                                        <td>
                                            <img src="@s.ImageUrl" class="rounded border" style="width: 100px; height: 50px; object-fit: cover;">
                                        </td>
                                        <td class="small fw-bold">@s.Title</td>
                                        <td><input type="number" class="form-control form-control-sm text-center" style="width: 60px;" value="@s.Position" onchange="updateSliderPos(@s.SliderId, this.value)"></td>
                                        <td>
                                            <div class="form-check form-switch">
                                                <input class="form-check-input" type="checkbox" @(s.IsActive ? "checked" : "") onchange="toggleSlider(@s.SliderId)">
                                            </div>
                                        </td>
                                        <td class="text-end">
                                            <button class="btn btn-icon btn-sm btn-outline-primary rounded-circle me-1" onclick="editSlider(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(s)))"><i class='bx bx-edit-alt'></i></button>
                                            <button class="btn btn-icon btn-sm btn-outline-danger rounded-circle" onclick="deleteSlider(@s.SliderId)"><i class='bx bx-trash'></i></button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. BANNER QUẢNG CÁO -->
        <div class="col-md-5">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header d-flex justify-content-between align-items-center bg-dark bg-opacity-10 py-3">
                    <h5 class="mb-0 fw-bold"><i class='bx bx-layout me-2'></i>BANNER PHỤ</h5>
                    <button class="btn btn-dark btn-sm rounded-pill px-3" onclick="openBannerModal()"><i class='bx bx-plus'></i> THÊM BANNER</button>
                </div>
                <div class="card-body pt-3">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Ảnh</th>
                                    <th>Vị trí</th>
                                    <th>Trạng thái</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var b in banners)
                                {
                                    <tr>
                                        <td>
                                            <img src="@b.ImageUrl" class="rounded border" style="width: 80px; height: 80px; object-fit: cover;">
                                        </td>
                                        <td class="x-small fw-bold">@b.Position</td>
                                        <td>
                                            <div class="form-check form-switch">
                                                <input class="form-check-input" type="checkbox" @(b.IsActive ? "checked" : "") onchange="toggleBanner(@b.BannerId)">
                                            </div>
                                        </td>
                                        <td class="text-end">
                                            <button class="btn btn-icon btn-sm btn-outline-primary rounded-circle me-1" onclick="editBanner(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(b)))"><i class='bx bx-edit-alt'></i></button>
                                            <button class="btn btn-icon btn-sm btn-outline-danger rounded-circle" onclick="deleteBanner(@b.BannerId)"><i class='bx bx-trash'></i></button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- SLIDER MODAL -->
<div class="modal fade" id="sliderModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <form id="sliderForm" enctype="multipart/form-data">
            <input type="hidden" name="SliderId" id="s_id" value="0">
            <div class="modal-content border-0 shadow-lg rounded-4">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="sliderModalTitle">THÊM SLIDER MỚI</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3 text-center">
                        <img id="s_preview" src="/assets/img/elements/18.jpg" class="img-fluid rounded border" style="max-height: 150px; width: 100%; object-fit: cover;">
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Ảnh Slider *</label>
                        <input type="file" name="imageFile" class="form-control" onchange="previewImg(this, 's_preview')">
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Tiêu đề</label>
                        <input type="text" name="Title" id="s_title" class="form-control" placeholder="Nhập tiêu đề hiển thị...">
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Link điều hướng</label>
                        <input type="text" name="LinkUrl" id="s_link" class="form-control" placeholder="Ví dụ: /san-pham/mam-rcb">
                    </div>
                    <div class="form-check form-switch mt-3">
                        <input class="form-check-input" type="checkbox" name="IsActive" id="s_active" checked value="true">
                        <label class="form-check-label fw-bold">Hiển thị ngay</label>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary fw-bold px-4">LƯU SLIDE</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const sModal = new bootstrap.Modal(document.getElementById('sliderModal'));

        function openSliderModal() {
            $('#sliderForm')[0].reset();
            $('#s_id').val(0);
            $('#s_preview').attr('src', '/assets/img/elements/18.jpg');
            $('#sliderModalTitle').text('THÊM SLIDER MỚI');
            sModal.show();
        }

        function editSlider(s) {
            $('#s_id').val(s.SliderId);
            $('#s_title').val(s.Title);
            $('#s_link').val(s.LinkUrl);
            $('#s_preview').attr('src', s.ImageUrl);
            $('#s_active').prop('checked', s.IsActive);
            $('#sliderModalTitle').text('CHỈNH SỬA SLIDER');
            sModal.show();
        }

        $('#sliderForm').submit(async function(e) {
            e.preventDefault();
            const formData = new FormData(this);
            const res = await fetch('/Admin/SliderBanner/SaveSlider', { method: 'POST', body: formData });
            const data = await res.json();
            if (data.success) location.reload();
        });

        async function deleteSlider(id) {
            if (!confirm('Bạn có chắc muốn xóa Slider này?')) return;
            const res = await fetch(`/Admin/SliderBanner/DeleteSlider?id=${id}`, { method: 'POST' });
            const data = await res.json();
            if (data.success) location.reload();
        }

        async function toggleSlider(id) {
            await fetch(`/Admin/SliderBanner/ToggleSlider?id=${id}`, { method: 'POST' });
        }

        function previewImg(input, targetId) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = (e) => { document.getElementById(targetId).src = e.target.result; }
                reader.readAsDataURL(input.files[0]);
            }
        }

        async function updateSliderPos(id, pos) {
            // Cập nhật vị trí trực tiếp nếu cần
        }
    </script>
    <style>
        .x-small { font-size: 11px; }
        .bg-opacity-10 { background-color: rgba(var(--bs-primary-rgb), 0.1) !important; }
    </style>
}
