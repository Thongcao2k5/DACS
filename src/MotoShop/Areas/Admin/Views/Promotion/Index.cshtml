@model List<MotoShop.Business.DTOs.PromotionDto>
@{
    ViewData["Title"] = "Quản lý Khuyến mãi";
    Layout = "_AdminLayout";
    var products = ViewBag.Products as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var categories = ViewBag.Categories as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var productVariants = ViewBag.ProductVariants as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var currentType = ViewBag.Type as string;
    var currentActive = ViewBag.IsActive as string;
    var currentTime = ViewBag.TimeStatus as string;
}

@section Styles {
    <style>
        :root { --ms-red: #e24b4a; --ms-ink: #1f2937; }
        .promotion-toolbar, .promotion-table, .promotion-modal-panel { background: #fff; border: 1px solid #eceef2; border-radius: 10px; }
        .promotion-toolbar { padding: 16px; }
        .promotion-type-badge { border-radius: 999px; padding: 6px 10px; font-size: 11px; font-weight: 800; letter-spacing: .2px; }
        .type-flashsale { background: #ffe5e5; color: #d90429; }
        .type-voucher { background: #e7f7ed; color: #168a45; }
        .type-productdiscount { background: #fff0db; color: #b75c00; }
        .type-orderdiscount { background: #f1e8ff; color: #6f2dbd; }
        .type-campaign { background: #e4f1ff; color: #075985; }
        .badge-active { background: #e8fadf; color: #2f8f12; }
        .badge-upcoming { background: #e7e7ff; color: #3f43d6; }
        .badge-expired { background: #f0f1f4; color: #64748b; }
        .badge-paused { background: #ffe5e5; color: #d90429; }
        .btn-ms-red { background: var(--ms-red); color: #fff; border: 0; }
        .btn-ms-red:hover { background: #c63d3c; color: #fff; }
        .product-picker { max-height: 220px; overflow: auto; border: 1px solid #e5e7eb; border-radius: 8px; padding: 10px; background: #fafafa; }
        .product-picker label { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 8px 10px; border-radius: 7px; margin: 0; cursor: pointer; }
        .product-picker label:hover { background: #fff; }
        .product-filter-bar {
            margin-bottom: 10px;
            padding: 12px;
            border: 1px solid #eef1f5;
            border-radius: 8px;
            background: #fff;
            box-shadow: 0 8px 18px rgba(15, 23, 42, .04);
        }
        .product-filter-bar .form-label { color: #53657d; font-size: 10px; letter-spacing: .2px; }
        .product-empty-state { display: none; padding: 16px; text-align: center; color: #8b98a9; }
        .usage-text { min-width: 74px; display: inline-block; }
        .promotion-editor { border: 1px solid #d9dee7; border-radius: 8px; overflow: hidden; background: #fff; }
        .promotion-editor-toolbar { display: flex; flex-wrap: wrap; gap: 4px; padding: 8px 10px; border-bottom: 1px solid #edf0f4; background: #fafafa; }
        .promotion-editor-toolbar button { width: 34px; height: 32px; border: 1px solid transparent; border-radius: 7px; background: transparent; color: #697a8d; display: inline-flex; align-items: center; justify-content: center; }
        .promotion-editor-toolbar button:hover { border-color: var(--ms-red); color: var(--ms-red); background: #fff5f5; }
        .promotion-editor-body { min-height: 150px; max-height: 280px; overflow-y: auto; padding: 12px 14px; outline: none; line-height: 1.6; }
        .promotion-editor-body:empty:before { content: attr(data-placeholder); color: #a8b1bb; }
        #promotionModal .modal-content { max-height: calc(100vh - 2rem); overflow: hidden; }
        #promotionModal #promotionForm { display: flex; flex-direction: column; max-height: calc(100vh - 2rem); min-height: 0; }
        #promotionModal .modal-header, #promotionModal .modal-footer { flex: 0 0 auto; background: #fff; z-index: 2; }
        #promotionModal .modal-body { flex: 1 1 auto; min-height: 0; overflow-y: auto; }
        #promotionModal .modal-footer { box-shadow: 0 -8px 18px rgba(15, 23, 42, .06); }
        #promotionModal .modal-footer .btn { min-width: 120px; }
        @@media (max-width: 767.98px) {
            .promotion-table table { min-width: 920px; }
            .promotion-toolbar .form-control, .promotion-toolbar .form-select, .promotion-toolbar .btn { width: 100%; }
        }
    </style>
}

<div class="p-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h4 class="fw-bold mb-1 text-dark"><i class="bx bxs-discount text-danger me-2"></i>Chương trình Khuyến mãi</h4>
            <div class="small text-muted">Quản lý Flash Sale, Voucher, giảm giá sản phẩm và các chiến dịch quảng bá.</div>
        </div>
        <button class="btn btn-ms-red px-4" type="button" onclick="openPromotionModal()">
            <i class="bx bx-plus-circle me-1"></i> Tạo khuyến mãi mới
        </button>
    </div>

    <form class="promotion-toolbar shadow-sm mb-4" method="get">
        <div class="row g-3 align-items-end">
            <div class="col-lg-3 col-md-6">
                <label class="form-label small fw-bold text-uppercase">Tìm kiếm</label>
                <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" class="form-control" placeholder="Tên hoặc mã voucher...">
            </div>
            <div class="col-lg-2 col-md-6">
                <label class="form-label small fw-bold text-uppercase">Loại</label>
                <select name="type" class="form-select">
                    <option value="">Tất cả</option>
                    <option value="FlashSale" selected="@(currentType == "FlashSale")">Flash Sale</option>
                    <option value="Voucher" selected="@(currentType == "Voucher")">Mã Voucher</option>
                    <option value="ProductDiscount" selected="@(currentType == "ProductDiscount")">Giảm giá SP</option>
                    <option value="OrderDiscount" selected="@(currentType == "OrderDiscount")">Giảm giá đơn hàng</option>
                    <option value="Campaign" selected="@(currentType == "Campaign")">Chiến dịch (Banner)</option>
                </select>
            </div>
            <div class="col-lg-2 col-md-6">
                <label class="form-label small fw-bold text-uppercase">Trạng thái</label>
                <select name="isActive" class="form-select">
                    <option value="">Tất cả</option>
                    <option value="true" selected="@(currentActive == "true")">Đang bật</option>
                    <option value="false" selected="@(currentActive == "false")">Đang tắt</option>
                </select>
            </div>
            <div class="col-lg-2 col-md-6">
                <label class="form-label small fw-bold text-uppercase">Thời gian</label>
                <select name="timeStatus" class="form-select">
                    <option value="">Tất cả</option>
                    <option value="running" selected="@(currentTime == "running")">Đang diễn ra</option>
                    <option value="upcoming" selected="@(currentTime == "upcoming")">Sắp diễn ra</option>
                    <option value="expired" selected="@(currentTime == "expired")">Đã kết thúc</option>
                </select>
            </div>
            <div class="col-lg-3 d-flex gap-2">
                <button class="btn btn-ms-red flex-fill" type="submit">Lọc dữ liệu</button>
                <a class="btn btn-light border flex-fill" href="/Admin/Promotion">Đặt lại</a>
            </div>
        </div>
    </form>

    <div class="promotion-table shadow-sm table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Chương trình</th>
                    <th>Loại</th>
                    <th>Mức giảm</th>
                    <th>Thời gian</th>
                    <th>Trạng thái</th>
                    <th>Lượt dùng</th>
                    <th class="text-end pe-4">Thao tác</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                var typeClass = "type-" + item.PromotionType.ToLowerInvariant();
                var typeDisplay = item.PromotionType switch {
                    "FlashSale" => "Flash Sale",
                    "Voucher" => "Mã Voucher",
                    "ProductDiscount" => "Giảm giá SP",
                    "OrderDiscount" => "Giảm giá ĐH",
                    "Campaign" => "Chiến dịch",
                    _ => item.PromotionType
                };

                <tr>
                    <td class="ps-4">
                        <div class="fw-bold text-dark">@item.Name</div>
                        @if (!string.IsNullOrWhiteSpace(item.CouponCode))
                        {
                            <div class="small text-muted">Mã: <span class="fw-bold text-primary">@item.CouponCode</span></div>
                        }
                    </td>
                    <td><span class="promotion-type-badge @typeClass">@typeDisplay</span></td>
                    <td>
                        <div class="fw-bold text-danger">
                            @(item.DiscountType == "Percent" ? $"-{item.DiscountValue:N0}%" : $"-{item.DiscountValue:N0}₫")
                        </div>
                        @if (item.MinOrderAmount != null)
                        {
                            <div class="small text-muted">Đơn từ @item.MinOrderAmount.Value.ToString("N0")₫</div>
                        }
                    </td>
                    <td>
                        <div class="small fw-bold">@DateTime.Parse(item.StartDate).ToString("dd/MM HH:mm")</div>
                        <div class="small text-muted">@DateTime.Parse(item.EndDate).ToString("dd/MM HH:mm")</div>
                        @if (item.PromotionType == "FlashSale")
                        {
                            <div class="small text-danger fw-bold js-countdown" data-end="@DateTime.Parse(item.EndDate).ToString("yyyy-MM-ddTHH:mm:ss")">--:--:--</div>
                        }
                    </td>
                    <td><span class="badge @item.StatusClass">@item.StatusText</span></td>
                    <td>
                        <span class="usage-text fw-bold">@item.UsedCount@(item.UsageLimit != null ? $"/{item.UsageLimit.Value}" : "")</span>
                    </td>
                    <td class="text-end pe-4">
                        <button type="button" class="btn btn-sm btn-icon btn-outline-primary btn-edit-promo" data-promo='@Json.Serialize(item)' title="Sửa">
                            <i class="bx bx-edit-alt"></i>
                        </button>
                        <button type="button" class="btn btn-sm btn-icon btn-outline-danger" onclick="confirmDelete(@item.Id)" title="Xóa">
                            <i class="bx bx-trash"></i>
                        </button>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="promotionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg">
            <form id="promotionForm" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" id="pId" value="0">
                <div class="modal-header border-bottom p-4">
                    <h5 class="modal-title fw-bold" id="modalTitle">Cấu hình Khuyến mãi</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-lg-6">
                            <label class="form-label fw-bold small">Tên chương trình</label>
                            <input type="text" name="Name" id="pName" class="form-control" required placeholder="VD: Khuyến mãi mùa hè 2024">
                        </div>
                        <div class="col-lg-3">
                            <label class="form-label fw-bold small">Loại khuyến mãi</label>
                            <select name="PromotionType" id="pPromotionType" class="form-select">
                                <option value="FlashSale">Flash Sale</option>
                                <option value="Voucher">Mã Voucher</option>
                                <option value="ProductDiscount">Giảm giá sản phẩm</option>
                                <option value="OrderDiscount">Giảm giá đơn hàng</option>
                                <option value="Campaign">Chiến dịch (Banner)</option>
                            </select>
                        </div>
                        <div class="col-lg-3">
                            <label class="form-label fw-bold small">Độ ưu tiên</label>
                            <input type="number" name="Priority" id="pPriority" class="form-control" value="0">
                        </div>
                        <div class="col-lg-3">
                            <label class="form-label fw-bold small">Pham vi ap dung</label>
                            <select name="ApplyType" id="pApplyType" class="form-select">
                                <option value="All">Toan bo don hang</option>
                                <option value="Category">Theo danh muc</option>
                                <option value="Product" selected>Theo san pham</option>
                                <option value="ProductVariantSKU">Theo SKU / bien the</option>
                            </select>
                        </div>
                        <div class="col-lg-3">
                            <label class="form-label fw-bold small">Kiểu giảm giá</label>
                            <select name="DiscountType" id="pDiscountType" class="form-select">
                                <option value="Percent">Theo Phần trăm (%)</option>
                                <option value="Fixed">Số tiền cố định (₫)</option>
                            </select>
                        </div>
                        <div class="col-lg-3">
                            <label class="form-label fw-bold small">Giá trị giảm</label>
                            <input type="number" step="0.01" name="DiscountValue" id="pDiscountValue" class="form-control" required placeholder="10 hoặc 50000">
                        </div>
                        <div class="col-lg-3">
                            <label class="form-label fw-bold small">Ngày bắt đầu</label>
                            <input type="datetime-local" name="StartDate" id="pStartDate" class="form-control" required>
                        </div>
                        <div class="col-lg-3">
                            <label class="form-label fw-bold small">Ngày kết thúc</label>
                            <input type="datetime-local" name="EndDate" id="pEndDate" class="form-control" required>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold small">Mô tả chương trình</label>
                            <textarea name="Description" id="pDescription" class="d-none"></textarea>
                            <div class="promotion-editor">
                                <div class="promotion-editor-toolbar" role="toolbar" aria-label="Thanh cong cu mo ta khuyen mai">
                                    <button type="button" data-cmd="undo" title="Hoàn tác"><i class="bx bx-undo"></i></button>
                                    <button type="button" data-cmd="redo" title="Làm lại"><i class="bx bx-redo"></i></button>
                                    <button type="button" data-cmd="bold" title="In đậm"><i class="bx bx-bold"></i></button>
                                    <button type="button" data-cmd="italic" title="In nghiêng"><i class="bx bx-italic"></i></button>
                                    <button type="button" data-cmd="underline" title="Gạch chân"><i class="bx bx-underline"></i></button>
                                    <button type="button" data-cmd="justifyLeft" title="Căn trái"><i class="bx bx-align-left"></i></button>
                                    <button type="button" data-cmd="justifyCenter" title="Căn giữa"><i class="bx bx-align-middle"></i></button>
                                    <button type="button" data-cmd="justifyRight" title="Căn phải"><i class="bx bx-align-right"></i></button>
                                    <button type="button" data-cmd="insertUnorderedList" title="Danh sách chấm"><i class="bx bx-list-ul"></i></button>
                                    <button type="button" data-cmd="insertOrderedList" title="Danh sách số"><i class="bx bx-list-ol"></i></button>
                                    <button type="button" data-cmd="createLink" title="Chèn liên kết"><i class="bx bx-link"></i></button>
                                    <button type="button" data-cmd="removeFormat" title="Xóa định dạng"><i class="bx bx-eraser"></i></button>
                                </div>
                                <div id="pDescriptionEditor" class="promotion-editor-body" contenteditable="true" data-placeholder="Nhập nội dung chi tiết về chương trình..."></div>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3 mt-1 promo-field promo-voucher">
                        <div class="col-md-4">
                            <label class="form-label fw-bold small">Mã Voucher</label>
                            <input type="text" name="CouponCode" id="pCouponCode" class="form-control" placeholder="VD: MOTOSHOP50">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold small">Giới hạn lượt dùng</label>
                            <input type="number" name="UsageLimit" id="pUsageLimit" class="form-control" placeholder="Để trống nếu không giới hạn">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold small">Đơn tối thiểu</label>
                            <input type="number" step="0.01" name="MinOrderAmount" id="pMinOrderAmount" class="form-control" placeholder="0">
                        </div>
                    </div>

                    <div class="row g-3 mt-1 promo-field promo-order">
                        <div class="col-md-6">
                            <label class="form-label fw-bold small">Giá trị đơn hàng tối thiểu</label>
                            <input type="number" step="0.01" name="MinOrderAmount_OrderMirror" id="pMinOrderMirror" class="form-control" placeholder="1,000,000">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small">Mức giảm tối đa</label>
                            <input type="number" step="0.01" name="MaxDiscountAmount" id="pMaxDiscountAmount" class="form-control" placeholder="Dùng cho giảm giá theo %">
                        </div>
                    </div>

                    <div class="row g-3 mt-1 promo-field promo-campaign">
                        <div class="col-md-8">
                            <label class="form-label fw-bold small">Đường dẫn Ảnh Banner</label>
                            <input type="text" name="BannerImage" id="pBannerImage" class="form-control" placeholder="/assets/img/promotions/banner-summer.jpg">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold small">Màu nền chủ đạo</label>
                            <input type="text" name="BackgroundColor" id="pBackgroundColor" class="form-control" placeholder="#e24b4a">
                        </div>
                    </div>

                    <div class="mt-4 promo-scope promo-categories">
                        <label class="form-label fw-bold small">Chon danh muc ap dung</label>
                        <div class="product-picker">
                            @foreach (var c in categories)
                            {
                                <label><span><input class="form-check-input me-2 category-check" type="checkbox" name="categoryIds" value="@c.CategoryId">@c.CategoryName</span></label>
                            }
                        </div>
                    </div>

                    <div class="mt-4 promo-scope promo-variants">
                        <label class="form-label fw-bold small">Chon SKU / bien the ap dung</label>
                        <div class="product-picker">
                            @foreach (var v in productVariants)
                            {
                                <label><span><input class="form-check-input me-2 variant-check" type="checkbox" name="productVariantIds" value="@v.ProductVariantId">@v.ProductName - @v.VariantName (@v.SKU)</span></label>
                            }
                        </div>
                    </div>

                    <div class="mt-4 promo-field promo-scope promo-products">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <label class="form-label fw-bold small mb-0">Chọn sản phẩm áp dụng</label>
                            <span class="small text-muted"><span id="selectedProductCount">0</span> sản phẩm đã chọn</span>
                        </div>
                        <div class="product-filter-bar">
                            <div class="row g-3 align-items-end">
                                <div class="col-lg-4 col-md-6">
                                    <label class="form-label fw-bold text-uppercase">Tìm kiếm</label>
                                    <input type="text" id="productSearchFilter" class="form-control" placeholder="Tên sản phẩm...">
                                </div>
                                <div class="col-lg-2 col-md-6">
                                    <label class="form-label fw-bold text-uppercase">Loại</label>
                                    <select id="productCategoryFilter" class="form-select">
                                        <option value="">Tất cả</option>
                                        @foreach (var c in categories)
                                        {
                                            <option value="@c.CategoryId">@c.CategoryName</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-lg-2 col-md-6">
                                    <label class="form-label fw-bold text-uppercase">Trạng thái</label>
                                    <select id="productStatusFilter" class="form-select">
                                        <option value="">Tất cả</option>
                                        <option value="active">Đang bán</option>
                                        <option value="inactive">Tạm ẩn</option>
                                    </select>
                                </div>
                                <div class="col-lg-2 col-md-6">
                                    <label class="form-label fw-bold text-uppercase">Tồn kho</label>
                                    <select id="productStockFilter" class="form-select">
                                        <option value="">Tất cả</option>
                                        <option value="in-stock">Còn hàng</option>
                                        <option value="out-of-stock">Hết hàng</option>
                                    </select>
                                </div>
                                <div class="col-lg-2 d-flex gap-2">
                                    <button type="button" id="applyProductFilters" class="btn btn-ms-red flex-fill">Lọc</button>
                                    <button type="button" id="resetProductFilters" class="btn btn-light border flex-fill">Đặt lại</button>
                                </div>
                            </div>
                        </div>
                        <div class="product-picker">
                            @foreach (var p in products)
                            {
                                var searchableText = $"{p.ProductName} {p.CategoryName}".ToLowerInvariant();
                                <label class="product-option"
                                       data-search="@searchableText"
                                       data-category-id="@p.CategoryId"
                                       data-status="@(p.IsActive ? "active" : "inactive")"
                                       data-stock="@p.StockQuantity">
                                    <span>
                                        <input class="form-check-input me-2 product-check" type="checkbox" name="productIds" value="@p.ProductId">
                                        @p.ProductName
                                    </span>
                                    <span class="small text-muted">@(((decimal)p.Price).ToString("N0"))₫</span>
                                </label>
                            }
                            <div id="productEmptyState" class="product-empty-state">Không tìm thấy sản phẩm phù hợp.</div>
                        </div>
                        <div class="small text-danger mt-2 promo-flash">
                            <i class="bx bx-info-circle"></i> Flash Sale sẽ tự động hiển thị Countdown trên giao diện người dùng.
                        </div>
                    </div>

                    <div class="d-flex flex-wrap gap-4 mt-4">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" name="IsActive" id="pIsActive" value="true" checked>
                            <label class="form-check-label fw-bold small" for="pIsActive">Kích hoạt ngay</label>
                        </div>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" name="IsFeatured" id="pIsFeatured" value="true">
                            <label class="form-check-label fw-bold small" for="pIsFeatured">Ưu đãi nổi bật (Hiện trang chủ)</label>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-top p-3 px-4">
                    <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button type="submit" class="btn btn-ms-red px-4">Lưu cấu hình</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const pModal = new bootstrap.Modal(document.getElementById('promotionModal'));

        function getPromotionDescriptionEditor() {
            return document.getElementById('pDescriptionEditor');
        }

        function setPromotionDescription(html) {
            const editor = getPromotionDescriptionEditor();
            if (editor) editor.innerHTML = html || '';
            document.getElementById('pDescription').value = html || '';
        }

        function syncPromotionDescription() {
            const editor = getPromotionDescriptionEditor();
            const html = editor ? editor.innerHTML.trim() : '';
            document.getElementById('pDescription').value = html;
            return html;
        }

        document.querySelectorAll('.promotion-editor-toolbar button').forEach(button => {
            button.addEventListener('click', function () {
                const cmd = this.dataset.cmd;
                const editor = getPromotionDescriptionEditor();
                editor?.focus();

                if (cmd === 'createLink') {
                    const url = prompt('Nhập đường dẫn liên kết:');
                    if (url) document.execCommand(cmd, false, url);
                } else {
                    document.execCommand(cmd, false, null);
                }

                syncPromotionDescription();
            });
        });

        getPromotionDescriptionEditor()?.addEventListener('input', syncPromotionDescription);
        getPromotionDescriptionEditor()?.addEventListener('blur', syncPromotionDescription);

        function openPromotionModal() {
            document.getElementById('promotionForm').reset();
            document.getElementById('pId').value = 0;
            document.getElementById('modalTitle').innerText = 'Tạo chương trình Khuyến mãi';
            setPromotionDescription('');
            setDefaultDates();
            syncDynamicFields();
            resetProductFilters();
            syncSelectedProductCount();
            pModal.show();
        }

        function setDefaultDates() {
            const now = new Date();
            const later = new Date(now.getTime() + 7 * 24 * 60 * 60 * 1000);
            document.getElementById('pStartDate').value = toLocalInput(now);
            document.getElementById('pEndDate').value = toLocalInput(later);
        }

        function toLocalInput(date) {
            const pad = n => n.toString().padStart(2, '0');
            return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}T${pad(date.getHours())}:${pad(date.getMinutes())}`;
        }

        function syncDynamicFields() {
            const type = document.getElementById('pPromotionType').value;
            const applyType = document.getElementById('pApplyType').value;
            document.querySelectorAll('.promo-field').forEach(el => el.style.display = 'none');
            document.querySelectorAll('.promo-scope').forEach(el => el.style.display = 'none');

            if (type === 'FlashSale') {
                document.querySelector('.promo-flash').style.display = '';
            }
            if (type === 'ProductDiscount') {
                document.querySelector('.promo-flash').style.display = 'none';
            }
            if (type === 'Voucher') document.querySelector('.promo-voucher').style.display = '';
            if (type === 'OrderDiscount') document.querySelector('.promo-order').style.display = '';
            if (type === 'Campaign') document.querySelector('.promo-campaign').style.display = '';

            if (applyType === 'Category') document.querySelector('.promo-categories').style.display = '';
            if (applyType === 'Product') document.querySelector('.promo-products').style.display = '';
            if (applyType === 'ProductVariantSKU') document.querySelector('.promo-variants').style.display = '';
        }

        function syncSelectedProductCount() {
            document.getElementById('selectedProductCount').innerText = document.querySelectorAll('.product-check:checked').length;
        }

        function filterPromotionProducts() {
            const keyword = (document.getElementById('productSearchFilter')?.value || '').trim().toLowerCase();
            const categoryId = document.getElementById('productCategoryFilter')?.value || '';
            const status = document.getElementById('productStatusFilter')?.value || '';
            const stock = document.getElementById('productStockFilter')?.value || '';
            let visibleCount = 0;

            document.querySelectorAll('.product-option').forEach(option => {
                const matchesKeyword = !keyword || (option.dataset.search || '').includes(keyword);
                const matchesCategory = !categoryId || option.dataset.categoryId === categoryId;
                const matchesStatus = !status || option.dataset.status === status;
                const stockQuantity = parseInt(option.dataset.stock || '0', 10);
                const matchesStock = !stock ||
                    (stock === 'in-stock' && stockQuantity > 0) ||
                    (stock === 'out-of-stock' && stockQuantity <= 0);
                const isVisible = matchesKeyword && matchesCategory && matchesStatus && matchesStock;
                option.style.display = isVisible ? '' : 'none';
                if (isVisible) visibleCount++;
            });

            const emptyState = document.getElementById('productEmptyState');
            if (emptyState) emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
        }

        function resetProductFilters() {
            const search = document.getElementById('productSearchFilter');
            if (search) search.value = '';
            const category = document.getElementById('productCategoryFilter');
            if (category) category.value = '';
            const status = document.getElementById('productStatusFilter');
            if (status) status.value = '';
            const stock = document.getElementById('productStockFilter');
            if (stock) stock.value = '';
            filterPromotionProducts();
        }

        document.getElementById('pPromotionType').addEventListener('change', syncDynamicFields);
        document.getElementById('pApplyType').addEventListener('change', syncDynamicFields);
        document.querySelectorAll('.product-check').forEach(cb => cb.addEventListener('change', syncSelectedProductCount));
        document.getElementById('productSearchFilter')?.addEventListener('input', filterPromotionProducts);
        document.getElementById('applyProductFilters')?.addEventListener('click', filterPromotionProducts);
        document.getElementById('resetProductFilters')?.addEventListener('click', resetProductFilters);
        document.getElementById('productCategoryFilter')?.addEventListener('change', filterPromotionProducts);
        document.getElementById('productStatusFilter')?.addEventListener('change', filterPromotionProducts);
        document.getElementById('productStockFilter')?.addEventListener('change', filterPromotionProducts);

        document.getElementById('promotionForm').addEventListener('submit', function (e) {
            e.preventDefault();
            syncPromotionDescription();
            if (document.getElementById('pPromotionType').value === 'OrderDiscount') {
                document.getElementById('pMinOrderAmount').value = document.getElementById('pMinOrderMirror').value;
            }

            $.post('/Admin/Promotion/Save', $(this).serialize(), function (res) {
                if (res.success) {
                    UI.toast(res.message, 'success');
                    setTimeout(() => location.reload(), 800);
                } else {
                    UI.toast(res.message || 'Không thể lưu chương trình khuyến mãi.', 'error');
                }
            });
        });

        $(document).on('click', '.btn-edit-promo', function () {
            const data = $(this).data('promo');
            document.getElementById('promotionForm').reset();
            document.getElementById('pId').value = data.id || 0;
            document.getElementById('pName').value = data.name || '';
            setPromotionDescription(data.description || '');
            document.getElementById('pPromotionType').value = data.promotionType || 'ProductDiscount';
            document.getElementById('pApplyType').value = data.applyType || 'Product';
            document.getElementById('pDiscountType').value = data.discountType || 'Percent';
            document.getElementById('pDiscountValue').value = data.discountValue || 0;
            document.getElementById('pCouponCode').value = data.couponCode || '';
            document.getElementById('pUsageLimit').value = data.usageLimit || '';
            document.getElementById('pMinOrderAmount').value = data.minOrderAmount || '';
            document.getElementById('pMinOrderMirror').value = data.minOrderAmount || '';
            document.getElementById('pMaxDiscountAmount').value = data.maxDiscountAmount || '';
            document.getElementById('pPriority').value = data.priority || 0;
            document.getElementById('pBannerImage').value = data.bannerImage || '';
            document.getElementById('pBackgroundColor').value = data.backgroundColor || '';
            document.getElementById('pStartDate').value = (data.startDate || '').substring(0, 16);
            document.getElementById('pEndDate').value = (data.endDate || '').substring(0, 16);
            document.getElementById('pIsActive').checked = !!data.isActive;
            document.getElementById('pIsFeatured').checked = !!data.isFeatured;

            const ids = new Set(data.productIds || []);
            document.querySelectorAll('.product-check').forEach(cb => cb.checked = ids.has(parseInt(cb.value)));
            const categoryIds = new Set(data.categoryIds || []);
            document.querySelectorAll('.category-check').forEach(cb => cb.checked = categoryIds.has(parseInt(cb.value)));

            const variantIds = new Set(data.productVariantIds || []);
            document.querySelectorAll('.variant-check').forEach(cb => cb.checked = variantIds.has(parseInt(cb.value)));

            document.getElementById('modalTitle').innerText = 'Chỉnh sửa Khuyến mãi';
            syncDynamicFields();
            resetProductFilters();
            syncSelectedProductCount();
            pModal.show();
        });

        function confirmDelete(id) {
            if (!confirm('Xác nhận xóa chương trình khuyến mãi này?')) return;
            $.post('/Admin/Promotion/BulkDelete', { ids: [id] }, function (res) {
                if (res.success) {
                    UI.toast(res.message, 'success');
                    setTimeout(() => location.reload(), 800);
                }
            });
        }

        function updateCountdowns() {
            document.querySelectorAll('.js-countdown').forEach(el => {
                const end = new Date(el.dataset.end).getTime();
                const diff = end - Date.now();
                if (diff <= 0) {
                    el.innerText = 'Đã kết thúc';
                    return;
                }
                const days = Math.floor(diff / 86400000);
                const hours = Math.floor((diff % 86400000) / 3600000);
                const minutes = Math.floor((diff % 3600000) / 60000);
                const seconds = Math.floor((diff % 60000) / 1000);
                el.innerText = `${days} ngày ${hours}:${minutes}:${seconds}`;
            });
        }

        setInterval(updateCountdowns, 1000);
        updateCountdowns();
        syncDynamicFields();
    </script>
}
