@model MotoShop.Data.Models.Blog

@{
    ViewData["Title"] = "Chỉnh sửa bài viết";
    Layout = "_AdminLayout";
}

<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold py-3 mb-4"><span class="text-muted fw-light">Blog /</span> Chỉnh sửa bài viết</h4>

    <div class="card">
        <div class="card-body">
            <!-- FIX 4: Thêm enctype để upload file -->
            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                
                <div class="row g-3">
                    <div class="col-md-8">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Tiêu đề bài viết *</label>
                            <input asp-for="Title" id="Title" class="form-control" placeholder="Nhập tiêu đề..." required>
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Đường dẫn (Slug)</label>
                            <input asp-for="Slug" id="Slug" class="form-control" placeholder="tu-dong-tao-slug">
                            <span asp-validation-for="Slug" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Nội dung *</label>
                            <textarea asp-for="Content" id="Editor" class="form-control"></textarea>
                            <span asp-validation-for="Content" class="text-danger"></span>
                        </div>
                    </div>
                    
                    <div class="col-md-4">
                        <!-- FIX 3: Sắp xếp lại Layout bên phải -->
                        <div class="card border p-3">
                            <div class="mb-3">
                                <label class="form-label fw-bold">Danh mục</label>
                                <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryId" required></select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold">Trạng thái</label>
                                <select asp-for="Status" class="form-select">
                                    <option value="0">Bản nháp (Draft)</option>
                                    <option value="1">Đăng bài (Published)</option>
                                </select>
                            </div>
                            
                            <div class="mb-3">
                                <label class="form-label fw-bold">Ảnh đại diện</label>
                                <!-- FIX 5: Hiển thị Preview ảnh hiện tại -->
                                <div class="mt-1 mb-3 text-center border rounded p-2 bg-light">
                                    <img id="preview" src="@(string.IsNullOrEmpty(Model.Thumbnail) ? "/assets/img/elements/1.jpg" : Model.Thumbnail)" 
                                         class="img-fluid rounded" style="max-height: 180px; object-fit: contain;">
                                    <div class="small text-muted mt-2">Ảnh hiện tại</div>
                                </div>
                                
                                <label class="btn btn-outline-primary btn-sm w-100 mb-2">
                                    <i class="bx bx-upload me-1"></i> Thay đổi ảnh
                                    <input type="file" name="thumbnailFile" class="form-control" hidden onchange="previewImage(this)">
                                </label>
                                <small class="text-muted d-block text-center" style="font-size: 11px;">Hỗ trợ: JPG, PNG, WEBP (Max 2MB)</small>
                            </div>

                            <hr>
                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-primary btn-lg">CẬP NHẬT</button>
                                <a asp-action="Index" class="btn btn-label-secondary">QUAY LẠI</a>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.ckeditor.com/4.16.2/standard/ckeditor.js"></script>
    <script>
        CKEDITOR.replace('Editor', { height: 400 });

        document.getElementById('Title').addEventListener('input', function() {
            document.getElementById('Slug').value = generateSlug(this.value);
        });

        function generateSlug(text) {
            return text.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[đĐ]/g, 'd').replace(/([^a-z0-9\s-]|_)/g, '').replace(/\s+/g, '-').replace(/-+/g, '-').trim();
        }

        function previewImage(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('preview').src = e.target.result;
                }
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}
