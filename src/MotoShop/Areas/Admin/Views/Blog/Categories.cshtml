@model IEnumerable<MotoShop.Data.Models.BlogCategory>
@{
    ViewData["Title"] = "Danh mục Blog";
    Layout = "_AdminLayout";
}

<div class="p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <a asp-action="Index" class="text-muted small fw-bold text-uppercase text-decoration-none"><i class='bx bx-left-arrow-alt me-1'></i>Quay lại bài viết</a>
            <h4 class="fw-bold m-0 mt-2 text-uppercase"><i class='bx bx-category me-2 text-danger'></i>Quản lý danh mục</h4>
        </div>
        <button class="btn btn-ms-red px-4 shadow-sm" onclick="openCatModal()"><i class='bx bx-plus-circle me-1'></i>Thêm danh mục</button>
    </div>

    <div class="table-container shadow-sm bg-white rounded-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle m-0">
                <thead class="bg-light small text-uppercase">
                    <tr>
                        <th class="ps-4">Tên danh mục</th>
                        <th>Đường dẫn (Slug)</th>
                        <th>Số bài viết</th>
                        <th class="text-end px-4">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model) {
                        <tr>
                            <td class="ps-4 fw-bold">@item.Name</td>
                            <td><code class="small text-primary">@item.Slug</code></td>
                            <td><span class="badge bg-label-info">@item.Blogs.Count bài</span></td>
                            <td class="text-end px-4">
                                <button class="btn btn-sm btn-icon btn-outline-primary" onclick="editCat(@Json.Serialize(item))"><i class="bx bx-edit-alt"></i></button>
                                <button class="btn btn-sm btn-icon btn-outline-danger" onclick="confirmDelete(@item.Id)"><i class="bx bx-trash"></i></button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Category -->
<div class="modal fade" id="catModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm">
        <div class="modal-content border-0 shadow-lg">
            <form id="catForm">
                <input type="hidden" name="Id" id="catId">
                <div class="modal-header border-bottom p-4">
                    <h5 class="modal-title fw-bold" id="modalTitle">Danh mục</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Tên danh mục</label>
                        <input type="text" name="Name" id="catName" class="form-control" required>
                    </div>
                    <div class="mb-0">
                        <label class="form-label small fw-bold">Slug</label>
                        <input type="text" name="Slug" id="catSlug" class="form-control bg-light">
                    </div>
                </div>
                <div class="modal-footer border-top p-3 px-4">
                    <button type="submit" class="btn btn-ms-red w-100">Lưu danh mục</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const cModal = new bootstrap.Modal(document.getElementById('catModal'));

        function openCatModal() {
            $('#catForm')[0].reset();
            $('#catId').val(0);
            $('#modalTitle').text('Thêm danh mục mới');
            cModal.show();
        }

        function editCat(data) {
            $('#catId').val(data.id);
            $('#catName').val(data.name);
            $('#catSlug').val(data.slug);
            $('#modalTitle').text('Chỉnh sửa danh mục');
            cModal.show();
        }

        $('#catName').on('input', function() {
            let slug = $(this).val().toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/[đĐ]/g, 'd').replace(/([^0-9a-z-\s])/g, '').replace(/(\s+)/g, '-').replace(/-+/g, '-').replace(/^-+|-+$/g, '');
            $('#catSlug').val(slug);
        });

        $('#catForm').on('submit', function(e) {
            e.preventDefault();
            $.post('/Admin/Blog/SaveCategory', $(this).serialize(), function(res) {
                if (res.success) { UI.toast(res.message, 'success'); setTimeout(() => location.reload(), 1000); }
            });
        });

        function confirmDelete(id) {
            if(confirm("Xác nhận xóa danh mục này? Toàn bộ bài viết thuộc danh mục sẽ bị ảnh hưởng.")) {
                $.post('/Admin/Blog/DeleteCategory', { id: id }, function(res) {
                    if (res.success) { UI.toast(res.message, 'success'); setTimeout(() => location.reload(), 1000); }
                });
            }
        }
    </script>
}
