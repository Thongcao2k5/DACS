@model IEnumerable<MotoShop.Data.Models.BlogCategory>
@{
    ViewData["Title"] = "Quản lý danh mục tin tức";
    Layout = "_AdminLayout";
}

<div class="container-xxl flex-grow-1 container-p-y">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold py-3 mb-0">
            <span class="text-muted fw-light">Tin tức /</span> Danh mục
        </h4>
        <button class="btn btn-danger rounded-pill fw-bold shadow-sm" onclick="openModal(0, '', '')">
            <i class='bx bx-plus me-1'></i> THÊM DANH MỤC MỚI
        </button>
    </div>

    <div class="card shadow-sm border-0">
        <div class="table-responsive text-nowrap">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th width="50">ID</th>
                        <th>Tên danh mục</th>
                        <th>Slug</th>
                        <th class="text-center">Số bài viết</th>
                        <th width="150" class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody class="table-border-bottom-0">
                    @foreach (var cat in Model)
                    {
                        <tr>
                            <td><strong>@cat.Id</strong></td>
                            <td><span class="fw-bold text-dark">@cat.Name</span></td>
                            <td><code class="small text-muted">@cat.Slug</code></td>
                            <td class="text-center">
                                <span class="badge bg-label-info rounded-pill px-3">@(cat.Blogs?.Count ?? 0) bài</span>
                            </td>
                            <td class="text-center">
                                <div class="btn-group">
                                    <button class="btn btn-sm btn-icon btn-outline-primary" onclick="openModal(@cat.Id, '@cat.Name', '@cat.Slug')">
                                        <i class='bx bx-edit-alt'></i>
                                    </button>
                                    <button class="btn btn-sm btn-icon btn-outline-danger ms-2" onclick="confirmDelete(@cat.Id)">
                                        <i class='bx bx-trash'></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Save Category -->
<div class="modal fade" id="categoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold" id="modalTitle">THÊM DANH MỤC</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="categoryForm">
                    <input type="hidden" id="catId" name="Id" value="0">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Tên danh mục</label>
                        <input type="text" id="catName" name="Name" class="form-control" placeholder="Mẹo sửa xe, Review..." required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Slug</label>
                        <input type="text" id="catSlug" name="Slug" class="form-control bg-light" readonly>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-top">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">HỦY</button>
                <button type="button" class="btn btn-danger rounded-pill px-4 shadow-sm" onclick="saveCategory()">LƯU LẠI</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const modal = new bootstrap.Modal(document.getElementById('categoryModal'));

        function openModal(id, name, slug) {
            document.getElementById('catId').value = id;
            document.getElementById('catName').value = name;
            document.getElementById('catSlug').value = slug;
            document.getElementById('modalTitle').innerText = id === 0 ? 'THÊM DANH MỤC MỚI' : 'CHỈNH SỬA DANH MỤC';
            modal.show();
        }

        // Auto Slug
        document.getElementById('catName').addEventListener('input', function() {
            let title = this.value;
            let slug = title.toLowerCase()
                .normalize("NFD").replace(/[\u0300-\u036f]/g, "")
                .replace(/[^\w\s-]/g, "")
                .trim()
                .replace(/\s+/g, "-")
                .replace(/-+/g, "-");
            document.getElementById('catSlug').value = slug;
        });

        function saveCategory() {
            const data = {
                Id: document.getElementById('catId').value,
                Name: document.getElementById('catName').value,
                Slug: document.getElementById('catSlug').value
            };

            $.post('/Admin/Blog/SaveCategory', data, function(res) {
                if (res.success) {
                    location.reload();
                } else {
                    alert('Có lỗi xảy ra: ' + res.message);
                }
            });
        }

        function confirmDelete(id) {
            if (confirm('Bạn có chắc chắn muốn xóa danh mục này? Các bài viết thuộc danh mục này có thể bị ảnh hưởng.')) {
                $.post('/Admin/Blog/DeleteCategory', { id: id }, function(res) {
                    if (res.success) location.reload();
                });
            }
        }
    </script>
}
