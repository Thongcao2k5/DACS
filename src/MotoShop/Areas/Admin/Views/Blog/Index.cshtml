@model IEnumerable<MotoShop.Data.Models.Blog>

@{
    ViewData["Title"] = "Quản lý Bài viết";
    Layout = "_AdminLayout";
}

<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold py-3 mb-4"><span class="text-muted fw-light">Blog /</span> Danh sách bài viết</h4>

    <!-- Filter & Search -->
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Tìm kiếm tiêu đề</label>
                    <input type="text" name="searchTerm" class="form-control" placeholder="Nhập tiêu đề..." value="@ViewBag.SearchTerm">
                </div>
                <div class="col-md-3">
                    <label class="form-label">Danh mục</label>
                    <select name="categoryId" class="form-select" asp-items="@(new SelectList(ViewBag.Categories, "Id", "Name"))">
                        <option value="">-- Tất cả danh mục --</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Trạng thái</label>
                    <select name="status" class="form-select">
                        <option value="">-- Tất cả --</option>
                        <option value="0" selected="@(ViewBag.Status?.ToString() == "0")">Bản nháp</option>
                        <option value="1" selected="@(ViewBag.Status?.ToString() == "1")">Đã đăng</option>
                    </select>
                </div>
                <div class="col-md-3 d-flex align-items-end gap-2">
                    <button type="submit" class="btn btn-primary w-100">Lọc</button>
                    <a asp-action="Create" class="btn btn-success w-100">Thêm mới</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Table -->
    <div class="card">
        <div class="table-responsive text-nowrap">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Tiêu đề</th>
                        <th>Hình ảnh</th>
                        <th>Danh mục</th>
                        <th>Ngày đăng</th>
                        <th>Trạng thái</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody class="table-border-bottom-0">
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td style="max-width: 300px; overflow: hidden; text-overflow: ellipsis;">
                                <strong>@item.Title</strong>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.Thumbnail))
                                {
                                    <img src="@item.Thumbnail" alt="Thumbnail" class="rounded" style="width: 60px; height: 40px; object-fit: cover;">
                                }
                                else
                                {
                                    <span class="badge bg-label-secondary">No Image</span>
                                }
                            </td>
                            <td><span class="badge bg-label-info">@item.Category?.Name</span></td>
                            <td>@item.CreatedDate.ToString("dd/MM/yyyy")</td>
                            <td>
                                @if (item.Status == 1)
                                {
                                    <span class="badge bg-label-success">Đã đăng</span>
                                }
                                else
                                {
                                    <span class="badge bg-label-warning">Bản nháp</span>
                                }
                            </td>
                            <td class="text-center" style="white-space: nowrap; width: 50px;">
                                <div class="dropdown">
                                    <button type="button" class="btn p-0 dropdown-toggle hide-arrow" data-bs-toggle="dropdown">
                                        <i class="bx bx-dots-vertical-rounded"></i>
                                    </button>
                                    <div class="dropdown-menu">
                                        <a class="dropdown-item" asp-action="Details" asp-route-id="@item.Id"><i class="bx bx-show-alt me-1"></i> Xem</a>
                                        <a class="dropdown-item" asp-action="Edit" asp-route-id="@item.Id"><i class="bx bx-edit-alt me-1"></i> Sửa</a>
                                        <a class="dropdown-item text-danger" href="javascript:void(0);" onclick="deleteBlog(@item.Id)"><i class="bx bx-trash me-1"></i> Xóa</a>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function deleteBlog(id) {
            Swal.fire({
                title: 'Bạn có chắc chắn muốn xóa?',
                text: "Hành động này không thể hoàn tác!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Đồng ý xóa',
                cancelButtonText: 'Hủy'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('/Admin/Blog/Delete/' + id, function (res) {
                        if (res.success) {
                            Swal.fire('Đã xóa!', res.message, 'success').then(() => location.reload());
                        } else {
                            Swal.fire('Lỗi!', res.message, 'error');
                        }
                    });
                }
            })
        }
    </script>
}
