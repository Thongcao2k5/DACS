@model IEnumerable<MotoShop.Data.Models.Category>
@{
    ViewData["Title"] = "Quản lý Danh mục";
    Layout = "_AdminLayout";
}

<div class="container-xxl flex-grow-1 container-p-y">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-0"><span class="text-muted fw-light">Cấu hình /</span> Danh mục</h4>
            <small class="text-muted">Quản lý các loại sản phẩm phụ tùng & xe máy</small>
        </div>
        <button type="button" class="btn btn-primary rounded-pill px-4 shadow-sm fw-bold" onclick="openCreateModal()">
            <i class="bx bx-plus me-1"></i> THÊM DANH MỤC
        </button>
    </div>

    <div class="card border-0 shadow-sm overflow-hidden">
        <div class="table-responsive text-nowrap">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 60px;">ID</th>
                        <th>Tên Danh Mục</th>
                        <th>Danh Mục Cha</th>
                        <th class="text-center">Số Sản Phẩm</th>
                        <th class="text-center" style="width: 150px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody class="table-border-bottom-0">
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><span class="text-muted">#@item.CategoryId</span></td>
                            <td>
                                @if (item.ParentId != null)
                                {
                                    <span class="text-muted me-2">L—</span>
                                }
                                <span class="fw-bold text-dark">@item.CategoryName</span>
                            </td>
                            <td>
                                @if (item.ParentCategory != null)
                                {
                                    <span class="badge bg-label-secondary">@item.ParentCategory.CategoryName</span>
                                }
                                else
                                {
                                    <span class="badge bg-label-primary">Danh mục gốc</span>
                                }
                            </td>
                            <td class="text-center"><span class="badge rounded-pill bg-light text-dark border">@item.Products?.Count</span></td>
                            <td class="text-center">
                                <div class="dropdown">
                                    <button type="button" class="btn p-0 dropdown-toggle hide-arrow" data-bs-toggle="dropdown">
                                        <i class="bx bx-dots-vertical-rounded"></i>
                                    </button>
                                    <div class="dropdown-menu">
                                        <a class="dropdown-item" href="javascript:void(0);" onclick="openEditModal(@item.CategoryId)">
                                            <i class="bx bx-edit-alt me-1"></i> Sửa
                                        </a>
                                        <a class="dropdown-item text-danger" href="javascript:void(0);" onclick="handleDelete(@item.CategoryId, '@item.CategoryName')">
                                            <i class="bx bx-trash me-1"></i> Xóa
                                        </a>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Thêm/Sửa Danh mục -->
<div class="modal fade" id="categoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow-lg border-0">
            <form id="categoryForm" onsubmit="handleFormSubmit(event)">
                <div class="modal-header border-bottom p-4">
                    <h5 class="modal-title fw-bold" id="modalTitle">Thêm danh mục mới</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <input type="hidden" id="CategoryId" name="CategoryId">
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-uppercase">Tên danh mục <span class="text-danger">*</span></label>
                        <input type="text" id="CategoryName" name="CategoryName" class="form-control border-primary" placeholder="Nhập tên danh mục (VD: Dàn chân, Nhớt máy...)" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-uppercase">Danh mục cha</label>
                        <select id="ParentId" name="ParentId" class="form-select">
                            <option value="0">-- Chọn danh mục cha (Để trống nếu là gốc) --</option>
                            @foreach (var p in ViewBag.ParentCategories)
                            {
                                <option value="@p.CategoryId">@p.CategoryName</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-uppercase">Đường dẫn ảnh (URL)</label>
                        <input type="url" id="ImageUrl" name="ImageUrl" class="form-control" placeholder="https://example.com/image.png">
                    </div>
                    <div class="mb-0">
                        <label class="form-label fw-bold small text-uppercase">Mô tả ngắn</label>
                        <textarea id="Description" name="Description" class="form-control" rows="3" placeholder="Nhập vài dòng giới thiệu về danh mục này..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-top p-3 px-4">
                    <button type="button" class="btn btn-outline-secondary px-4 rounded-pill" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary px-4 rounded-pill fw-bold">LƯU DANH MỤC</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const categoryModal = new bootstrap.Modal(document.getElementById('categoryModal'));
        const categoryForm = document.getElementById('categoryForm');

        function openCreateModal() {
            categoryForm.reset();
            document.getElementById('CategoryId').value = "";
            document.getElementById('modalTitle').innerText = "Thêm danh mục mới";
            categoryModal.show();
        }

        function openEditModal(id) {
            categoryForm.reset();
            showLoader();
            $.get('/Admin/Category/GetCategory/' + id, function (data) {
                hideLoader();
                document.getElementById('CategoryId').value = data.categoryId;
                document.getElementById('CategoryName').value = data.categoryName;
                document.getElementById('ParentId').value = data.parentId || 0;
                document.getElementById('ImageUrl').value = data.imageUrl || "";
                document.getElementById('Description').value = data.description || "";
                document.getElementById('modalTitle').innerText = "Cập nhật danh mục";
                categoryModal.show();
            });
        }

        function handleFormSubmit(e) {
            e.preventDefault();
            const url = '/Admin/Category/Upsert';
            const formData = new FormData(categoryForm);
            
            const data = {};
            formData.forEach((value, key) => data[key] = value);

            showLoader();
            $.post(url, data, function (res) {
                hideLoader();
                if (res.success) {
                    categoryModal.hide();
                    location.reload();
                } else {
                    alert(res.message);
                }
            });
        }

        function handleDelete(id, name) {
            if (confirm(`Bạn có chắc chắn muốn xóa danh mục "${name}"? Thao tác này không thể hoàn tác.`)) {
                showLoader();
                $.post('/Admin/Category/Delete/' + id, function (res) {
                    hideLoader();
                    if (res.success) {
                        location.reload();
                    } else {
                        alert(res.message);
                    }
                });
            }
        }
    </script>
}
